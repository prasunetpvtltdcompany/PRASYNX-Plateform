// === PARENT LINKING ===
router.post('/link-parent-student', asyncHandler(async (req, res) => {
  const { parent_id, student_id, relationship } = req.body;
  const orgId = (req as any).user?.organisationId;
  
  try {
    const { data: student } = await supabase
      .from('students')
      .select('organisation_id')
      .eq('id', student_id)
      .single();
    if (!student || student.organisation_id !== orgId) {
      return res.status(403).json({ error: 'Access denied: student not in your organisation' });
    }
    const { data, error } = await supabase
      .from('parent_student_links')
      .insert({ parent_id, student_id, relationship })
      .select()
      .single();
    
    if (error) throw error;
    res.status(201).json(data);
  } catch (error: any) {
    res.status(500).json({ error: error.message });
  }
});

router.post('/parents/bulk', asyncHandler(async (req, res) => {
  const { organisation_id, parents } = req.body;
  if (!organisation_id || !Array.isArray(parents) || parents.length === 0) {
    return res.status(400).json({ error: 'organisation_id and parents array required' });
  }
  const results: any[] = [];
  let success = 0, failed = 0;
  for (const p of parents) {
    try {
      if (!p.parent_name || !p.parent_email || !p.student_name) {
        failed++;
        results.push({ parent_name: p.parent_name || 'Unknown', parent_email: p.parent_email || '', status: 'failed', error: 'parent_name, parent_email, student_name required' });
        continue;
      }
      const password = p.parent_password || crypto.randomUUID().slice(0, 12) + '!';
      const passwordHash = await bcrypt.hash(password, 10);
      const { data: existing } = await supabase.from('users').select('id').eq('email', p.parent_email).maybeSingle();
      let parentUserId: string;
      let authCreated = false;
      if (existing) {
        parentUserId = existing.id;
      } else {
        const { data: newUser, error: userError } = await supabase.from('users').insert({
          organisation_id, full_name: p.parent_name, email: p.parent_email,
          password_hash: passwordHash, role: 'parent', status: 'active'
        }).select().single();
        if (userError) throw userError;
        parentUserId = newUser.id;
        try {
          await createAuthUser(p.parent_email, password, p.parent_name, 'parent', organisation_id);
          authCreated = true;
        } catch (authError: any) {
          await supabase.from('users').delete().eq('id', newUser.id);
          throw authError;
        }
      }
      const { data: studentMatch } = await supabase.from('students')
        .select('id').eq('organisation_id', organisation_id)
        .ilike('full_name', `%${p.student_name}%`).maybeSingle();
      if (studentMatch) {
        await supabase.from('parent_student_links').insert({
          parent_id: parentUserId, student_id: studentMatch.id,
          relationship: p.relationship || 'guardian'
        }).select().single();
      }
      success++;
      results.push({ parent_name: p.parent_name, parent_email: p.parent_email, password, status: 'success', student_linked: !!studentMatch });
      if (!existing) getOrgName(organisation_id).then(n => logCredential(organisation_id, n, p.parent_name, p.parent_email, 'parent', 'Management Bulk Import'));
    } catch (e: any) {
      failed++;
      results.push({ parent_name: p.parent_name || 'Unknown', parent_email: p.parent_email || '', status: 'failed', error: e.message });
    }
  }
  res.json({ total: parents.length, success_count: success, failed_count: failed, results });
});

router.post('/parents', asyncHandler(async (req, res) => {
  let { organisation_id, parent_name, parent_email, parent_password, student_id, student_name, relationship, phone } = req.body;
  if (!organisation_id) organisation_id = req.user?.organisationId || '';
  if (!organisation_id) return res.status(400).json({ error: 'organisation_id required — try logging out and back in' });
  if (!isValidUUID(organisation_id)) return res.status(400).json({ error: 'Invalid organisation_id' });
  if (!parent_name) return res.status(400).json({ error: 'parent_name required' });
  if (!parent_email) return res.status(400).json({ error: 'parent_email required' });
  try {
    let resolvedStudentId = student_id;
    if (!resolvedStudentId && student_name) {
      const { data: stuList } = await supabase.from('students')
        .select('id').eq('organisation_id', organisation_id)
        .ilike('full_name', `%${student_name}%`).limit(1);
      if (stuList && stuList.length > 0) resolvedStudentId = stuList[0].id;
    }
    const password = parent_password || crypto.randomUUID().slice(0, 12) + '!';
    const passwordHash = await bcrypt.hash(password, 10);
    const { data: existing } = await supabase.from('users').select('id').eq('email', parent_email).maybeSingle();
    let parentUserId: string;
    let authCreated = false;
    if (existing) {
      parentUserId = existing.id;
    } else {
      const { data: newUser, error: userError } = await supabase.from('users').insert({
        organisation_id, full_name: parent_name, email: parent_email,
        password_hash: passwordHash, role: 'parent', status: 'active'
      }).select().single();
      if (userError) throw userError;
      parentUserId = newUser.id;
      try {
        await createAuthUser(parent_email, password, parent_name, 'parent', organisation_id);
        authCreated = true;
      } catch (authError: any) {
        await supabase.from('users').delete().eq('id', newUser.id);
        throw authError;
      }
    }
    await supabase.from('parents').insert({
      organisation_id, user_id: parentUserId,
      student_id: resolvedStudentId || null,
      full_name: parent_name, email: parent_email,
      phone: phone || null, status: 'active'
    }).select().single();
    if (resolvedStudentId) {
      await supabase.from('parent_student_links').insert({
        parent_id: parentUserId, student_id: resolvedStudentId,
        relationship: relationship || 'guardian'
      }).select().single();
    }
    res.status(201).json({ parent_user_id: parentUserId, credentials: { email: parent_email, password } });
    getOrgName(organisation_id).then(n => logCredential(organisation_id, n, parent_name, parent_email, 'parent', 'Management Portal'));
  } catch (error: any) {
    res.status(500).json({ error: error.message });
  }
});

