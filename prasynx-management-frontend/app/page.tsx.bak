                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Reporting Manager</span>
                        <span className="font-bold text-gray-800 text-sm capitalize">{selectedStaff.reporting_manager || '—'}</span>
                      </div>
                    </div>
                  </div>

                  {/* Address & Payroll details */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div className="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
