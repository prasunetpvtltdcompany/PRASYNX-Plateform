                                                ✓ {r}
                                              </span>
                                            ))}
                                          </div>
                                        )}
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('class_teacher', ct.id)}
                                        className="text-indigo-400 hover:text-red-500 font-bold text-base p-1 hover:bg-indigo-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Transport Assignments */}
                            {assignmentsData.transport?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-amber-600 text-[10px] uppercase tracking-wider">Transport Duty (Vehicles & Routes)</h5>
                                <div className="space-y-2">
                                  {assignmentsData.transport.map((t: any) => (
                                    <div key={t.id} className="bg-amber-50/40 border border-amber-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-amber-955">
                                          🚌 Vehicle: <span className="font-mono text-purple-700">{t.vehicle_no}</span> | Route: <span className="text-indigo-600 font-semibold">{t.route_name}</span>
                                        </p>
                                        <p className="text-[10px] text-gray-500 font-medium">Assigned Students: <span className="font-bold text-gray-700">{t.assigned_students_count || 0}</span></p>
                                        {Array.isArray(t.responsibilities) && t.responsibilities.length > 0 && (
                                          <div className="flex flex-wrap gap-1 mt-1">
                                            {t.responsibilities.map((r: string, idx: number) => (
                                              <span key={idx} className="bg-white text-amber-700 px-2 py-0.5 rounded text-[9px] font-semibold border border-amber-50">
                                                ✓ {r}
                                              </span>
                                            ))}
                                          </div>
                                        )}
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('transport', t.id)}
                                        className="text-amber-400 hover:text-red-500 font-bold text-base p-1 hover:bg-amber-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Security Assignments */}
                            {assignmentsData.security?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-emerald-600 text-[10px] uppercase tracking-wider">Security Shift Duty</h5>
                                <div className="space-y-2">
                                  {assignmentsData.security.map((sec: any) => (
                                    <div key={sec.id} className="bg-emerald-50/40 border border-emerald-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-emerald-955">
                                          🛡️ Gate Location: <span className="text-purple-700 font-semibold">{sec.gate_name}</span>
                                        </p>
                                        <p className="text-[10px] text-gray-500 font-medium">
                                          Area: <span className="font-bold text-gray-700">{sec.building_area || 'Main Gate'}</span> | Shift: <span className="bg-emerald-100 text-emerald-800 font-bold text-[9px] px-1.5 py-0.5 rounded">{sec.shift}</span>
                                        </p>
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('security', sec.id)}
                                        className="text-emerald-400 hover:text-red-500 font-bold text-base p-1 hover:bg-emerald-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Housekeeping Assignments */}
                            {assignmentsData.housekeeping?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-pink-600 text-[10px] uppercase tracking-wider">Housekeeping Facilities Duty</h5>
                                <div className="space-y-2">
                                  {assignmentsData.housekeeping.map((hk: any) => (
                                    <div key={hk.id} className="bg-pink-50/40 border border-pink-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-pink-955">
                                          🧹 Building: <span className="text-purple-700 font-semibold">{hk.building}</span>
                                        </p>
                                        <p className="text-[10px] text-gray-500 font-medium">
                                          Floor: <span className="font-bold text-gray-700">{hk.floor || 'All Floors'}</span> | Zone: <span className="font-bold text-gray-700">{hk.zone || 'All Zones'}</span>
                                        </p>
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('housekeeping', hk.id)}
                                        className="text-pink-400 hover:text-red-500 font-bold text-base p-1 hover:bg-pink-50 rounded"
