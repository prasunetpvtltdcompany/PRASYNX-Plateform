}

function AlumniDonationFormModal({ open, onClose, onSaved }: { open: boolean; onClose: () => void; onSaved: () => void }) {
  const f = useForm({ alumni_id: '', amount: '', purpose: '', donation_date: new Date().toISOString().split('T')[0] });
  const [alumniList, setAlumniList] = useState<any[]>([]);
  const [saving, setSaving] = useState(false);
  useEffect(() => { (async () => setAlumniList(await apiClient.safeFetchArray(`/alumni-management/alumni/${orgId()}`)))(); }, []);
  return <CrudModal open={open} onClose={onClose} title="Add Donation">
    <div className="space-y-4">
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Alumni</label>
        <select value={f.values.alumni_id as string} onChange={e => f.handleChange('alumni_id', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          <option value="">Select alumni...</option>
          {alumniList.map((a: any) => <option key={a.id} value={a.id}>{a.full_name} ({a.graduation_year})</option>)}
        </select></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Amount (₹)</label>
        <input type="number" value={f.values.amount as string} onChange={e => f.handleChange('amount', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Purpose</label>
        <input type="text" value={f.values.purpose as string} onChange={e => f.handleChange('purpose', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Date</label>
        <input type="date" value={f.values.donation_date as string} onChange={e => f.handleChange('donation_date', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <button disabled={saving} onClick={async () => { setSaving(true); try { await alumniMgmtApi.createDonation(f.values); toast.success('Donation recorded'); onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : 'Record Donation'}</button>
    </div>
  </CrudModal>;
}

function AlumniMentorFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { alumni_id: '', expertise: '', availability: '' });
  const [alumniList, setAlumniList] = useState<any[]>([]);
  const [saving, setSaving] = useState(false);
  useEffect(() => { (async () => setAlumniList(await apiClient.safeFetchArray(`/alumni-management/alumni/${orgId()}`)))(); }, []);
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Mentor' : 'Add Mentor'}>
    <div className="space-y-4">
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Alumni</label>
        <select value={f.values.alumni_id as string} onChange={e => f.handleChange('alumni_id', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          <option value="">Select alumni...</option>
          {alumniList.map((a: any) => <option key={a.id} value={a.id}>{a.full_name} ({a.current_occupation})</option>)}
        </select></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Expertise</label>
        <input type="text" value={f.values.expertise as string} onChange={e => f.handleChange('expertise', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Availability</label>
        <input type="text" value={f.values.availability as string} onChange={e => f.handleChange('availability', e.target.value)} placeholder="e.g. Weekends, Evenings" className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await alumniMgmtApi.updateMentor(edit.id, f.values); toast.success('Updated'); } else { await alumniMgmtApi.createMentor(f.values); toast.success('Mentor added'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Add Mentor'}</button>
    </div>
  </CrudModal>;
}

function AlumniModule() {
  return <AlumniTab />;
}

function CareerTab() {
  const [activeTab, setActiveTab] = useState('internships');
  const internships = useApi(() => careerMgmtApi.getInternships(), []);
  const psychTests = useApi(() => careerMgmtApi.getPsychometricTests(), []);
  const collegeApps = useApi(() => careerMgmtApi.getCollegeApplications(), []);
  const skillAssess = useApi(() => careerMgmtApi.getSkillAssessments(), []);
  const sessions = useApi(() => careerMgmtApi.getSessions(), []);

  const [intModal, setIntModal] = useState(false);
  const [editInt, setEditInt] = useState<any>(null);
  const [psyModal, setPsyModal] = useState(false);
  const [editPsy, setEditPsy] = useState<any>(null);
  const [colModal, setColModal] = useState(false);
  const [editCol, setEditCol] = useState<any>(null);
  const [sklModal, setSklModal] = useState(false);
  const [sesModal, setSesModal] = useState(false);
  const [editSes, setEditSes] = useState<any>(null);

  const tabs = [
    { key: 'internships', label: 'Internships', icon: Briefcase },
    { key: 'psychometric', label: 'Psychometric Tests', icon: Brain },
    { key: 'college', label: 'College Apps', icon: FileText },
    { key: 'skills', label: 'Skill Assessments', icon: Target },
    { key: 'sessions', label: 'Career Sessions', icon: CalendarDays },
  ];

  return (<div>
    <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit flex-wrap">
      {tabs.map(t => (<button key={t.key} onClick={() => setActiveTab(t.key)}
        className={`flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-all ${activeTab === t.key ? 'bg-white text-[#6D4CFF] shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
        <t.icon size={14} /> {t.label}
      </button>))}
    </div>

    {activeTab === 'internships' && <ModulePage title="Internships" desc="Manage internship opportunities" actions={
      <AddButton onClick={() => { setEditInt(null); setIntModal(true); }} label="Add Internship" />
    }>
      <div className="grid grid-cols-2 gap-4">
        {(internships.data || []).map((e: any) => (<div key={e.id} className="bg-white rounded-xl border border-gray-100 p-4">
          <div className="flex items-start justify-between mb-2">
            <div>
              <div className="text-sm font-bold">{e.role}</div>
              <div className="text-[11px] text-gray-400">{e.company}{e.duration && ` • ${e.duration}`}</div>
            </div>
            <Badge variant={e.status === 'open' ? 'success' : 'default'} className="text-[9px]">{e.status}</Badge>
          </div>
          {e.description && <p className="text-[11px] text-gray-500 mb-2 line-clamp-2">{e.description}</p>}
          <div className="flex items-center gap-3 text-[10px] text-gray-400 mb-3">
            {e.stipend && <span>Stipend: <strong className="text-gray-600">{e.stipend}</strong></span>}
            {e.application_deadline && <span>Deadline: {new Date(e.application_deadline).toLocaleDateString()}</span>}
          </div>
          <div className="flex gap-2">
            <button onClick={() => { setEditInt(e); setIntModal(true); }} className="flex-1 py-1.5 rounded-lg border border-gray-200 text-gray-500 text-[10px] font-semibold hover:bg-gray-50 flex items-center justify-center gap-1"><Edit3 size={12} /> Edit</button>
            <button onClick={async () => { if (!confirm('Delete?')) return; try { await careerMgmtApi.deleteInternship(e.id); internships.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="flex-1 py-1.5 rounded-lg border border-red-200 text-red-400 text-[10px] font-semibold hover:bg-red-50 flex items-center justify-center gap-1"><Trash2 size={12} /> Delete</button>
          </div>
        </div>))}
      </div>
      <IntFormModal open={intModal} edit={editInt} onClose={() => { setIntModal(false); setEditInt(null); }} onSaved={() => { internships.refetch(); setIntModal(false); setEditInt(null); }} />
    </ModulePage>}

    {activeTab === 'psychometric' && <ModulePage title="Psychometric Tests" desc="Career aptitude and psychometric assessments" actions={
      <AddButton onClick={() => { setEditPsy(null); setPsyModal(true); }} label="Add Test" />
    }>
      <DataTable columns={[
        { key: 'name', label: 'Test Name' },
        { key: 'description', label: 'Description' },
        { key: 'duration', label: 'Duration (min)', render: (v: number) => v ? `${v} min` : '—' },
        { key: 'actions', label: '', render: (_: any, r: any) => (<div className="flex gap-1">
          <button onClick={() => { setEditPsy(r); setPsyModal(true); }} className="px-2 py-1 rounded bg-gray-50 text-gray-400 text-[9px] font-semibold hover:bg-gray-100"><Edit3 size={11} /></button>
          <button onClick={async () => { if (!confirm('Delete?')) return; try { await careerMgmtApi.deletePsychometricTest(r.id); psychTests.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        </div>)}
      ]} data={psychTests.data || []} loading={psychTests.loading} error={psychTests.error} onRetry={psychTests.refetch} emptyMessage="No psychometric tests yet." />
      <PsyFormModal open={psyModal} edit={editPsy} onClose={() => { setPsyModal(false); setEditPsy(null); }} onSaved={() => { psychTests.refetch(); setPsyModal(false); setEditPsy(null); }} />
    </ModulePage>}

    {activeTab === 'college' && <ModulePage title="College Applications" desc="Track student college applications" actions={
      <AddButton onClick={() => { setEditCol(null); setColModal(true); }} label="Add Application" />
    }>
      <DataTable columns={[
        { key: 'student', label: 'Student', render: (_: any, r: any) => r.student?.full_name || r.student_id || '—' },
        { key: 'college_name', label: 'College' },
        { key: 'program', label: 'Program' },
        { key: 'application_date', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
        { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'accepted' ? 'success' : v === 'rejected' ? 'danger' : 'default'} className="text-[9px]">{v}</Badge> },
        { key: 'actions', label: '', render: (_: any, r: any) => (<div className="flex gap-1">
          <button onClick={() => { setEditCol(r); setColModal(true); }} className="px-2 py-1 rounded bg-gray-50 text-gray-400 text-[9px] font-semibold hover:bg-gray-100"><Edit3 size={11} /></button>
          <button onClick={async () => { if (!confirm('Delete?')) return; try { await careerMgmtApi.deleteCollegeApplication(r.id); collegeApps.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        </div>)}
      ]} data={collegeApps.data || []} loading={collegeApps.loading} error={collegeApps.error} onRetry={collegeApps.refetch} emptyMessage="No college applications yet." />
      <ColFormModal open={colModal} edit={editCol} onClose={() => { setColModal(false); setEditCol(null); }} onSaved={() => { collegeApps.refetch(); setColModal(false); setEditCol(null); }} />
    </ModulePage>}

    {activeTab === 'skills' && <ModulePage title="Skill Assessments" desc="Track student skill assessments" actions={
      <AddButton onClick={() => setSklModal(true)} label="Add Assessment" />
    }>
      <DataTable columns={[
        { key: 'student', label: 'Student', render: (_: any, r: any) => r.student?.full_name || r.student_id || '—' },
        { key: 'skill', label: 'Skill' },
        { key: 'score', label: 'Score', render: (v: number) => <span className="font-semibold">{v}/100</span> },
        { key: 'assessed_date', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
        { key: 'actions', label: '', render: (_: any, r: any) => (
          <button onClick={async () => { if (!confirm('Delete?')) return; try { await careerMgmtApi.deleteSkillAssessment(r.id); skillAssess.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        )}
      ]} data={skillAssess.data || []} loading={skillAssess.loading} error={skillAssess.error} onRetry={skillAssess.refetch} emptyMessage="No assessments yet." />
      <SklFormModal open={sklModal} onClose={() => setSklModal(false)} onSaved={() => { skillAssess.refetch(); setSklModal(false); }} />
    </ModulePage>}

    {activeTab === 'sessions' && <ModulePage title="Career Sessions" desc="Career guidance sessions and workshops" actions={
      <AddButton onClick={() => { setEditSes(null); setSesModal(true); }} label="Add Session" />
    }>
      <div className="grid grid-cols-2 gap-4">
        {(sessions.data || []).map((e: any) => (<div key={e.id} className="bg-white rounded-xl border border-gray-100 p-4">
          <div className="flex items-start justify-between mb-2">
            <div>
              <div className="text-sm font-bold">{e.title}</div>
              <div className="text-[11px] text-gray-400">{e.speaker && `by ${e.speaker}`}{e.location && ` • ${e.location}`}</div>
            </div>
            <Badge variant={e.status === 'upcoming' ? 'success' : e.status === 'ongoing' ? 'warning' : 'default'} className="text-[9px]">{e.status}</Badge>
          </div>
          {e.description && <p className="text-[11px] text-gray-500 mb-2 line-clamp-2">{e.description}</p>}
          <div className="flex items-center gap-3 text-[10px] text-gray-400 mb-3">
            {e.session_date && <span>{new Date(e.session_date).toLocaleDateString()}</span>}
            {e.session_time && <span>{e.session_time.slice(0,5)}</span>}
            {e.max_participants && <span>Max: {e.max_participants}</span>}
          </div>
          <div className="flex gap-2">
            <button onClick={() => { setEditSes(e); setSesModal(true); }} className="flex-1 py-1.5 rounded-lg border border-gray-200 text-gray-500 text-[10px] font-semibold hover:bg-gray-50 flex items-center justify-center gap-1"><Edit3 size={12} /> Edit</button>
            <button onClick={async () => { if (!confirm('Delete?')) return; try { await careerMgmtApi.deleteSession(e.id); sessions.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="flex-1 py-1.5 rounded-lg border border-red-200 text-red-400 text-[10px] font-semibold hover:bg-red-50 flex items-center justify-center gap-1"><Trash2 size={12} /> Delete</button>
          </div>
        </div>))}
      </div>
      <SesFormModal open={sesModal} edit={editSes} onClose={() => { setSesModal(false); setEditSes(null); }} onSaved={() => { sessions.refetch(); setSesModal(false); setEditSes(null); }} />
    </ModulePage>}
  </div>);
}

function IntFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { company: '', role: '', description: '', duration: '', stipend: '', application_deadline: '' });
  const [saving, setSaving] = useState(false);
  const fields = [
    { key: 'company', label: 'Company', type: 'text' },
    { key: 'role', label: 'Role', type: 'text' },
    { key: 'description', label: 'Description', type: 'text' },
    { key: 'duration', label: 'Duration', type: 'text' },
    { key: 'stipend', label: 'Stipend', type: 'text' },
    { key: 'application_deadline', label: 'Deadline', type: 'date' },
  ];
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Internship' : 'Add Internship'}>
    <div className="space-y-4">
      {fields.map(field => (<div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
        <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
      </div>))}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await careerMgmtApi.updateInternship(edit.id, f.values); toast.success('Updated'); } else { await careerMgmtApi.createInternship(f.values); toast.success('Created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Create'}</button>
    </div>
  </CrudModal>;
}

function PsyFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { name: '', description: '', duration: '' });
  const [saving, setSaving] = useState(false);
  const fields = [
    { key: 'name', label: 'Test Name', type: 'text' },
    { key: 'description', label: 'Description', type: 'text' },
    { key: 'duration', label: 'Duration (minutes)', type: 'number' },
  ];
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Test' : 'Add Test'}>
    <div className="space-y-4">
      {fields.map(field => (<div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
        <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
      </div>))}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await careerMgmtApi.updatePsychometricTest(edit.id, f.values); toast.success('Updated'); } else { await careerMgmtApi.createPsychometricTest(f.values); toast.success('Created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Create'}</button>
    </div>
  </CrudModal>;
}

function ColFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { student_id: '', college_name: '', program: '', application_date: new Date().toISOString().split('T')[0], status: 'draft' });
  const [students, setStudents] = useState<any[]>([]);
  const [saving, setSaving] = useState(false);
  useEffect(() => { (async () => setStudents(await apiClient.safeFetchArray(`/management/students/${orgId()}`)))(); }, []);
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Application' : 'Add Application'}>
    <div className="space-y-4">
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Student</label>
        <select value={f.values.student_id as string} onChange={e => f.handleChange('student_id', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          <option value="">Select student...</option>
          {students.map((s: any) => <option key={s.id} value={s.id}>{s.full_name} ({s.roll_number})</option>)}
        </select></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">College Name</label>
        <input type="text" value={f.values.college_name as string} onChange={e => f.handleChange('college_name', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Program</label>
        <input type="text" value={f.values.program as string} onChange={e => f.handleChange('program', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Application Date</label>
        <input type="date" value={f.values.application_date as string} onChange={e => f.handleChange('application_date', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      {edit && <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Status</label>
        <select value={f.values.status as string} onChange={e => f.handleChange('status', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          {['draft','submitted','accepted','rejected','waitlisted'].map(o => <option key={o} value={o}>{o.charAt(0).toUpperCase()+o.slice(1)}</option>)}
        </select></div>}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await careerMgmtApi.updateCollegeApplication(edit.id, f.values); toast.success('Updated'); } else { await careerMgmtApi.createCollegeApplication(f.values); toast.success('Created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Create'}</button>
    </div>
  </CrudModal>;
}

function SklFormModal({ open, onClose, onSaved }: { open: boolean; onClose: () => void; onSaved: () => void }) {
  const f = useForm({ student_id: '', skill: '', score: '50', assessed_date: new Date().toISOString().split('T')[0] });
  const [students, setStudents] = useState<any[]>([]);
  const [saving, setSaving] = useState(false);
  useEffect(() => { (async () => setStudents(await apiClient.safeFetchArray(`/management/students/${orgId()}`)))(); }, []);
  return <CrudModal open={open} onClose={onClose} title="Add Assessment">
    <div className="space-y-4">
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Student</label>
        <select value={f.values.student_id as string} onChange={e => f.handleChange('student_id', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          <option value="">Select student...</option>
          {students.map((s: any) => <option key={s.id} value={s.id}>{s.full_name} ({s.roll_number})</option>)}
        </select></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Skill</label>
        <input type="text" value={f.values.skill as string} onChange={e => f.handleChange('skill', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Score (0-100)</label>
        <input type="number" min="0" max="100" value={f.values.score as string} onChange={e => f.handleChange('score', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Assessment Date</label>
        <input type="date" value={f.values.assessed_date as string} onChange={e => f.handleChange('assessed_date', e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      <button disabled={saving} onClick={async () => { setSaving(true); try { await careerMgmtApi.createSkillAssessment(f.values); toast.success('Assessment recorded'); onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : 'Record Assessment'}</button>
    </div>
  </CrudModal>;
}

function SesFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { title: '', description: '', speaker: '', session_date: '', session_time: '', location: '', max_participants: '' });
  const [saving, setSaving] = useState(false);
  const fields = [
    { key: 'title', label: 'Title', type: 'text' },
    { key: 'description', label: 'Description', type: 'text' },
    { key: 'speaker', label: 'Speaker', type: 'text' },
    { key: 'session_date', label: 'Date', type: 'date' },
    { key: 'session_time', label: 'Time', type: 'time' },
    { key: 'location', label: 'Location', type: 'text' },
    { key: 'max_participants', label: 'Max Participants', type: 'number' },
  ];
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Session' : 'Add Session'}>
    <div className="space-y-4">
      {fields.map(field => (<div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
        <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
      </div>))}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await careerMgmtApi.updateSession(edit.id, f.values); toast.success('Updated'); } else { await careerMgmtApi.createSession(f.values); toast.success('Created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Create'}</button>
    </div>
  </CrudModal>;
}

function CareerModule() {
  return <CareerTab />;
}

function PartTimeJobsModule() {
  const [showCreate, setShowCreate] = useState(false);
  const [selectedJob, setSelectedJob] = useState<any>(null);
  const [jobForm, setJobForm] = useState({ title: '', description: '', type: 'local', area: '', pay_type: 'fixed', pay_amount: '', duration: '', slots: '1', skills: '', contact_info: '', target_role: '' });
  const [editing, setEditing] = useState<string | false>(false);
  const [submitting, setSubmitting] = useState(false);
  const [applications, setApplications] = useState<any[]>([]);
  const [showApps, setShowApps] = useState(false);

  const jobs = useApi(() => partTimeJobApi.getAll(), []);

  const handleSubmit = async () => {
    setSubmitting(true);
    const sessionData = typeof window !== 'undefined' ? JSON.parse(localStorage.getItem('managementSession') || '{}') : {};
    const orgId = sessionData?.organisation?.id || '00000000-0000-0000-0000-000000000001';
    const payload = { ...jobForm, organisation_id: orgId, pay_amount: Number(jobForm.pay_amount), slots: Number(jobForm.slots) };
    const res = editing ? await partTimeJobApi.update(editing, payload) : await partTimeJobApi.create(payload);
    setSubmitting(false);
    if (res.success) { toast.success(editing ? 'Job updated' : 'Job created'); setShowCreate(false); resetForm(); jobs.refetch(); }
    else toast.error(res.error || 'Failed');
  };

  const resetForm = () => {
    setJobForm({ title: '', description: '', type: 'local', area: '', pay_type: 'fixed', pay_amount: '', duration: '', slots: '1', skills: '', contact_info: '', target_role: '' });
    setEditing(false);
  };

  const loadApplications = async (job: any) => {
    setSelectedJob(job);
    const res = await partTimeJobApi.getApplications(job.id);
    if (res.success) setApplications(res.data || []);
    setShowApps(true);
  };

  const updateAppStatus = async (appId: string, status: string) => {
    const res = await partTimeJobApi.updateApplicationStatus(appId, status);
    if (res.success) { toast.success(`Application ${status}`); loadApplications(selectedJob); }
    else toast.error(res.error || 'Failed');
  };

  return (
    <ModulePage title="Part-Time Jobs" desc="Manage job listings and applications for staff, parents, and students"
      actions={<AddButton onClick={() => { resetForm(); setShowCreate(true); }} label="Create Job" />}>
      {showApps && selectedJob ? (
        <Card className="p-5 mb-6">
          <div className="flex items-center justify-between mb-4">
            <div><h3 className="text-sm font-bold">Applications for {selectedJob.title}</h3><p className="text-xs text-gray-400">{applications.length} total</p></div>
            <button onClick={() => setShowApps(false)} className="text-xs text-[#6D4CFF] font-semibold hover:underline">Back to Jobs</button>
          </div>
          {applications.length === 0 ? <EmptyState message="No applications yet" /> :
           <div className="space-y-3">{applications.map((app: any) => (
            <div key={app.id} className="flex items-center justify-between p-3 rounded-xl bg-gray-50 border border-gray-100">
              <div className="flex-1">
                <div className="text-sm font-semibold">{app.applicant_name}</div>
                <div className="text-xs text-gray-400">{app.applicant_email} · {app.applicant_type} {app.phone ? `· ${app.phone}` : ''}</div>
                {app.cover_note && <div className="text-xs text-gray-500 mt-1 italic">"{app.cover_note}"</div>}
              </div>
              <div className="flex items-center gap-2">
                <Badge className={app.status === 'approved' ? 'bg-green-50 text-green-600' : app.status === 'rejected' ? 'bg-red-50 text-red-600' : 'bg-yellow-50 text-yellow-600'}>{app.status}</Badge>
                {app.status === 'pending' && <><button onClick={() => updateAppStatus(app.id, 'approved')} className="px-3 py-1.5 rounded-lg bg-green-50 text-green-600 text-xs font-semibold hover:bg-green-100">Approve</button><button onClick={() => updateAppStatus(app.id, 'rejected')} className="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 text-xs font-semibold hover:bg-red-100">Reject</button></>}
              </div>
            </div>
           ))}</div>}
        </Card>
      ) : null}

      <DataTable columns={[
        { key: 'title', label: 'Title' },
        { key: 'type', label: 'Type', render: (v: string) => <Badge className={v === 'online' ? 'bg-blue-50 text-blue-600' : 'bg-orange-50 text-orange-600'}>{v}</Badge> },
        { key: 'area', label: 'Area' },
        { key: 'pay_amount', label: 'Pay', render: (v: number, row: any) => `$${v || 0}/${row.pay_type === 'hourly' ? 'hr' : 'fixed'}` },
        { key: 'slots', label: 'Slots' },
        { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'warning'} className="text-[9px]">{v}</Badge> },
        { key: 'actions', label: '', render: (_: any, row: any) => (
          <div className="flex items-center gap-2">
            <button onClick={() => loadApplications(row)} className="px-3 py-1.5 rounded-lg bg-[#F3F0FF] text-[#6D4CFF] text-xs font-semibold hover:bg-[#E8E3FF]">Applications</button>
            <button onClick={() => { setJobForm({ title: row.title, description: row.description || '', type: row.type, area: row.area || '', pay_type: row.pay_type, pay_amount: String(row.pay_amount || ''), duration: row.duration || '', slots: String(row.slots || '1'), skills: row.skills || '', contact_info: row.contact_info || '', target_role: row.target_role || '' }); setEditing(row.id); setShowCreate(true); }} className="text-xs text-gray-400 hover:text-gray-600"><Edit3 size={14} /></button>
            <button onClick={async () => { if (confirm('Delete this job?')) { const r = await partTimeJobApi.remove(row.id); if (r.success) { toast.success('Deleted'); jobs.refetch(); } else toast.error(r.error); } }} className="text-xs text-gray-400 hover:text-red-500"><Trash2 size={14} /></button>
          </div>
        )},
      ]} data={Array.isArray(jobs.data) ? jobs.data : []} loading={jobs.loading} error={jobs.error} onRetry={jobs.refetch} emptyMessage="No jobs created yet. Create your first job listing." />

      {showCreate && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40" onClick={() => setShowCreate(false)}>
          <div className="bg-white rounded-2xl p-6 w-full max-w-lg mx-4 shadow-2xl max-h-[90vh] overflow-y-auto" onClick={e => e.stopPropagation()}>
            <div className="flex items-center justify-between mb-4">
              <h3 className="font-bold">{editing ? 'Edit Job' : 'Create Job'}</h3>
              <button onClick={() => setShowCreate(false)} className="text-gray-400 hover:text-gray-600"><X size={20} /></button>
            </div>
            <div className="space-y-3">
              <div><label className="text-xs font-medium text-gray-500 mb-1 block">Title *</label><input className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.title} onChange={e => setJobForm(p => ({ ...p, title: e.target.value }))} /></div>
              <div><label className="text-xs font-medium text-gray-500 mb-1 block">Description</label><textarea className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF] min-h-[80px]" value={jobForm.description} onChange={e => setJobForm(p => ({ ...p, description: e.target.value }))} /></div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Type</label><select className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.type} onChange={e => setJobForm(p => ({ ...p, type: e.target.value }))}><option value="local">📍 Local</option><option value="online">🖥 Online</option></select></div>
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Area</label><input className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" placeholder="e.g. Downtown, Remote" value={jobForm.area} onChange={e => setJobForm(p => ({ ...p, area: e.target.value }))} /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Pay Type</label><select className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.pay_type} onChange={e => setJobForm(p => ({ ...p, pay_type: e.target.value }))}><option value="fixed">Fixed</option><option value="hourly">Hourly</option></select></div>
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Pay Amount ($)</label><input type="number" className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.pay_amount} onChange={e => setJobForm(p => ({ ...p, pay_amount: e.target.value }))} /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Duration</label><input className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" placeholder="e.g. 3 months, Flexible" value={jobForm.duration} onChange={e => setJobForm(p => ({ ...p, duration: e.target.value }))} /></div>
                <div><label className="text-xs font-medium text-gray-500 mb-1 block">Slots</label><input type="number" className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.slots} onChange={e => setJobForm(p => ({ ...p, slots: e.target.value }))} /></div>
              </div>
              <div><label className="text-xs font-medium text-gray-500 mb-1 block">Target Role (who should see this job)</label><select className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" value={jobForm.target_role} onChange={e => setJobForm(p => ({ ...p, target_role: e.target.value }))}><option value="">All Staff</option><option value="teacher">Teachers</option><option value="driver">Drivers</option><option value="admin">Admin</option><option value="librarian">Librarians</option><option value="coach">Coaches</option><option value="accountant">Accountants</option><option value="student">Students</option><option value="parent">Parents</option></select></div>
              <div><label className="text-xs font-medium text-gray-500 mb-1 block">Skills (comma separated)</label><input className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" placeholder="e.g. Teaching, Data Entry, Sales" value={jobForm.skills} onChange={e => setJobForm(p => ({ ...p, skills: e.target.value }))} /></div>
              <div><label className="text-xs font-medium text-gray-500 mb-1 block">Contact Info</label><input className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#6D4CFF]" placeholder="Phone or email for inquiries" value={jobForm.contact_info} onChange={e => setJobForm(p => ({ ...p, contact_info: e.target.value }))} /></div>
              <button onClick={handleSubmit} disabled={submitting || !jobForm.title} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold hover:bg-[#5a3ed9] transition-all disabled:opacity-50">{submitting ? 'Saving...' : editing ? 'Update Job' : 'Create Job'}</button>
            </div>
          </div>
        </div>
      )}
    </ModulePage>
  );
}

function StoreTab() {
  const [mode, setMode] = useState<string>('products');
  const [searchQ, setSearchQ] = useState('');
  const [catFilter, setCatFilter] = useState('');
  const [invFilter, setInvFilter] = useState('');
  const [orderStatusFilter, setOrderStatusFilter] = useState('');
  const [payStatusFilter, setPayStatusFilter] = useState('');

  const dash = useApi(() => storeApiV2.getDashboard(), []);
  const products = useApi(() => storeApiV2.getProducts({ category: catFilter, status: invFilter, search: searchQ }), [catFilter, invFilter, searchQ]);
  const orders = useApi(() => storeApiV2.getOrders({ payment_status: payStatusFilter, delivery_status: orderStatusFilter, search: searchQ }), [payStatusFilter, orderStatusFilter, searchQ]);
  const inventory = useApi(() => storeApiV2.getInventory(), []);
  const categories = useApi(() => storeApiV2.getCategories(), []);
  const suppliers = useApi(() => storeApiV2.getSuppliers(), []);
  const analytics = useApi(() => storeApiV2.getAnalytics(), []);
  const aiInsights = useApi(() => storeApiV2.getAiInsights(), []);
  const sidebar = useApi(() => storeApiV2.getSidebar(), []);

  const dd = dash.data?.data || dash.data || {};
  const ad = analytics.data?.data || analytics.data || {};
  const ai = aiInsights.data?.data || aiInsights.data || {};
  const sd = sidebar.data?.data || sidebar.data || {};

  const KPI_CONFIG = [
    { icon: Package, label: 'Total Products', value: dd.totalProducts ?? 0, trend: `+${dd.trends?.products?.pct || 12}%`, color: '#6D4CFF', bg: '#F5F3FF' },
    { icon: ShoppingCart, label: 'Total Orders', value: dd.totalOrders ?? 0, trend: `+${dd.trends?.orders?.pct || 18}%`, color: '#22C55E', bg: '#F0FDF4' },
    { icon: DollarSign, label: 'Revenue Generated', value: `$${(dd.revenue / 1000).toFixed(1)}K`, trend: `+${dd.trends?.revenue?.pct || 15}%`, color: '#F59E0B', bg: '#FFFBEB' },
    { icon: Clock, label: 'Pending Orders', value: dd.pendingOrders ?? 0, trend: `processing`, color: '#EF4444', bg: '#FEF2F2' },
    { icon: AlertTriangle, label: 'Low Stock Items', value: dd.lowStockItems ?? 0, trend: `${dd.trends?.stock?.pct || -5}%`, color: '#F97316', bg: '#FFF7ED' },
    { icon: Users, label: 'Active Customers', value: dd.activeCustomers ?? 0, trend: `unique buyers`, color: '#3B82F6', bg: '#EFF6FF' },
    { icon: DollarSign, label: 'Inventory Value', value: `$${(dd.inventoryValue / 1000).toFixed(1)}K`, trend: `total stock`, color: '#A855F7', bg: '#FAF5FF' },
    { icon: TrendingUp, label: 'Monthly Sales Growth', value: `${dd.monthlySalesGrowth ?? 0}%`, trend: `vs last month`, color: '#06B6D4', bg: '#ECFEFF' },
  ];

  const NAVS = [
    { key: 'products', label: 'Products', icon: Package },
    { key: 'orders', label: 'Orders', icon: ShoppingCart },
    { key: 'inventory', label: 'Inventory', icon: Layers },
    { key: 'categories', label: 'Categories', icon: Tag },
    { key: 'suppliers', label: 'Suppliers', icon: Truck },
    { key: 'analytics', label: 'Sales Analytics', icon: BarChart3 },
    { key: 'insights', label: 'AI Insights', icon: Brain },
    { key: 'reports', label: 'Reports', icon: FileSpreadsheet },
  ];

  const renderProducts = () => {
    const items = products.data?.data || products.data || [];
    return (
      <div className="space-y-4">
        <div className="flex items-center gap-2">
          <input type="text" placeholder="Search product, SKU..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
          <select value={catFilter} onChange={e => setCatFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
            <option value="">All Categories</option>
            <option value="School Uniforms">School Uniforms</option>
            <option value="Books">Books</option>
            <option value="Stationery">Stationery</option>
            <option value="Sports Equipment">Sports Equipment</option>
            <option value="Lab Materials">Lab Materials</option>
            <option value="ID Cards">ID Cards</option>
            <option value="Bags">Bags</option>
            <option value="Accessories">Accessories</option>
          </select>
          <select value={invFilter} onChange={e => setInvFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
            <option value="">All Status</option>
            <option value="in_stock">In Stock</option>
            <option value="low_stock">Low Stock</option>
            <option value="out_of_stock">Out Of Stock</option>
            <option value="discontinued">Discontinued</option>
          </select>
          <button onClick={() => toast.success('Add product form opened')} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold"><Plus size={14} className="inline mr-1" />Add Product</button>
        </div>
        <Card className="p-0 overflow-hidden">
          <DataTable
            columns={[
              { key: 'image_url', label: 'Image', render: () => (
                <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-[#6D4CFF20] to-[#8B5CF620] flex items-center justify-center text-[#6D4CFF]"><Package size={14} /></div>
              )},
              { key: 'name', label: 'Product Name', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
              { key: 'sku', label: 'SKU', render: (v: string) => <span className="text-[10px] text-gray-500">{v || '—'}</span> },
              { key: 'category', label: 'Category', render: (v: string) => <Badge className="text-[9px]">{v || 'General'}</Badge> },
              { key: 'price', label: 'Price', render: (v: number) => <span className="text-[11px] font-semibold">${(v || 0).toFixed(2)}</span> },
              { key: 'stock_quantity', label: 'Stock', render: (v: number, row: any) => (
                <span className={`text-[11px] font-semibold ${(v || 0) <= (row.min_stock || 10) ? 'text-[#EF4444]' : 'text-[#22C55E]'}`}>{v ?? 0}</span>
              )},
              { key: 'sold_quantity', label: 'Sold', render: (v: number) => <span className="text-[11px] text-gray-600">{v || 0}</span> },
              { key: 'status', label: 'Status', render: (v: string) => {
                const map: Record<string, 'success' | 'warning' | 'danger' | 'default'> = {
                  in_stock: 'success', low_stock: 'warning', out_of_stock: 'danger', discontinued: 'default',
                };
                return <Badge variant={map[v] || 'default'} className="text-[9px] capitalize">{(v || 'in_stock').replace(/_/g, ' ')}</Badge>;
              }},
              { key: 'id', label: '', render: (_: string, row: any) => (
                <div className="flex gap-1">
                  <button onClick={() => toast.success('Viewing ' + row.name)} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold"><Eye size={10} className="inline mr-1" />View</button>
                  <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Edit</button>
                  <button onClick={() => storeApiV2.duplicateProduct(row.id).then(() => { products.refetch(); toast.success('Product duplicated'); })} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Copy size={10} className="inline mr-1" />Dup</button>
                  <button onClick={() => toast.success('Update stock for ' + row.name)} className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold">Stock</button>
                  <button onClick={() => storeApiV2.deleteProduct(row.id).then(() => { products.refetch(); toast.success('Product deleted'); })} className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[9px] font-semibold"><Trash2 size={10} className="inline mr-1" /></button>
                </div>
              )},
            ]}
            data={items.length > 0 ? items : []}
            loading={products.loading}
            emptyMessage="No products found"
          />
        </Card>
      </div>
    );
  };

  const renderOrders = () => {
    const items = orders.data?.data || orders.data || [];
    return (
      <div className="space-y-4">
        <div className="flex items-center gap-2">
          <input type="text" placeholder="Search order ID, customer..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
          <select value={payStatusFilter} onChange={e => setPayStatusFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
            <option value="">Payment Status</option>
            <option value="paid">Paid</option>
            <option value="pending">Pending</option>
            <option value="failed">Failed</option>
            <option value="refunded">Refunded</option>
          </select>
          <select value={orderStatusFilter} onChange={e => setOrderStatusFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
            <option value="">Delivery Status</option>
            <option value="processing">Processing</option>
            <option value="packed">Packed</option>
            <option value="shipped">Shipped</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
          <button onClick={() => toast.success('Create order form opened')} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold"><Plus size={14} className="inline mr-1" />Create Order</button>
        </div>
        <Card className="p-0 overflow-hidden">
          <DataTable
            columns={[
              { key: 'id', label: 'Order ID', render: (v: string) => <span className="text-[10px] font-mono font-semibold">#{v?.slice(0, 8) || '—'}</span> },
              { key: 'customer_name', label: 'Customer', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
              { key: 'product_count', label: 'Items', render: (v: number) => <span className="text-[11px]">{v || 0}</span> },
              { key: 'created_at', label: 'Order Date', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
              { key: 'total_amount', label: 'Total', render: (v: number) => <span className="text-[11px] font-bold text-[#6D4CFF]">${(v || 0).toFixed(2)}</span> },
              { key: 'payment_status', label: 'Payment', render: (v: string) => {
                const map: Record<string, 'success' | 'warning' | 'danger' | 'default'> = {
                  paid: 'success', pending: 'warning', failed: 'danger', refunded: 'info' as any,
                };
                return <Badge variant={map[v] || 'warning'} className="text-[9px] capitalize">{v || 'pending'}</Badge>;
              }},
              { key: 'delivery_status', label: 'Delivery', render: (v: string) => {
                const map: Record<string, 'success' | 'warning' | 'default'> = {
                  delivered: 'success', shipped: 'info' as any, packed: 'warning', processing: 'warning', cancelled: 'danger' as any,
                };
                return <Badge variant={map[v] || 'default'} className="text-[9px] capitalize">{v || 'processing'}</Badge>;
              }},
              { key: 'id', label: '', render: (_: string, row: any) => (
                <div className="flex gap-1">
                  <button onClick={() => toast.success('Viewing order')} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold"><Eye size={10} className="inline mr-1" />View</button>
                  <button onClick={() => toast.success('Update order status')} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Status</button>
                  <button onClick={() => toast.success('Invoice generated')} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Printer size={10} className="inline mr-1" /></button>
                  {row.payment_status === 'paid' && <button onClick={() => storeApiV2.refundOrder(row.id).then(() => { orders.refetch(); toast.success('Order refunded'); })} className="px-2 py-1 rounded-lg bg-[#F59E0B10] text-[#F59E0B] text-[9px] font-semibold">Refund</button>}
                  {row.delivery_status !== 'cancelled' && row.delivery_status !== 'delivered' && <button onClick={() => storeApiV2.updateOrderStatus(row.id, { delivery_status: 'cancelled' }).then(() => { orders.refetch(); toast.success('Order cancelled'); })} className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[9px] font-semibold">Cancel</button>}
                </div>
              )},
            ]}
            data={items.length > 0 ? items : []}
            loading={orders.loading}
            emptyMessage="No orders found"
          />
        </Card>
      </div>
    );
  };

  const renderInventory = () => {
    const items = inventory.data?.data || inventory.data || [];
    return (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-gray-700">Inventory Management</h3>
          <div className="flex gap-2">
            <button onClick={() => toast.success('Stock audit initiated')} className="px-3 py-1.5 rounded-xl bg-[#6D4CFF10] text-[#6D4CFF] text-[10px] font-semibold"><RefreshCw size={12} className="inline mr-1" />Stock Audit</button>
            <AddButton onClick={() => toast.success('Add stock form')} label="Add Stock" />
          </div>
        </div>
        <Card className="p-0 overflow-hidden">
          <DataTable
            columns={[
              { key: 'name', label: 'Product', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
              { key: 'sku', label: 'SKU', render: (v: string) => <span className="text-[10px] text-gray-500">{v || '—'}</span> },
              { key: 'stock_quantity', label: 'Current Stock', render: (v: number, row: any) => (
                <span className={`text-[11px] font-bold ${(v || 0) <= (row.min_stock || 10) ? 'text-[#EF4444]' : 'text-[#22C55E]'}`}>{v ?? 0}</span>
              )},
              { key: 'min_stock', label: 'Min Stock', render: (v: number) => <span className="text-[11px]">{v || 10}</span> },
              { key: 'reorderLevel', label: 'Reorder Level', render: (v: number) => <span className="text-[11px]">{v || 20}</span> },
              { key: 'needsReorder', label: 'Alert', render: (v: boolean) => v ? <Badge variant="danger" className="text-[8px]">Reorder Now</Badge> : <Badge variant="success" className="text-[8px]">OK</Badge> },
              { key: 'updated_at', label: 'Last Updated', render: (v: string) => <span className="text-[9px] text-gray-400">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
              { key: 'id', label: '', render: (_: string, row: any) => (
                <div className="flex gap-1">
                  <button onClick={() => toast.success('Add stock to ' + row.name)} className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold"><Plus size={10} className="inline mr-1" />Add</button>
                  <button onClick={() => toast.success('Remove stock from ' + row.name)} className="px-2 py-1 rounded-lg bg-[#EF444410] text-[#EF4444] text-[9px] font-semibold"><X size={10} className="inline mr-1" />Remove</button>
                  <button onClick={() => toast.success('Transfer stock: ' + row.name)} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Transfer</button>
                </div>
              )},
            ]}
            data={items.length > 0 ? items : []}
            loading={inventory.loading}
            emptyMessage="No inventory items"
          />
        </Card>
      </div>
    );
  };

  const renderCategories = () => {
    const items = categories.data?.data || categories.data || [];
    return (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-gray-700">Product Categories</h3>
          <AddButton onClick={() => toast.success('Add category form opened')} label="Add Category" />
        </div>
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {[
            { name: 'School Uniforms', icon: Briefcase, color: '#6D4CFF', count: 12 },
            { name: 'Books', icon: BookOpen, color: '#22C55E', count: 24 },
            { name: 'Stationery', icon: Edit3, color: '#F59E0B', count: 36 },
            { name: 'Sports Equipment', icon: Trophy, color: '#EF4444', count: 8 },
            { name: 'Lab Materials', icon: Target, color: '#3B82F6', count: 6 },
            { name: 'ID Cards', icon: CreditCard, color: '#A855F7', count: 4 },
            { name: 'Bags', icon: Briefcase, color: '#06B6D4', count: 10 },
            { name: 'Accessories', icon: Gift, color: '#F97316', count: 18 },
          ].map(cat => {
            const Icon = cat.icon;
            return (
              <Card key={cat.name} className="p-4 hover:shadow-md transition-shadow cursor-pointer">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ background: cat.color + '15' }}>
                    <Icon size={18} style={{ color: cat.color }} />
                  </div>
                  <div>
                    <h4 className="text-xs font-semibold text-gray-800">{cat.name}</h4>
                    <div className="text-[9px] text-gray-400">{cat.count} products</div>
                  </div>
                </div>
                <div className="flex gap-2 mt-3 pt-3 border-t border-gray-50">
                  <button onClick={() => toast.success('Viewing ' + cat.name)} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[8px] font-semibold">View</button>
                  <button onClick={() => toast.success('Editing ' + cat.name)} className="px-2 py-1 rounded-lg bg-gray-100 text-[8px] font-semibold text-gray-600">Edit</button>
                  <button onClick={() => toast.success(cat.name + ' archived')} className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[8px] font-semibold">Archive</button>
                </div>
              </Card>
            );
          })}
        </div>
      </div>
    );
  };

  const renderSuppliers = () => {
    const items = suppliers.data?.data || suppliers.data || [];
    return (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-gray-700">Supplier Management</h3>
          <AddButton onClick={() => toast.success('Add supplier form opened')} label="Add Supplier" />
        </div>
        <Card className="p-0 overflow-hidden">
          <DataTable
            columns={[
              { key: 'name', label: 'Supplier Name', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
              { key: 'contact_person', label: 'Contact Person', render: (v: string) => <span className="text-[11px]">{v || '—'}</span> },
              { key: 'phone', label: 'Phone', render: (v: string) => <span className="text-[11px]">{v || '—'}</span> },
              { key: 'products_supplied', label: 'Products Supplied', render: (v: string) => <span className="text-[10px]">{v || '—'}</span> },
              { key: 'last_order', label: 'Last Order', render: (v: string) => <span className="text-[10px] text-gray-400">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
              { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'warning'} className="text-[9px] capitalize">{v || 'active'}</Badge> },
              { key: 'id', label: '', render: (_: string, row: any) => (
                <div className="flex gap-1">
                  <button onClick={() => toast.success('Viewing ' + row.name)} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold"><Eye size={10} className="inline mr-1" />View</button>
                  <button onClick={() => toast.success('Place order with ' + row.name)} className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold">Order</button>
                  <button onClick={() => toast.success('Editing ' + row.name)} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Edit</button>
                  <button onClick={() => toast.success('Performance report for ' + row.name)} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Performance</button>
                </div>
              )},
            ]}
            data={items.length > 0 ? items : []}
            loading={suppliers.loading}
            emptyMessage="No suppliers found"
          />
        </Card>
      </div>
    );
  };

  const renderAnalyticsView = () => {
    const monthlyTrend = ad.monthlySalesTrend || [];
    const categorySales = ad.categorySales || [];
    const bestSellers = ad.bestSellingProducts || [];
    const invTurnover = ad.inventoryTurnover || [];
    const orderDist = ad.orderStatusDistribution || [];
    const customerAnalysis = ad.customerPurchaseAnalysis || [];
    const profitMargin = ad.profitMarginAnalysis || {};

    return (
      <div className="space-y-4">
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <Card className="p-4 text-center"><div className="text-[11px] text-gray-500">Total Revenue</div><div className="text-2xl font-extrabold text-[#6D4CFF]">${(ad.totalRevenue / 1000).toFixed(1)}K</div></Card>
          <Card className="p-4 text-center"><div className="text-[11px] text-gray-500">Total Orders</div><div className="text-2xl font-extrabold text-[#22C55E]">{ad.totalOrders}</div></Card>
          <Card className="p-4 text-center"><div className="text-[11px] text-gray-500">Total Products</div><div className="text-2xl font-extrabold text-[#F59E0B]">{ad.totalProducts}</div></Card>
          <Card className="p-4 text-center"><div className="text-[11px] text-gray-500">Profit Margin</div><div className="text-2xl font-extrabold text-[#3B82F6]">{profitMargin.profitMargin ?? 0}%</div></Card>
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Monthly Sales Trend</h4>
            {monthlyTrend.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <AreaChart data={monthlyTrend}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Area type="monotone" dataKey="revenue" stroke="#6D4CFF" fill="#6D4CFF20" strokeWidth={2} name="Revenue" />
                  <Area type="monotone" dataKey="sales" stroke="#22C55E" fill="#22C55E20" strokeWidth={2} name="Sales" />
                </AreaChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No monthly data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Revenue Growth</h4>
            {(ad.revenueGrowth || monthlyTrend).length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={ad.revenueGrowth || monthlyTrend}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="revenue" fill="#6D4CFF" radius={[4, 4, 0, 0]} name="Revenue" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No revenue data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Product Category Sales</h4>
            {categorySales.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={categorySales} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis type="category" dataKey="category" tick={{ fontSize: 10 }} width={100} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="revenue" fill="#8B5CF6" radius={[0, 4, 4, 0]} name="Revenue" />
                  <Bar dataKey="sold" fill="#22C55E" radius={[0, 4, 4, 0]} name="Sold" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No category data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Best Selling Products</h4>
            {bestSellers.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={bestSellers} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis type="category" dataKey="name" tick={{ fontSize: 9 }} width={120} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="sold" fill="#6D4CFF" radius={[0, 4, 4, 0]} name="Sold" />
                  <Bar dataKey="revenue" fill="#22C55E" radius={[0, 4, 4, 0]} name="Revenue" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No sales data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Inventory Turnover</h4>
            {invTurnover.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={invTurnover} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis type="category" dataKey="name" tick={{ fontSize: 9 }} width={100} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="turnover" fill="#F59E0B" radius={[0, 4, 4, 0]} name="Turnover" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No inventory data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Order Status Distribution</h4>
            {orderDist.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={orderDist}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="status" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="count" fill="#6D4CFF" radius={[4, 4, 0, 0]} name="Orders" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No order data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Customer Purchase Analysis</h4>
            {customerAnalysis.length > 0 ? (
              <ResponsiveContainer width="100%" height={240}>
                <BarChart data={customerAnalysis} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis type="category" dataKey="name" tick={{ fontSize: 8 }} width={80} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="total" fill="#8B5CF6" radius={[0, 4, 4, 0]} name="Total Spent" />
                </BarChart>
              </ResponsiveContainer>
            ) : <EmptyState message="No customer data" />}
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Profit Margin Analysis</h4>
            <div className="grid grid-cols-2 gap-4">
              <div className="p-4 rounded-xl bg-[#6D4CFF10] text-center">
                <div className="text-[10px] text-gray-500">Total Revenue</div>
                <div className="text-lg font-extrabold text-[#6D4CFF]">${(profitMargin.totalRevenue / 1000).toFixed(1)}K</div>
              </div>
              <div className="p-4 rounded-xl bg-[#22C55E10] text-center">
                <div className="text-[10px] text-gray-500">Profit Margin</div>
                <div className="text-lg font-extrabold text-[#22C55E]">{profitMargin.profitMargin ?? 0}%</div>
              </div>
            </div>
            {(ad.revenueGrowth || monthlyTrend).length > 0 && (
              <div className="mt-4">
                <ResponsiveContainer width="100%" height={200}>
                  <AreaChart data={ad.revenueGrowth || monthlyTrend}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                    <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                    <YAxis tick={{ fontSize: 10 }} />
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                    <Area type="monotone" dataKey="revenue" stroke="#22C55E" fill="#22C55E20" strokeWidth={2} name="Revenue" />
                  </AreaChart>
                </ResponsiveContainer>
              </div>
            )}
          </Card>
        </div>
      </div>
    );
  };

  const renderAiInsights = () => (
    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <Card className="p-5">
        <h4 className="text-xs font-semibold text-gray-700 mb-4 flex items-center gap-2"><Brain size={14} className="text-[#6D4CFF]" />AI Store Assistant</h4>
        <div className="grid grid-cols-2 gap-4">
          <div className="p-4 rounded-xl bg-[#6D4CFF10] text-center">
            <div className="text-[10px] text-gray-500">Sales Forecast</div>
            <div className="text-lg font-extrabold text-[#6D4CFF]">{ai.salesForecast || '—'}</div>
          </div>
          <div className="p-4 rounded-xl bg-[#22C55E10] text-center">
            <div className="text-[10px] text-gray-500">Revenue Forecast</div>
            <div className="text-lg font-extrabold text-[#22C55E]">{ai.revenueForecasting || '—'}</div>
          </div>
        </div>
        <div className="mt-4 space-y-3">
          <div className="flex justify-between text-[10px]"><span className="text-gray-500">Demand Prediction</span><span className="font-semibold">{ai.demandPrediction || '—'}</span></div>
          <div className="flex justify-between text-[10px]"><span className="text-gray-500">Inventory Health</span><span className="font-semibold">{ai.inventoryOptimization || '—'}</span></div>
          <div className="flex justify-between text-[10px]"><span className="text-gray-500">Seasonal Demand</span><span className="font-semibold">{ai.seasonalDemandPrediction || '—'}</span></div>
          <div className="flex justify-between text-[10px]"><span className="text-gray-500">Supplier Performance</span><Badge variant="success" className="text-[8px]">{ai.supplierPerformanceAnalysis || '—'}</Badge></div>
        </div>
      </Card>
      <Card className="p-5">
        <h4 className="text-xs font-semibold text-gray-700 mb-4 flex items-center gap-2"><Lightbulb size={14} className="text-[#F59E0B]" />Inventory Recommendations</h4>
        <div className="space-y-2">
          {(ai.restockSuggestions || []).map((s: string, i: number) => (
            <div key={i} className="flex items-start gap-2 p-2 rounded-lg bg-gray-50">
              <div className="w-5 h-5 rounded-full bg-[#6D4CFF15] flex items-center justify-center text-[#6D4CFF] text-[9px] font-bold mt-0.5">{i + 1}</div>
              <span className="text-[10px] text-gray-600">{s}</span>
            </div>
          ))}
          {(!ai.restockSuggestions || ai.restockSuggestions.length === 0) && <EmptyState message="All stock levels healthy. No restock suggestions." />}
        </div>
        <div className="mt-4 p-3 rounded-xl bg-[#F59E0B10] border border-[#F59E0B20]">
          <div className="flex items-center gap-2"><Brain size={12} className="text-[#F59E0B]" /><span className="text-[10px] font-semibold text-[#F59E0B]">Smart Recommendations</span></div>
          <p className="text-[9px] text-gray-500 mt-1">Best sellers: {ai.bestSellingProducts || '—'}. {ai.lowStockAlerts?.length > 0 ? `Low stock: ${ai.lowStockAlerts.join(', ')}` : 'All stock levels adequate'}</p>
        </div>
      </Card>
    </div>
  );

  const renderReports = () => {
    const rps = [
      { key: 'sales', label: 'Sales Report', icon: TrendingUp, desc: 'Complete sales records and revenue' },
      { key: 'product', label: 'Product Report', icon: Package, desc: 'Product performance and stock' },
      { key: 'inventory', label: 'Inventory Report', icon: Layers, desc: 'Current inventory and reorder needs' },
      { key: 'supplier', label: 'Supplier Report', icon: Truck, desc: 'Supplier performance and orders' },
      { key: 'revenue', label: 'Revenue Report', icon: DollarSign, desc: 'Revenue breakdown and trends' },
      { key: 'order', label: 'Order Report', icon: ShoppingCart, desc: 'Order history and fulfillment' },
      { key: 'customer', label: 'Customer Report', icon: Users, desc: 'Customer purchase analytics' },
      { key: 'forecast', label: 'AI Forecast Report', icon: Brain, desc: 'AI-powered sales forecasting' },
    ];
    return (
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {rps.map(r => {
          const Icon = r.icon;
          return (
            <Card key={r.key} className="p-5 hover:shadow-md transition-shadow cursor-pointer">
              <div className="flex items-start gap-3">
                <div className="w-10 h-10 rounded-xl bg-[#6D4CFF10] flex items-center justify-center text-[#6D4CFF]"><Icon size={18} /></div>
                <div className="flex-1">
                  <h4 className="text-xs font-semibold text-gray-800">{r.label}</h4>
                  <p className="text-[9px] text-gray-400 mt-0.5">{r.desc}</p>
                  <div className="flex gap-2 mt-3">
                    <button onClick={() => toast.success(r.label + ' generated')} className="px-2.5 py-1 rounded-lg bg-[#6D4CFF] text-white text-[9px] font-semibold">Generate</button>
                    <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline mr-1" />PDF</button>
                    <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline mr-1" />CSV</button>
                  </div>
                </div>
              </div>
            </Card>
          );
        })}
      </div>
    );
  };

  const renderRightSidebar = () => {
    const overview = sd.overview || {};
    const recentOrders = sd.recentOrders || [];
    const ins = sd.aiInsights || {};
    return (
      <div className="space-y-4">
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Store Overview</h4>
          <div className="space-y-2">
            {[
              { label: 'Products', value: overview.totalProducts ?? 0, color: '#6D4CFF' },
              { label: 'Orders', value: overview.totalOrders ?? 0, color: '#22C55E' },
              { label: 'Revenue', value: overview.totalRevenue ? `$${(overview.totalRevenue / 1000).toFixed(1)}K` : '$0', color: '#F59E0B' },
              { label: 'Inventory Value', value: overview.inventoryValue ? `$${(overview.inventoryValue / 1000).toFixed(1)}K` : '$0', color: '#A855F7' },
            ].map(item => (
              <div key={item.label} className="flex justify-between py-1.5 border-b border-gray-50 last:border-0">
                <span className="text-[10px] text-gray-500">{item.label}</span>
                <span className="text-[10px] font-bold" style={{ color: item.color }}>{item.value}</span>
              </div>
            ))}
          </div>
          {overview.doughnutData && (
            <div className="mt-3">
              <ResponsiveContainer width="100%" height={130}>
                <RePieChart>
                  <Pie data={overview.doughnutData} cx="50%" cy="50%" innerRadius={35} outerRadius={55} dataKey="value" paddingAngle={2}>
                    {(overview.doughnutData || []).map((entry: any, i: number) => <Cell key={i} fill={entry.color} />)}
                  </Pie>
                </RePieChart>
              </ResponsiveContainer>
              <div className="flex flex-wrap justify-center gap-2 mt-1">
                {(overview.doughnutData || []).map((d: any) => (
                  <div key={d.name} className="flex items-center gap-1"><div className="w-2 h-2 rounded-full" style={{ background: d.color }} /><span className="text-[8px] text-gray-400">{d.name}</span></div>
                ))}
              </div>
            </div>
          )}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Recent Orders</h4>
          {recentOrders.length > 0 ? (
            <div className="space-y-2">
              {recentOrders.slice(0, 5).map((o: any) => (
                <div key={o.id} className="flex items-center gap-2 p-2 rounded-lg bg-gray-50">
                  <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold">{o.customerName?.charAt(0) || 'C'}</div>
                  <div className="flex-1 min-w-0">
                    <div className="text-[10px] font-semibold truncate">{o.customerName}</div>
                    <div className="text-[8px] text-gray-400">{o.date ? new Date(o.date).toLocaleDateString() : ''}</div>
                  </div>
                  <div className="text-right">
                    <div className="text-[10px] font-bold">${(o.amount || 0).toLocaleString()}</div>
                    <Badge variant={o.status === 'delivered' ? 'success' : 'warning'} className="text-[7px]">{o.status}</Badge>
                  </div>
                </div>
              ))}
            </div>
          ) : <EmptyState message="No recent orders" />}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">AI Store Insights</h4>
          <div className="space-y-2 text-[10px]">
            <div className="flex justify-between"><span className="text-gray-500">Best Sellers</span><span className="font-semibold text-[#6D4CFF] truncate max-w-[120px]">{ins.bestSelling || '—'}</span></div>
            <div className="flex justify-between"><span className="text-gray-500">Low Stock Alerts</span><Badge variant="danger" className="text-[8px]">{ins.lowStockAlerts && ins.lowStockAlerts !== 'None' ? 'Alert' : 'OK'}</Badge></div>
            <div className="flex justify-between"><span className="text-gray-500">Sales Forecast</span><span className="font-semibold text-[#22C55E]">{ins.salesForecast || '—'}</span></div>
            <div className="flex justify-between"><span className="text-gray-500">Revenue Prediction</span><span className="font-semibold text-[#F59E0B]">{ins.revenuePrediction || '—'}</span></div>
            <p className="text-[9px] text-gray-400 mt-1">{ins.inventoryRecommendations || 'No recommendations'}</p>
          </div>
        </Card>
      </div>
    );
  };

  const renderContent = () => {
    switch (mode) {
      case 'products': return renderProducts();
      case 'orders': return renderOrders();
      case 'inventory': return renderInventory();
      case 'categories': return renderCategories();
      case 'suppliers': return renderSuppliers();
      case 'analytics': return renderAnalyticsView();
      case 'insights': return renderAiInsights();
      case 'reports': return renderReports();
      default: return renderProducts();
    }
  };

  return (
    <ModulePage title="School Store" desc="Manage products, inventory, orders, uniforms, books, stationery, and store analytics.">
      <div className="flex flex-wrap items-center gap-2 mb-6">
        <button onClick={() => toast.success('Add product form opened')} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5"><Plus size={14} /> Add Product</button>
        <button onClick={() => toast.success('Create order form opened')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50"><ShoppingCart size={14} /> Create Order</button>
        <button onClick={() => { setMode('inventory'); toast.success('Inventory management'); }} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50"><Layers size={14} /> Manage Inventory</button>
        <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50"><Download size={14} /> Export Reports</button>
        <button onClick={() => toast.success('Store settings opened')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50"><Settings size={14} /> Store Settings</button>
      </div>
      <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-6">
        {KPI_CONFIG.map(k => <KpiCard key={k.label} {...k} />)}
      </div>
      <div className="flex flex-wrap items-center gap-2 mb-6 p-3 rounded-xl bg-white border border-gray-100 shadow-sm">
        <select value={catFilter} onChange={e => setCatFilter(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[100px]">
          <option value="">Product Category</option>
          <option value="School Uniforms">School Uniforms</option>
          <option value="Books">Books</option>
          <option value="Stationery">Stationery</option>
          <option value="Sports Equipment">Sports Equipment</option>
          <option value="Lab Materials">Lab Materials</option>
          <option value="ID Cards">ID Cards</option>
          <option value="Bags">Bags</option>
          <option value="Accessories">Accessories</option>
        </select>
        <select value={invFilter} onChange={e => setInvFilter(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white">
          <option value="">Inventory Status</option>
          <option value="in_stock">In Stock</option>
          <option value="low_stock">Low Stock</option>
          <option value="out_of_stock">Out Of Stock</option>
          <option value="discontinued">Discontinued</option>
        </select>
        <select value={orderStatusFilter} onChange={e => setOrderStatusFilter(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white">
          <option value="">Order Status</option>
          <option value="processing">Processing</option>
          <option value="packed">Packed</option>
          <option value="shipped">Shipped</option>
          <option value="delivered">Delivered</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <select className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white">
          <option value="">Supplier</option>
          <option value="supplier1">Supplier 1</option>
          <option value="supplier2">Supplier 2</option>
        </select>
        <select className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white">
          <option value="">Class</option>
          <option value="1">Class 1</option>
          <option value="2">Class 2</option>
          <option value="3">Class 3</option>
        </select>
        <input type="date" className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white" />
        <input type="date" className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white" />
        <input type="text" placeholder="Product name, SKU, Order ID..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 min-w-[120px] px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px]" />
        <button onClick={() => toast.success('Filters applied')} className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">Apply</button>
        <button onClick={() => { setSearchQ(''); setCatFilter(''); setInvFilter(''); setOrderStatusFilter(''); setPayStatusFilter(''); }} className="px-3 py-1.5 rounded-lg border border-gray-200 text-[10px] font-semibold text-gray-500">Reset</button>
      </div>
      <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
        {NAVS.map(nav => (
          <button key={nav.key} onClick={() => setMode(nav.key)}
            className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
            <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
          </button>
        ))}
      </div>
      <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
        <div className="xl:col-span-3">
          {dash.loading ? <LoadingSkeleton rows={6} cols={4} /> : renderContent()}
        </div>
        <div className="xl:col-span-1">
          {sidebar.loading ? <LoadingSkeleton rows={5} cols={1} /> : renderRightSidebar()}
        </div>
      </div>
      <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-[#6D4CFF20]">
        <h4 className="text-[11px] font-semibold text-gray-600 mb-3">Quick Actions</h4>
        <div className="flex flex-wrap gap-2">
          {[
            { icon: Plus, label: 'Add Product' },
            { icon: ShoppingCart, label: 'Create Order' },
            { icon: Layers, label: 'Update Inventory' },
            { icon: Eye, label: 'View Orders' },
            { icon: BarChart3, label: 'Sales Analytics' },
            { icon: Truck, label: 'Supplier Management' },
            { icon: Download, label: 'Export Reports' },
            { icon: Brain, label: 'AI Insights' },
          ].map(a => (
            <button key={a.label} onClick={() => toast.success(a.label)} className="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 hover:border-[#6D4CFF30] hover:text-[#6D4CFF] transition-all">
              <a.icon size={12} /> {a.label}
            </button>
          ))}
        </div>
      </div>
      <div className="mt-6 p-3 rounded-xl bg-gray-50 border border-gray-100 flex flex-wrap items-center justify-between">
        <div className="flex items-center gap-4 text-[9px] text-gray-400">
          <span className="font-semibold text-gray-500">Role-Based Access:</span>
          <span><Badge variant="purple" className="text-[8px]">Admin: Full Access</Badge></span>
          <span><Badge variant="purple" className="text-[8px]">Store Manager: Store Operations</Badge></span>
          <span><Badge className="text-[8px]">Accountant: Revenue Tracking</Badge></span>
          <span><Badge className="text-[8px]">Student: Purchase Products</Badge></span>
          <span><Badge className="text-[8px]">Parent: Purchase & Track Orders</Badge></span>
        </div>
        <Badge variant="purple" className="text-[8px]">Store Enterprise Plan</Badge>
      </div>
    </ModulePage>
  );
}

function AdmissionModule() {
  const d = useApi(() => admissionApi.getApplications(), []);
  return <ModulePage title="Admission Management" desc="Application and enquiry management"><DataTable columns={[
    { key: 'full_name', label: 'Applicant' }, { key: 'applied_class', label: 'Class' },
    { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'approved' ? 'success' : v === 'rejected' ? 'danger' : 'warning'} className="text-[9px]">{v}</Badge> },
    { key: 'created_at', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
  ]} data={d.data || []} loading={d.loading} error={d.error} onRetry={d.refetch} /></ModulePage>;
}

function ParentsModule() {
  const [bulkOpen, setBulkOpen] = useState(false);
  const [modalOpen, setModalOpen] = useState(false);
  const [newCreds, setNewCreds] = useState<Record<string, { email: string; password: string }>>({});
  const d = useApi(() => parentApi.getLinks(), []);
  const exportCSV = () => {
    const rows = (d.data || []).map((row: any) => ({
      Name: row.parent?.full_name || row.parent_name || '',
      Email: row.parent?.email || row.parent_email || '',
      Password: newCreds[row.parent?.email || row.parent_email]?.password || '',
      Student: row.student?.full_name || row.student_name || '',
      Relationship: row.relationship || '',
      Status: row.status || 'active'
    }));
    const headers = Object.keys(rows[0] || {});
    const csv = [headers.join(','), ...rows.map((r: any) => headers.map(h => `"${(r[h]||'').replace(/"/g,'""')}"`).join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' }); const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'parents-credentials.csv'; a.click();
    URL.revokeObjectURL(url);
  };
  return <>
    <ModulePage title="Parent Management" desc="Parent-student relationships" actions={
      <div className="flex items-center gap-2">
        <button onClick={exportCSV} className="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all"><Download size={14} /> Export CSV</button>
        <button onClick={() => setBulkOpen(true)} className="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all"><Upload size={14} /> Bulk Import</button>
        <AddButton onClick={() => setModalOpen(true)} label="Add Parent" />
      </div>
    }>
      <DataTable columns={[
        { key: 'parent', label: 'Parent', render: (_: any, row: any) => row.parent?.full_name || row.parent_name || '—' },
        { key: 'email', label: 'Email', render: (_: any, row: any) => {
          const email = row.parent?.email || row.parent_email;
          const c = newCreds[email];
          return <span>{email || '—'}{c && <span className="ml-2 text-[9px] text-green-600">(just created)</span>}</span>;
        }},
        { key: 'password', label: 'Password', render: (_: any, row: any) => {
          const email = row.parent?.email || row.parent_email;
          const pw = newCreds[email]?.password;
          return pw ? <span className="font-mono text-[10px] bg-gray-100 px-1.5 py-0.5 rounded">{pw}</span> : <span className="text-gray-300">—</span>;
        }},
        { key: 'student', label: 'Student', render: (_: any, row: any) => row.student?.full_name || row.student_name || '—' },
        { key: 'relationship', label: 'Relationship' },
        { key: 'status', label: 'Status', render: (v: string) => <Badge className="text-[9px]">{v || 'active'}</Badge> },
      ]} data={d.data || []} loading={d.loading} error={d.error} onRetry={d.refetch} />
    </ModulePage>
    <CrudModal open={modalOpen} onClose={() => setModalOpen(false)} title="Add Parent">
      <ParentForm onDone={() => { d.refetch(); setModalOpen(false); }} onCreated={(creds) => {
        setNewCreds(p => ({ ...p, [creds.email]: creds }));
      }} />
    </CrudModal>
    <BulkImportModal open={bulkOpen} onClose={() => setBulkOpen(false)} type="parent" onDone={() => d.refetch()} onCreated={(creds) => setNewCreds(p => ({ ...p, ...creds }))} />
  </>;
}

function ConfigureModule({ moduleConfigs: cfg }: { moduleConfigs: any }) {
  const [saving, setSaving] = useState<string | null>(null);

  const toggleModule = async (key: string, currentEnabled: boolean) => {
    setSaving(key);
    const res = await moduleConfigApi.update(key, !currentEnabled);
    if (res.success) {
      cfg.setData((prev: any) => (prev || []).map((m: any) => m.module_key === key ? { ...m, enabled: !currentEnabled } : m));
      toast.success(`Module ${!currentEnabled ? 'enabled' : 'disabled'}`);
    } else {
      toast.error(res.error || 'Failed to update module');
    }
    setSaving(null);
  };

  const moduleIcons: Record<string, any> = {
    dashboard: LayoutDashboard, students: GraduationCap, staff: Users, classes: School,
    subjects: BookOpen, exams: FileText, fees: DollarSign, attendance: ClipboardList,
    assignments: BookOpen, timetable: CalendarDays, library: Library, transport: Bus,
    hostel: Building2, health: Heart, inventory: ClipboardList, alumni: Globe,
    career: Briefcase, store: Building2, collaboration: MessageSquare,
    extracurricular: CalendarDays, admission: UserPlus, payroll: CreditCard,
    ledger: Wallet, documents: FileText, 'audit-logs': Shield, helpdesk: MessageSquare,
    scholarships: Award, 'ai-insights': Brain, notifications: Bell,
    'bulk-ops': Download, 'part-time-jobs': DollarSign, 'digital-credentials': Award,
    'parent-student-links': UserCheck, 'staff-management': Users,
    gamification: Trophy, esports: Gamepad2, 'transport-smart': Bus,
    'hostel-mgmt': Building2, credentials: Award, 'credential-mgmt': Key,
  };

  const categoryLabels: Record<string, string> = {
    overview: 'Overview & Analytics', users: 'User Management', academic: 'Academic',
    financial: 'Financial', campus: 'Campus', engagement: 'Engagement',
    system: 'System & Settings',
  };

  const moduleCategories: Record<string, string[]> = {
    overview: ['dashboard', 'ai-insights', 'audit-logs'],
    users: ['students', 'staff', 'parent-student-links', 'credentials', 'digital-credentials', 'credential-mgmt', 'bulk-ops'],
    academic: ['classes', 'subjects', 'timetable', 'attendance', 'exams', 'assignments', 'library'],
    financial: ['fees', 'scholarships', 'ledger', 'payroll', 'store'],
    campus: ['transport', 'hostel', 'health', 'inventory', 'helpdesk', 'admission'],
    engagement: ['extracurricular', 'collaboration', 'gamification', 'esports', 'career', 'part-time-jobs', 'alumni', 'notifications', 'staff-management'],
    system: ['transport-smart', 'hostel-mgmt', 'documents'],
  };

  return (
    <ModulePage title="Module Configuration" desc="Enable or disable modules for your institution">
      {cfg.loading ? (
        <LoadingSkeleton rows={8} cols={1} />
      ) : cfg.error ? (
        <ErrorState message={cfg.error} onRetry={cfg.refetch} />
      ) : (
        <div className="space-y-8">
          {Object.entries(moduleCategories).map(([catKey, moduleKeys]) => {
            const catModules = (cfg.data || []).filter((m: any) => moduleKeys.includes(m.module_key));
            if (catModules.length === 0) return null;
            return (
              <div key={catKey}>
                <h3 className="text-sm font-bold text-gray-800 mb-3">{categoryLabels[catKey] || catKey}</h3>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {catModules.map((mod: any) => {
                    const Icon = moduleIcons[mod.module_key] || Settings;
                    return (
                      <div key={mod.module_key} className={`flex items-center gap-3 p-3.5 rounded-xl border transition-all ${mod.enabled ? 'border-gray-200 bg-white' : 'border-gray-100 bg-gray-50/50'}`}>
                        <div className={`w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 ${mod.enabled ? 'bg-[#F3F0FF] text-[#6D4CFF]' : 'bg-gray-100 text-gray-400'}`}>
                          <Icon size={16} />
                        </div>
                        <div className="flex-1 min-w-0">
                          <div className={`text-xs font-semibold ${mod.enabled ? 'text-gray-900' : 'text-gray-400'}`}>{mod.module_name}</div>
                          <div className="text-[10px] text-gray-400 truncate">{mod.description || ''}</div>
                        </div>
                        <button
                          onClick={() => toggleModule(mod.module_key, mod.enabled)}
                          disabled={saving === mod.module_key}
                          className={`relative w-10 h-5 rounded-full transition-all flex-shrink-0 ${mod.enabled ? 'bg-[#6D4CFF]' : 'bg-gray-200'}`}
                        >
                          <span className={`absolute top-0.5 w-4 h-4 bg-white rounded-full shadow-sm transition-all ${mod.enabled ? 'left-5' : 'left-0.5'}`} />
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </ModulePage>
  );
}

function LargeCrudModal({ open, onClose, title, children }: { open: boolean; onClose: () => void; title: string; children: React.ReactNode }) {
  if (!open) return null;
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 backdrop-blur-sm" onClick={onClose}>
      <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }}
        className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto" onClick={e => e.stopPropagation()}>
        <div className="flex items-center justify-between p-5 border-b border-gray-100">
          <h3 className="font-bold text-sm">{title}</h3>
          <button onClick={onClose} className="w-7 h-7 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-700 text-lg">×</button>
        </div>
        <div className="p-5">{children}</div>
      </motion.div>
    </div>
  );
}

function EditStudentForm({ student, classesList, onDone }: { student: any; classesList: any[]; onDone: () => void }) {
  const [saving, setSaving] = useState(false);
  const f = useForm({
    full_name: student.full_name || '',
    roll_number: student.roll_number || '',
    class_id: student.class_id || '',
    section_id: student.section_id || student.section || '',
    email: student.email || '',
    phone: student.phone || '',
    status: student.status || 'active',
    parent_name: student.parent_name || '',
    parent_email: student.parent_email || '',
    parent_phone: student.parent_phone || '',
    parent_relationship: student.parent_relationship || 'guardian'
  });

  const handleUpdate = async () => {
    setSaving(true);
    try {
      const res = await studentApi.update(student.id, f.values);
      if (res.success) {
        toast.success('Student updated successfully!');
        onDone();
      } else {
        toast.error(res.error || 'Failed to update student');
      }
    } catch (err: any) {
      toast.error(err.message || 'Error occurred');
    } finally {
      setSaving(false);
    }
  };

  return (
    <form onSubmit={e => { e.preventDefault(); handleUpdate(); }} className="space-y-4">
      <h4 className="text-xs font-bold text-purple-600 uppercase tracking-wider mb-2 border-b pb-1">Student Details</h4>
      <div className="grid grid-cols-2 gap-4">
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Full Name</label>
          <input type="text" value={f.values.full_name} onChange={e => f.handleChange('full_name', e.target.value)} required
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Roll Number</label>
          <input type="text" value={f.values.roll_number} onChange={e => f.handleChange('roll_number', e.target.value)} required
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Class</label>
          <select value={f.values.class_id} onChange={e => f.handleChange('class_id', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] bg-white">
            <option value="">Select Class</option>
            {classesList.map((c: any) => (
              <option key={c.id} value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Section</label>
          <input type="text" placeholder="e.g. A, B, C" value={f.values.section_id} onChange={e => f.handleChange('section_id', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Student Email</label>
          <input type="email" value={f.values.email} onChange={e => f.handleChange('email', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Student Phone</label>
          <input type="text" value={f.values.phone} onChange={e => f.handleChange('phone', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Status</label>
          <select value={f.values.status} onChange={e => f.handleChange('status', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] bg-white">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
      </div>

      <h4 className="text-xs font-bold text-purple-600 uppercase tracking-wider mt-4 mb-2 border-b pb-1">Parent Details</h4>
      <div className="grid grid-cols-2 gap-4">
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Parent Name</label>
          <input type="text" value={f.values.parent_name} onChange={e => f.handleChange('parent_name', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Parent Email</label>
          <input type="email" value={f.values.parent_email} onChange={e => f.handleChange('parent_email', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Parent Phone</label>
          <input type="text" value={f.values.parent_phone} onChange={e => f.handleChange('parent_phone', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Relationship</label>
          <select value={f.values.parent_relationship} onChange={e => f.handleChange('parent_relationship', e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] bg-white">
            <option value="father">Father</option>
            <option value="mother">Mother</option>
            <option value="guardian">Guardian</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>

      <button type="submit" disabled={saving}
        className="w-full mt-6 py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold hover:shadow-lg disabled:opacity-50">
        {saving ? 'Saving Changes...' : 'Save Changes'}
      </button>
    </form>
  );
}

function StudentTab({ students }: { students: any }) {
  const [modalOpen, setModalOpen] = useState(false);
  const [bulkOpen, setBulkOpen] = useState(false);
  const [editOpen, setEditOpen] = useState(false);
  const [viewOpen, setViewOpen] = useState(false);
  const [parentViewOpen, setParentViewOpen] = useState(false);
  
  const [selectedStudent, setSelectedStudent] = useState<any>(null);
  const [newCreds, setNewCreds] = useState<Record<string, { email: string; password: string }>>({});
  const [expandedCards, setExpandedCards] = useState<Record<string, boolean>>({});

  const [classesList, setClassesList] = useState<any[]>([]);
  const [filters, setFilters] = useState({
    class_name: '',
    section_name: '',
    status: '',
    relationship: '',
    student_login: '',
    parent_login: '',
    date_added: '',
    start_date: '',
    end_date: '',
    search: ''
  });

  const [sortField, setSortField] = useState<string>('created_at');
  const [sortDirection, setSortDirection] = useState<'asc' | 'desc'>('desc');
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);

  useEffect(() => {
    classApi.getAll().then(res => {
      if (res.success && Array.isArray(res.data)) {
        setClassesList(res.data);
      }
    }).catch(() => {});
  }, []);

  useEffect(() => {
    const oId = orgId();
    if (!oId) return;
    try {
      const saved = localStorage.getItem(`prasynx_student_filters_${oId}`);
      if (saved) {
        setFilters(JSON.parse(saved));
      }
    } catch (e) {}
  }, []);

  const saveFilters = (newFilters: typeof filters) => {
    setFilters(newFilters);
    const oId = orgId();
    if (oId) {
      localStorage.setItem(`prasynx_student_filters_${oId}`, JSON.stringify(newFilters));
    }
  };

  const handleClearFilters = () => {
    const cleared = {
      class_name: '',
      section_name: '',
      status: '',
      relationship: '',
      student_login: '',
      parent_login: '',
      date_added: '',
      start_date: '',
      end_date: '',
      search: ''
    };
    saveFilters(cleared);
  };

  const availableClasses = useMemo(() => {
    const cls = classesList.map(c => c.name).filter(Boolean);
    const standards = Array.from({ length: 12 }, (_, i) => `Grade ${i + 1}`);
    return [...new Set([...cls, ...standards])];
  }, [classesList]);

  const availableSections = useMemo(() => {
    const studentSecs = (students?.data || []).map((s: any) => s.section).filter(Boolean);
    const classSecs = classesList.map(c => c.section).filter(Boolean);
    return [...new Set([...studentSecs, ...classSecs, 'A', 'B', 'C', 'D'])].sort();
  }, [students?.data, classesList]);

  const filteredStudents = useMemo(() => {
    let result = students?.data || [];

    if (filters.search) {
      const q = filters.search.toLowerCase().trim();
      result = result.filter((s: any) => {
        return (
          s.full_name?.toLowerCase().includes(q) ||
          s.roll_number?.toLowerCase().includes(q) ||
          s.email?.toLowerCase().includes(q) ||
          s.parent_name?.toLowerCase().includes(q) ||
          s.parent_email?.toLowerCase().includes(q) ||
          s.phone?.toLowerCase().includes(q) ||
          s.parent_phone?.toLowerCase().includes(q)
        );
      });
    }

    if (filters.class_name) {
      result = result.filter((s: any) => s.student_class === filters.class_name);
    }

    if (filters.section_name) {
      result = result.filter((s: any) => s.section === filters.section_name);
    }

    if (filters.status) {
      result = result.filter((s: any) => s.status === filters.status);
    }

    if (filters.relationship) {
      result = result.filter((s: any) => s.parent_relationship === filters.relationship);
    }

    if (filters.student_login) {
      const wantCreated = filters.student_login === 'created';
      result = result.filter((s: any) => !!s.student_login_created === wantCreated);
    }

    if (filters.parent_login) {
      const wantCreated = filters.parent_login === 'created';
      result = result.filter((s: any) => !!s.parent_login_created === wantCreated);
    }

    if (filters.date_added) {
      const now = new Date();
      result = result.filter((s: any) => {
        if (!s.created_at) return false;
        const createdDate = new Date(s.created_at);
        
        if (filters.date_added === 'today') {
          return createdDate.toDateString() === now.toDateString();
        } else if (filters.date_added === 'week') {
          const startOfWeek = new Date();
          startOfWeek.setDate(now.getDate() - now.getDay());
          startOfWeek.setHours(0,0,0,0);
          return createdDate >= startOfWeek;
        } else if (filters.date_added === 'month') {
          return (
            createdDate.getMonth() === now.getMonth() &&
            createdDate.getFullYear() === now.getFullYear()
          );
        } else if (filters.date_added === 'custom') {
          if (filters.start_date && filters.end_date) {
            const start = new Date(filters.start_date + 'T00:00:00');
            const end = new Date(filters.end_date + 'T23:59:59');
            return createdDate >= start && createdDate <= end;
          }
        }
        return true;
      });
    }

    return result;
  }, [students?.data, filters]);

  const sortedStudents = useMemo(() => {
    const result = [...filteredStudents];
    if (!sortField) return result;

    result.sort((a: any, b: any) => {
      let valA = a[sortField];
      let valB = b[sortField];

      if (typeof valA === 'boolean') valA = valA ? 1 : 0;
      if (typeof valB === 'boolean') valB = valB ? 1 : 0;

      if (typeof valA === 'string') valA = valA.toLowerCase().trim();
      if (typeof valB === 'string') valB = valB.toLowerCase().trim();

      if (valA === undefined || valA === null) valA = '';
      if (valB === undefined || valB === null) valB = '';

      if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
      if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
      return 0;
    });
    return result;
  }, [filteredStudents, sortField, sortDirection]);

  const paginatedStudents = useMemo(() => {
    const startIdx = (currentPage - 1) * pageSize;
    return sortedStudents.slice(startIdx, startIdx + pageSize);
  }, [sortedStudents, currentPage, pageSize]);

  const totalPages = Math.ceil(sortedStudents.length / pageSize) || 1;

  useEffect(() => {
    setCurrentPage(1);
  }, [filters, pageSize]);

  const handleSort = (field: string) => {
    if (sortField === field) {
      setSortDirection(prev => (prev === 'asc' ? 'desc' : 'asc'));
    } else {
      setSortField(field);
      setSortDirection('asc');
    }
  };

  const handleExportFiltered = () => {
    const rows = sortedStudents.map((s: any) => ({
      'Full Name': s.full_name,
      'Roll No': s.roll_number,
      'Class': s.student_class,
      'Section': s.section,
      'Email': s.email,
      'Phone': s.phone || '',
      'Parent Name': s.parent_name,
      'Parent Email': s.parent_email,
      'Parent Phone': s.parent_phone || '',
      'Relationship': s.parent_relationship,
      'Student Login': s.student_login_created ? 'Created' : 'Not Created',
      'Parent Login': s.parent_login_created ? 'Created' : 'Not Created',
      'Status': s.status
    }));

    if (rows.length === 0) {
      toast.warning('No filtered results to export.');
      return;
    }

    const headers = Object.keys(rows[0]);
    const csvContent = [
      headers.join(','),
      ...rows.map((row: any) =>
        headers
          .map(h => `"${(row[h] || '').toString().replace(/"/g, '""')}"`)
          .join(',')
      )
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', 'filtered-students.csv');
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    toast.success(`Exported ${rows.length} records successfully!`);
  };

  const headers = [
    { key: 'full_name', label: 'Full Name', className: 'w-[180px] min-w-[180px] max-w-[180px]' },
    { key: 'roll_number', label: 'Roll No', className: 'w-[120px] min-w-[120px] max-w-[120px]' },
    { key: 'student_class', label: 'Class', className: 'w-[100px] min-w-[100px] max-w-[100px]' },
    { key: 'section', label: 'Section', className: 'w-[100px] min-w-[100px] max-w-[100px]' },
    { key: 'email', label: 'Email', className: 'w-[250px] min-w-[250px] max-w-[250px] hidden lg:table-cell' },
    { key: 'phone', label: 'Phone', className: 'w-[150px] min-w-[150px] max-w-[150px]' },
    { key: 'parent_name', label: 'Parent Name', className: 'w-[180px] min-w-[180px] max-w-[180px]' },
    { key: 'parent_email', label: 'Parent Email', className: 'w-[250px] min-w-[250px] max-w-[250px] hidden xl:table-cell' },
    { key: 'parent_phone', label: 'Parent Phone', className: 'w-[150px] min-w-[150px] max-w-[150px] hidden xl:table-cell' },
    { key: 'parent_relationship', label: 'Relationship', className: 'w-[120px] min-w-[120px] max-w-[120px] hidden lg:table-cell' },
    { key: 'student_login_created', label: 'Student Login', className: 'w-[120px] min-w-[120px] max-w-[120px] hidden xl:table-cell' },
    { key: 'parent_login_created', label: 'Parent Login', className: 'w-[120px] min-w-[120px] max-w-[120px] hidden xl:table-cell' },
    { key: 'status', label: 'Status', className: 'w-[120px] min-w-[120px] max-w-[120px]' }
  ];

  return (
    <ModulePage title="Student Management" desc="Manage all student records" actions={
      <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
        <button onClick={handleExportFiltered} className="flex items-center justify-center gap-1.5 px-3 py-3 sm:py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all min-h-[44px] sm:min-h-0 w-full sm:w-auto"><Download size={14} /> Export CSV</button>
        <button onClick={() => setBulkOpen(true)} className="flex items-center justify-center gap-1.5 px-3 py-3 sm:py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all min-h-[44px] sm:min-h-0 w-full sm:w-auto"><Upload size={14} /> Bulk Import</button>
        <AddButton onClick={() => setModalOpen(true)} label="Add Student" />
      </div>
    }>
      {/* Advanced Filters */}
      <div className="bg-white rounded-xl border border-gray-100 p-4 mb-4 shadow-sm space-y-3">
        <div className="flex items-center justify-between border-b pb-2">
          <div className="flex items-center gap-1.5 text-sm font-semibold text-gray-700">
            <Filter size={15} className="text-[#6D4CFF]" />
            <span>Advanced Filters</span>
          </div>
          <button onClick={handleClearFilters} className="flex items-center gap-1 text-xs font-medium text-gray-400 hover:text-red-500 transition-colors">
            <RotateCcw size={12} /> Clear Filters
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
          {/* Search Bar */}
          <div className="relative col-span-full">
            <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400" size={14} />
            <input aria-label="Search students" type="text" placeholder="Search name, roll, email, parent..." value={filters.search} onChange={e => saveFilters({ ...filters, search: e.target.value })}
              className="w-full pl-8 pr-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20" />
          </div>

          {/* Class Filter */}
          <div>
            <select aria-label="Filter by Class" value={filters.class_name} onChange={e => saveFilters({ ...filters, class_name: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Classes</option>
              {availableClasses.map(c => <option key={c} value={c}>{c}</option>)}
            </select>
          </div>

          {/* Section Filter */}
          <div>
            <select aria-label="Filter by Section" value={filters.section_name} onChange={e => saveFilters({ ...filters, section_name: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Sections</option>
              {availableSections.map(s => <option key={s} value={s}>{s}</option>)}
            </select>
          </div>

          {/* Status Filter */}
          <div>
            <select aria-label="Filter by Status" value={filters.status} onChange={e => saveFilters({ ...filters, status: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Statuses</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>

          {/* Relationship Filter */}
          <div>
            <select aria-label="Filter by Relationship" value={filters.relationship} onChange={e => saveFilters({ ...filters, relationship: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Relationships</option>
              <option value="father">Father</option>
              <option value="mother">Mother</option>
              <option value="guardian">Guardian</option>
              <option value="other">Other</option>
            </select>
          </div>

          {/* Student Login Filter */}
          <div>
            <select aria-label="Filter by Student Login status" value={filters.student_login} onChange={e => saveFilters({ ...filters, student_login: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">Student Login: All</option>
              <option value="created">Login Created</option>
              <option value="not_created">Login Not Created</option>
            </select>
          </div>

          {/* Parent Login Filter */}
          <div>
            <select aria-label="Filter by Parent Login status" value={filters.parent_login} onChange={e => saveFilters({ ...filters, parent_login: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">Parent Login: All</option>
              <option value="created">Login Created</option>
              <option value="not_created">Login Not Created</option>
            </select>
          </div>

          {/* Date Added Filter */}
          <div>
            <select aria-label="Filter by Date Added" value={filters.date_added} onChange={e => saveFilters({ ...filters, date_added: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Added Dates</option>
              <option value="today">Today</option>
              <option value="week">This Week</option>
              <option value="month">This Month</option>
              <option value="custom">Custom Range</option>
            </select>
          </div>

          {/* Custom Date Picker */}
          {filters.date_added === 'custom' && (
            <div className="col-span-full md:col-span-2 lg:col-span-2 flex gap-2 items-center">
              <input aria-label="Start Date" type="date" value={filters.start_date} onChange={e => saveFilters({ ...filters, start_date: e.target.value })}
                className="w-full px-2 py-1.5 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20" />
              <span className="text-gray-400 text-xs">to</span>
              <input aria-label="End Date" type="date" value={filters.end_date} onChange={e => saveFilters({ ...filters, end_date: e.target.value })}
                className="w-full px-2 py-1.5 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20" />
            </div>
          )}
        </div>
      </div>

      {/* Redesigned Student Table */}
      {students?.loading ? (
        <LoadingSkeleton rows={5} cols={headers.length} />
      ) : students?.error ? (
        <ErrorState message={students?.error} onRetry={students?.refetch} />
      ) : sortedStudents.length === 0 ? (
        <EmptyState message="No students found matching current filters." />
      ) : (
        <div className="space-y-4">
          {/* Desktop Responsive Student Table */}
          <div className="hidden md:block overflow-x-auto rounded-xl border border-gray-100 shadow-sm bg-white" style={{ WebkitOverflowScrolling: 'touch' }}>
            <table className="min-w-[1600px] w-full border-collapse text-left text-xs text-gray-500">
              <thead className="bg-white text-gray-700 font-semibold uppercase tracking-wider text-[10px] border-b border-gray-100">
                <tr>
                  {headers.map(col => (
                    <th key={col.key} onClick={() => handleSort(col.key)} className={`px-4 py-3 cursor-pointer select-none hover:bg-gray-100 transition-colors whitespace-nowrap sticky top-0 bg-white z-10 ${col.key === 'full_name' ? 'left-0 z-20 shadow-[2px_0_5px_rgba(0,0,0,0.05)] border-r border-gray-100' : ''} ${col.className || ''}`}>
                      <div className="flex items-center gap-1">
                        <span>{col.label}</span>
                        <span className="text-gray-400 text-[9px]">
                          {sortField === col.key ? (sortDirection === 'asc' ? '▲' : '▼') : '↕'}
                        </span>
                      </div>
                    </th>
                  ))}
                  <th className="px-4 py-3 text-center sticky top-0 bg-white z-10 w-[120px] min-w-[120px] max-w-[120px]">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-100">
                {paginatedStudents.map((row: any, i) => (
                  <tr key={row.id || i} className="hover:bg-purple-50/20 transition-all group">
                    {/* Full Name */}
                    <td className="px-4 py-3 font-medium text-gray-900 whitespace-nowrap sticky left-0 bg-white z-10 shadow-[2px_0_5px_rgba(0,0,0,0.05)] border-r border-gray-100 group-hover:bg-purple-50/50 transition-colors w-[180px] min-w-[180px] max-w-[180px]">
                      <button onClick={() => { setSelectedStudent(row); setViewOpen(true); }} className="hover:text-[#6D4CFF] text-left hover:underline">
                        {row.full_name}
                      </button>
                    </td>
                    {/* Roll No */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px]">{row.roll_number}</td>
                    {/* Class */}
                    <td className="px-4 py-3 whitespace-nowrap w-[100px] min-w-[100px] max-w-[100px]">{row.student_class || '—'}</td>
                    {/* Section */}
                    <td className="px-4 py-3 whitespace-nowrap w-[100px] min-w-[100px] max-w-[100px]">
                      <span className="px-1.5 py-0.5 rounded bg-gray-100 text-gray-600 font-bold">{row.section || '—'}</span>
                    </td>
                    {/* Email */}
                    <td className="px-4 py-3 font-mono text-[10px] hidden lg:table-cell w-[250px] min-w-[250px] max-w-[250px] truncate" style={{ maxWidth: '250px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{row.email || '—'}</td>
                    {/* Phone */}
                    <td className="px-4 py-3 whitespace-nowrap w-[150px] min-w-[150px] max-w-[150px]">{row.phone || '—'}</td>
                    {/* Parent Name */}
                    <td className="px-4 py-3 whitespace-nowrap font-medium text-gray-900 w-[180px] min-w-[180px] max-w-[180px]">
                      {row.parent_name ? (
                        <button onClick={() => { setSelectedStudent(row); setParentViewOpen(true); }} className="hover:text-[#6D4CFF] text-left hover:underline">
                          {row.parent_name}
                        </button>
                      ) : '—'}
                    </td>
                    {/* Parent Email */}
                    <td className="px-4 py-3 font-mono text-[10px] hidden xl:table-cell w-[250px] min-w-[250px] max-w-[250px] truncate" style={{ maxWidth: '250px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{row.parent_email || '—'}</td>
                    {/* Parent Phone */}
                    <td className="px-4 py-3 whitespace-nowrap hidden xl:table-cell w-[150px] min-w-[150px] max-w-[150px]">{row.parent_phone || '—'}</td>
                    {/* Relationship */}
                    <td className="px-4 py-3 whitespace-nowrap capitalize hidden lg:table-cell w-[120px] min-w-[120px] max-w-[120px]">
                      <span className="px-2 py-0.5 rounded-full bg-purple-50 text-purple-600 text-[10px] font-semibold">
                        {row.parent_relationship || 'guardian'}
                      </span>
                    </td>
                    {/* Student Login */}
                    <td className="px-4 py-3 whitespace-nowrap hidden xl:table-cell w-[120px] min-w-[120px] max-w-[120px]">
                      <Badge variant={row.student_login_created ? 'success' : 'default'} className="text-[10px]">
                        {row.student_login_created ? 'Created' : 'No Access'}
                      </Badge>
                    </td>
                    {/* Parent Login */}
                    <td className="px-4 py-3 whitespace-nowrap hidden xl:table-cell w-[120px] min-w-[120px] max-w-[120px]">
                      <Badge variant={row.parent_login_created ? 'success' : 'default'} className="text-[10px]">
                        {row.parent_login_created ? 'Created' : 'No Access'}
                      </Badge>
                    </td>
                    {/* Status */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px]">
                      <Badge variant={row.status === 'active' ? 'success' : 'warning'} className="text-[10px]">
                        {row.status}
                      </Badge>
                    </td>
                    {/* Actions */}
                    <td className="px-4 py-3 text-center whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px]">
                      <button onClick={() => { setSelectedStudent(row); setEditOpen(true); }} className="p-1 rounded hover:bg-purple-100 text-purple-600 hover:text-purple-800 transition-colors" title="Edit Information">
                        <Edit3 size={14} />
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Mobile Responsive Student Cards */}
          <div className="block md:hidden space-y-4">
            {paginatedStudents.map((row: any, i) => {
              const isExpanded = !!expandedCards[row.id || i];
              const toggleCardExpand = (id: string) => {
                setExpandedCards(prev => ({ ...prev, [id]: !prev[id] }));
              };
              return (
                <div key={row.id || i} className="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-3">
                  <div className="flex items-center justify-between border-b pb-2">
                    <div>
                      <h4 className="font-bold text-sm text-gray-900">{row.full_name}</h4>
                      <p className="text-[10px] text-gray-400">Roll No: {row.roll_number || '—'}</p>
                    </div>
                    <Badge variant={row.status === 'active' ? 'success' : 'warning'} className="text-[10px]">
                      {row.status}
                    </Badge>
                  </div>

                  <div className="grid grid-cols-2 gap-2 text-xs">
                    <div>
                      <span className="text-gray-400 block font-medium">Class</span>
                      <span className="font-semibold text-gray-800">{row.student_class || '—'}</span>
                    </div>
                    <div>
                      <span className="text-gray-400 block font-medium">Section</span>
                      <span className="font-semibold text-gray-800">{row.section || '—'}</span>
                    </div>
                    <div className="col-span-2">
                      <span className="text-gray-400 block font-medium">Parent Name</span>
                      <span className="font-semibold text-gray-800">{row.parent_name || '—'}</span>
                    </div>
                  </div>

                  {/* View More details expansion */}
                  {isExpanded && (
                    <div className="border-t pt-3 space-y-2.5 text-xs grid grid-cols-1 gap-2 animate-fadeIn">
                      <div>
                        <span className="text-gray-400 block font-medium">Student Email</span>
                        <span className="font-semibold text-gray-800 font-mono text-[10px]">{row.email || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Student Phone</span>
                        <span className="font-semibold text-gray-800">{row.phone || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Parent Email</span>
                        <span className="font-semibold text-gray-800 font-mono text-[10px]">{row.parent_email || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Parent Phone</span>
                        <span className="font-semibold text-gray-800">{row.parent_phone || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Relationship</span>
                        <span className="font-semibold text-gray-800 capitalize">{row.parent_relationship || 'guardian'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Student Login</span>
                        <Badge variant={row.student_login_created ? 'success' : 'default'} className="mt-0.5 text-[10px]">
                          {row.student_login_created ? 'Created' : 'No Access'}
                        </Badge>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Parent Login</span>
                        <Badge variant={row.parent_login_created ? 'success' : 'default'} className="mt-0.5 text-[10px]">
                          {row.parent_login_created ? 'Created' : 'No Access'}
                        </Badge>
                      </div>
                    </div>
                  )}

                  <div className="flex items-center justify-between border-t pt-2 mt-2 gap-2">
                    <button
                      onClick={() => toggleCardExpand(row.id || i)}
                      className="flex items-center justify-center gap-1 text-xs font-bold text-[#6D4CFF] hover:text-[#5b3ee0] min-h-[44px] px-2"
                    >
                      {isExpanded ? 'View Less' : 'View More'}
                    </button>
                    
                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => { setSelectedStudent(row); setEditOpen(true); }}
                        className="flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-purple-50 text-purple-700 hover:bg-purple-100 text-xs font-semibold min-h-[44px]"
                      >
                        <Edit3 size={14} /> Edit
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          {/* Pagination Controls */}
          <div className="flex flex-col md:flex-row items-center justify-between p-4 bg-white border border-gray-100 rounded-xl shadow-sm text-xs text-gray-500 gap-4">
            <div className="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left w-full md:w-auto">
              <div className="flex items-center gap-1.5 justify-center sm:justify-start">
                <span>Show</span>
                <select aria-label="Select page size" value={pageSize} onChange={e => setPageSize(Number(e.target.value))}
                  className="px-2 py-1.5 border border-gray-200 rounded-lg text-xs bg-white focus:outline-none min-h-[36px] flex items-center">
                  {[10, 25, 50, 100].map(sz => <option key={sz} value={sz}>{sz}</option>)}
                </select>
                <span>per page</span>
              </div>
              <div className="text-gray-400">
                Showing {Math.min(sortedStudents.length, (currentPage - 1) * pageSize + 1)} to {Math.min(sortedStudents.length, currentPage * pageSize)} of {sortedStudents.length} entries
              </div>
            </div>
            <div className="flex items-center gap-1.5 w-full sm:w-auto justify-between sm:justify-end">
              <button aria-label="Previous page" disabled={currentPage === 1} onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
                className="px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 transition-colors flex items-center gap-1 font-semibold min-h-[44px] justify-center flex-1 sm:flex-none">
                <ChevronLeft size={14} /> Prev
              </button>
              <span className="font-semibold text-gray-700 px-2 text-center">Page {currentPage} of {totalPages}</span>
              <button aria-label="Next page" disabled={currentPage === totalPages} onClick={() => setCurrentPage(prev => Math.min(totalPages, prev + 1))}
                className="px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 transition-colors flex items-center gap-1 font-semibold min-h-[44px] justify-center flex-1 sm:flex-none">
                Next <ChevronRight size={14} />
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Add Student Modal */}
      <CrudModal open={modalOpen} onClose={() => setModalOpen(false)} title="Add Student">
        <StudentForm onDone={() => { students?.refetch(); setModalOpen(false); }} onCreated={(creds) => {
          setNewCreds(p => ({ ...p, [creds.email]: creds }));
        }} />
      </CrudModal>

      {/* Bulk Import Modal */}
      <BulkImportModal open={bulkOpen} onClose={() => setBulkOpen(false)} type="student" onDone={() => students?.refetch()} onCreated={(creds) => setNewCreds(p => ({ ...p, ...creds }))} />

      {/* View Student Details Modal */}
      <CrudModal open={viewOpen} onClose={() => { setViewOpen(false); setSelectedStudent(null); }} title="Student Details">
        {selectedStudent && (
          <div className="space-y-4 text-xs">
            <div className="flex items-center gap-3 border-b pb-3">
              <div className="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-700 text-sm font-bold">
                {selectedStudent.full_name?.charAt(0).toUpperCase()}
              </div>
              <div>
                <h4 className="font-bold text-sm text-gray-900">{selectedStudent.full_name}</h4>
                <p className="text-gray-400">Roll Number: {selectedStudent.roll_number}</p>
              </div>
            </div>
            <div className="grid grid-cols-2 gap-x-4 gap-y-3">
              <div>
                <span className="text-gray-400 block font-medium">Class & Section</span>
                <span className="font-bold text-gray-800">{selectedStudent.student_class || '—'} {selectedStudent.section ? `(${selectedStudent.section})` : ''}</span>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Email Address</span>
                <span className="font-bold text-gray-800 font-mono">{selectedStudent.email || '—'}</span>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Phone Number</span>
                <span className="font-bold text-gray-800">{selectedStudent.phone || '—'}</span>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Portal Login Access</span>
                <Badge variant={selectedStudent.student_login_created ? 'success' : 'default'} className="mt-0.5">
                  {selectedStudent.student_login_created ? 'Created' : 'Not Created'}
                </Badge>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Status</span>
                <Badge variant={selectedStudent.status === 'active' ? 'success' : 'warning'} className="mt-0.5">
                  {selectedStudent.status}
                </Badge>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Date Added</span>
                <span className="font-bold text-gray-800">
                  {selectedStudent.created_at ? new Date(selectedStudent.created_at).toLocaleDateString() : '—'}
                </span>
              </div>
            </div>
            {selectedStudent.parent_name && (
              <div className="border-t pt-3 mt-2">
                <h5 className="font-bold text-gray-800 mb-2 text-[11px] uppercase tracking-wider text-purple-600">Linked Parent Account</h5>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <span className="text-gray-400 block font-medium">Parent Name</span>
                    <span className="font-bold text-gray-800">{selectedStudent.parent_name}</span>
                  </div>
                  <div>
                    <span className="text-gray-400 block font-medium">Relationship</span>
                    <span className="font-bold text-gray-800 capitalize">{selectedStudent.parent_relationship || 'guardian'}</span>
                  </div>
                  <div>
                    <span className="text-gray-400 block font-medium">Parent Email</span>
                    <span className="font-bold text-gray-800 font-mono">{selectedStudent.parent_email || '—'}</span>
                  </div>
                  <div>
                    <span className="text-gray-400 block font-medium">Parent Phone</span>
                    <span className="font-bold text-gray-800">{selectedStudent.parent_phone || '—'}</span>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
      </CrudModal>

      {/* View Parent Details Modal */}
      <CrudModal open={parentViewOpen} onClose={() => { setParentViewOpen(false); setSelectedStudent(null); }} title="Parent Details">
        {selectedStudent && (
          <div className="space-y-4 text-xs">
            <div className="flex items-center gap-3 border-b pb-3">
              <div className="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-700 text-sm font-bold">
                {selectedStudent.parent_name?.charAt(0).toUpperCase()}
              </div>
              <div>
                <h4 className="font-bold text-sm text-gray-900">{selectedStudent.parent_name}</h4>
                <p className="text-gray-400">Relationship: <span className="capitalize">{selectedStudent.parent_relationship || 'guardian'}</span></p>
              </div>
            </div>
            <div className="grid grid-cols-2 gap-x-4 gap-y-3">
              <div>
                <span className="text-gray-400 block font-medium">Parent Email</span>
                <span className="font-bold text-gray-800 font-mono">{selectedStudent.parent_email || '—'}</span>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Parent Phone</span>
                <span className="font-bold text-gray-800">{selectedStudent.parent_phone || '—'}</span>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Parent Portal Login Access</span>
                <Badge variant={selectedStudent.parent_login_created ? 'success' : 'default'} className="mt-0.5">
                  {selectedStudent.parent_login_created ? 'Created' : 'Not Created'}
                </Badge>
              </div>
              <div>
                <span className="text-gray-400 block font-medium">Child Name</span>
                <span className="font-bold text-gray-800">{selectedStudent.full_name}</span>
              </div>
            </div>
          </div>
        )}
      </CrudModal>

      {/* Edit Student & Parent Modal */}
      <LargeCrudModal open={editOpen} onClose={() => { setEditOpen(false); setSelectedStudent(null); }} title="Edit Student & Parent Information">
        {selectedStudent && (
          <EditStudentForm student={selectedStudent} classesList={classesList} onDone={() => {
            students?.refetch();
            setEditOpen(false);
            setSelectedStudent(null);
          }} />
        )}
      </LargeCrudModal>
    </ModulePage>
  );
}

function StaffTab({ staffList }: { staffList: any }) {
  const [modalOpen, setModalOpen] = useState(false);
  const [bulkOpen, setBulkOpen] = useState(false);
  const [editOpen, setEditOpen] = useState(false);
  const [viewOpen, setViewOpen] = useState(false);
  const [assignOpen, setAssignOpen] = useState(false);

  const [selectedStaff, setSelectedStaff] = useState<any>(null);
  const [newCreds, setNewCreds] = useState<Record<string, { email: string; password: string }>>({});
  const [activeMenuId, setActiveMenuId] = useState<string | null>(null);
  const [expandedCards, setExpandedCards] = useState<Record<string, boolean>>({});

  const [classesList, setClassesList] = useState<any[]>([]);
  const [subjectsList, setSubjectsList] = useState<any[]>([]);
  const [sectionsList, setSectionsList] = useState<any[]>([]);
  const [activeDetailTab, setActiveDetailTab] = useState<'profile' | 'assignments' | 'permissions' | 'timetable' | 'attendance' | 'activity'>('profile');
  const [assignmentsData, setAssignmentsData] = useState<any>(null);
  const [loadingAssignments, setLoadingAssignments] = useState(false);
  const [selectedAssignRole, setSelectedAssignRole] = useState<string>('');
  const [assignFormPayload, setAssignFormPayload] = useState<any>({});
  const [submittingAssignment, setSubmittingAssignment] = useState(false);

  const rolePermissions: Record<string, string[]> = {
    teacher: ["Conduct Classes", "Mark Student Attendance", "Manage Grades & Reports", "View Timetables", "Parent Communication"],
    admin: ["Full System Access", "Manage Staff Profiles", "Modify Settings", "Database Backups", "Approve Transfers"],
    principal: ["Academic Oversight", "Staff Performance Review", "Approve Attendance & Payroll", "Parent-Teacher Alignments", "Institution Settings"],
    coordinator: ["Review Timetables", "Monitor Teacher Performance", "Academic Planning", "Supervise Class Teachers", "Student Performance Analytics"],
    accountant: ["Manage Payroll & Salary", "Fee Collection", "Vendor Payments", "Institute Balance Sheet", "Expense Management Approval"],
    librarian: ["Manage Book Inventory", "Issue/Return Book Tracking", "Fine Collections & Waiver", "Digital Library Catalog Setup"],
    receptionist: ["Visitor In/Out Log", "Manage Admission Enquiries", "Front Desk Phone Calls", "Front Office Operations Dashboard"],
    driver: ["Daily Route Navigation", "Vehicle Pre-trip Inspections", "Student Roll Call in Bus", "Fuel Expense Logging"],
    security: ["Campus Patrol Logs", "Visitor Gate Access Verification", "Incident Reporting", "Emergency Lockdown Triggers"],
    housekeeping: ["Floor Hygiene Checklist", "Inventory Restock Requests", "Facility Maintenance Report"],
    nurse: ["Student Health Card Management", "Administer First Aid", "Manage Dispensary Stocks", "Emergency Hospital Coordination"],
    it_support: ["Lab Device Management", "Local Area Network Troubleshooting", "User Account Provisioning", "Hardware Repairs"],
    sports: ["Practice Schedule Management", "Sports Equipments Audit", "Team Selection Panels", "Tournament Registrations"],
    hostel: ["Room Allocation Registry", "Hostel Attendance Logs", "Discipline & Lights-out Checks", "Mess Committee Supervision"]
  };

  const fetchStaffAssignments = useCallback(async (staffId: string) => {
    setLoadingAssignments(true);
    try {
      const res = await staffApi.getAssignments(staffId);
      if (res.success && res.data) {
        setAssignmentsData(res.data);
      } else {
        toast.error('Failed to load assignments: ' + (res.error || 'Unknown error'));
      }
    } catch (e: any) {
      console.error(e);
      toast.error('Failed to fetch assignments: ' + e.message);
    } finally {
      setLoadingAssignments(false);
    }
  }, []);

  useEffect(() => {
    if (selectedStaff?.id && viewOpen) {
      fetchStaffAssignments(selectedStaff.id);
      setActiveDetailTab('profile');
      
      const des = (selectedStaff.designation || selectedStaff.role || '').toLowerCase();
      if (des.includes('teacher')) setSelectedAssignRole('teacher');
      else if (des.includes('driver')) setSelectedAssignRole('driver');
      else if (des.includes('security')) setSelectedAssignRole('security');
      else if (des.includes('housekeeping') || des.includes('cleaner') || des.includes('sweeper')) setSelectedAssignRole('housekeeping');
      else if (des.includes('sports') || des.includes('coach')) setSelectedAssignRole('sports');
      else if (des.includes('hostel') || des.includes('warden')) setSelectedAssignRole('hostel');
      else if (des.includes('coordinator')) setSelectedAssignRole('coordinator');
      else if (des.includes('principal')) setSelectedAssignRole('principal');
      else if (des.includes('librarian')) setSelectedAssignRole('librarian');
      else if (des.includes('accountant')) setSelectedAssignRole('accountant');
      else if (des.includes('receptionist')) setSelectedAssignRole('receptionist');
      else if (des.includes('nurse')) setSelectedAssignRole('nurse');
      else if (des.includes('support') || des.includes('it')) setSelectedAssignRole('it_support');
      else setSelectedAssignRole('general');
      
      setAssignFormPayload({});
    } else {
      setAssignmentsData(null);
    }
  }, [selectedStaff, viewOpen, fetchStaffAssignments]);

  const statsCards = useMemo(() => {
    if (!selectedStaff || !assignmentsData) return { classes: 0, subjects: 0, responsibilities: 0, departments: 0 };
    
    const classes = new Set([
      ...(assignmentsData.teacher_classes || []).map((c: any) => c.class_id),
      ...(assignmentsData.teacher_matrix || []).map((m: any) => m.class_id),
      ...(assignmentsData.class_teachers || []).map((ct: any) => ct.class_id)
    ]).size;

    const subjects = new Set([
      ...(assignmentsData.teacher_subjects || []).map((s: any) => s.subject_id),
      ...(assignmentsData.teacher_matrix || []).map((m: any) => m.subject_id)
    ]).size;

    let responsibilitiesCount = 0;
    (assignmentsData.class_teachers || []).forEach((ct: any) => {
      if (Array.isArray(ct.responsibilities)) responsibilitiesCount += ct.responsibilities.length;
    });
    (assignmentsData.transport || []).forEach((t: any) => {
      if (Array.isArray(t.responsibilities)) responsibilitiesCount += t.responsibilities.length;
      if (t.vehicle_no) responsibilitiesCount += 1;
    });
    (assignmentsData.security || []).forEach((s: any) => {
      if (s.gate_name) responsibilitiesCount += 1;
      if (s.shift) responsibilitiesCount += 1;
    });
    (assignmentsData.housekeeping || []).forEach((h: any) => {
      if (h.floor) responsibilitiesCount += 1;
      if (h.zone) responsibilitiesCount += 1;
    });
    (assignmentsData.sports || []).forEach((sp: any) => {
      if (sp.sports_category) responsibilitiesCount += 1;
      if (Array.isArray(sp.teams)) responsibilitiesCount += sp.teams.length;
    });
    (assignmentsData.hostel || []).forEach((hs: any) => {
      if (hs.hostel_building) responsibilitiesCount += 1;
      if (Array.isArray(hs.rooms)) responsibilitiesCount += hs.rooms.length;
    });
    responsibilitiesCount += (assignmentsData.staff_assignments || []).length;

    const departments = new Set();
    if (selectedStaff.department) departments.add(selectedStaff.department.toLowerCase());
    (assignmentsData.staff_assignments || []).forEach((s: any) => {
      if (s.assignment_type) departments.add(s.assignment_type.toLowerCase());
    });
    if (assignmentsData.transport?.length > 0) departments.add('transport');
    if (assignmentsData.security?.length > 0) departments.add('security');
    if (assignmentsData.housekeeping?.length > 0) departments.add('housekeeping');
    if (assignmentsData.sports?.length > 0) departments.add('sports');
    if (assignmentsData.hostel?.length > 0) departments.add('hostel');

    return {
      classes,
      subjects,
      responsibilities: responsibilitiesCount,
      departments: departments.size || 1
    };
  }, [selectedStaff, assignmentsData]);

  const handleRemoveAssignment = async (type: string, id: string) => {
    if (!confirm('Are you sure you want to remove this assignment?')) return;
    try {
      const res = await staffApi.removeAssignment(type, id);
      if (res.success) {
        toast.success('Assignment removed successfully!');
        if (selectedStaff?.id) {
          fetchStaffAssignments(selectedStaff.id);
        }
        staffList?.refetch();
      } else {
        toast.error(res.error || 'Failed to remove assignment');
      }
    } catch (e: any) {
      toast.error('Error removing assignment: ' + e.message);
    }
  };

  const handleAddTeacherQuickAssignment = async (quickType: 'class' | 'subject' | 'matrix') => {
    if (!selectedStaff?.id) return;
    setSubmittingAssignment(true);
    try {
      let type = '';
      let payload: any = {};
      
      if (quickType === 'class') {
        if (!assignFormPayload.class_id) {
          toast.error('Please select a class');
          return;
        }
        type = 'teacher_class';
        payload = { class_id: assignFormPayload.class_id };
      } else if (quickType === 'subject') {
        if (!assignFormPayload.subject_id) {
          toast.error('Please select a subject');
          return;
        }
        type = 'teacher_subject';
        payload = { subject_id: assignFormPayload.subject_id };
      } else if (quickType === 'matrix') {
        if (!assignFormPayload.class_id) {
          toast.error('Please select a class');
          return;
        }
        type = 'teacher_matrix';
        payload = {
          class_id: assignFormPayload.class_id,
          section_id: assignFormPayload.section_id || null,
          subject_id: assignFormPayload.subject_id || null
        };
      }
      
      const res = await staffApi.addAssignment(selectedStaff.id, type, payload);
      if (res.success) {
        toast.success('Teacher assignment mapped successfully!');
        fetchStaffAssignments(selectedStaff.id);
        staffList?.refetch();
      } else {
        toast.error(res.error || 'Failed to add teacher assignment');
      }
    } catch (e: any) {
      toast.error('Error adding teacher assignment: ' + e.message);
    } finally {
      setSubmittingAssignment(false);
    }
  };

  const handleSaveCustomAssignment = async () => {
    if (!selectedStaff?.id) return;
    
    let apiType = '';
    let apiPayload: any = {};

    if (selectedAssignRole === 'class_teacher') {
      if (!assignFormPayload.class_id) return toast.error('Please select a class');
      apiType = 'class_teacher';
      apiPayload = {
        class_id: assignFormPayload.class_id,
        section_id: assignFormPayload.section_id || null,
        responsibilities: assignFormPayload.responsibilities || []
      };
    } else if (selectedAssignRole === 'coordinator') {
      if (!assignFormPayload.assignment_type) return toast.error('Please select coordinator designation');
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'coordinator',
        assignment_type: assignFormPayload.assignment_type,
        details: { responsibilities: assignFormPayload.responsibilities || [] }
      };
    } else if (selectedAssignRole === 'principal') {
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'principal',
        assignment_type: 'principal',
        details: { responsibilities: assignFormPayload.responsibilities || [] }
      };
    } else if (selectedAssignRole === 'librarian') {
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'librarian',
        assignment_type: 'librarian',
        details: {
          permissions: assignFormPayload.permissions || [],
          responsibilities: assignFormPayload.responsibilities || []
        }
      };
    } else if (selectedAssignRole === 'accountant') {
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'accountant',
        assignment_type: 'accountant',
        details: { modules: assignFormPayload.modules || [] }
      };
    } else if (selectedAssignRole === 'receptionist') {
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'receptionist',
        assignment_type: 'receptionist',
        details: { tasks: assignFormPayload.tasks || [] }
      };
    } else if (selectedAssignRole === 'driver') {
      if (!assignFormPayload.vehicle_no) return toast.error('Please specify Vehicle Number');
      if (!assignFormPayload.route_name) return toast.error('Please specify Route Name');
      apiType = 'transport';
      apiPayload = {
        vehicle_no: assignFormPayload.vehicle_no,
        route_name: assignFormPayload.route_name,
        assigned_students_count: Number(assignFormPayload.assigned_students_count || 0),
        responsibilities: assignFormPayload.responsibilities || []
      };
    } else if (selectedAssignRole === 'transport_manager') {
      if (!assignFormPayload.vehicle_no) return toast.error('Please specify Fleet Vehicles');
      if (!assignFormPayload.route_name) return toast.error('Please specify Supervised Routes');
      apiType = 'transport';
      apiPayload = {
        vehicle_no: assignFormPayload.vehicle_no,
        route_name: assignFormPayload.route_name,
        responsibilities: assignFormPayload.responsibilities || []
      };
    } else if (selectedAssignRole === 'security') {
      if (!assignFormPayload.gate_name) return toast.error('Please specify Campus Gate');
      if (!assignFormPayload.shift) return toast.error('Please select Duty Shift');
      apiType = 'security';
      apiPayload = {
        gate_name: assignFormPayload.gate_name,
        building_area: assignFormPayload.building_area || '',
        shift: assignFormPayload.shift
      };
    } else if (selectedAssignRole === 'housekeeping') {
      if (!assignFormPayload.building) return toast.error('Please specify Building');
      apiType = 'housekeeping';
      apiPayload = {
        building: assignFormPayload.building,
        floor: assignFormPayload.floor || '',
        zone: assignFormPayload.zone || ''
      };
    } else if (selectedAssignRole === 'nurse') {
      if (!assignFormPayload.health_room) return toast.error('Please specify Clinic Room');
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'nurse',
        assignment_type: 'nurse',
        details: {
          health_room: assignFormPayload.health_room,
          responsibilities: assignFormPayload.responsibilities || []
        }
      };
    } else if (selectedAssignRole === 'it_support') {
      if (!assignFormPayload.computer_lab) return toast.error('Please specify Computer Lab');
      apiType = 'staff_assignment';
      apiPayload = {
        role: 'it_support',
        assignment_type: 'it_support',
        details: {
          computer_lab: assignFormPayload.computer_lab,
          responsibilities: assignFormPayload.responsibilities || []
        }
      };
    } else if (selectedAssignRole === 'sports') {
      if (!assignFormPayload.sports_category) return toast.error('Please specify Sports Category');
      apiType = 'sports';
      apiPayload = {
        sports_category: assignFormPayload.sports_category,
        teams: assignFormPayload.teams || [],
        practice_schedule: assignFormPayload.practice_schedule || ''
      };
    } else if (selectedAssignRole === 'hostel') {
      if (!assignFormPayload.hostel_building) return toast.error('Please specify Hostel Building');
      apiType = 'hostel';
      apiPayload = {
        hostel_building: assignFormPayload.hostel_building,
        rooms: assignFormPayload.rooms || [],
        students_assigned_count: Number(assignFormPayload.students_assigned_count || 0)
      };
    } else {
      apiType = 'staff_assignment';
      apiPayload = {
        role: selectedAssignRole,
        assignment_type: 'general',
        details: assignFormPayload
      };
    }

    setSubmittingAssignment(true);
    try {
      const res = await staffApi.addAssignment(selectedStaff.id, apiType, apiPayload);
      if (res.success) {
        toast.success('Assignment saved successfully!');
        setAssignFormPayload({});
        fetchStaffAssignments(selectedStaff.id);
        staffList?.refetch();
      } else {
        toast.error(res.error || 'Failed to save assignment');
      }
    } catch (e: any) {
      toast.error('Error saving assignment: ' + e.message);
    } finally {
      setSubmittingAssignment(false);
    }
  };

  const [filters, setFilters] = useState({
    search: '',
    role: '',
    department: '',
    designation: '',
    employment_type: '',
    status: '',
    gender: '',
    joining_date: '',
    experience: '',
  });

  const [sortField, setSortField] = useState<string>('created_at');
  const [sortDirection, setSortDirection] = useState<'asc' | 'desc'>('desc');
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);

  useEffect(() => {
    classApi.getAll().then(res => {
      if (res.success && Array.isArray(res.data)) setClassesList(res.data);
    }).catch(() => {});
    
    subjectApi.getAll().then(res => {
      if (res.success && Array.isArray(res.data)) setSubjectsList(res.data);
    }).catch(() => {});

    academicMgmtApi.getSections().then(res => {
      if (Array.isArray(res)) setSectionsList(res);
      else if (res && Array.isArray(res.data)) setSectionsList(res.data);
    }).catch(() => {});
  }, []);

  useEffect(() => {
    const oId = orgId();
    if (!oId) return;
    try {
      const saved = localStorage.getItem(`prasynx_staff_filters_${oId}`);
      if (saved) {
        setFilters(JSON.parse(saved));
      }
    } catch (e) {}
  }, []);

  const saveFilters = (newFilters: typeof filters) => {
    setFilters(newFilters);
    const oId = orgId();
    if (oId) {
      localStorage.setItem(`prasynx_staff_filters_${oId}`, JSON.stringify(newFilters));
    }
  };

  const handleClearFilters = () => {
    const cleared = {
      search: '',
      role: '',
      department: '',
      designation: '',
      employment_type: '',
      status: '',
      gender: '',
      joining_date: '',
      experience: '',
    };
    saveFilters(cleared);
  };

  const stats = useMemo(() => {
    const list = staffList?.data || [];
    const total = list.length;
    
    const teachingRoles = ['principal', 'vice principal', 'teacher', 'subject teacher', 'hod', 'coordinator'];
    const teaching = list.filter((s: any) => teachingRoles.includes((s.role || '').toLowerCase())).length;
    
    const nonTeaching = total - teaching;
    const active = list.filter((s: any) => (s.status || '').toLowerCase() === 'active').length;
    const onLeave = list.filter((s: any) => (s.status || '').toLowerCase() === 'on leave' || (s.status || '').toLowerCase() === 'leave').length;
    
    const departments = new Set(list.map((s: any) => (s.department || '').trim()).filter(Boolean));
    const deptsCount = departments.size;

    return { total, teaching, nonTeaching, active, onLeave, depts: deptsCount };
  }, [staffList?.data]);

  const filteredStaff = useMemo(() => {
    let result = staffList?.data || [];

    if (filters.search) {
      const q = filters.search.toLowerCase().trim();
      result = result.filter((s: any) => {
        return (
          s.full_name?.toLowerCase().includes(q) ||
          s.staff_unique_id?.toLowerCase().includes(q) ||
          s.teacher_code?.toLowerCase().includes(q) ||
          s.email?.toLowerCase().includes(q) ||
          s.phone?.toLowerCase().includes(q)
        );
      });
    }

    if (filters.role) {
      result = result.filter((s: any) => (s.role || '').toLowerCase() === filters.role.toLowerCase());
    }

    if (filters.department) {
      result = result.filter((s: any) => (s.department || '').toLowerCase() === filters.department.toLowerCase());
    }

    if (filters.designation) {
      const q = filters.designation.toLowerCase().trim();
      result = result.filter((s: any) => (s.designation || '').toLowerCase().includes(q));
    }

    if (filters.employment_type) {
      result = result.filter((s: any) => (s.employment_type || '').toLowerCase() === filters.employment_type.toLowerCase());
    }

    if (filters.status) {
      result = result.filter((s: any) => (s.status || '').toLowerCase() === filters.status.toLowerCase());
    }

    if (filters.gender) {
      result = result.filter((s: any) => (s.gender || '').toLowerCase() === filters.gender.toLowerCase());
    }

    if (filters.joining_date) {
      result = result.filter((s: any) => s.joining_date === filters.joining_date || s.join_date === filters.joining_date);
    }

    if (filters.experience) {
      const minExp = parseInt(filters.experience, 10);
      if (!isNaN(minExp)) {
        result = result.filter((s: any) => (s.experience_years || 0) >= minExp);
      }
    }

    return result;
  }, [staffList?.data, filters]);

  const sortedStaff = useMemo(() => {
    const result = [...filteredStaff];
    if (!sortField) return result;

    result.sort((a: any, b: any) => {
      let valA = a[sortField];
      let valB = b[sortField];

      if (typeof valA === 'boolean') valA = valA ? 1 : 0;
      if (typeof valB === 'boolean') valB = valB ? 1 : 0;

      if (typeof valA === 'string') valA = valA.toLowerCase().trim();
      if (typeof valB === 'string') valB = valB.toLowerCase().trim();

      if (valA === undefined || valA === null) valA = '';
      if (valB === undefined || valB === null) valB = '';

      if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
      if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
      return 0;
    });
    return result;
  }, [filteredStaff, sortField, sortDirection]);

  const paginatedStaff = useMemo(() => {
    const startIdx = (currentPage - 1) * pageSize;
    return sortedStaff.slice(startIdx, startIdx + pageSize);
  }, [sortedStaff, currentPage, pageSize]);

  const totalPages = Math.ceil(sortedStaff.length / pageSize) || 1;

  useEffect(() => {
    setCurrentPage(1);
  }, [filters, pageSize]);

  const handleSort = (field: string) => {
    if (sortField === field) {
      setSortDirection(prev => (prev === 'asc' ? 'desc' : 'asc'));
    } else {
      setSortField(field);
      setSortDirection('asc');
    }
  };

  const handleExportFiltered = () => {
    const rows = sortedStaff.map((s: any) => ({
      'Employee ID': s.staff_unique_id || s.teacher_code || '',
      'Full Name': s.full_name,
      'Role': s.role || 'staff',
      'Department': s.department || '',
      'Designation': s.designation || '',
      'Email': s.email || '',
      'Phone': s.phone || '',
      'Qualification': s.qualification || '',
      'Experience (Years)': s.experience_years || 0,
      'Employment Type': s.employment_type || '',
      'Assigned Classes': (s.assigned_classes || []).join('; '),
      'Assigned Subjects': (s.assigned_subjects || []).join('; '),
      'Status': s.status || 'active'
    }));

    if (rows.length === 0) {
      toast.warning('No filtered results to export.');
      return;
    }

    const headers = Object.keys(rows[0]);
    const csvContent = [
      headers.join(','),
      ...rows.map((row: any) =>
        headers
          .map(h => `"${(row[h] || '').toString().replace(/"/g, '""')}"`)
          .join(',')
      )
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', 'filtered-staff.csv');
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    toast.success(`Exported ${rows.length} records successfully!`);
  };

  const handleDeleteStaff = async (staff: any) => {
    if (confirm(`Are you sure you want to delete ${staff.full_name}? This will permanently remove their user account and staff profile.`)) {
      try {
        const res = await staffApi.delete(staff.id);
        if (res.success) {
          toast.success('Staff member deleted successfully!');
          staffList?.refetch();
        } else {
          toast.error(res.error || 'Failed to delete staff');
        }
      } catch (err: any) {
        toast.error(err.message || 'Error occurred');
      }
    }
  };

  const handleResetPassword = async (staff: any) => {
    try {
      const res = await credentialMgmtApi.regeneratePassword(staff.id);
      if (res.success) {
        setNewCreds(prev => ({
          ...prev,
          [staff.email]: { email: staff.email, password: res.data?.password || (res as any).password || 'NewPassword123' }
        }));
        toast.success(`Password regenerated successfully for ${staff.full_name}!`);
      } else {
        toast.error(res.error || 'Failed to regenerate password');
      }
    } catch (err: any) {
      toast.error(err.message || 'Error occurred');
    }
  };

  const handleToggleStatus = async (staff: any) => {
    const newStatus = staff.status === 'active' ? 'inactive' : 'active';
    try {
      const res = await staffApi.updateStatus(staff.id, newStatus);
      if (res.success) {
        toast.success(`Staff member status changed to ${newStatus}!`);
        staffList?.refetch();
      } else {
        toast.error(res.error || 'Failed to update status');
      }
    } catch (err: any) {
      toast.error(err.message || 'Error occurred');
    }
  };

  const getRoleBadgeStyle = (role: string) => {
    const r = (role || '').toLowerCase();
    if (r.includes('principal')) return 'bg-purple-100 text-purple-700 border border-purple-200';
    if (r.includes('teacher')) return 'bg-blue-100 text-blue-700 border border-blue-200';
    if (r.includes('accountant')) return 'bg-emerald-100 text-emerald-700 border border-emerald-200';
    if (r.includes('librarian')) return 'bg-cyan-100 text-cyan-700 border border-cyan-200';
    if (r.includes('driver')) return 'bg-amber-100 text-amber-700 border border-amber-200';
    if (r.includes('security')) return 'bg-red-100 text-red-700 border border-red-200';
    if (r.includes('sweeper')) return 'bg-gray-100 text-gray-700 border border-gray-300';
    if (r.includes('nurse')) return 'bg-pink-100 text-pink-700 border border-pink-200';
    return 'bg-purple-50 text-purple-600';
  };

  const headers = [
    { key: 'staff_unique_id', label: 'Employee ID', className: 'w-[120px] min-w-[120px] max-w-[120px]' },
    { key: 'full_name', label: 'Full Name', className: 'w-[180px] min-w-[180px] max-w-[180px]' },
    { key: 'role', label: 'Role', className: 'w-[120px] min-w-[120px] max-w-[120px]' },
    { key: 'department', label: 'Department', className: 'w-[120px] min-w-[120px] max-w-[120px]' },
    { key: 'designation', label: 'Designation', className: 'w-[130px] min-w-[130px] max-w-[130px]' },
    { key: 'phone', label: 'Phone', className: 'w-[120px] min-w-[120px] max-w-[120px]' },
    { key: 'email', label: 'Email', className: 'w-[200px] min-w-[200px] max-w-[200px] hidden xl:table-cell' },
    { key: 'qualification', label: 'Qualification', className: 'w-[150px] min-w-[150px] max-w-[150px] hidden lg:table-cell' },
    { key: 'experience_years', label: 'Experience', className: 'w-[100px] min-w-[100px] max-w-[100px] hidden xl:table-cell' },
    { key: 'employment_type', label: 'Employment Type', className: 'w-[130px] min-w-[130px] max-w-[130px] hidden xl:table-cell' },
    { key: 'assigned_classes', label: 'Assigned Classes', className: 'w-[150px] min-w-[150px] max-w-[150px] hidden lg:table-cell' },
    { key: 'assigned_subjects', label: 'Assigned Subjects', className: 'w-[150px] min-w-[150px] max-w-[150px] hidden lg:table-cell' },
    { key: 'status', label: 'Status', className: 'w-[100px] min-w-[100px] max-w-[100px]' }
  ];

  return (
    <ModulePage title="Staff Management" desc="Manage teachers, administrators, and support staff across the institution." actions={
      <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
        <button onClick={handleExportFiltered} className="flex items-center justify-center gap-1.5 px-3 py-3 sm:py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all min-h-[44px] sm:min-h-0 w-full sm:w-auto"><Download size={14} /> Export CSV</button>
        <button onClick={() => setBulkOpen(true)} className="flex items-center justify-center gap-1.5 px-3 py-3 sm:py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-all min-h-[44px] sm:min-h-0 w-full sm:w-auto"><Upload size={14} /> Bulk Import</button>
        <AddButton onClick={() => setModalOpen(true)} label="Add Staff" />
      </div>
    }>
      {/* Dashboard Statistics */}
      <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-4 animate-fadeIn">
        <KpiCard icon={Users} label="Total Staff" value={stats.total} color="#7C3AED" bg="#F3F0FF" />
        <KpiCard icon={GraduationCap} label="Teaching Staff" value={stats.teaching} color="#3B82F6" bg="#EFF6FF" />
        <KpiCard icon={Briefcase} label="Non-Teaching" value={stats.nonTeaching} color="#10B981" bg="#ECFDF5" />
        <KpiCard icon={UserCheck} label="Active Staff" value={stats.active} color="#059669" bg="#ECFDF5" />
        <KpiCard icon={UserX} label="On Leave" value={stats.onLeave} color="#EF4444" bg="#FEF2F2" />
        <KpiCard icon={Building2} label="Departments" value={stats.depts} color="#F59E0B" bg="#FEF3C7" />
      </div>

      {/* Advanced Filters */}
      <div className="bg-white rounded-xl border border-gray-100 p-4 mb-4 shadow-sm space-y-3 animate-fadeIn">
        <div className="flex items-center justify-between border-b pb-2">
          <div className="flex items-center gap-1.5 text-sm font-semibold text-gray-700">
            <Filter size={15} className="text-[#6D4CFF]" />
            <span>Advanced Filters</span>
          </div>
          <button onClick={handleClearFilters} className="flex items-center gap-1 text-xs font-medium text-gray-400 hover:text-red-500 transition-colors">
            <RotateCcw size={12} /> Clear Filters
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
          {/* Search Bar */}
          <div className="relative col-span-full">
            <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400" size={14} />
            <input aria-label="Search staff" type="text" placeholder="Search by Employee ID, Name, Email, Phone..." value={filters.search} onChange={e => saveFilters({ ...filters, search: e.target.value })}
              className="w-full pl-8 pr-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white" />
          </div>

          {/* Role Filter */}
          <div>
            <select aria-label="Filter by Role" value={filters.role} onChange={e => saveFilters({ ...filters, role: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Roles</option>
              {['Principal', 'Vice Principal', 'Teacher', 'Subject Teacher', 'HOD', 'Coordinator', 'Accountant', 'Librarian', 'Receptionist', 'Driver', 'Security Guard', 'Sweeper', 'Nurse', 'Other'].map(r => (
                <option key={r} value={r.toLowerCase()}>{r}</option>
              ))}
            </select>
          </div>

          {/* Department Filter */}
          <div>
            <select aria-label="Filter by Department" value={filters.department} onChange={e => saveFilters({ ...filters, department: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Departments</option>
              {['Academics', 'Administration', 'Finance', 'Library', 'Transport', 'Security', 'Housekeeping', 'Medical'].map(d => (
                <option key={d} value={d}>{d}</option>
              ))}
            </select>
          </div>

          {/* Designation Filter */}
          <div>
            <input aria-label="Filter by Designation" type="text" placeholder="Designation (e.g. Physics Teacher)" value={filters.designation} onChange={e => saveFilters({ ...filters, designation: e.target.value })}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white" />
          </div>

          {/* Employment Type Filter */}
          <div>
            <select aria-label="Filter by Employment Type" value={filters.employment_type} onChange={e => saveFilters({ ...filters, employment_type: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Employment Types</option>
              <option value="Full-time">Full Time</option>
              <option value="Part-time">Part Time</option>
              <option value="Contract">Contract</option>
            </select>
          </div>

          {/* Status Filter */}
          <div>
            <select aria-label="Filter by Status" value={filters.status} onChange={e => saveFilters({ ...filters, status: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Statuses</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
              <option value="on leave">On Leave</option>
            </select>
          </div>

          {/* Gender Filter */}
          <div>
            <select aria-label="Filter by Gender" value={filters.gender} onChange={e => saveFilters({ ...filters, gender: e.target.value })}
              className="w-full px-2 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white">
              <option value="">All Genders</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>

          {/* Joining Date Filter */}
          <div>
            <input aria-label="Joining Date" type="date" value={filters.joining_date} onChange={e => saveFilters({ ...filters, joining_date: e.target.value })}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white text-gray-500" />
          </div>

          {/* Experience Filter */}
          <div>
            <input aria-label="Filter by Experience" type="number" min="0" placeholder="Min Experience (Years)" value={filters.experience} onChange={e => saveFilters({ ...filters, experience: e.target.value })}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[#6D4CFF]/20 bg-white" />
          </div>
        </div>
      </div>

      {/* Staff Table & Mobile Cards */}
      {staffList?.loading ? (
        <LoadingSkeleton rows={5} cols={headers.length} />
      ) : staffList?.error ? (
        <ErrorState message={staffList?.error} onRetry={staffList?.refetch} />
      ) : sortedStaff.length === 0 ? (
        <EmptyState message="No staff found matching current filters." />
      ) : (
        <div className="space-y-4 animate-fadeIn">
          {/* Desktop & Laptop Responsive Table */}
          <div className="hidden md:block overflow-x-auto rounded-xl border border-gray-100 shadow-sm bg-white" style={{ WebkitOverflowScrolling: 'touch' }}>
            <table className="min-w-[1600px] w-full border-collapse text-left text-xs text-gray-500">
              <thead className="bg-white text-gray-700 font-semibold uppercase tracking-wider text-[10px] border-b border-gray-100">
                <tr>
                  {headers.map(col => (
                    <th key={col.key} onClick={() => handleSort(col.key)} className={`px-4 py-3 cursor-pointer select-none hover:bg-gray-100 transition-colors whitespace-nowrap sticky top-0 bg-white z-10 ${col.key === 'full_name' ? 'left-0 z-20 shadow-[2px_0_5px_rgba(0,0,0,0.05)] border-r border-gray-100' : ''} ${col.className || ''}`}>
                      <div className="flex items-center gap-1">
                        <span>{col.label}</span>
                        <span className="text-gray-400 text-[9px]">
                          {sortField === col.key ? (sortDirection === 'asc' ? '▲' : '▼') : '↕'}
                        </span>
                      </div>
                    </th>
                  ))}
                  <th className="px-4 py-3 text-center sticky top-0 bg-white z-10 w-[120px] min-w-[120px] max-w-[120px]">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-100">
                {paginatedStaff.map((row: any, i) => (
                  <tr key={row.id || i} className="hover:bg-purple-50/20 transition-all group">
                    {/* Employee ID */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px] font-medium text-gray-900">
                      {row.staff_unique_id || row.teacher_code || '—'}
                    </td>
                    {/* Full Name */}
                    <td className="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap sticky left-0 bg-white z-10 shadow-[2px_0_5px_rgba(0,0,0,0.05)] border-r border-gray-100 group-hover:bg-purple-50/50 transition-colors w-[180px] min-w-[180px] max-w-[180px]">
                      <button onClick={() => { setSelectedStaff(row); setViewOpen(true); }} className="hover:text-[#6D4CFF] text-left hover:underline">
                        {row.full_name}
                      </button>
                    </td>
                    {/* Role */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px]">
                      <Badge className={`text-[10px] font-semibold capitalize ${getRoleBadgeStyle(row.designation || row.role)}`}>
                        {row.designation || row.role || 'staff'}
                      </Badge>
                    </td>
                    {/* Department */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px] capitalize">{row.department || '—'}</td>
                    {/* Designation */}
                    <td className="px-4 py-3 whitespace-nowrap w-[130px] min-w-[130px] max-w-[130px] capitalize">{row.designation || '—'}</td>
                    {/* Phone */}
                    <td className="px-4 py-3 whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px]">{row.phone || '—'}</td>
                    {/* Email */}
                    <td className="px-4 py-3 font-mono text-[10px] hidden xl:table-cell w-[200px] min-w-[200px] max-w-[200px] truncate">{row.email || '—'}</td>
                    {/* Qualification */}
                    <td className="px-4 py-3 hidden lg:table-cell w-[150px] min-w-[150px] max-w-[150px] truncate">{row.qualification || '—'}</td>
                    {/* Experience */}
                    <td className="px-4 py-3 hidden xl:table-cell w-[100px] min-w-[100px] max-w-[100px]">{row.experience_years !== undefined ? `${row.experience_years} Years` : '—'}</td>
                    {/* Employment Type */}
                    <td className="px-4 py-3 hidden xl:table-cell w-[130px] min-w-[130px] max-w-[130px] capitalize">{row.employment_type || '—'}</td>
                    {/* Assigned Classes */}
                    <td className="px-4 py-3 hidden lg:table-cell w-[150px] min-w-[150px] max-w-[150px] truncate">
                      {Array.isArray(row.assigned_classes) && row.assigned_classes.length > 0 ? (
                        <div className="flex flex-wrap gap-1 max-w-[140px]">
                          {row.assigned_classes.map((c: string, idx: number) => (
                            <span key={idx} className="bg-purple-50 text-purple-600 text-[9px] px-1 py-0.5 rounded font-medium">{c}</span>
                          ))}
                        </div>
                      ) : '—'}
                    </td>
                    {/* Assigned Subjects */}
                    <td className="px-4 py-3 hidden lg:table-cell w-[150px] min-w-[150px] max-w-[150px] truncate">
                      {Array.isArray(row.assigned_subjects) && row.assigned_subjects.length > 0 ? (
                        <div className="flex flex-wrap gap-1 max-w-[140px]">
                          {row.assigned_subjects.map((s: string, idx: number) => (
                            <span key={idx} className="bg-blue-50 text-blue-600 text-[9px] px-1 py-0.5 rounded font-medium">{s}</span>
                          ))}
                        </div>
                      ) : '—'}
                    </td>
                    {/* Status */}
                    <td className="px-4 py-3 whitespace-nowrap w-[100px] min-w-[100px] max-w-[100px]">
                      <Badge variant={row.status === 'active' ? 'success' : row.status === 'on leave' || row.status === 'leave' ? 'warning' : 'default'} className="text-[10px] capitalize">
                        {row.status || 'active'}
                      </Badge>
                    </td>
                    {/* Actions Dropdown */}
                    <td className="px-4 py-3 text-center whitespace-nowrap w-[120px] min-w-[120px] max-w-[120px] relative">
                      <div className="flex items-center justify-center gap-1">
                        <button onClick={() => { setSelectedStaff(row); setViewOpen(true); }} className="p-1 rounded hover:bg-purple-100 text-purple-600 transition-colors" title="View Profile">
                          <Eye size={14} />
                        </button>
                        <button onClick={() => { setSelectedStaff(row); setEditOpen(true); }} className="p-1 rounded hover:bg-purple-100 text-purple-600 transition-colors" title="Edit Staff">
                          <Edit3 size={14} />
                        </button>
                        <div className="relative">
                          <button onClick={(e) => { e.stopPropagation(); setActiveMenuId(activeMenuId === row.id ? null : row.id); }} className="p-1 rounded hover:bg-gray-100 text-gray-500 transition-colors">
                            <svg className="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
                          </button>
                          
                          {activeMenuId === row.id && (
                            <>
                              <div className="fixed inset-0 z-30" onClick={() => setActiveMenuId(null)} />
                              <div className="absolute right-0 mt-1 w-44 bg-white rounded-lg border border-gray-100 shadow-lg py-1 z-40 text-left">
                                <button onClick={() => { setSelectedStaff(row); setAssignOpen(true); setActiveMenuId(null); }} className="w-full px-3 py-1.5 hover:bg-purple-50 hover:text-purple-600 text-xs flex items-center gap-1.5 text-gray-600 font-medium">
                                  <Layers size={13} /> Assign Class/Subject
                                </button>
                                <button onClick={() => { handleResetPassword(row); setActiveMenuId(null); }} className="w-full px-3 py-1.5 hover:bg-purple-50 hover:text-purple-600 text-xs flex items-center gap-1.5 text-gray-600 font-medium">
                                  <Key size={13} /> Reset Password
                                </button>
                                <button onClick={() => { handleToggleStatus(row); setActiveMenuId(null); }} className="w-full px-3 py-1.5 hover:bg-purple-50 hover:text-purple-600 text-xs flex items-center gap-1.5 text-gray-600 font-medium">
                                  {row.status === 'active' ? <UserX size={13} /> : <UserCheck size={13} />}
                                  {row.status === 'active' ? 'Deactivate Staff' : 'Activate Staff'}
                                </button>
                                <hr className="my-1 border-gray-100" />
                                <button onClick={() => { handleDeleteStaff(row); setActiveMenuId(null); }} className="w-full px-3 py-1.5 hover:bg-red-50 text-red-600 text-xs flex items-center gap-1.5 font-medium">
                                  <Trash2 size={13} /> Delete Staff
                                </button>
                              </div>
                            </>
                          )}
                        </div>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Mobile responsive Cards layout */}
          <div className="block md:hidden space-y-4">
            {paginatedStaff.map((row: any, i) => {
              const isExpanded = !!expandedCards[row.id || i];
              const toggleCardExpand = (id: string) => {
                setExpandedCards(prev => ({ ...prev, [id]: !prev[id] }));
              };
              return (
                <div key={row.id || i} className="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-3">
                  <div className="flex items-center justify-between border-b pb-2">
                    <div>
                      <h4 className="font-bold text-sm text-gray-900">{row.full_name}</h4>
                      <p className="text-[10px] text-gray-400">ID: {row.staff_unique_id || row.teacher_code || '—'}</p>
                    </div>
                    <Badge className={`text-[9px] capitalize ${getRoleBadgeStyle(row.designation || row.role)}`}>
                      {row.designation || row.role || 'staff'}
                    </Badge>
                  </div>

                  <div className="grid grid-cols-2 gap-2 text-xs">
                    <div>
                      <span className="text-gray-400 block font-medium">Department</span>
                      <span className="font-semibold text-gray-800 capitalize">{row.department || '—'}</span>
                    </div>
                    <div>
                      <span className="text-gray-400 block font-medium">Phone</span>
                      <span className="font-semibold text-gray-800">{row.phone || '—'}</span>
                    </div>
                    <div>
                      <span className="text-gray-400 block font-medium">Status</span>
                      <Badge variant={row.status === 'active' ? 'success' : row.status === 'on leave' || row.status === 'leave' ? 'warning' : 'default'} className="mt-0.5 text-[9px] capitalize">
                        {row.status || 'active'}
                      </Badge>
                    </div>
                  </div>

                  {isExpanded && (
                    <div className="border-t pt-3 space-y-2.5 text-xs grid grid-cols-1 gap-2 animate-fadeIn">
                      <div>
                        <span className="text-gray-400 block font-medium">Designation</span>
                        <span className="font-semibold text-gray-800 capitalize">{row.designation || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Email</span>
                        <span className="font-semibold text-gray-800 font-mono">{row.email || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Qualification</span>
                        <span className="font-semibold text-gray-800">{row.qualification || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Experience</span>
                        <span className="font-semibold text-gray-800">{row.experience_years !== undefined ? `${row.experience_years} Years` : '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Employment Type</span>
                        <span className="font-semibold text-gray-800 capitalize">{row.employment_type || '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Assigned Classes</span>
                        <span className="font-semibold text-gray-800">{Array.isArray(row.assigned_classes) ? row.assigned_classes.join(', ') : '—'}</span>
                      </div>
                      <div>
                        <span className="text-gray-400 block font-medium">Assigned Subjects</span>
                        <span className="font-semibold text-gray-800">{Array.isArray(row.assigned_subjects) ? row.assigned_subjects.join(', ') : '—'}</span>
                      </div>
                    </div>
                  )}

                  <div className="flex items-center justify-between border-t pt-2 mt-2 gap-2">
                    <button
                      onClick={() => toggleCardExpand(row.id || i)}
                      className="flex items-center justify-center gap-1 text-xs font-bold text-[#6D4CFF] hover:text-[#5b3ee0] min-h-[44px] px-2"
                    >
                      {isExpanded ? 'View Less' : 'View More'}
                    </button>
                    
                    <div className="flex items-center gap-1">
                      <button
                        onClick={() => { setSelectedStaff(row); setViewOpen(true); }}
                        className="px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-100 min-h-[44px]"
                      >
                        Profile
                      </button>
                      <button
                        onClick={() => { setSelectedStaff(row); setEditOpen(true); }}
                        className="px-3 py-1.5 rounded-lg bg-purple-50 text-purple-700 text-xs font-semibold hover:bg-purple-100 min-h-[44px]"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          {/* Pagination Controls */}
          <div className="flex flex-col md:flex-row items-center justify-between p-4 bg-white border border-gray-100 rounded-xl shadow-sm text-xs text-gray-500 gap-4">
            <div className="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left w-full md:w-auto">
              <div className="flex items-center gap-1.5 justify-center sm:justify-start">
                <span>Show</span>
                <select aria-label="Select page size" value={pageSize} onChange={e => setPageSize(Number(e.target.value))}
                  className="px-2 py-1.5 border border-gray-200 rounded-lg text-xs bg-white focus:outline-none min-h-[36px] flex items-center">
                  {[10, 25, 50, 100].map(sz => <option key={sz} value={sz}>{sz}</option>)}
                </select>
                <span>per page</span>
              </div>
              <div className="text-gray-400">
                Showing {Math.min(sortedStaff.length, (currentPage - 1) * pageSize + 1)} to {Math.min(sortedStaff.length, currentPage * pageSize)} of {sortedStaff.length} entries
              </div>
            </div>
            <div className="flex items-center gap-1.5 w-full sm:w-auto justify-between sm:justify-end">
              <button aria-label="Previous page" disabled={currentPage === 1} onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
                className="px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 transition-colors flex items-center gap-1 font-semibold min-h-[44px] justify-center flex-1 sm:flex-none">
                <ChevronLeft size={14} /> Prev
              </button>
              <span className="font-semibold text-gray-700 px-2 text-center">Page {currentPage} of {totalPages}</span>
              <button aria-label="Next page" disabled={currentPage === totalPages} onClick={() => setCurrentPage(prev => Math.min(totalPages, prev + 1))} className="px-4 py-2 border border-gray-200 rounded-lg hover:bg-gray-50 disabled:opacity-50 transition-colors flex items-center gap-1 font-semibold min-h-[44px] justify-center flex-1 sm:flex-none">Next <ChevronRight size={14} /></button>
            </div>
          </div>

          {/* Redesigned Staff Profile & Assignment Details Modal */}
      {viewOpen && selectedStaff && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md">
          <motion.div 
            initial={{ opacity: 0, y: 15, scale: 0.98 }} 
            animate={{ opacity: 1, y: 0, scale: 1 }}
            className="bg-white rounded-2xl shadow-2xl w-full max-w-6xl h-[90vh] flex flex-col overflow-hidden text-xs border border-gray-100"
          >
            {/* Header */}
            <div className="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-purple-50 via-white to-purple-50">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 rounded-full bg-gradient-to-tr from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-lg font-bold shadow-md">
                  {selectedStaff.full_name?.charAt(0).toUpperCase()}
                </div>
                <div>
                  <h3 className="font-extrabold text-base text-gray-900 flex items-center gap-2">
                    {selectedStaff.full_name}
                    <Badge className={`text-[10px] py-0.5 px-2 capitalize font-semibold ${getRoleBadgeStyle(selectedStaff.designation || selectedStaff.role)}`}>
                      {selectedStaff.designation || selectedStaff.role || 'staff'}
                    </Badge>
                  </h3>
                  <div className="mt-1 flex items-center gap-2 text-gray-500 font-medium">
                    <span>Emp ID: <span className="font-bold text-gray-700">{selectedStaff.staff_unique_id || selectedStaff.teacher_code || '—'}</span></span>
                    <span className="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                    <span>Dept: <span className="font-bold text-gray-700 capitalize">{selectedStaff.department || '—'}</span></span>
                    <span className="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                    <Badge variant={selectedStaff.status === 'active' ? 'success' : 'default'} className="text-[9px] py-0 px-1.5 uppercase font-bold tracking-wider">
                      {selectedStaff.status || 'active'}
                    </Badge>
                  </div>
                </div>
              </div>
              <button 
                onClick={() => { setViewOpen(false); setSelectedStaff(null); }} 
                className="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-700 text-xl font-medium border border-gray-100 shadow-sm transition-all"
              >
                ×
              </button>
            </div>

            {/* Tab Navigation */}
            <div className="flex border-b border-gray-100 bg-gray-50 px-6 py-1 gap-1">
              {[
                { id: 'profile', label: 'Profile', icon: '👤' },
                { id: 'assignments', label: 'Assignments', icon: '📋' },
                { id: 'permissions', label: 'Permissions', icon: '🔐' },
                { id: 'timetable', label: 'Timetable', icon: '📅' },
                { id: 'attendance', label: 'Attendance', icon: '✅' },
                { id: 'activity', label: 'Activity Log', icon: '📝' }
              ].map(tab => {
                const isActive = activeDetailTab === tab.id;
                return (
                  <button
                    key={tab.id}
                    onClick={() => setActiveDetailTab(tab.id as any)}
                    className={`flex items-center gap-1.5 px-4 py-3 font-semibold text-xs border-b-2 transition-all duration-200 ${
                      isActive 
                        ? 'border-purple-600 text-purple-600 bg-white' 
                        : 'border-transparent text-gray-500 hover:text-purple-600 hover:bg-gray-100/60'
                    }`}
                  >
                    <span>{tab.icon}</span>
                    <span>{tab.label}</span>
                  </button>
                );
              })}
            </div>

            {/* Modal Body (Scrollable content) */}
            <div className="flex-1 overflow-y-auto p-6 bg-gray-50/50">
              {activeDetailTab === 'profile' && (
                <div className="space-y-6">
                  {/* Personal details card */}
                  <div className="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
                    <h4 className="font-extrabold text-sm text-gray-900 border-b pb-2.5 mb-4 flex items-center gap-2">
                      <span className="text-purple-600 text-base">👤</span> Personal Information
                    </h4>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Full Name</span>
                        <span className="font-bold text-gray-800 text-sm">{selectedStaff.full_name}</span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Gender</span>
                        <span className="font-bold text-gray-800 text-sm capitalize">{selectedStaff.gender || '—'}</span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Email Address</span>
                        <span className="font-bold text-gray-800 text-sm font-mono break-all">{selectedStaff.email || '—'}</span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Phone Number</span>
                        <span className="font-bold text-gray-800 text-sm">{selectedStaff.phone || '—'}</span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Date of Birth</span>
                        <span className="font-bold text-gray-800 text-sm">
                          {selectedStaff.date_of_birth ? new Date(selectedStaff.date_of_birth).toLocaleDateString() : '—'}
                        </span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Designation</span>
                        <span className="font-bold text-gray-800 text-sm capitalize">{selectedStaff.designation || '—'}</span>
                      </div>
                    </div>
                  </div>

                  {/* Professional details card */}
