    <div className="space-y-4">
      {fields.map(field => (<div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
        {field.type === 'select' ? <select value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:border-[#6D4CFF]">
          {(field.options || []).map(o => <option key={o} value={o}>{o.charAt(0).toUpperCase() + o.slice(1)}</option>)}
        </select> : <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />}
      </div>))}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await eventMgmtApi.updateSportsTeam(edit.id, f.values); toast.success('Team updated'); } else { await eventMgmtApi.createSportsTeam(f.values); toast.success('Team created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update Team' : 'Create Team'}</button>
    </div>
  </CrudModal>;
}

function EventsModule() {
  return <EventsTab />
}

function AlumniTab() {
  const [activeTab, setActiveTab] = useState('directory');
  const alumni = useApi(() => alumniMgmtApi.getAll(), []);
  const events = useApi(() => alumniMgmtApi.getEvents(), []);
  const donations = useApi(() => alumniMgmtApi.getDonations(), []);
  const mentors = useApi(() => alumniMgmtApi.getMentors(), []);

  const [alumniModal, setAlumniModal] = useState(false);
  const [editAlumni, setEditAlumni] = useState<any>(null);
  const [eventModal, setEventModal] = useState(false);
  const [editEvent, setEditEvent] = useState<any>(null);
  const [donationModal, setDonationModal] = useState(false);
  const [mentorModal, setMentorModal] = useState(false);
  const [editMentor, setEditMentor] = useState<any>(null);

  const tabs = [
    { key: 'directory', label: 'Directory', icon: Globe },
    { key: 'events', label: 'Events', icon: CalendarDays },
    { key: 'donations', label: 'Donations', icon: DollarSign },
    { key: 'mentors', label: 'Mentors', icon: UserCheck },
  ];

  return (<div>
    <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit">
      {tabs.map(t => (<button key={t.key} onClick={() => setActiveTab(t.key)}
        className={`flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-all ${activeTab === t.key ? 'bg-white text-[#6D4CFF] shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
        <t.icon size={14} /> {t.label}
      </button>))}
    </div>

    {activeTab === 'directory' && <ModulePage title="Alumni Directory" desc="Manage alumni records" actions={
      <AddButton onClick={() => { setEditAlumni(null); setAlumniModal(true); }} label="Add Alumni" />
    }>
      <DataTable columns={[
        { key: 'full_name', label: 'Name' },
        { key: 'graduation_year', label: 'Grad Year' },
        { key: 'current_occupation', label: 'Occupation' },
        { key: 'company', label: 'Company' },
        { key: 'email', label: 'Email' },
        { key: 'phone', label: 'Phone' },
        { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'default'} className="text-[9px]">{v}</Badge> },
        { key: 'actions', label: '', render: (_: any, r: any) => (<div className="flex gap-1">
          <button onClick={() => { setEditAlumni(r); setAlumniModal(true); }} className="px-2 py-1 rounded bg-gray-50 text-gray-400 text-[9px] font-semibold hover:bg-gray-100"><Edit3 size={11} /></button>
          <button onClick={async () => { if (!confirm('Delete?')) return; try { await alumniMgmtApi.delete(r.id); alumni.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        </div>)}
      ]} data={alumni.data || []} loading={alumni.loading} error={alumni.error} onRetry={alumni.refetch} emptyMessage="No alumni records yet." />
      <AlumniFormModal open={alumniModal} edit={editAlumni} onClose={() => { setAlumniModal(false); setEditAlumni(null); }} onSaved={() => { alumni.refetch(); setAlumniModal(false); setEditAlumni(null); }} />
    </ModulePage>}

    {activeTab === 'events' && <ModulePage title="Alumni Events" desc="Manage alumni events and reunions" actions={
      <AddButton onClick={() => { setEditEvent(null); setEventModal(true); }} label="Add Event" />
    }>
      <div className="grid grid-cols-2 gap-4">
        {(events.data || []).map((e: any) => (<div key={e.id} className="bg-white rounded-xl border border-gray-100 p-4">
          <div className="flex items-start justify-between mb-3">
            <div>
              <div className="text-sm font-bold">{e.title}</div>
              <div className="text-[10px] text-gray-400 mt-0.5">{e.event_date ? new Date(e.event_date).toLocaleDateString() : ''}{e.location && ` • ${e.location}`}</div>
            </div>
            <Badge variant={e.status === 'upcoming' ? 'success' : 'default'} className="text-[9px]">{e.status}</Badge>
          </div>
          {e.description && <p className="text-[11px] text-gray-500 mb-3 line-clamp-2">{e.description}</p>}
          <div className="flex gap-2">
            <button onClick={() => { setEditEvent(e); setEventModal(true); }} className="flex-1 py-1.5 rounded-lg border border-gray-200 text-gray-500 text-[10px] font-semibold hover:bg-gray-50 flex items-center justify-center gap-1"><Edit3 size={12} /> Edit</button>
            <button onClick={async () => { if (!confirm('Delete event?')) return; try { await alumniMgmtApi.deleteEvent(e.id); events.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="flex-1 py-1.5 rounded-lg border border-red-200 text-red-400 text-[10px] font-semibold hover:bg-red-50 flex items-center justify-center gap-1"><Trash2 size={12} /> Delete</button>
          </div>
        </div>))}
      </div>
      <AlumniEventFormModal open={eventModal} edit={editEvent} onClose={() => { setEventModal(false); setEditEvent(null); }} onSaved={() => { events.refetch(); setEventModal(false); setEditEvent(null); }} />
    </ModulePage>}

    {activeTab === 'donations' && <ModulePage title="Donations" desc="Track alumni donations" actions={
      <AddButton onClick={() => setDonationModal(true)} label="Add Donation" />
    }>
      <DataTable columns={[
        { key: 'alumni_id', label: 'Alumni' },
        { key: 'amount', label: 'Amount', render: (v: number) => v ? `₹${Number(v).toLocaleString()}` : '—' },
        { key: 'purpose', label: 'Purpose' },
        { key: 'donation_date', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
        { key: 'actions', label: '', render: (_: any, r: any) => (
          <button onClick={async () => { if (!confirm('Delete donation?')) return; try { await alumniMgmtApi.deleteDonation(r.id); donations.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        )}
      ]} data={donations.data || []} loading={donations.loading} error={donations.error} onRetry={donations.refetch} emptyMessage="No donations yet." />
      <AlumniDonationFormModal open={donationModal} onClose={() => setDonationModal(false)} onSaved={() => { donations.refetch(); setDonationModal(false); }} />
    </ModulePage>}

    {activeTab === 'mentors' && <ModulePage title="Mentorship Program" desc="Alumni mentoring students" actions={
      <AddButton onClick={() => { setEditMentor(null); setMentorModal(true); }} label="Add Mentor" />
    }>
      <DataTable columns={[
        { key: 'alumni', label: 'Alumni', render: (_: any, r: any) => r.alumni?.full_name || r.alumni_id || '—' },
        { key: 'expertise', label: 'Expertise' },
        { key: 'availability', label: 'Availability' },
        { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'warning'} className="text-[9px]">{v}</Badge> },
        { key: 'actions', label: '', render: (_: any, r: any) => (<div className="flex gap-1">
          <button onClick={() => { setEditMentor(r); setMentorModal(true); }} className="px-2 py-1 rounded bg-gray-50 text-gray-400 text-[9px] font-semibold hover:bg-gray-100"><Edit3 size={11} /></button>
          <button onClick={async () => { if (!confirm('Delete?')) return; try { await alumniMgmtApi.deleteMentor(r.id); mentors.refetch(); toast.success('Deleted'); } catch (e: any) { toast.error(e.message); } }} className="px-2 py-1 rounded bg-red-50 text-red-400 text-[9px] font-semibold hover:bg-red-100"><Trash2 size={11} /></button>
        </div>)}
      ]} data={mentors.data || []} loading={mentors.loading} error={mentors.error} onRetry={mentors.refetch} emptyMessage="No mentors yet." />
      <AlumniMentorFormModal open={mentorModal} edit={editMentor} onClose={() => { setMentorModal(false); setEditMentor(null); }} onSaved={() => { mentors.refetch(); setMentorModal(false); setEditMentor(null); }} />
    </ModulePage>}
  </div>);
}

function AlumniFormModal({ open, edit, onClose, onSaved }: { open: boolean; edit: any; onClose: () => void; onSaved: () => void }) {
  const f = useForm(edit || { full_name: '', email: '', phone: '', graduation_year: '', current_occupation: '', company: '', address: '' });
  const [saving, setSaving] = useState(false);
  const fields = [
    { key: 'full_name', label: 'Full Name', type: 'text' },
    { key: 'email', label: 'Email', type: 'text' },
    { key: 'phone', label: 'Phone', type: 'text' },
    { key: 'graduation_year', label: 'Graduation Year', type: 'number' },
    { key: 'current_occupation', label: 'Occupation', type: 'text' },
    { key: 'company', label: 'Company', type: 'text' },
    { key: 'address', label: 'Address', type: 'text' },
  ];
  return <CrudModal open={open} onClose={onClose} title={edit ? 'Edit Alumni' : 'Add Alumni'}>
    <div className="space-y-4">
      {fields.map(field => (<div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
        <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
      </div>))}
      <button disabled={saving} onClick={async () => { setSaving(true); try { if (edit) { await alumniMgmtApi.update(edit.id, f.values); toast.success('Updated'); } else { await alumniMgmtApi.create(f.values); toast.success('Created'); } onSaved(); } catch (e: any) { toast.error(e.message); } finally { setSaving(false); } }}
        className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">{saving ? 'Saving...' : edit ? 'Update' : 'Create'}</button>
    </div>
  </CrudModal>;
}

