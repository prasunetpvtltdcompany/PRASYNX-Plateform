                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Sports Coaching Assignments */}
                            {assignmentsData.sports?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-teal-600 text-[10px] uppercase tracking-wider">Sports Category & Team Assignments</h5>
                                <div className="space-y-2">
                                  {assignmentsData.sports.map((sp: any) => (
                                    <div key={sp.id} className="bg-teal-50/40 border border-teal-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-teal-955">
                                          ⚽ Sport: <span className="text-purple-700 font-semibold">{sp.sports_category}</span>
                                        </p>
                                        {sp.practice_schedule && <p className="text-[10px] text-gray-500 font-medium">Schedule: <span className="font-bold text-gray-700">{sp.practice_schedule}</span></p>}
                                        {Array.isArray(sp.teams) && sp.teams.length > 0 && (
                                          <div className="flex flex-wrap gap-1 mt-1">
                                            {sp.teams.map((t: string, idx: number) => (
                                              <span key={idx} className="bg-white text-teal-700 px-2 py-0.5 rounded text-[9px] font-semibold border border-teal-50">
                                                🏆 {t}
                                              </span>
                                            ))}
                                          </div>
                                        )}
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('sports', sp.id)}
                                        className="text-teal-400 hover:text-red-500 font-bold text-base p-1 hover:bg-teal-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Hostel Assignments */}
                            {assignmentsData.hostel?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-rose-600 text-[10px] uppercase tracking-wider">Hostel Warden Duties</h5>
                                <div className="space-y-2">
                                  {assignmentsData.hostel.map((hs: any) => (
                                    <div key={hs.id} className="bg-rose-50/40 border border-rose-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-rose-955">
                                          🏨 Hostel: <span className="text-purple-700 font-semibold">{hs.hostel_building}</span>
                                        </p>
                                        <p className="text-[10px] text-gray-500 font-medium">Assigned Supervised Students: <span className="font-bold text-gray-700">{hs.students_assigned_count || 0}</span></p>
                                        {Array.isArray(hs.rooms) && hs.rooms.length > 0 && (
                                          <div className="flex flex-wrap gap-1 mt-1">
                                            {hs.rooms.map((r: string, idx: number) => (
                                              <span key={idx} className="bg-white text-rose-700 px-2 py-0.5 rounded text-[9px] font-semibold border border-rose-50">
                                                🔑 Room {r}
                                              </span>
                                            ))}
                                          </div>
                                        )}
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('hostel', hs.id)}
                                        className="text-rose-400 hover:text-red-500 font-bold text-base p-1 hover:bg-rose-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Staff Assignments (General Roles like Coordinator, Librarian, Principal, Accountant) */}
                            {assignmentsData.staff_assignments?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-blue-600 text-[10px] uppercase tracking-wider">Administrative & Staff Duties</h5>
                                <div className="space-y-2">
                                  {assignmentsData.staff_assignments.map((sa: any) => (
                                    <div key={sa.id} className="bg-blue-50/30 border border-blue-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-blue-955 capitalize">
                                          🛡️ {sa.assignment_type} Role Scope
                                        </p>
                                        {sa.details && (
                                          <div className="text-[10px] text-gray-600 mt-1 font-medium space-y-1 bg-white p-2 rounded-lg border border-gray-50">
                                            {/* Principal Responsibilities */}
                                            {sa.details.responsibilities && (
                                              <div>
                                                <span className="font-bold text-[9px] text-purple-600 uppercase">Responsibilities:</span>
                                                <ul className="list-disc pl-4 mt-0.5 space-y-0.5 font-medium text-gray-700">
                                                  {sa.details.responsibilities.map((r: string, idx: number) => <li key={idx}>{r}</li>)}
                                                </ul>
                                              </div>
                                            )}

                                            {/* Librarian Permissions */}
                                            {sa.details.permissions && (
                                              <div className="mt-1">
                                                <span className="font-bold text-[9px] text-purple-600 uppercase">Granted Permissions:</span>
                                                <ul className="list-disc pl-4 mt-0.5 space-y-0.5 font-medium text-gray-700">
                                                  {sa.details.permissions.map((p: string, idx: number) => <li key={idx}>{p}</li>)}
                                                </ul>
                                              </div>
                                            )}

                                            {/* Accountant Modules */}
                                            {sa.details.modules && (
                                              <div>
                                                <span className="font-bold text-[9px] text-emerald-600 uppercase">Assigned Modules:</span>
                                                <ul className="list-disc pl-4 mt-0.5 space-y-0.5 font-medium text-gray-700">
                                                  {sa.details.modules.map((m: string, idx: number) => <li key={idx}>{m}</li>)}
                                                </ul>
                                              </div>
                                            )}

                                            {/* Receptionist Tasks */}
                                            {sa.details.tasks && (
                                              <div>
                                                <span className="font-bold text-[9px] text-pink-600 uppercase">Oversight Tasks:</span>
                                                <ul className="list-disc pl-4 mt-0.5 space-y-0.5 font-medium text-gray-700">
                                                  {sa.details.tasks.map((t: string, idx: number) => <li key={idx}>{t}</li>)}
                                                </ul>
                                              </div>
                                            )}

                                            {/* Nurse Details */}
                                            {sa.details.health_room && (
                                              <p>🏥 Assigned Clinic Room: <span className="font-bold">{sa.details.health_room}</span></p>
                                            )}

                                            {/* IT Lab Details */}
                                            {sa.details.computer_lab && (
                                              <p>💻 Assigned Computer Lab: <span className="font-bold">{sa.details.computer_lab}</span></p>
                                            )}

                                            {/* General description */}
                                            {sa.details.description && <p className="italic text-gray-500">{sa.details.description}</p>}
                                          </div>
                                        )}
                                      </div>
                                      <button 
                                        onClick={() => handleRemoveAssignment('staff_assignment', sa.id)}
                                        className="text-blue-400 hover:text-red-500 font-bold text-base p-1 hover:bg-blue-50 rounded"
                                      >
                                        ×
                                      </button>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}
                          </div>
                        )}
                      </div>

                      {/* History log block */}
                      <div className="border-t border-gray-100 pt-3 mt-4">
                        <span className="text-[9px] font-extrabold uppercase text-gray-400 tracking-wider">Assignment Audit Status</span>
                        <p className="text-[10px] text-gray-500 font-medium mt-0.5">Operational changes take effect in client portals immediately.</p>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {activeDetailTab === 'permissions' && (
                <div className="space-y-6 bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                  <div>
                    <h4 className="font-extrabold text-sm text-gray-900 border-b pb-2 mb-2 flex items-center gap-2">
                      <span className="text-purple-600 text-base">🔑</span> System Access & Permissions Matrix
                    </h4>
                    <p className="text-gray-500 font-medium">Automatic role-based operational permissions & explicit responsibility-based scopes.</p>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {/* Left: Role Permission Policies */}
                    <div className="space-y-3">
                      <h5 className="font-bold text-[10px] uppercase tracking-wider text-purple-600">Default Role-Based Access Control (RBAC)</h5>
                      <div className="bg-purple-50/40 border border-purple-100 rounded-xl p-4 space-y-3">
                        <div>
                          <span className="font-extrabold text-purple-900 text-xs capitalize flex items-center gap-1.5">
                            🛡️ Role: {selectedStaff.role || 'staff'}
                          </span>
                          <p className="text-gray-400 text-[10px] mt-0.5">Implicit permissions granted to all users with this system role.</p>
                        </div>
                        <ul className="space-y-1.5 pl-1">
                          {(rolePermissions[(selectedStaff.role || 'staff').toLowerCase()] || ["Basic Portal Access", "View Institution Events", "Submit Grievance Tickets"]).map((perm, idx) => (
                            <li key={idx} className="flex items-center gap-2 font-bold text-purple-950">
                              <span className="text-purple-500">✔</span>
                              <span>{perm}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    {/* Right: Operational Responsibilities */}
                    <div className="space-y-3">
                      <h5 className="font-bold text-[10px] uppercase tracking-wider text-emerald-600">Active Operational Responsibilities</h5>
                      <div className="bg-emerald-50/40 border border-emerald-100 rounded-xl p-4 space-y-3">
                        <div>
                          <span className="font-extrabold text-emerald-955 text-xs">📋 Operational Duty Permissions</span>
                          <p className="text-gray-400 text-[10px] mt-0.5">Permissions activated dynamically based on current assignments.</p>
                        </div>
                        
                        {(!assignmentsData || (
                          (!assignmentsData.teacher_matrix?.length) &&
                          (!assignmentsData.class_teachers?.length) &&
                          (!assignmentsData.transport?.length) &&
                          (!assignmentsData.security?.length) &&
                          (!assignmentsData.staff_assignments?.length)
                        )) ? (
                          <p className="text-gray-400 italic font-semibold text-[10px] py-4 text-center">No active operational duties configured.</p>
                        ) : (
                          <ul className="space-y-1.5 font-bold text-gray-700">
                            {assignmentsData.teacher_matrix?.map((m: any, idx: number) => (
                              <li key={idx} className="flex items-center gap-2 font-bold text-gray-700">
                                <span className="text-emerald-500">✦</span>
                                <span>Can input marks and attendance for {m.classes?.name} - {m.subjects?.name}</span>
                              </li>
                            ))}
                            {assignmentsData.class_teachers?.map((ct: any, idx: number) => (
                              <li key={idx} className="flex items-center gap-2 font-bold text-gray-700">
                                <span className="text-emerald-500">✦</span>
                                <span>Can update reporting & parents profiles for {ct.classes?.name}</span>
                              </li>
                            ))}
                            {assignmentsData.transport?.map((t: any, idx: number) => (
                              <li key={idx} className="flex items-center gap-2 font-bold text-gray-700">
                                <span className="text-emerald-500">✦</span>
                                <span>Can super-track student counts & check-ins on Route: {t.route_name}</span>
                              </li>
                            ))}
                            {assignmentsData.security?.map((s: any, idx: number) => (
                              <li key={idx} className="flex items-center gap-2 font-bold text-gray-700">
                                <span className="text-emerald-500">✦</span>
                                <span>Can issue Gate Passes at {s.gate_name} during {s.shift} shift</span>
                              </li>
                            ))}
                            {assignmentsData.staff_assignments?.map((sa: any, idx: number) => (
                              <li key={idx} className="flex items-center gap-2 font-bold text-gray-700">
                                <span className="text-emerald-500">✦</span>
                                <span className="capitalize">Can execute operational duties for {sa.assignment_type} module</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {activeDetailTab === 'timetable' && (
                <div className="space-y-5 bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                  <div>
                    <h4 className="font-extrabold text-sm text-gray-900 border-b pb-2 mb-2 flex items-center gap-2">
                      <span className="text-purple-600 text-base">📅</span> Staff Work Schedule & Timetable
                    </h4>
                    <p className="text-gray-500 font-medium">Weekly calendar preview dynamically compiled from active class and subject mappings.</p>
                  </div>

                  {!assignmentsData?.teacher_matrix?.length ? (
                    <div className="text-center py-12 text-gray-400 font-medium bg-gray-50/50 rounded-xl border border-dashed border-gray-200">
                      <p className="text-lg">📅</p>
                      <p className="text-xs font-bold text-gray-500 mt-2">No Scheduled Teaching Assignments</p>
                      <p className="text-[10px] text-gray-400 mt-1 max-w-xs mx-auto">This staff member is not currently assigned subjects or classes in the teacher matrix.</p>
                    </div>
                  ) : (
                    <div className="overflow-x-auto border border-gray-100 rounded-xl shadow-sm">
                      <table className="w-full border-collapse">
                        <thead>
                          <tr className="bg-purple-50/50 border-b border-gray-100 text-purple-950 font-bold">
                            <th className="py-3 px-4 text-left border-r border-gray-100 font-bold">Day</th>
                            <th className="py-3 px-4 text-center border-r border-gray-100 font-bold">Period 1<br/><span className="text-[9px] text-purple-500 font-semibold">09:00 - 10:00</span></th>
                            <th className="py-3 px-4 text-center border-r border-gray-100 font-bold">Period 2<br/><span className="text-[9px] text-purple-500 font-semibold">10:00 - 11:00</span></th>
                            <th className="py-3 px-4 text-center border-r border-gray-100 font-bold">Period 3<br/><span className="text-[9px] text-purple-500 font-semibold">11:15 - 12:15</span></th>
                            <th className="py-3 px-4 text-center border-r border-gray-100 font-bold">Period 4<br/><span className="text-[9px] text-purple-500 font-semibold">01:00 - 02:00</span></th>
                            <th className="py-3 px-4 text-center font-bold">Period 5<br/><span className="text-[9px] text-purple-500 font-semibold">02:00 - 03:00</span></th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100 font-semibold text-gray-700 text-center">
                          {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].map((day, dIdx) => (
                            <tr key={day} className="hover:bg-gray-50/50 transition-colors">
                              <td className="py-4 px-4 text-left font-bold border-r border-gray-100 bg-gray-50/50">{day}</td>
                              {[1, 2, 3, 4, 5].map(pNum => {
                                // Assign matrix elements deterministically to fill slots elegantly
                                const maps = assignmentsData.teacher_matrix;
                                const mapItem = maps[(dIdx + pNum) % maps.length];
                                const isAssigned = (dIdx + pNum) % 3 !== 0; // Create mock free slots
                                
                                return (
                                  <td key={pNum} className="py-4 px-3 border-r border-gray-100 text-xs">
                                    {isAssigned && mapItem ? (
                                      <div className="p-2 bg-purple-50/80 border border-purple-100 rounded-lg text-left shadow-sm">
                                        <p className="font-extrabold text-purple-900 leading-tight">{mapItem.subjects?.name || 'Class Period'}</p>
                                        <p className="text-[9px] text-purple-600 font-bold mt-1">
                                          {mapItem.classes?.name || 'Grade 5'} ({mapItem.sections?.name || 'A'})
                                        </p>
                                      </div>
                                    ) : (
                                      <span className="text-gray-300 italic font-medium">Free Slot</span>
                                    )}
                                  </td>
                                );
                              })}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              )}

              {activeDetailTab === 'attendance' && (
                <div className="space-y-5 bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                  <div className="flex justify-between items-center border-b pb-2 mb-2">
                    <div>
                      <h4 className="font-extrabold text-sm text-gray-900 flex items-center gap-2">
                        <span className="text-purple-600 text-base">✅</span> Attendance & Check-in History
                      </h4>
                      <p className="text-gray-500 font-medium">Daily attendance check-ins for the current calendar month.</p>
                    </div>
                    <div className="flex gap-2">
                      <span className="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded text-[10px] font-bold border border-emerald-100">Present Rate: 94%</span>
                      <span className="bg-amber-50 text-amber-700 px-2 py-0.5 rounded text-[10px] font-bold border border-amber-100">Leaves: 2 Days</span>
                    </div>
                  </div>

                  <div className="border border-gray-100 rounded-xl overflow-hidden shadow-sm">
                    <table className="w-full border-collapse">
                      <thead>
                        <tr className="bg-purple-50/50 border-b border-gray-100 text-purple-950 font-bold">
                          <th className="py-2.5 px-4 text-left font-bold">Date</th>
                          <th className="py-2.5 px-4 text-left font-bold">Check-In Time</th>
                          <th className="py-2.5 px-4 text-left font-bold">Check-Out Time</th>
                          <th className="py-2.5 px-4 text-left font-bold">Status</th>
                          <th className="py-2.5 px-4 text-left font-bold">Remarks</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100 font-medium text-gray-700">
                        {[
                          { date: 'Today (June 17, 2026)', in: '08:52 AM', out: '04:05 PM', status: 'present', note: 'On-time checkin' },
                          { date: 'Yesterday (June 16, 2026)', in: '08:58 AM', out: '04:01 PM', status: 'present', note: 'On-time checkin' },
                          { date: 'June 15, 2026', in: '—', out: '—', status: 'leave', note: 'Casual Leave (Approved)' },
                          { date: 'June 14, 2026', in: '08:45 AM', out: '04:00 PM', status: 'present', note: 'Early checkin' },
                          { date: 'June 13, 2026', in: '08:55 AM', out: '04:03 PM', status: 'present', note: 'On-time checkin' }
                        ].map((att, idx) => (
                          <tr key={idx} className="hover:bg-gray-50/50 transition-colors font-medium">
                            <td className="py-3 px-4 font-bold">{att.date}</td>
                            <td className="py-3 px-4 font-mono">{att.in}</td>
                            <td className="py-3 px-4 font-mono">{att.out}</td>
                            <td className="py-3 px-4">
                              <Badge variant={att.status === 'present' ? 'success' : 'warning'} className="text-[9px] uppercase font-bold tracking-wider py-0 px-2">
                                {att.status}
                              </Badge>
                            </td>
                            <td className="py-3 px-4 text-gray-500">{att.note}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {activeDetailTab === 'activity' && (
                <div className="space-y-5 bg-white p-5 rounded-xl border border-gray-100 shadow-sm">
                  <div>
                    <h4 className="font-extrabold text-sm text-gray-900 border-b pb-2 mb-2 flex items-center gap-2">
                      <span className="text-purple-600 text-base">📝</span> Staff Operational Activity Log
                    </h4>
                    <p className="text-gray-500 font-medium">Audit logs of profiles and work assignments changes.</p>
                  </div>

                  <div className="space-y-4 pl-4 relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-0.5 before:bg-gray-200">
                    {[
                      { time: 'June 17, 2026 14:32', type: 'assignment', user: 'Admin User', msg: `Added assignments/matrix mappings for ${selectedStaff.full_name}` },
                      { time: 'June 17, 2026 11:15', type: 'system', user: 'System Sync', msg: 'Timetables and Portal accounts updated successfully' },
                      { time: 'June 16, 2026 09:00', type: 'profile', user: 'Admin User', msg: 'Staff record joining date and department configured' },
                      { time: 'June 15, 2026 10:25', type: 'portal', user: 'System Sync', msg: 'Staff portal authorization credentials generated' }
                    ].map((act, idx) => (
                      <div key={idx} className="relative flex items-start gap-4">
                        {/* Dot */}
                        <div className="w-6 h-6 rounded-full bg-purple-50 border-2 border-purple-600 flex items-center justify-center text-[10px] z-10 shrink-0 shadow-sm">
                          {act.type === 'assignment' ? '📋' : act.type === 'system' ? '⚙️' : '👤'}
                        </div>
                        <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100 flex-1">
                          <div className="flex justify-between items-center gap-3">
                            <span className="font-bold text-gray-900 text-xs">{act.msg}</span>
                            <span className="text-[9px] text-gray-400 font-semibold font-mono whitespace-nowrap">{act.time}</span>
                          </div>
                          <p className="text-[9px] text-gray-500 mt-1 font-medium">Triggered by: <span className="font-bold text-purple-600">{act.user}</span></p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="flex items-center justify-between px-6 py-4 border-t border-gray-100 bg-gray-50">
              <span className="text-[10px] text-gray-400 font-semibold">Institution Portal Staff Operations</span>
              <button 
                onClick={() => { setViewOpen(false); setSelectedStaff(null); }} 
                className="px-5 py-2.5 bg-gray-900 text-white hover:bg-gray-800 rounded-xl font-bold transition-all shadow-md"
              >
                Close View
              </button>
            </div>
          </motion.div>
        </div>
    </ModulePage>
  );
}

function AssignClassForm({ staff, classesList, subjectsList, onDone }: { staff: any; classesList: any[]; subjectsList: any[]; onDone: () => void }) {
  const [classId, setClassId] = useState('');
  const [subjectId, setSubjectId] = useState('');
  const [saving, setSaving] = useState(false);

  const handleAssign = async () => {
    if (!classId || !subjectId) {
      toast.error('Please select both a class and a subject');
      return;
    }
    setSaving(true);
    try {
      const res = await staffApi.assignClass(staff.id, { class_id: classId, subject_id: subjectId });
      if (res.success) {
        toast.success('Class and subject assigned successfully!');
        onDone();
      } else {
        toast.error(res.error || 'Failed to assign class/subject');
      }
    } catch (err: any) {
      toast.error(err.message || 'Error occurred');
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="space-y-4 text-xs">
      <div className="p-3 bg-purple-50 rounded-lg border border-purple-100">
        <p className="font-bold text-purple-900">Assigning for: {staff.full_name}</p>
        <p className="text-purple-600 mt-0.5">Role: <span className="capitalize">{staff.role}</span></p>
      </div>
      <div>
        <label className="text-xs font-semibold text-gray-700 mb-1 block">Class <span className="text-red-500">*</span></label>
        <select value={classId} onChange={e => setClassId(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
          <option value="">Select Class</option>
          {classesList.map(c => <option key={c.id} value={c.id}>{c.name}{c.section ? ` - ${c.section}` : ''}</option>)}
        </select>
      </div>
      <div>
        <label className="text-xs font-semibold text-gray-700 mb-1 block">Subject <span className="text-red-500">*</span></label>
        <select value={subjectId} onChange={e => setSubjectId(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
          <option value="">Select Subject</option>
          {subjectsList.map(s => <option key={s.id} value={s.id}>{s.name} ({s.code || s.name})</option>)}
        </select>
      </div>
      <button onClick={handleAssign} disabled={saving} className="w-full mt-2 py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold hover:shadow-lg disabled:opacity-50 transition-all">
        {saving ? 'Assigning...' : 'Assign Class & Subject'}
      </button>
    </div>
  );
}

function EditStaffForm({ staff, onDone }: { staff: any; onDone: () => void }) {
  const [saving, setSaving] = useState(false);
  const f = useForm({
    full_name: staff.full_name || '',
    email: staff.email || '',
    role: staff.role || 'teacher',
    phone: staff.phone || '',
    employee_id: staff.staff_unique_id || staff.teacher_code || '',
    department: staff.department || '',
    designation: staff.designation || '',
    qualification: staff.qualification || '',
    experience_years: staff.experience_years !== undefined ? String(staff.experience_years) : '',
    joining_date: staff.join_date || staff.joining_date ? (staff.join_date || staff.joining_date).split('T')[0] : '',
    gender: staff.gender || 'Male',
    date_of_birth: staff.date_of_birth ? staff.date_of_birth.split('T')[0] : '',
    address: staff.address || '',
    city: staff.city || '',
    state: staff.state || '',
    country: staff.country || '',
    postal_code: staff.postal_code || '',
    salary: staff.salary !== undefined ? String(staff.salary) : '',
    employment_type: staff.employment_type || 'Full-time',
    reporting_manager: staff.reporting_manager || '',
    subject: staff.subject || '',
    status: staff.status || 'active'
  });

  const handleUpdate = async () => {
    if (!f.values.full_name) {
      toast.error('Full Name is required');
      return;
    }
    setSaving(true);
    try {
      const res = await staffApi.update(staff.id, f.values);
      if (res.success) {
        toast.success('Staff member updated successfully!');
        onDone();
      } else {
        toast.error(res.error || 'Failed to update staff');
      }
    } catch (err: any) {
      toast.error(err.message || 'Error occurred');
    } finally {
      setSaving(false);
    }
  };

  return (
    <form onSubmit={e => { e.preventDefault(); handleUpdate(); }} className="space-y-6 max-h-[70vh] overflow-y-auto pr-2">
      {/* Section 1: Account Info & Role */}
      <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
        <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
          <Key size={14} /> Account & Role
        </h4>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Full Name <span className="text-red-500">*</span></label>
            <input type="text" value={f.values.full_name} onChange={e => f.handleChange('full_name', e.target.value)} required
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Role <span className="text-red-500">*</span></label>
            <select value={f.values.role} onChange={e => f.handleChange('role', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
              <option value="teacher">Teacher</option>
              <option value="admin">Admin</option>
              <option value="accountant">Accountant</option>
              <option value="librarian">Librarian</option>
              <option value="transport_manager">Transport Manager</option>
              <option value="hostel_warden">Hostel Warden</option>
              <option value="staff">Staff</option>
              <option value="driver">Driver</option>
              <option value="counsellor">Counsellor</option>
            </select>
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Phone</label>
            <input type="tel" value={f.values.phone} onChange={e => f.handleChange('phone', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Login Email</label>
            <input type="email" readOnly value={f.values.email}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs bg-gray-100 text-gray-500 cursor-not-allowed" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Status</label>
            <select value={f.values.status} onChange={e => f.handleChange('status', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
              <option value="on leave">On Leave</option>
            </select>
          </div>
        </div>
      </div>

      {/* Section 2: Professional Profile */}
      <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
        <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
          <Briefcase size={14} /> Professional Details
        </h4>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Employee ID</label>
            <input type="text" value={f.values.employee_id} onChange={e => f.handleChange('employee_id', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Department</label>
            <input type="text" value={f.values.department} onChange={e => f.handleChange('department', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Designation</label>
            <input type="text" value={f.values.designation} onChange={e => f.handleChange('designation', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div className="md:col-span-2">
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Qualification</label>
            <input type="text" value={f.values.qualification} onChange={e => f.handleChange('qualification', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Experience (Years)</label>
            <input type="number" min="0" value={f.values.experience_years} onChange={e => f.handleChange('experience_years', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Joining Date</label>
            <input type="date" value={f.values.joining_date} onChange={e => f.handleChange('joining_date', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white text-gray-500" />
          </div>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Salary</label>
            <input type="number" min="0" value={f.values.salary} onChange={e => f.handleChange('salary', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Employment Type</label>
            <select value={f.values.employment_type} onChange={e => f.handleChange('employment_type', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
              <option value="Full-time">Full-time</option>
              <option value="Part-time">Part-time</option>
              <option value="Contract">Contract</option>
              <option value="Temporary">Temporary</option>
            </select>
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Reporting Manager</label>
            <input type="text" value={f.values.reporting_manager} onChange={e => f.handleChange('reporting_manager', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
        </div>
        {f.values.role === 'teacher' && (
          <div className="pt-2">
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Subject(s)</label>
            <input type="text" value={f.values.subject} onChange={e => f.handleChange('subject', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
        )}
      </div>

      {/* Section 3: Personal & Address Details */}
      <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
        <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
          <Users size={14} /> Personal & Address Details
        </h4>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Gender</label>
            <select value={f.values.gender} onChange={e => f.handleChange('gender', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Date of Birth</label>
            <input type="date" value={f.values.date_of_birth} onChange={e => f.handleChange('date_of_birth', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white text-gray-500" />
          </div>
        </div>
        <div>
          <label className="text-xs font-semibold text-gray-700 mb-1 block">Address</label>
          <input type="text" value={f.values.address} onChange={e => f.handleChange('address', e.target.value)}
            className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
        </div>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">City</label>
            <input type="text" value={f.values.city} onChange={e => f.handleChange('city', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">State</label>
            <input type="text" value={f.values.state} onChange={e => f.handleChange('state', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Country</label>
            <input type="text" value={f.values.country} onChange={e => f.handleChange('country', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
          <div>
            <label className="text-xs font-semibold text-gray-700 mb-1 block">Postal Code</label>
            <input type="text" value={f.values.postal_code} onChange={e => f.handleChange('postal_code', e.target.value)}
              className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white" />
          </div>
        </div>
      </div>

      <button type="submit" disabled={saving} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold hover:shadow-lg disabled:opacity-50 flex items-center justify-center gap-1.5 transition-all">
        {saving ? 'Saving...' : 'Save Changes'}
      </button>
    </form>
  );
}

function StudentForm({ onDone, onCreated }: { onDone: () => void; onCreated?: (creds: { email: string; password: string }) => void }) {
  const f = useForm({ full_name: '', roll_number: '', student_class: '', section: '', phone: '', email: '', password: '', parent_email: '', parent_phone: '', parent_name: '', parent_relationship: 'guardian' });
  const [parentMode, setParentMode] = useState<'none' | 'search' | 'new'>('none');
  const [searchTerm, setSearchTerm] = useState('');
  const [searchResults, setSearchResults] = useState<any[]>([]);
  const [selectedParentId, setSelectedParentId] = useState<string | null>(null);
  const [selectedParentName, setSelectedParentName] = useState('');
  const [searching, setSearching] = useState(false);
  const searchTimer = useRef<any>(null);
  const fields = [
    { key: 'full_name' as const, label: 'Full Name', type: 'text' },
    { key: 'roll_number' as const, label: 'Roll Number', type: 'text' },
    { key: 'student_class' as const, label: 'Class', type: 'text' },
    { key: 'section' as const, label: 'Section', type: 'text' },
    { key: 'email' as const, label: 'Login Email', type: 'email' },
    { key: 'password' as const, label: 'Login Password', type: 'password' },
    { key: 'phone' as const, label: 'Phone', type: 'tel' },
  ];
  const [creating, setCreating] = useState(false);
  const [ro, setRo] = useState(true);

  const doSearchParent = async (term: string) => {
    if (term.length < 3) { setSearchResults([]); return; }
    setSearching(true);
    try {
      const res = await apiClient.get<any[]>(`/management/parents/search/${orgId()}?q=${encodeURIComponent(term)}`);
      setSearchResults(res.success && Array.isArray(res.data) ? res.data : []);
    } catch { setSearchResults([]); }
    setSearching(false);
  };

  return (
    <form autoComplete="off" onSubmit={e => e.preventDefault()} className="space-y-4">
      {fields.map(field => (
        <div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
          <input type={field.type} autoComplete={field.type === 'password' ? 'new-password' : 'off'} readOnly={field.type === 'password' || field.key.includes('email') ? ro : false} onFocus={() => setRo(false)} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] focus:ring-3 focus:ring-[rgba(109,76,255,0.1)]" /></div>
      ))}
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Parent Information</label>
        <div className="flex gap-2 mb-2">
          <button type="button" onClick={() => { setParentMode('none'); setSelectedParentId(null); setSelectedParentName(''); }} className={`px-3 py-1.5 text-xs rounded-lg ${parentMode === 'none' ? 'bg-[#6D4CFF] text-white' : 'bg-gray-100 text-gray-600'}`}>No Parent</button>
          <button type="button" onClick={() => setParentMode('search')} className={`px-3 py-1.5 text-xs rounded-lg ${parentMode === 'search' ? 'bg-[#6D4CFF] text-white' : 'bg-gray-100 text-gray-600'}`}>Link Existing</button>
          <button type="button" onClick={() => setParentMode('new')} className={`px-3 py-1.5 text-xs rounded-lg ${parentMode === 'new' ? 'bg-[#6D4CFF] text-white' : 'bg-gray-100 text-gray-600'}`}>Create New</button>
        </div>
        {parentMode === 'search' && (<div>
          <input type="text" placeholder="Search parent by email or name..." value={searchTerm} onChange={e => { setSearchTerm(e.target.value); clearTimeout(searchTimer.current); searchTimer.current = setTimeout(() => doSearchParent(e.target.value), 300); }} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] mb-1" />
          {searching && <p className="text-xs text-gray-400">Searching...</p>}
          {selectedParentId && <p className="text-xs text-green-600 mb-1">Selected: {selectedParentName}</p>}
          {searchResults.length > 0 && <div className="max-h-32 overflow-y-auto border border-gray-100 rounded-lg mb-1">{searchResults.map((p: any) => (
            <button key={p.id} type="button" onClick={() => { setSelectedParentId(p.id); setSelectedParentName(p.full_name || p.email); setSearchResults([]); }} className={`w-full text-left px-3 py-2 text-xs hover:bg-gray-50 ${selectedParentId === p.id ? 'bg-purple-50' : ''}`}>{p.full_name || 'Unknown'} — {p.email}{p.phone ? ` (${p.phone})` : ''}</button>
          ))}</div>}
        </div>)}
        {parentMode === 'new' && (<div className="space-y-2 p-2 bg-gray-50 rounded-lg">
          <input type="text" placeholder="Parent Name" value={f.values.parent_name as string} onChange={e => f.handleChange('parent_name', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
          <input type="email" placeholder="Parent Email" value={f.values.parent_email as string} onChange={e => f.handleChange('parent_email', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
          <input type="tel" placeholder="Parent Phone" value={f.values.parent_phone as string} onChange={e => f.handleChange('parent_phone', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
          <select value={f.values.parent_relationship as string} onChange={e => f.handleChange('parent_relationship', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white">
            <option value="guardian">Guardian</option>
            <option value="father">Father</option>
            <option value="mother">Mother</option>
            <option value="other">Other</option>
          </select>
        </div>)}
      </div>
      <button type="button" onClick={async () => {
        if (creating) return;
        setCreating(true);
        try {
          let parent_info: any = undefined;
          if (parentMode === 'search' && selectedParentId) {
            parent_info = { type: 'existing', parent_id: selectedParentId };
          } else if (parentMode === 'new' && f.values.parent_email) {
            parent_info = { type: 'new', full_name: f.values.parent_name, email: f.values.parent_email, phone: f.values.parent_phone, relationship: f.values.parent_relationship };
          }
          const payload = { ...f.values, parent_email: undefined, parent_phone: undefined, parent_name: undefined, parent_relationship: undefined, parent_info };
          const res = await studentApi.create(payload);
          if (!res.success) { toast.error(res.error || 'Failed to create student'); return; }
          const creds = res.data?.credentials || {};
          if (f.values.email && f.values.password) {
            toast.success(`Student created — Email: ${creds.email || f.values.email}, Password: ${creds.password || f.values.password}`);
            onCreated?.({ email: creds.email || f.values.email, password: creds.password || f.values.password });
          } else {
            toast.success('Student created (no login account — add email/password to enable)');
          }
          onDone();
        } catch (err: any) { toast.error(err.message); } finally { setCreating(false); }
      }} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold hover:shadow-lg disabled:opacity-50">{creating ? 'Creating...' : 'Create Student'}</button>
    </form>
  );
}

function StaffForm({ onDone, onCreated }: { onDone: () => void; onCreated?: (creds: { email: string; password: string }) => void }) {
  const f = useForm({
    full_name: '',
    email: '',
    password: '',
    role: 'teacher',
    phone: '',
    employee_id: '',
    department: '',
    designation: '',
    qualification: '',
    experience_years: '',
    joining_date: '',
    gender: 'Male',
    date_of_birth: '',
    address: '',
    city: '',
    state: '',
    country: '',
    postal_code: '',
    salary: '',
    employment_type: 'Full-time',
    reporting_manager: '',
    subject: ''
  });

  const [creating, setCreating] = useState(false);
  const [ro, setRo] = useState(true);
  const [createdTeacherId, setCreatedTeacherId] = useState<string | null>(null);
  const [classes, setClasses] = useState<any[]>([]);
  const [subjects, setSubjects] = useState<any[]>([]);
  const [selectedClassId, setSelectedClassId] = useState('');
  const [selectedSubjectId, setSelectedSubjectId] = useState('');
  const [assigning, setAssigning] = useState(false);

  return (
    <form autoComplete="off" onSubmit={e => e.preventDefault()} className="space-y-6 max-h-[70vh] overflow-y-auto pr-2">
      {!createdTeacherId ? (
        <>
          {/* Section 1: Account Credentials & Role */}
          <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
            <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
              <Key size={14} /> Account & Role
            </h4>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Full Name <span className="text-red-500">*</span></label>
                <input type="text" value={f.values.full_name} onChange={e => f.handleChange('full_name', e.target.value)} required
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Jane Smith" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Role <span className="text-red-500">*</span></label>
                <select value={f.values.role} onChange={e => f.handleChange('role', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
                  <option value="teacher">Teacher</option>
                  <option value="admin">Admin</option>
                  <option value="accountant">Accountant</option>
                  <option value="librarian">Librarian</option>
                  <option value="transport_manager">Transport Manager</option>
                  <option value="hostel_warden">Hostel Warden</option>
                  <option value="staff">Staff</option>
                  <option value="driver">Driver</option>
                  <option value="counsellor">Counsellor</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Phone</label>
                <input type="tel" value={f.values.phone} onChange={e => f.handleChange('phone', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="9876543210" />
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Login Email <span className="text-gray-400 font-normal">(Auto-generated if blank)</span></label>
                <input type="email" readOnly={ro} onFocus={() => setRo(false)} value={f.values.email} onChange={e => f.handleChange('email', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="jane.smith@school.edu" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Login Password <span className="text-gray-400 font-normal">(Auto-generated if blank)</span></label>
                <input type="password" readOnly={ro} onFocus={() => setRo(false)} value={f.values.password} onChange={e => f.handleChange('password', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="••••••••" />
              </div>
            </div>
          </div>

          {/* Section 2: Professional Profile */}
          <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
            <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
              <Briefcase size={14} /> Professional Details
            </h4>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Employee ID / Code</label>
                <input type="text" value={f.values.employee_id} onChange={e => f.handleChange('employee_id', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="EMP001" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Department</label>
                <input type="text" value={f.values.department} onChange={e => f.handleChange('department', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Science" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Designation</label>
                <input type="text" value={f.values.designation} onChange={e => f.handleChange('designation', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Physics Teacher" />
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div className="md:col-span-2">
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Qualification</label>
                <input type="text" value={f.values.qualification} onChange={e => f.handleChange('qualification', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="B.Sc Physics, M.Ed" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Experience (Years)</label>
                <input type="number" min="0" value={f.values.experience_years} onChange={e => f.handleChange('experience_years', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="5" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Joining Date</label>
                <input type="date" value={f.values.joining_date} onChange={e => f.handleChange('joining_date', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white text-gray-500" />
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Salary</label>
                <input type="number" min="0" value={f.values.salary} onChange={e => f.handleChange('salary', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="45000" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Employment Type</label>
                <select value={f.values.employment_type} onChange={e => f.handleChange('employment_type', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
                  <option value="Full-time">Full-time</option>
                  <option value="Part-time">Part-time</option>
                  <option value="Contract">Contract</option>
                  <option value="Temporary">Temporary</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Reporting Manager</label>
                <input type="text" value={f.values.reporting_manager} onChange={e => f.handleChange('reporting_manager', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Dr. Kumar" />
              </div>
            </div>
            {f.values.role === 'teacher' && (
              <div className="pt-2">
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Subject(s) <span className="text-gray-400 font-normal">(e.g., Mathematics, Physics)</span></label>
                <input type="text" value={f.values.subject} onChange={e => f.handleChange('subject', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Science, Mathematics" />
              </div>
            )}
          </div>

          {/* Section 3: Personal & Address Details */}
          <div className="bg-gray-50/50 p-4 rounded-xl border border-gray-100 space-y-4">
            <h4 className="text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5 pb-2 border-b border-gray-100/80">
              <Users size={14} /> Personal & Address Details
            </h4>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Gender</label>
                <select value={f.values.gender} onChange={e => f.handleChange('gender', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] bg-white">
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Date of Birth</label>
                <input type="date" value={f.values.date_of_birth} onChange={e => f.handleChange('date_of_birth', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white text-gray-500" />
              </div>
            </div>
            <div>
              <label className="text-xs font-semibold text-gray-700 mb-1 block">Address</label>
              <input type="text" value={f.values.address} onChange={e => f.handleChange('address', e.target.value)}
                className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="123 Main St" />
            </div>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">City</label>
                <input type="text" value={f.values.city} onChange={e => f.handleChange('city', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Mumbai" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">State</label>
                <input type="text" value={f.values.state} onChange={e => f.handleChange('state', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="Maharashtra" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Country</label>
                <input type="text" value={f.values.country} onChange={e => f.handleChange('country', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="India" />
              </div>
              <div>
                <label className="text-xs font-semibold text-gray-700 mb-1 block">Postal Code</label>
                <input type="text" value={f.values.postal_code} onChange={e => f.handleChange('postal_code', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF] focus:ring-2 focus:ring-[rgba(109,76,255,0.05)] bg-white" placeholder="400001" />
              </div>
            </div>
          </div>

          <button type="button" onClick={async () => {
            if (creating) return;
            if (!f.values.full_name) { toast.error('Full Name is required'); return; }
            setCreating(true);
            try {
              const res = await staffApi.create(f.values);
              if (!res.success) { toast.error(res.error || 'Failed to create staff'); return; }
              const creds = res.data?.credentials || {};
              toast.success(`Staff created — Email: ${creds.email || f.values.email || res.data?.user?.email}, Password: ${creds.password || f.values.password}`);
              onCreated?.({ email: creds.email || f.values.email || res.data?.user?.email, password: creds.password || f.values.password });
              if (f.values.role === 'teacher' && res.data?.teacher?.id) {
                setCreatedTeacherId(res.data.teacher.id);
                classApi.getAll().then(r => { if (r.success && Array.isArray(r.data)) setClasses(r.data); });
                apiClient.get<any[]>(`/management/subjects/${orgId()}`).then(r => { if (r.success && Array.isArray(r.data)) setSubjects(r.data); });
              } else { onDone(); }
            } catch (err: any) { toast.error(err.message); } finally { setCreating(false); }
          }} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold hover:shadow-lg disabled:opacity-50 flex items-center justify-center gap-1.5 transition-all">
            {creating ? 'Creating...' : <>Add Staff Member</>}
          </button>
        </>
      ) : (
        <div className="p-4 bg-purple-50/50 rounded-xl border border-purple-100/50 space-y-4">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center text-purple-600">
              <Briefcase size={16} />
            </div>
            <div>
              <p className="text-xs font-bold text-purple-900">Assign Class & Subject</p>
              <p className="text-[10px] text-purple-500">Link the newly created teacher to their respective academic divisions</p>
            </div>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="text-xs font-semibold text-gray-700 mb-1 block">Class</label>
              <select value={selectedClassId} onChange={e => setSelectedClassId(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
                <option value="">Select Class</option>
                {classes.map((c: any) => <option key={c.id} value={c.id}>{c.name}{c.section ? ` - ${c.section}` : ''}</option>)}
              </select>
            </div>
            <div>
              <label className="text-xs font-semibold text-gray-700 mb-1 block">Subject</label>
              <select value={selectedSubjectId} onChange={e => setSelectedSubjectId(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
                <option value="">Select Subject</option>
                {subjects.map((s: any) => <option key={s.id} value={s.id}>{s.name}{s.code ? ` (${s.code})` : ''}</option>)}
              </select>
            </div>
          </div>
          <div className="flex gap-3 pt-2">
            <button type="button" onClick={() => onDone()} className="flex-1 py-2 rounded-lg border border-gray-200 text-gray-500 text-xs font-semibold hover:bg-gray-50 transition-all">Skip Assignment</button>
            <button type="button" onClick={async () => {
              if (!selectedClassId || !selectedSubjectId || assigning) return;
              setAssigning(true);
              try {
                const res = await apiClient.post(`/management/staff/${createdTeacherId}/assign-class`, { class_id: selectedClassId, subject_id: selectedSubjectId });
                if (res.success) { toast.success('Class & subject assigned!'); onDone(); }
                else toast.error(res.error || 'Assignment failed');
              } catch (err: any) { toast.error(err.message); } finally { setAssigning(false); }
            }} className="flex-1 py-2 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold hover:shadow-lg disabled:opacity-50 transition-all">
              {assigning ? 'Assigning...' : 'Assign & Done'}
            </button>
          </div>
        </div>
      )}
    </form>
  );
}

function ParentForm({ onDone, onCreated }: { onDone: () => void; onCreated?: (creds: { email: string; password: string }) => void }) {
  const f = useForm({ parent_name: '', parent_email: '', parent_password: '', student_id: '', relationship: 'guardian', phone: '' });
  const fields = [
    { key: 'parent_name' as const, label: 'Parent Name', type: 'text' },
    { key: 'parent_email' as const, label: 'Email', type: 'email' },
    { key: 'parent_password' as const, label: 'Password', type: 'password' },
    { key: 'phone' as const, label: 'Phone', type: 'tel' },
    { key: 'relationship' as const, label: 'Relationship', type: 'select', options: ['guardian', 'father', 'mother', 'other'] },
  ];
  const [creating, setCreating] = useState(false);
  const [ro, setRo] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  const [searchResults, setSearchResults] = useState<any[]>([]);
  const [selectedStudent, setSelectedStudent] = useState<any>(null);
  const [searching, setSearching] = useState(false);
  const searchTimer = useRef<any>(null);

  const doSearchStudent = async (term: string) => {
    if (term.length < 2) { setSearchResults([]); return; }
    setSearching(true);
    try {
      const res = await apiClient.get<any[]>(`/management/students/search/${orgId()}?q=${encodeURIComponent(term)}`);
      setSearchResults(res.success && Array.isArray(res.data) ? res.data : []);
    } catch { setSearchResults([]); }
    setSearching(false);
  };

  return (
    <form autoComplete="off" onSubmit={e => e.preventDefault()} className="space-y-4">
      {fields.map(field => (
        <div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
          {field.type === 'select' ? (
            <select value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)}
              className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white">
              {(field.options || []).map(o => <option key={o} value={o}>{o.charAt(0).toUpperCase() + o.slice(1)}</option>)}
            </select>
          ) : <input type={field.type} autoComplete={field.type === 'password' ? 'new-password' : 'off'} readOnly={field.type === 'password' || field.key.includes('email') ? ro : false} onFocus={() => setRo(false)} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] focus:ring-3 focus:ring-[rgba(109,76,255,0.1)]" />}
        </div>
      ))}
      <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Link to Student</label>
        <input type="text" placeholder="Search by name, roll number, or code..." value={searchTerm} onChange={e => { setSearchTerm(e.target.value); clearTimeout(searchTimer.current); searchTimer.current = setTimeout(() => doSearchStudent(e.target.value), 300); }} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />
        {searching && <p className="text-xs text-gray-400 mt-1">Searching...</p>}
        {selectedStudent && <p className="text-xs text-green-600 mt-1">Selected: {selectedStudent.full_name} ({selectedStudent.roll_number})</p>}
        {searchResults.length > 0 && <div className="max-h-40 overflow-y-auto border border-gray-100 rounded-lg mt-1">{searchResults.map((s: any) => (
          <button key={s.id} type="button" onClick={() => { setSelectedStudent(s); f.handleChange('student_id', s.id); setSearchResults([]); setSearchTerm(''); }} className={`w-full text-left px-3 py-2 text-xs hover:bg-gray-50 border-b border-gray-50 ${selectedStudent?.id === s.id ? 'bg-purple-50' : ''}`}>
            <span className="font-medium">{s.full_name}</span> — Roll: {s.roll_number || '—'}{s.student_class ? `, Class: ${s.student_class}` : ''}
          </button>
        ))}</div>}
      </div>
      <button type="button" onClick={async () => {
        if (creating) return;
        setCreating(true);
        try {
          const payload = { ...f.values, student_name: undefined };
          const res = await parentApi.create(payload);
          if (!res.success) { toast.error(res.error || 'Failed to create parent'); return; }
          const creds = res.data?.credentials || {};
          toast.success(`Parent created — Email: ${creds.email || f.values.parent_email}, Password: ${creds.password || f.values.parent_password}`);
          onCreated?.({ email: creds.email || f.values.parent_email, password: creds.password || f.values.parent_password });
          onDone();
        } catch (err: any) { toast.error(err.message); } finally { setCreating(false); }
      }} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold hover:shadow-lg disabled:opacity-50">{creating ? 'Creating...' : 'Create Parent'}</button>
    </form>
  );
}

function ExamForm({ onDone }: { onDone: () => void }) {
  const f = useForm({ title: '', type: 'midterm', date: '', total_marks: '' });
  return (
    <div className="space-y-4">
      {[
        { key: 'title' as const, label: 'Title', type: 'text' },
        { key: 'type' as const, label: 'Type', type: 'select', options: ['midterm', 'final', 'quiz', 'test', 'practical'] },
        { key: 'date' as const, label: 'Date', type: 'date' },
        { key: 'total_marks' as const, label: 'Total Marks', type: 'number' },
      ].map(field => (
        <div key={field.key}><label className="text-xs font-semibold text-gray-700 mb-1 block">{field.label}</label>
          {field.type === 'select' ? (
            <select value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)}
              className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF] bg-white">
              {(field.options || []).map(o => <option key={o} value={o}>{o.charAt(0).toUpperCase() + o.slice(1)}</option>)}
            </select>
          ) : <input type={field.type} value={f.values[field.key] as string} onChange={e => f.handleChange(field.key, e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" />}
        </div>
      ))}
      <button onClick={async () => {
        try { await examApi.create(f.values); toast.success('Exam created'); onDone(); } catch (err: any) { toast.error(err.message); }
      }} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold">Create Exam</button>
    </div>
  );
}

function FeeStructureForm({ onDone }: { onDone: () => void }) {
  const f = useForm({ name: '', class_name: '', total_amount: '' });
  return (
    <div className="space-y-4">
      {(['name', 'class_name', 'total_amount'] as const).map(field => (
        <div key={field}><label className="text-xs font-semibold text-gray-700 mb-1 block capitalize">{field.replace('_', ' ')}</label>
          <input type={field === 'total_amount' ? 'number' : 'text'} value={f.values[field] as string} onChange={e => f.handleChange(field, e.target.value)}
            className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-[#6D4CFF]" /></div>
      ))}
      <button onClick={async () => {
        try { await feeApi.createStructure(f.values); toast.success('Fee structure created'); onDone(); } catch (err: any) { toast.error(err.message); }
      }} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-sm font-semibold">Create Fee Structure</button>
    </div>
  );
}

// ======================== MAIN PAGE ========================
export default function ManagementPage() {
  const { t } = useLanguage();
  const { session, login: authLogin, logout: authLogout } = useAuth();
  const [form, setForm] = useState({ email: '', password: '' });
  const [message, setMessage] = useState('');
  const [messageType, setMessageType] = useState<'success' | 'error'>('success');
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [rememberMe, setRememberMe] = useState(false);
  const [loading, setLoading] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [searchQuery, setSearchQuery] = useState('');
  const [darkMode, setDarkMode] = useState(false);
  const [showNotifDropdown, setShowNotifDropdown] = useState(false);
  const [crudModal, setCrudModal] = useState<{ open: boolean; module: string }>({ open: false, module: '' });
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });

  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width - 0.5;
    const y = (e.clientY - rect.top) / rect.height - 0.5;
    setMousePos({ x, y });
  };

  const handleMouseLeave = () => {
    setMousePos({ x: 0, y: 0 });
  };

  const notifRef = useRef<HTMLDivElement>(null);

  const dash = useApi(() => dashboardApi.getStats(), []);
  const students = useApi(() => studentApi.getAll(), []);
  const staffList = useApi(() => staffApi.getAll(), []);
  const classList = useApi(() => classApi.getAll(), []);
  const subjectList = useApi(() => subjectApi.getAll(), []);
  const examList = useApi(() => examApi.getAll(), []);
  const feeStructures = useApi(() => feeApi.getStructures(), []);
  const academicReport = useApi(() => reportApi.getAcademic(), []);
  const attendanceReport = useApi(() => reportApi.getAttendance(), []);
  const feeReport = useApi(() => reportApi.getFee(), []);
  const aiPredictions = useApi(() => aiInsightApi.getPredictions(), []);
  const moduleConfigs = useApi(() => moduleConfigApi.getAll(), []);
  const riskAssessments = useApi(() => riskDetectionApi.analyzeAll(), []);
  const riskAlerts = useApi(() => riskDetectionApi.getAlerts(), []);
  const riskInsights = useApi(() => riskDetectionApi.getPredictiveInsights(), []);
  const teacherPerformance = useApi(() => teacherPerformanceApi.analyzeAll(), []);
  const teacherObservations = useApi(() => teacherPerformanceApi.getObservations(), []);
  const teacherReviews = useApi(() => teacherPerformanceApi.getReviews(), []);
  const teacherRetention = useApi(() => teacherPerformanceApi.getRetention(), []);
  const institutionIntelligence = useApi(() => institutionIntelligenceApi.getDashboard(), []);
  const esportsDash = useApi(() => esportsApi.getDashboard(), []);
  const esportsLeagues = useApi(() => esportsApi.getLeagues(), []);
  const esportsTeams = useApi(() => esportsApi.getTeams(), []);
  const esportsMatches = useApi(() => esportsApi.getMatches(), []);
  const esportsStreams = useApi(() => esportsApi.getStreams(), []);
  const esportsCurriculum = useApi(() => esportsApi.getCurriculum(), []);
  const collabDash = useApi(() => collaborationApi.getDashboard(), []);
  const collabClassrooms = useApi(() => collaborationApi.getClassrooms(), []);
  const collabProjects = useApi(() => collaborationApi.getProjects(), []);
  const collabDocs = useApi(() => collaborationApi.getDocuments(), []);
  const collabForums = useApi(() => collaborationApi.getForums(), []);
  const collabWhiteboards = useApi(() => collaborationApi.getWhiteboards(), []);
  const bioDash = useApi(() => biometricsApi.getDashboard(), []);
  const bioDevices = useApi(() => biometricsApi.getDevices(), []);
  const bioTemplates = useApi(() => biometricsApi.getTemplates(), []);
  const bioAttendance = useApi(() => biometricsApi.getAttendanceLogs(), []);
  const bioAssignments = useApi(() => biometricsApi.getAssignments(), []);
  const analyticsDash = useApi(() => analyticsApi.getDashboard(), []);
  const analyticsDashboards = useApi(() => analyticsApi.getDashboards(), []);
  const analyticsReports = useApi(() => analyticsApi.getReports(), []);
  const analyticsDataSources = useApi(() => analyticsApi.getDataSources(), []);
  const classDashData = useApi(() => classApiV2.getDashboard(), []);
  const classesV2 = useApi(() => classApiV2.getClasses(), []);
  const [notifList, setNotifList] = useState<any[]>([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const notifFetchId = useRef<ReturnType<typeof setInterval>>();

  useEffect(() => {
    const fetchNotifs = async () => {
      const [listRes, countRes] = await Promise.all([
        notificationApi.getV2(),
        notificationApi.getUnreadCount(),
      ]);
      if (listRes.success && listRes.data) {
        setNotifList(listRes.data.data || []);
        setUnreadCount(listRes.data.unread || 0);
      }
      if (countRes.success && countRes.data) {
        setUnreadCount(countRes.data.count || 0);
      }
    };
    fetchNotifs();
    notifFetchId.current = setInterval(fetchNotifs, 30000);
    return () => { if (notifFetchId.current) clearInterval(notifFetchId.current); };
  }, []);

  const userInitials = session?.user?.full_name?.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2) || 'A';
  const dashStats = dash.data?.stats || { totalStudents: 0, totalStaff: 0, totalClasses: 0 };
  const recentAnnouncements = dash.data?.recentAnnouncements || [];

  useEffect(() => {
    const handleClick = (e: MouseEvent) => {
      if (notifRef.current && !notifRef.current.contains(e.target as Node)) setShowNotifDropdown(false);
    };
    document.addEventListener('mousedown', handleClick);
    return () => document.removeEventListener('mousedown', handleClick);
  }, []);

  const handleSubmit = async () => {
    setError(null); setLoading(true);
    if (!form.email || !form.password) {
      setError('Please enter Email and Password.');
      setLoading(false);
      return;
    }
    try {
      const res = await apiClient.login(form.email, form.password);
      if (res.success && res.data) {
        authLogin(res.data.token, res.data.user, res.data.organisation);
      } else {
        setError(res.error || 'Login failed');
      }
    } catch (error: any) {
      setError(error.message || 'Login failed');
    } finally {
      setLoading(false);
    }
  };

  const logout = () => { authLogout(); setForm({ email: '', password: '' }); };
  const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

  const NavItem = ({ item, isActive }: { item: typeof navGroups[0]['items'][0]; isActive: boolean }) => {
    const Icon = item.icon;
    return (
      <button onClick={() => { setActiveTab(item.key); setSidebarOpen(false); }}
        className={`sidebar-item ${isActive ? 'active' : ''}`}>
        <Icon size={18} className="sidebar-item-icon" />
        <span>{item.label}</span>
      </button>
    );
  };

  if (!session) {
    return (
      <div className="flex h-dvh overflow-hidden bg-white">
        <div className="pointer-events-none fixed inset-0">
          <div className="absolute -top-96 -left-96 h-[800px] w-[800px] rounded-full bg-purple-500/5 blur-[150px]" />
          <div className="absolute -bottom-96 -right-96 h-[800px] w-[800px] rounded-full bg-purple-500/5 blur-[150px]" />
          <div className="absolute top-1/3 left-1/2 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-purple-500/3 blur-[120px]" />
        </div>

        <div className="relative flex w-full flex-col justify-center overflow-y-auto px-4 py-8 lg:w-1/2 lg:px-12">
          <div className="mx-auto w-full max-w-sm sm:max-w-md">
            <Link
              href="http://localhost:3000/signin"
              className="mb-4 inline-flex items-center gap-1.5 text-xs font-semibold text-[#64748B] transition hover:text-[#7C3AED]"
            >
              <ChevronLeft size={14} />
              Back to role selection
            </Link>

            <div className="mb-6 text-center lg:text-left">
              <div className="mb-3 inline-flex items-center gap-2 rounded-full border border-[#EDE9FE] bg-purple-50 px-3 py-1">
                <Shield size={11} className="text-purple-600" />
                <span className="text-[10px] font-bold text-purple-600">Management Portal</span>
              </div>
              <h1 className="text-2xl font-black text-[#0F172A] sm:text-3xl">Welcome Back</h1>
              <p className="mt-1.5 text-sm text-[#64748B]">Sign in to your management account to oversee school operations</p>
            </div>

            <div className="rounded-2xl border border-[#E2E8F0] bg-white p-5 shadow-sm sm:p-6">
              {error && (
                <motion.div initial={{ opacity: 0, y: -8 }} animate={{ opacity: 1, y: 0 }}
                  className="mb-3 flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-600">
                  <AlertCircle size={14} /> {error}
                </motion.div>
              )}
              <form className="space-y-3.5" onSubmit={(e) => { e.preventDefault(); handleSubmit(); }}>
                <div>
                  <label className="mb-1 block text-xs font-bold text-[#475569]">Email</label>
                  <input type="email" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })}
                    placeholder="Enter your email"
                    className="w-full rounded-xl border border-[#E2E8F0] bg-white px-3.5 py-2.5 text-sm text-[#0F172A] outline-none transition placeholder:text-[#94A3B8] focus:border-purple-500 focus:ring-2 focus:ring-purple-500/15" />
                </div>
                <div>
                  <label className="mb-1 block text-xs font-bold text-[#475569]">Password</label>
                  <div className="relative">
                    <input type={showPassword ? 'text' : 'password'} value={form.password}
                      onChange={e => setForm({ ...form, password: e.target.value })}
                      placeholder="Enter your password"
                      className="w-full rounded-xl border border-[#E2E8F0] bg-white px-3.5 py-2.5 pr-10 text-sm text-[#0F172A] outline-none transition placeholder:text-[#94A3B8] focus:border-purple-500 focus:ring-2 focus:ring-purple-500/15" />
                    <button type="button" onClick={() => setShowPassword(!showPassword)}
                      className="absolute right-3 top-1/2 -translate-y-1/2 text-[#94A3B8] hover:text-[#475569] transition-colors">
                      {showPassword ? <EyeOff size={16} /> : <Eye size={16} />}
                    </button>
                  </div>
                </div>
                <div className="flex items-center justify-between">
                  <label className="flex cursor-pointer items-center gap-2">
                    <input type="checkbox" checked={rememberMe} onChange={() => setRememberMe(!rememberMe)}
                      className="h-4 w-4 rounded border-[#CBD5E1] text-purple-600 focus:ring-purple-500" />
                    <span className="text-xs font-semibold text-[#475569]">Remember me</span>
                  </label>
                  <button type="button" className="text-xs font-bold text-purple-600 transition hover:text-purple-700 hover:underline">
                    Forgot Password?
                  </button>
                </div>
                <motion.button type="submit" disabled={loading}
                  whileTap={{ scale: loading ? 1 : 0.98 }}
                  className="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-purple-600 to-purple-700 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-purple-500/25 transition hover:from-purple-700 hover:to-purple-800 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60">
                  {loading ? <Loader2 size={16} className="animate-spin" /> : <><ArrowRight size={16} /> Sign In</>}
                </motion.button>
              </form>
            </div>

            <div className="mt-4 text-center">
              <button type="button" onClick={() => window.location.href = 'mailto:support@prasunet.com'}
                className="text-xs font-semibold text-[#64748B] transition hover:text-purple-600">
                Need help? Contact Support
              </button>
            </div>

            <div className="mt-4 flex items-center justify-center gap-4 text-[10px] text-[#94A3B8]">
              <span className="flex items-center gap-1"><Lock size={11} /> SSL Secured</span>
              <span className="flex items-center gap-1"><Shield size={11} /> 256-bit Encrypted</span>
            </div>

            <div className="mt-6 text-center">
              <span className="text-[9px] font-medium tracking-wider text-[#CBD5E1] uppercase">Powered by Prerana AI</span>
            </div>
          </div>
        </div>

        <motion.div
          initial={{ opacity: 0, x: 30 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ duration: 0.5, delay: 0.1 }}
          className="relative hidden lg:flex lg:w-1/2 items-center justify-center"
        >
          <div className="absolute inset-0 bg-gradient-to-br from-purple-500/5 via-transparent to-purple-500/5" />
          <img src="/adminlogin.png" alt="Management Portal" className="h-full w-full object-contain p-8" />
        </motion.div>
      </div>
    );
  }

  // ====================== DASHBOARD ======================
  const renderDashboard = () => (
    <div>
      <div className="hero-section relative overflow-hidden rounded-3xl p-5 sm:p-6 md:p-8 xl:p-10 mb-8 border border-white/10 shadow-[0_20px_50px_rgba(109,76,255,0.2)] min-h-[320px] sm:min-h-[360px] md:min-h-[400px]">
        {/* Premium mesh gradient + floating particles */}
        <div className="absolute inset-0 z-0 overflow-hidden pointer-events-none">
          <div className="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#A855F7]/15 rounded-full blur-[120px]" />
          <div className="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-[#3B82F6]/15 rounded-full blur-[120px]" />
          <div className="absolute top-[40%] left-[60%] w-[30%] h-[30%] bg-[#EC4899]/8 rounded-full blur-[100px]" />
          {[...Array(8)].map((_, i) => (
            <motion.div
              key={i}
              animate={{ opacity: [0.1, 0.45, 0.1], y: [0, -(8 + (i % 3) * 6), 0], x: [0, (i % 2 === 0 ? 6 : -6), 0] }}
              transition={{ duration: 3 + (i % 4) * 1.5, repeat: Infinity, ease: 'easeInOut', delay: i * 0.5 }}
              className="absolute rounded-full bg-white/30 pointer-events-none"
              style={{
                width: `${1.5 + (i % 3) * 1.5}px`,
                height: `${1.5 + (i % 3) * 1.5}px`,
                top: `${12 + (i * 11) % 76}%`,
                left: `${8 + (i * 14) % 84}%`,
              }}
            />
          ))}
        </div>

        <div className="relative z-10 w-full grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-center">
          {/* Left Side Content */}
          <div className="md:col-span-7 xl:col-span-8 flex flex-col justify-center text-left">
            <div className="hero-label text-[9px] sm:text-[10px] tracking-[0.2em] font-semibold text-white/70 uppercase mb-1">
              School Operating System
            </div>
            <h1 className="hero-title text-xl sm:text-2xl md:text-3xl xl:text-4xl font-extrabold text-white mb-1.5 sm:mb-2 leading-tight tracking-tight">
              Prasunet ERP
            </h1>
            <p className="hero-desc text-[11px] sm:text-xs md:text-sm text-white/80 max-w-2xl leading-relaxed mb-3 sm:mb-4">
              Manage students, staff, parents, academics, attendance, examinations, finance, transportation, and school operations from one intelligent platform.
            </p>

            {/* Intelligent ERP Summary - single dynamic sentence replacing stat cards */}
            <div className="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 sm:mb-4 py-2.5 sm:py-3 border-t border-b border-white/10">
              {(() => {
                const parts: string[] = [];
                const s = dashStats.totalStudents;
                const st = dashStats.totalStaff;
                const c = dashStats.totalClasses;
                const att = attendanceReport.data?.average;
                if (s > 0) parts.push(`${s} active student${s !== 1 ? 's' : ''}`);
                if (st > 0) parts.push(`${st} staff member${st !== 1 ? 's' : ''}`);
                if (c > 0) parts.push(`${c} running class${c !== 1 ? 'es' : ''}`);
                if (parts.length === 0) return <span className="text-white/60">Your school management system is ready. Start by adding students and staff.</span>;
                const summary = parts.slice(0, -1).join(', ') + (parts.length > 1 ? ' and ' : '') + parts.slice(-1);
                return <>Today, your school has <strong className="text-white">{summary}</strong>{att ? `, with <strong className="text-white">${att}%</strong> average attendance` : ''}. All systems are functioning normally.</>;
              })()}
            </div>

            {/* Pill-style Quick Actions */}
            <div className="flex flex-wrap gap-2 sm:gap-2.5 mb-2">
              <button onClick={() => setActiveTab('students')} className="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 text-white text-[11px] sm:text-xs font-semibold transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.97] backdrop-blur-sm whitespace-nowrap group">
                <div className="p-0.5 rounded bg-[#22C55E]/20 text-[#22C55E] group-hover:scale-110 transition-transform"><Plus size={11} /></div>
                Add Student
              </button>
              <button onClick={() => setActiveTab('attendance')} className="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 text-white text-[11px] sm:text-xs font-semibold transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.97] backdrop-blur-sm whitespace-nowrap group">
                <div className="p-0.5 rounded bg-[#F59E0B]/20 text-[#F59E0B] group-hover:scale-110 transition-transform"><ClipboardList size={11} /></div>
                Take Attendance
              </button>
              <button onClick={() => setActiveTab('events')} className="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 text-white text-[11px] sm:text-xs font-semibold transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.97] backdrop-blur-sm whitespace-nowrap group">
                <div className="p-0.5 rounded bg-[#A855F7]/20 text-[#A855F7] group-hover:scale-110 transition-transform"><Megaphone size={11} /></div>
                Announce
              </button>
              <button onClick={() => setActiveTab('reports')} className="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 text-white text-[11px] sm:text-xs font-semibold transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.97] backdrop-blur-sm whitespace-nowrap group">
                <div className="p-0.5 rounded bg-[#EF4444]/20 text-[#EF4444] group-hover:scale-110 transition-transform"><FileText size={11} /></div>
                View Reports
              </button>
            </div>

            {/* Compact stat badges (replaces large cards on mobile) */}
            <div className="flex flex-wrap gap-1.5 sm:gap-2 mt-2 sm:mt-3">
              <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/8 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] text-white/70 font-medium">
                <GraduationCap size={10} className="text-blue-300" /> {dashStats.totalStudents} students
              </span>
              <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/8 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] text-white/70 font-medium">
                <Users size={10} className="text-green-300" /> {dashStats.totalStaff} staff
              </span>
              <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/8 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] text-white/70 font-medium">
                <School size={10} className="text-purple-300" /> {dashStats.totalClasses} classes
              </span>
              <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/8 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] text-white/70 font-medium">
                <ClipboardList size={10} className="text-amber-300" /> {attendanceReport.data?.average ? `${attendanceReport.data.average}%` : '—'} attendance
              </span>
            </div>
          </div>

          {/* Right Side - ERP Illustration (moves below on mobile) */}
          <div className="md:col-span-5 xl:col-span-4 relative flex items-center justify-center md:justify-end mt-2 md:mt-0">
            {/* Soft purple-blue radial glow */}
            <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200px] h-[200px] sm:w-[240px] sm:h-[240px] md:w-[280px] md:h-[280px] bg-gradient-to-tr from-[#6D4CFF] to-[#3B82F6] rounded-full blur-[60px] opacity-30 sm:opacity-40 mix-blend-screen pointer-events-none" />

            {/* Floating education icons - hidden on very small screens */}
            <div className="absolute inset-0 pointer-events-none overflow-visible max-sm:hidden">
              <motion.div animate={{ y: [0, -10, 0], opacity: [0.4, 0.7, 0.4] }} transition={{ repeat: Infinity, duration: 3.5, ease: 'easeInOut', delay: 0 }} className="absolute top-[12%] right-[15%] w-2 h-2 rounded-full bg-[#A855F7]/60 blur-[1px]" />
              <motion.div animate={{ y: [0, -8, 0], opacity: [0.3, 0.6, 0.3] }} transition={{ repeat: Infinity, duration: 4, ease: 'easeInOut', delay: 0.5 }} className="absolute bottom-[18%] right-[8%] w-1.5 h-1.5 rounded-full bg-[#3B82F6]/60 blur-[1px]" />
              <motion.div animate={{ y: [0, -12, 0], opacity: [0.35, 0.65, 0.35] }} transition={{ repeat: Infinity, duration: 4.5, ease: 'easeInOut', delay: 1 }} className="absolute top-[35%] left-[5%] w-2 h-2 rounded-full bg-[#22C55E]/50 blur-[1px]" />
              <motion.div animate={{ y: [0, -6, 0], opacity: [0.25, 0.55, 0.25] }} transition={{ repeat: Infinity, duration: 3, ease: 'easeInOut', delay: 1.5 }} className="absolute top-[60%] left-[10%] w-1.5 h-1.5 rounded-full bg-[#F59E0B]/50 blur-[1px]" />
            </div>

            {/* ERP sticker - 15% larger, floating animation, parallax */}
            <motion.div
              className="relative select-none pointer-events-none z-10 flex items-center justify-center"
              style={{ x: mousePos.x * 15, y: mousePos.y * 15 }}
              animate={{ y: [0, -8, 0] }}
              transition={{ duration: 4, repeat: Infinity, ease: 'easeInOut' }}
            >
              <img
                src="/erp-sticker.png"
                alt="Prasunet ERP"
                className="w-[180px] xs:w-[230px] sm:w-[276px] md:w-[322px] lg:w-[414px] xl:w-[506px] h-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.3)] transition-all"
              />
            </motion.div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {[
          { title: 'Students at Risk', value: (aiPredictions.data || []).filter((p: any) => p.risk_level === 'high').length.toString() || '0', desc: 'Attendance below 70%', color: CLR.danger, icon: AlertTriangle },
          { title: 'Total Predictions', value: (aiPredictions.data?.length || 0).toString(), desc: 'AI-generated insights', color: CLR.info, icon: Brain },
          { title: 'Total Students', value: dashStats.totalStudents.toString(), desc: 'Enrolled this term', color: CLR.success, icon: Award },
          { title: 'Staff Ratio', value: dashStats.totalStaff > 0 ? `${Math.round((dashStats.totalStudents / dashStats.totalStaff) * 10) / 10}:1` : '—', desc: 'Student-to-staff ratio', color: CLR.primary, icon: TrendingUp },
        ].map((insight, i) => {
          const Icon = insight.icon;
          return (
            <motion.div key={i} initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.05 * i }}
              className="ai-card" style={{ background: `${insight.color}08`, borderColor: `${insight.color}20` }}>
              <div className="flex items-start justify-between mb-3">
                <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ background: `${insight.color}15`, color: insight.color }}><Icon size={20} /></div>
                <Badge variant={['danger', 'info', 'success', 'info'][i] as any} className="text-[9px]">AI</Badge>
              </div>
              <div className="text-2xl font-extrabold" style={{ color: insight.color }}>{insight.value}</div>
              <div className="text-xs text-gray-500 font-medium mt-1">{insight.title}</div>
              <div className="text-[10px] text-gray-400 mt-0.5">{insight.desc}</div>
            </motion.div>
          );
        })}
      </div>

      {recentAnnouncements.length > 0 && (
        <Card className="p-4 mb-8 bg-gradient-to-r from-[#F3F0FF] to-white border-[#6D4CFF]/10">
          <div className="flex items-center gap-3 flex-wrap">
            <div className="w-8 h-8 rounded-lg bg-[#6D4CFF] flex items-center justify-center"><Sparkles size={16} className="text-white" /></div>
            <span className="text-sm font-bold">Recent Announcements</span>
            <div className="flex gap-2 flex-wrap">
              {recentAnnouncements.slice(0, 4).map((a: any, i: number) => (
                <Badge key={i} className="text-[9px] cursor-pointer bg-white border border-gray-200 text-gray-700 hover:bg-gray-50">
                  {a.title || `Update ${i + 1}`}
                </Badge>
              ))}
            </div>
          </div>
        </Card>
      )}

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
        <KpiCard icon={GraduationCap} label="Total Students" value={dashStats.totalStudents.toLocaleString()} trend="Live" color={CLR.primary} bg="#F3F0FF" chart={[40,55,48,62,58,70,65,78,72,85,80,92]} />
        <KpiCard icon={Users} label="Total Staff" value={dashStats.totalStaff.toString()} trend="Live" color={CLR.success} bg="#F0FDF4" chart={[25,30,28,35,32,38,36,40,38,42,40,45]} />
        <KpiCard icon={School} label="Total Classes" value={dashStats.totalClasses.toString()} trend="Live" color={CLR.info} bg="#EFF6FF" chart={[30,38,35,45,42,50,48,55,52,60,58,65]} />
        <KpiCard icon={DollarSign} label="Fee Collection" value={feeReport.data?.totalCollected ? `$${(feeReport.data.totalCollected / 1000).toFixed(1)}K` : '—'} trend={feeReport.data?.collectionRate ? `${feeReport.data.collectionRate}%` : '—'} color={CLR.secondary} bg="#F5F3FF" chart={[60,68,65,75,72,80,78,85,82,90,88,95]} />
        <KpiCard icon={CalendarDays} label="Attendance" value={attendanceReport.data?.average ? `${attendanceReport.data.average}%` : '—'} trend="Live" color={CLR.warning} bg="#FFFBEB" chart={[82,85,83,88,86,90,89,92,91,94,93,95]} />
        <KpiCard icon={Award} label="Academic Avg" value={academicReport.data?.averageScore ? `${academicReport.data.averageScore}%` : '—'} trend="Live" color={CLR.danger} bg="#FEF2F2" chart={[72,75,74,80,78,84,82,86,85,88,87,90]} />
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">
        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <div><h3 className="text-sm font-bold">Students Per Class</h3><p className="text-[10px] text-gray-400">Distribution across classes</p></div>
            <Badge variant="info" className="text-[9px]">{classList.data?.length || 0} Classes</Badge>
          </div>
          <div className="h-60">
            {classList.loading ? <LoadingSkeleton rows={3} cols={1} /> : classList.error ? <ErrorState message={classList.error} onRetry={classList.refetch} /> : (
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={(classList.data || []).slice(0, 12)}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#F1F5F9" />
                  <XAxis dataKey="name" tick={{ fontSize: 10 }} axisLine={false} tickLine={false} />
                  <YAxis tick={{ fontSize: 10 }} axisLine={false} tickLine={false} />
                  <Tooltip contentStyle={{ borderRadius: 12, border: '1px solid #F1F5F9' }} />
                  <Bar dataKey="capacity" fill="#6D4CFF" radius={[4, 4, 0, 0]} name="Capacity" />
                </BarChart>
              </ResponsiveContainer>
            )}
          </div>
        </Card>
        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <div><h3 className="text-sm font-bold">Staff by Role</h3><p className="text-[10px] text-gray-400">Distribution across roles</p></div>
            <Badge variant="success" className="text-[9px]">{staffList.data?.length || 0} Staff</Badge>
          </div>
          <div className="h-60 flex items-center justify-center">
            {staffList.loading ? <LoadingSkeleton rows={3} cols={1} /> : staffList.error ? <ErrorState message={staffList.error} onRetry={staffList.refetch} /> : (
              <ResponsiveContainer width="100%" height="100%">
                <RePieChart>
                  <Pie data={Object.entries((staffList.data || []).reduce((acc: Record<string, number>, s: any) => { const r = s.role || 'staff'; acc[r] = (acc[r] || 0) + 1; return acc; }, {})).map(([name, value]) => ({ name, value }))}
                    cx="50%" cy="50%" innerRadius={50} outerRadius={90} dataKey="value" label={({ name, value }: any) => `${name}: ${value}`}>
                    {[['teacher','#6D4CFF'],['admin','#22C55E'],['accountant','#F59E0B'],['librarian','#3B82F6'],['transport_manager','#A855F7'],['hostel_warden','#EF4444']].map(([key, color]) => (
                      <Cell key={key} fill={color} />
                    ))}
                  </Pie>
                  <Tooltip />
                </RePieChart>
              </ResponsiveContainer>
            )}
          </div>
        </Card>
      </div>

      <h2 className="text-base font-extrabold mb-4">Management Hub</h2>
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {[
          { icon: Users, label: 'Staff Management', desc: `${dashStats.totalStaff} staff members`, color: CLR.primary, bg: '#F3F0FF', count: dashStats.totalStaff.toString(), key: 'staff' },
          { icon: GraduationCap, label: 'Student Records', desc: `${dashStats.totalStudents} enrolled`, color: CLR.success, bg: '#F0FDF4', count: dashStats.totalStudents.toString(), key: 'students' },
          { icon: School, label: 'Class Management', desc: `${dashStats.totalClasses} active classes`, color: CLR.secondary, bg: '#F5F3FF', count: dashStats.totalClasses.toString(), key: 'classes' },
          { icon: DollarSign, label: 'Fee Management', desc: feeReport.data?.totalCollected ? `$${(feeReport.data.totalCollected / 1000).toFixed(1)}K collected` : 'Manage fees', color: CLR.warning, bg: '#FFFBEB', count: feeReport.data?.totalCollected ? `$${(feeReport.data.totalCollected / 1000).toFixed(1)}K` : '$—', key: 'fees' },
          { icon: CalendarDays, label: 'Timetable', desc: `${subjectList.data?.length || 0} subjects`, color: CLR.accent, bg: '#FAF5FF', count: subjectList.data?.length.toString() || '0', key: 'timetable' },
          { icon: ClipboardList, label: 'Attendance', desc: attendanceReport.data?.average ? `${attendanceReport.data.average}% average` : 'Track attendance', color: CLR.warning, bg: '#FFFBEB', count: attendanceReport.data?.average ? `${attendanceReport.data.average}%` : '—', key: 'attendance' },
          { icon: FileText, label: 'Examinations', desc: `${examList.data?.length || 0} exams planned`, color: CLR.danger, bg: '#FEF2F2', count: (examList.data?.length || 0).toString(), key: 'exams' },
          { icon: Users, label: 'Parent Engagement', desc: `${Math.round(dashStats.totalStudents * 0.7)} registered`, color: CLR.info, bg: '#EFF6FF', count: Math.round(dashStats.totalStudents * 0.7).toLocaleString(), key: 'parents' },
          { icon: Bus, label: 'Transport', desc: 'Route & vehicle mgmt', color: '#0EA5E9', bg: '#F0F9FF', count: '—', key: 'transport' },
          { icon: Building2, label: 'Hostel', desc: 'Room management', color: '#8B5CF6', bg: '#F5F3FF', count: '—', key: 'hostel' },
          { icon: Heart, label: 'Health Center', desc: 'Student wellness', color: CLR.danger, bg: '#FEF2F2', count: '—', key: 'health' },
          { icon: Trophy, label: 'Gamification', desc: 'Engagement system', color: CLR.warning, bg: '#FFFBEB', count: '—', key: 'gamification' },
        ].map((hub, i) => {
          const Icon = hub.icon;
          return (
            <motion.div key={i} initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.02 * i }}
              className="module-card" onClick={() => setActiveTab(hub.key)}>
              <div className="flex items-start justify-between mb-3">
                <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ background: hub.bg, color: hub.color }}><Icon size={20} /></div>
                <Badge variant="default" className="text-[9px] font-bold">{hub.count}</Badge>
              </div>
              <div className="text-sm font-bold mb-0.5">{hub.label}</div>
              <div className="text-[11px] text-gray-400">{hub.desc}</div>
            </motion.div>
          );
        })}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <Card className="p-5 lg:col-span-2">
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-sm font-bold">Recent Announcements</h3>
            <button className="text-[#6D4CFF] text-[10px] font-semibold hover:underline" onClick={() => setActiveTab('events')}>View all</button>
          </div>
          {recentAnnouncements.length === 0 ? (
            <EmptyState message="No announcements yet" />
          ) : (
            <div className="space-y-2">{recentAnnouncements.map((a: any, i: number) => (
              <div key={i} className="flex items-center gap-3 p-3 rounded-xl bg-gray-50 border border-gray-100">
                <div className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 bg-[#F3F0FF] text-[#6D4CFF]"><Megaphone size={16} /></div>
                <div className="flex-1 min-w-0">
                  <div className="text-xs font-semibold truncate">{a.title || 'Announcement'}</div>
                  <div className="text-[10px] text-gray-400">{new Date(a.created_at).toLocaleDateString()}</div>
                </div>
              </div>
            ))}</div>
          )}
        </Card>
        <Card className="p-5">
          <h3 className="text-sm font-bold mb-4">Quick Actions</h3>
          <div className="grid grid-cols-2 gap-2">
            {[
              { icon: UserPlus, label: 'Add Staff', color: CLR.primary, key: 'staff' },
              { icon: GraduationCap, label: 'Add Student', color: CLR.success, key: 'students' },
              { icon: FileText, label: 'New Exam', color: CLR.warning, key: 'exams' },
              { icon: DollarSign, label: 'Fee Entry', color: CLR.info, key: 'fees' },
              { icon: Bus, label: 'Route', color: '#8B5CF6', key: 'transport' },
              { icon: MessageSquare, label: 'Announce', color: CLR.accent, key: 'events' },
              { icon: Trophy, label: 'Badge', color: '#F59E0B', key: 'gamification' },
              { icon: ClipboardList, label: 'Report', color: CLR.danger, key: 'reports' },
            ].map((action, i) => {
              const Icon = action.icon;
              return (
                <button key={i} onClick={() => setActiveTab(action.key)}
                  className="flex flex-col items-center gap-1.5 p-2.5 rounded-xl bg-gray-50 border border-gray-100 hover:bg-white hover:shadow-md hover:-translate-y-0.5 transition-all">
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ background: `${action.color}15`, color: action.color }}><Icon size={15} /></div>
                  <span className="text-[9px] font-semibold text-gray-600">{action.label}</span>
                </button>
              );
            })}
          </div>
        </Card>
      </div>
    </div>
  );

  const renderBulkImportDashboard = () => (
    <div>
      <div className="page-header">
        <h1>Bulk Import</h1>
        <p>Import multiple records at once using CSV files. Choose a category below.</p>
      </div>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { key: 'students', icon: GraduationCap, title: 'Students', desc: 'Import student records with class, section, and parent contact info', color: CLR.info },
          { key: 'staff', icon: Users, title: 'Staff', desc: 'Import teachers and support staff with roles and subjects', color: CLR.primary },
          { key: 'parents', icon: UserCheck, title: 'Parents', desc: 'Import parent records and link them to students', color: CLR.success },
        ].map(card => {
          const Icon = card.icon;
          return (
            <Card key={card.key} className="p-6 cursor-pointer hover:shadow-lg hover:-translate-y-0.5 transition-all"
              onClick={() => setActiveTab(card.key)}>
              <div className="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={{ background: `${card.color}15`, color: card.color }}>
                <Icon size={22} />
              </div>
              <h3 className="text-sm font-bold mb-1">{card.title}</h3>
              <p className="text-xs text-gray-400">{card.desc}</p>
              <div className="mt-4 flex items-center gap-1 text-xs font-semibold" style={{ color: card.color }}>
                Import <Upload size={12} />
              </div>
            </Card>
          );
        })}
      </div>
      <Card className="p-6 mt-6">
        <h3 className="text-sm font-bold mb-3">CSV Format Guidelines</h3>
        <div className="space-y-3 text-xs text-gray-600">
          <p>- First row must be column headers matching the field names</p>
          <p>- <strong>Students:</strong> full_name, roll_number, student_class, section, phone, parent_email, parent_phone</p>
          <p>- <strong>Staff:</strong> full_name, email, password, role, subject, phone</p>
          <p>- <strong>Parents:</strong> parent_name, parent_email, parent_phone, student_name, relationship, parent_password</p>
          <p>- Navigate to each section above to upload and import</p>
        </div>
      </Card>
    </div>
  );

  const AttendanceTab = () => {
    const [activeTab, setActiveTab] = useState<'overview' | 'student' | 'daily' | 'subject' | 'monthly' | 'analytics' | 'reports' | 'ai'>('overview');
    const [selectedClass, setSelectedClass] = useState('');
    const [selectedSection, setSelectedSection] = useState('');
    const [selectedSubject, setSelectedSubject] = useState('');
    const [selectedTeacher, setSelectedTeacher] = useState('');
    const [selectedStatus, setSelectedStatus] = useState('');
    const [attendanceDate, setAttendanceDate] = useState(new Date().toISOString().split('T')[0]);
    const [searchQuery, setSearchQuery] = useState('');
    const [fromDate, setFromDate] = useState(new Date(new Date().setMonth(new Date().getMonth() - 1)).toISOString().split('T')[0]);
    const [toDate, setToDate] = useState(new Date().toISOString().split('T')[0]);
    const [reportType, setReportType] = useState('daily');
    const [saving, setSaving] = useState(false);
    const [modalOpen, setModalOpen] = useState(false);
    const [markForm, setMarkForm] = useState<any>({ student_id: '', date: attendanceDate, status: 'present', check_in: '', check_out: '', remarks: '', leave_reason: '' });
    const [bulkRecords, setBulkRecords] = useState<Record<string, string>>({});
    const [selectedStudents, setSelectedStudents] = useState<Set<string>>(new Set());
    const [page, setPage] = useState(1);

    const dashboard = useApi(() => attendanceApiV2.getDashboard(attendanceDate), [attendanceDate]);
    const studentsList = useApi(() => attendanceApiV2.getStudents({ class_id: selectedClass, section: selectedSection, search: searchQuery }), [selectedClass, selectedSection, searchQuery]);
    const attendanceRecords = useApi(() => attendanceApiV2.getRecords({
      class_id: selectedClass || undefined, section: selectedSection || undefined,
      subject_id: selectedSubject || undefined, teacher_id: selectedTeacher || undefined,
      date: activeTab === 'daily' ? attendanceDate : undefined,
      from: activeTab === 'monthly' || activeTab === 'reports' || activeTab === 'analytics' ? fromDate : undefined,
      to: activeTab === 'monthly' || activeTab === 'reports' || activeTab === 'analytics' ? toDate : undefined,
      status: selectedStatus || undefined,
      search: searchQuery || undefined, page, limit: 50,
    }), [selectedClass, selectedSection, selectedSubject, selectedTeacher, selectedStatus, attendanceDate, fromDate, toDate, searchQuery, page, activeTab]);
    const dailySummary = useApi(() => attendanceApiV2.getDailySummary(attendanceDate), [attendanceDate]);
    const analytics = useApi(() => attendanceApiV2.getAnalytics({ from: fromDate, to: toDate, class_id: selectedClass || undefined }), [fromDate, toDate, selectedClass]);
    const riskFlags = useApi(() => attendanceApiV2.getRiskFlags(), []);
    const aiInsights = useApi(() => attendanceApiV2.getAiInsights(), []);
    const reports = useApi(() => attendanceApiV2.getReports({ type: reportType, from: fromDate, to: toDate, class_id: selectedClass || undefined }), [reportType, fromDate, toDate, selectedClass]);
    const settings = useApi(() => attendanceApiV2.getSettings(), []);

    const cls = classList;
    const ds = dashboard.data?.summary || {};
    const trend = dashboard.data?.trend || {};
    const todaySum = dailySummary.data;

    const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const STATUS_COLORS: Record<string, string> = { present: '#22C55E', absent: '#EF4444', late: '#F59E0B', half_day: '#3B82F6', medical_leave: '#8B5CF6', approved_leave: '#EC4899' };
    const STATUS_LABELS: Record<string, string> = { present: 'Present', absent: 'Absent', late: 'Late', half_day: 'Half Day', medical_leave: 'Medical Leave', approved_leave: 'Approved Leave' };

    const tabs = [
      { key: 'student', label: 'Student Attendance', icon: Users },
      { key: 'daily', label: 'Daily Attendance', icon: CalendarDays },
      { key: 'subject', label: 'Subject Attendance', icon: BookOpen },
      { key: 'monthly', label: 'Monthly Report', icon: BarChart3 },
      { key: 'analytics', label: 'Analytics', icon: TrendingUp },
      { key: 'reports', label: 'Reports', icon: FileText },
      { key: 'ai', label: 'AI Insights', icon: Brain },
    ];

    const resetFilters = () => { setSelectedClass(''); setSelectedSection(''); setSelectedSubject(''); setSelectedTeacher(''); setSelectedStatus(''); setSearchQuery(''); setPage(1); };
    const openMarkModal = (student?: any) => {
      setMarkForm({ student_id: student?.id || '', date: attendanceDate, status: 'present', check_in: '', check_out: '', remarks: '', leave_reason: '' });
      setModalOpen(true);
    };
    const handleMarkAttendance = async () => {
      if (!markForm.student_id) { toast.error('Select a student'); return; }
      setSaving(true);
      const res = await attendanceApiV2.markAttendance(markForm);
      if (res.success) { toast.success('Attendance marked'); setModalOpen(false); attendanceRecords.refetch(); dashboard.refetch(); dailySummary.refetch(); }
      else toast.error(res.error || 'Failed');
      setSaving(false);
    };
    const handleBulkMarkAll = async (status: string) => {
      const records = (studentsList.data || []).map((s: any) => ({ student_id: s.id, status, check_in: '', check_out: '' }));
      if (records.length === 0) { toast.error('No students'); return; }
      setSaving(true);
      const res = await attendanceApiV2.bulkMark({ date: attendanceDate, class_id: selectedClass, records });
      if (res.success) { toast.success(`${res.data?.length || records.length} marked ${status}`); attendanceRecords.refetch(); dashboard.refetch(); dailySummary.refetch(); }
      else toast.error(res.error || 'Failed');
      setSaving(false);
    };
    const handleBulkSelected = async (status: string) => {
      const records = Array.from(selectedStudents).map(id => ({ student_id: id, status }));
      if (records.length === 0) { toast.error('Select students first'); return; }
      setSaving(true);
      const res = await attendanceApiV2.bulkMark({ date: attendanceDate, class_id: selectedClass, records });
      if (res.success) { toast.success(`${records.length} marked ${status}`); setSelectedStudents(new Set()); attendanceRecords.refetch(); dashboard.refetch(); dailySummary.refetch(); }
      else toast.error(res.error || 'Failed');
      setSaving(false);
    };
    const toggleStudent = (id: string) => {
      setSelectedStudents(prev => { const n = new Set(prev); if (n.has(id)) n.delete(id); else n.add(id); return n; });
    };

    const getStatusBadge = (status: string) => {
      const c = STATUS_COLORS[status] || '#6B7280';
      return <Badge className="text-[9px] px-2 py-0.5" style={{ background: `${c}15`, color: c }}>{STATUS_LABELS[status] || status}</Badge>;
    };
    const miniSparkline = (data: number[]) => (
      <div className="flex items-end gap-[1px] h-6">
        {data.slice(-7).map((v, i) => (
          <div key={i} className="w-2 rounded-sm" style={{ height: `${Math.max(v * 5, 2)}px`, background: '#7C3AED35' }} />
        ))}
      </div>
    );

    const renderDashboard = () => (
      <>
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
          <KpiCard icon={Users} label="Total Students" value={ds.totalStudents} color="#7C3AED" bg="#7C3AED15" />
          <KpiCard icon={CheckCircle2} label="Present Today" value={ds.presentToday} trend={`${trend.present || 0}%`} color="#22C55E" bg="#22C55E15" chart={[40, 60, 50, 70, ds.presentToday]} />
          <KpiCard icon={X} label="Absent Today" value={ds.absentToday} color="#EF4444" bg="#EF444415" chart={[30, 20, ds.absentToday]} />
          <KpiCard icon={Clock} label="Late Today" value={ds.lateToday} trend={`${trend.late || 0}%`} color="#F59E0B" bg="#F59E0B15" />
          <KpiCard icon={Sun} label="Half Day" value={ds.halfDayToday} color="#3B82F6" bg="#3B82F615" />
          <KpiCard icon={BarChart3} label="Monthly %" value={`${ds.monthlyAttendancePct || 0}%`} trend={trend.monthly ? `${trend.monthly}%` : undefined} color="#8B5CF6" bg="#8B5CF615" />
          <KpiCard icon={AlertTriangle} label="At-Risk" value={ds.atRiskStudents} color={ds.atRiskStudents > 5 ? '#EF4444' : '#F59E0B'} bg="#EF444415" />
          <KpiCard icon={Award} label="Compliance" value={`${ds.complianceScore || 0}%`} color={ds.complianceScore >= 80 ? '#22C55E' : '#F59E0B'} bg="#22C55E15" />
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
          <Card className="p-4 lg:col-span-2">
            <h3 className="font-bold text-xs mb-3">Today's Summary by Class</h3>
            {dailySummary.loading ? <LoadingSkeleton rows={3} cols={5} /> : dailySummary.error ? <ErrorState message={dailySummary.error} onRetry={dailySummary.refetch} /> : !todaySum?.byClass?.length ? <EmptyState message="No data for today" /> : (
              <div className="overflow-x-auto">
                <table className="w-full min-w-[500px]">
                  <thead><tr className="text-[10px] font-bold text-gray-400 uppercase">{['Class', 'Total', 'Present', 'Absent', 'Late', 'HD', '%'].map(h => <th key={h} className="p-2 text-left">{h}</th>)}</tr></thead>
                  <tbody>
                    {todaySum.byClass.map((bc: any) => (
                      <tr key={bc.class_name} className="border-t border-gray-100 text-xs">
                        <td className="p-2 font-semibold text-gray-800">{bc.class_name}</td>
                        <td className="p-2">{bc.total}</td>
                        <td className="p-2 text-green-600 font-semibold">{bc.present}</td>
                        <td className="p-2 text-red-500">{bc.absent}</td>
                        <td className="p-2 text-amber-500">{bc.late}</td>
                        <td className="p-2 text-blue-500">{bc.half_day}</td>
                        <td className="p-2 font-bold">{bc.total > 0 ? Math.round((bc.present / bc.total) * 100) : 0}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </Card>
          <div className="space-y-4">
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Today's Overview</h3>
              <div className="space-y-3">
                <div><div className="flex justify-between text-[10px]"><span className="text-gray-400">Total Students</span><span className="font-bold">{ds.totalStudents}</span></div><div className="w-full h-1.5 rounded-full bg-gray-100 mt-1"><div className="h-full rounded-full bg-[#7C3AED]" style={{ width: '100%' }} /></div></div>
                <div><div className="flex justify-between text-[10px]"><span className="text-gray-400">Present</span><span className="font-bold text-green-600">{ds.presentToday}</span></div><div className="w-full h-1.5 rounded-full bg-gray-100 mt-1"><div className="h-full rounded-full bg-green-500" style={{ width: `${ds.totalStudents ? (ds.presentToday / ds.totalStudents) * 100 : 0}%` }} /></div></div>
                <div><div className="flex justify-between text-[10px]"><span className="text-gray-400">Absent</span><span className="font-bold text-red-600">{ds.absentToday}</span></div><div className="w-full h-1.5 rounded-full bg-gray-100 mt-1"><div className="h-full rounded-full bg-red-500" style={{ width: `${ds.totalStudents ? (ds.absentToday / ds.totalStudents) * 100 : 0}%` }} /></div></div>
                <div className="flex justify-between text-[10px]"><span className="text-gray-400">Late</span><span className="font-bold text-amber-600">{ds.lateToday}</span></div>
                {ds.medicalToday > 0 && <div className="flex justify-between text-[10px]"><span className="text-gray-400">Medical</span><span className="font-bold text-purple-600">{ds.medicalToday}</span></div>}
              </div>
              <div className="mt-4 pt-3 border-t border-gray-100">
                <div className="flex justify-center">
                  <div className="relative w-24 h-24">
                    <svg viewBox="0 0 36 36" className="w-full h-full">
                      <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#E5E7EB" strokeWidth="3" />
                      <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#7C3AED" strokeWidth="3" strokeDasharray={`${ds.monthlyAttendancePct || 0}, 100`} />
                    </svg>
                    <div className="absolute inset-0 flex items-center justify-center text-lg font-extrabold text-gray-900">{ds.monthlyAttendancePct || 0}%</div>
                  </div>
                </div>
                <div className="text-center text-[9px] text-gray-400 mt-1">Monthly Attendance</div>
              </div>
            </Card>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-2">Quick Actions</h3>
              <div className="space-y-1.5">
                <button onClick={() => setActiveTab('student')} className="w-full text-left p-2 rounded-lg hover:bg-gray-50 text-[10px] font-medium text-gray-600 flex items-center gap-2"><Users size={12} /> Mark Attendance</button>
                <button onClick={() => setActiveTab('analytics')} className="w-full text-left p-2 rounded-lg hover:bg-gray-50 text-[10px] font-medium text-gray-600 flex items-center gap-2"><BarChart3 size={12} /> View Analytics</button>
                <button onClick={() => setActiveTab('ai')} className="w-full text-left p-2 rounded-lg hover:bg-gray-50 text-[10px] font-medium text-gray-600 flex items-center gap-2"><Brain size={12} /> AI Insights</button>
                <button onClick={() => handleBulkMarkAll('present')} className="w-full text-left p-2 rounded-lg hover:bg-green-50 text-[10px] font-medium text-green-600 flex items-center gap-2"><CheckCircle2 size={12} /> Mark All Present</button>
              </div>
            </Card>
          </div>
        </div>
      </>
    );

    const renderStudentAttendance = () => (
      <div className="space-y-4">
        {/* Filters + Actions */}
        <div className="flex flex-wrap items-center gap-2 bg-white p-3 rounded-xl border border-gray-200 sticky top-0 z-20">
          <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)} className="px-2.5 py-2 rounded-lg border border-gray-200 text-[10px] font-medium">
            <option value="">All Classes</option>
            {(cls.data || []).map((c: any) => <option key={c.id} value={c.name}>{c.name}</option>)}
          </select>
          <input type="date" value={attendanceDate} onChange={e => setAttendanceDate(e.target.value)} className="px-2.5 py-2 rounded-lg border border-gray-200 text-[10px]" />
          <div className="relative flex-1 min-w-[140px]">
            <Search size={12} className="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400" />
            <input value={searchQuery} onChange={e => setSearchQuery(e.target.value)} placeholder="Search student..." className="w-full pl-7 pr-2.5 py-2 rounded-lg border border-gray-200 text-[10px]" />
          </div>
          <div className="flex gap-1.5 ml-auto">
            <button onClick={() => handleBulkMarkAll('present')} className="px-2.5 py-1.5 rounded-lg bg-green-50 text-green-700 text-[9px] font-semibold hover:bg-green-100">All Present</button>
            <button onClick={() => handleBulkMarkAll('absent')} className="px-2.5 py-1.5 rounded-lg bg-red-50 text-red-700 text-[9px] font-semibold hover:bg-red-100">All Absent</button>
            <button onClick={() => setModalOpen(true)} className="px-3 py-1.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-[9px] font-semibold">+ Mark</button>
            <button onClick={resetFilters} className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-gray-500 text-[9px] font-semibold">Reset</button>
          </div>
        </div>
        {/* Bulk actions bar when students selected */}
        {selectedStudents.size > 0 && (
          <div className="flex items-center gap-2 p-2.5 bg-[#7C3AED]/5 rounded-xl border border-[#7C3AED]/20">
            <span className="text-[10px] font-semibold text-gray-600">{selectedStudents.size} selected</span>
            <div className="flex gap-1.5 ml-auto">
              {['present', 'absent', 'late'].map(st => (
                <button key={st} onClick={() => handleBulkSelected(st)} className="px-2.5 py-1 rounded-lg text-[9px] font-semibold" style={{ background: `${STATUS_COLORS[st]}15`, color: STATUS_COLORS[st] }}>{STATUS_LABELS[st]}</button>
              ))}
              <button onClick={() => setSelectedStudents(new Set())} className="px-2.5 py-1 rounded-lg text-[9px] font-semibold bg-gray-100 text-gray-500">Clear</button>
            </div>
          </div>
        )}
        {/* Table */}
        {studentsList.loading ? <LoadingSkeleton rows={8} cols={6} /> : studentsList.error ? <ErrorState message={studentsList.error} onRetry={studentsList.refetch} /> : (!studentsList.data || studentsList.data.length === 0) ? <EmptyState message="No students found" /> : (
          <div className="overflow-x-auto rounded-xl border border-gray-200 bg-white">
            <table className="w-full min-w-[900px] border-collapse">
              <thead><tr className="bg-gray-50 sticky top-0">
                <th className="p-3 w-10"><input type="checkbox" onChange={e => { if (e.target.checked) setSelectedStudents(new Set((studentsList.data || []).map((s: any) => s.id))); else setSelectedStudents(new Set()); }} className="rounded" /></th>
                <th className="p-3 text-left text-[10px] font-bold text-gray-400 uppercase">Roll</th>
                <th className="p-3 text-left text-[10px] font-bold text-gray-400 uppercase">Student</th>
                <th className="p-3 text-left text-[10px] font-bold text-gray-400 uppercase">Class</th>
                <th className="p-3 text-center text-[10px] font-bold text-gray-400 uppercase">Status</th>
                <th className="p-3 text-center text-[10px] font-bold text-gray-400 uppercase">Check In</th>
                <th className="p-3 text-center text-[10px] font-bold text-gray-400 uppercase">Check Out</th>
                <th className="p-3 text-center text-[10px] font-bold text-gray-400 uppercase">Duration</th>
                <th className="p-3 text-left text-[10px] font-bold text-gray-400 uppercase">Remarks</th>
                <th className="p-3 text-center text-[10px] font-bold text-gray-400 uppercase">Actions</th>
              </tr></thead>
              <tbody>
                {studentsList.data.map((student: any) => (
                  <tr key={student.id} className="border-t border-gray-100 hover:bg-gray-50/50 transition-colors">
                    <td className="p-3"><input type="checkbox" checked={selectedStudents.has(student.id)} onChange={() => toggleStudent(student.id)} className="rounded" /></td>
                    <td className="p-3 text-[10px] font-mono text-gray-500">{student.roll_number || '—'}</td>
                    <td className="p-3">
                      <div className="flex items-center gap-2.5">
                        <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold flex-shrink-0">
                          {(student.full_name || '?')[0]}
                        </div>
                        <div className="min-w-0">
                          <div className="text-xs font-semibold text-gray-800 truncate">{student.full_name}</div>
                          <div className="text-[9px] text-gray-400">{student.admission_number || ''}</div>
                        </div>
                      </div>
                    </td>
                    <td className="p-3 text-[10px] text-gray-600">{student.student_class || '—'} {student.section || ''}</td>
                    <td className="p-3 text-center">{getStatusBadge('present')}</td>
                    <td className="p-3 text-center text-[10px] text-gray-500">—</td>
                    <td className="p-3 text-center text-[10px] text-gray-500">—</td>
                    <td className="p-3 text-center text-[10px] text-gray-500">—</td>
                    <td className="p-3 text-[10px] text-gray-400 max-w-[120px] truncate">—</td>
                    <td className="p-3 text-center">
                      <div className="flex items-center justify-center gap-1">
                        <button onClick={() => openMarkModal(student)} className="p-1.5 rounded-md hover:bg-[#7C3AED]/10 text-[#7C3AED]" title="Mark"><CheckCircle2 size={13} /></button>
                        <button className="p-1.5 rounded-md hover:bg-blue-50 text-blue-500" title="View History"><Eye size={13} /></button>
                        <button className="p-1.5 rounded-md hover:bg-amber-50 text-amber-500" title="Notify"><Bell size={13} /></button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {/* Pagination */}
        {attendanceRecords.data && attendanceRecords.data.total > 50 && (
          <div className="flex items-center justify-between">
            <span className="text-[10px] text-gray-400">{attendanceRecords.data.total} total records</span>
            <div className="flex gap-1">
              <button onClick={() => setPage(p => Math.max(1, p - 1))} disabled={page === 1} className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium disabled:opacity-50">Prev</button>
              <span className="px-2.5 py-1.5 text-[10px] text-gray-500">Page {page}</span>
              <button onClick={() => setPage(p => p + 1)} className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium">Next</button>
            </div>
          </div>
        )}
      </div>
    );

    const renderDailyAttendance = () => (
      <div className="space-y-4">
        <div className="flex flex-wrap items-center gap-2">
          <input type="date" value={attendanceDate} onChange={e => setAttendanceDate(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs" />
          <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs">
            <option value="">All Classes</option>
            {(cls.data || []).map((c: any) => <option key={c.id} value={c.name}>{c.name}</option>)}
          </select>
        </div>
        {dailySummary.loading ? <LoadingSkeleton rows={4} cols={5} /> : dailySummary.error ? <ErrorState message={dailySummary.error} onRetry={dailySummary.refetch} /> : !todaySum ? <EmptyState message="No data for this date" /> : (
          <div className="space-y-4">
            <div className="grid grid-cols-4 sm:grid-cols-7 gap-2">
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Total</div><div className="text-lg font-extrabold text-gray-900">{todaySum.totalStudents}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Present</div><div className="text-lg font-extrabold text-green-600">{todaySum.totalPresent}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Absent</div><div className="text-lg font-extrabold text-red-600">{todaySum.totalAbsent}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Late</div><div className="text-lg font-extrabold text-amber-600">{todaySum.totalLate}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Half Day</div><div className="text-lg font-extrabold text-blue-600">{todaySum.totalHalfDay}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">Medical</div><div className="text-lg font-extrabold text-purple-600">{todaySum.totalMedical}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] font-semibold text-gray-400">%</div><div className="text-lg font-extrabold text-[#7C3AED]">{todaySum.attendancePct}%</div></Card>
            </div>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Per-Class Breakdown</h3>
              <div className="overflow-x-auto">
                <table className="w-full min-w-[600px]">
                  <thead><tr className="text-[10px] font-bold text-gray-400 uppercase">{['Class', 'Total', 'Present', 'Absent', 'Late', 'HD', 'Medical', '%'].map(h => <th key={h} className="p-2 text-left">{h}</th>)}</tr></thead>
                  <tbody>
                    {(todaySum.byClass || []).map((bc: any) => (
                      <tr key={bc.class_name} className="border-t border-gray-100 text-xs">
                        <td className="p-2 font-semibold text-gray-800">{bc.class_name}</td>
                        <td className="p-2">{bc.total}</td>
                        <td className="p-2 text-green-600 font-semibold">{bc.present}</td>
                        <td className="p-2 text-red-500">{bc.absent}</td>
                        <td className="p-2 text-amber-500">{bc.late}</td>
                        <td className="p-2 text-blue-500">{bc.half_day}</td>
                        <td className="p-2 text-purple-500">{bc.medical}</td>
                        <td className="p-2 font-bold">{bc.total > 0 ? Math.round((bc.present / bc.total) * 100) : 0}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Card>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Attendance Distribution</h3>
              <ResponsiveContainer width="100%" height={160}>
                <BarChart data={[
                  { name: 'Present', count: todaySum.totalPresent }, { name: 'Absent', count: todaySum.totalAbsent },
                  { name: 'Late', count: todaySum.totalLate }, { name: 'Half Day', count: todaySum.totalHalfDay },
                  { name: 'Medical', count: todaySum.totalMedical },
                ]}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="name" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 10 }} />
                  <Tooltip />
                  <Bar dataKey="count" radius={[4, 4, 0, 0]}>
                    {[todaySum.totalPresent, todaySum.totalAbsent, todaySum.totalLate, todaySum.totalHalfDay, todaySum.totalMedical].map((v, i) => (
                      <Cell key={i} fill={['#22C55E', '#EF4444', '#F59E0B', '#3B82F6', '#8B5CF6'][i]} />
                    ))}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </Card>
          </div>
        )}
      </div>
    );

    const renderAnalytics = () => {
      const a = analytics.data;
      return (
        <div className="space-y-4">
          <div className="flex flex-wrap items-center gap-2">
            <input type="date" value={fromDate} onChange={e => setFromDate(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs" />
            <span className="text-[10px] text-gray-400">to</span>
            <input type="date" value={toDate} onChange={e => setToDate(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs" />
            <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs">
              <option value="">All Classes</option>
              {(cls.data || []).map((c: any) => <option key={c.id} value={c.name}>{c.name}</option>)}
            </select>
          </div>
          {analytics.loading ? <LoadingSkeleton rows={6} cols={4} /> : analytics.error ? <ErrorState message={analytics.error} onRetry={analytics.refetch} /> : !a ? <EmptyState message="No analytics data" /> : (
            <>
              <div className="grid grid-cols-3 sm:grid-cols-6 gap-2">
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">Records</div><div className="text-sm font-extrabold text-gray-900">{a.summary?.totalRecords}</div></Card>
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">%</div><div className="text-sm font-extrabold text-[#7C3AED]">{a.summary?.attendancePct}%</div></Card>
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">Present</div><div className="text-sm font-extrabold text-green-600">{a.summary?.present}</div></Card>
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">Absent</div><div className="text-sm font-extrabold text-red-600">{a.summary?.absent}</div></Card>
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">Late</div><div className="text-sm font-extrabold text-amber-600">{a.summary?.late}</div></Card>
                <Card className="p-2.5 text-center"><div className="text-[9px] text-gray-400">Medical</div><div className="text-sm font-extrabold text-purple-600">{a.summary?.medical_leave}</div></Card>
              </div>
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Daily Attendance Trend</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <AreaChart data={(a.dailyTrend || []).slice(-30)}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="date" tick={false} />
                      <YAxis tick={{ fontSize: 10 }} domain={[0, 'auto']} />
                      <Tooltip />
                      <Area type="monotone" dataKey="present" stroke="#7C3AED" fill="#7C3AED20" />
                    </AreaChart>
                  </ResponsiveContainer>
                </Card>
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Weekly Trend</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <AreaChart data={(a.weeklyTrend || []).slice(-12)}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="week" tick={false} />
                      <YAxis tick={{ fontSize: 10 }} domain={[0, 'auto']} />
                      <Tooltip />
                      <Area type="monotone" dataKey="present" stroke="#22C55E" fill="#22C55E20" />
                    </AreaChart>
                  </ResponsiveContainer>
                </Card>
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Class-wise Attendance</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <BarChart data={a.classWise || []} layout="vertical">
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis type="number" tick={{ fontSize: 10 }} />
                      <YAxis dataKey="class" type="category" tick={{ fontSize: 9 }} width={70} />
                      <Tooltip />
                      <Bar dataKey="present" fill="#7C3AED" radius={[0, 4, 4, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </Card>
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Section-wise</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <BarChart data={a.sectionWise || []} layout="vertical">
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis type="number" tick={{ fontSize: 10 }} />
                      <YAxis dataKey="section" type="category" tick={{ fontSize: 9 }} width={50} />
                      <Tooltip />
                      <Bar dataKey="present" fill="#8B5CF6" radius={[0, 4, 4, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </Card>
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Monthly Trend</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <BarChart data={a.monthlyTrend || []}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="month" tick={{ fontSize: 9 }} />
                      <YAxis tick={{ fontSize: 10 }} />
                      <Tooltip />
                      <Bar dataKey="present" fill="#F59E0B" radius={[4, 4, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </Card>
                <Card className="p-4">
                  <h3 className="font-bold text-xs mb-3">Attendance Distribution</h3>
                  <ResponsiveContainer width="100%" height={200}>
                    <RePieChart>
                      <Pie data={[
                        { name: 'Present', value: a.summary?.present || 0 },
                        { name: 'Absent', value: a.summary?.absent || 0 },
                        { name: 'Late', value: a.summary?.late || 0 },
                        { name: 'Medical', value: a.summary?.medical_leave || 0 },
                      ]} dataKey="value" cx="50%" cy="50%" outerRadius={70} label={({ name, percent }: any) => `${name} ${((percent || 0) * 100).toFixed(0)}%`}>
                        {['#22C55E', '#EF4444', '#F59E0B', '#8B5CF6'].map((c, i) => <Cell key={i} fill={c} />)}
                      </Pie>
                      <Tooltip />
                    </RePieChart>
                  </ResponsiveContainer>
                </Card>
              </div>
              <Card className="p-4">
                <h3 className="font-bold text-xs mb-3">Attendance Heatmap (Day × Hour)</h3>
                <div className="overflow-x-auto">
                  <div className="grid grid-cols-13 gap-0.5 min-w-[400px]" style={{ gridTemplateColumns: '40px repeat(12, 1fr)' }}>
                    <div />
                    {Array.from({ length: 12 }, (_, i) => <div key={i} className="text-[7px] text-gray-400 text-center">{i + 6}h</div>)}
                    {(a.heatmap || []).map((row: number[], di: number) => (
                      <>
                        <div key={`lbl-${di}`} className="text-[7px] text-gray-400 flex items-center">{DAYS[di]}</div>
                        {row.map((v: number, hi: number) => (
                          <div key={`${di}-${hi}`} className="h-4 rounded-sm" style={{ background: v > 0 ? `rgba(124, 58, 237, ${Math.min(v / 20, 1)})` : '#F3F4F6' }} title={`${DAYS[di]} ${hi + 6}h: ${v}`} />
                        ))}
                      </>
                    ))}
                  </div>
                </div>
              </Card>
            </>
          )}
        </div>
      );
    };

    const renderAiInsights = () => (
      <div className="space-y-4">
        {aiInsights.loading ? <LoadingSkeleton rows={6} cols={3} /> : aiInsights.error ? <ErrorState message={aiInsights.error} onRetry={aiInsights.refetch} /> : !aiInsights.data ? <EmptyState message="No AI insights available" /> : (
          <>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Overall Attendance</div><div className="text-xl font-extrabold mt-1">{aiInsights.data.totalAttendance}%</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Low Attendance</div><div className="text-xl font-extrabold text-amber-600 mt-1">{(aiInsights.data.lowAttendanceStudents || []).length}</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Chronic Absentees</div><div className="text-xl font-extrabold text-red-600 mt-1">{(aiInsights.data.chronicAbsentees || []).length}</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">At Risk</div><div className="text-xl font-extrabold text-red-600 mt-1">{(aiInsights.data.riskStudents || []).length}</div></Card>
            </div>
            {/* Low Attendance Students */}
            {(aiInsights.data.lowAttendanceStudents || []).length > 0 && (
              <Card className="p-4">
                <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><AlertTriangle size={13} className="text-amber-500" /> Low Attendance Students (&lt;75%)</h3>
                <div className="space-y-2">
                  {(aiInsights.data.lowAttendanceStudents || []).map((item: any, i: number) => (
                    <div key={i} className="flex items-center justify-between p-2.5 rounded-lg bg-amber-50">
                      <div className="flex items-center gap-2.5">
                        <div className="w-7 h-7 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center text-white text-[9px] font-bold">{(item.student?.full_name || '?')[0]}</div>
                        <div><div className="text-xs font-semibold text-gray-800">{item.student?.full_name}</div><div className="text-[9px] text-gray-400">{item.student?.student_class} · {item.total} records</div></div>
                      </div>
                      <Badge className="text-[9px]" style={{ background: item.attendancePct < 40 ? '#EF444430' : item.attendancePct < 60 ? '#F59E0B30' : '#3B82F630', color: item.attendancePct < 40 ? '#EF4444' : item.attendancePct < 60 ? '#F59E0B' : '#3B82F6' }}>{item.attendancePct}%</Badge>
                    </div>
                  ))}
                </div>
              </Card>
            )}
            {/* Chronic Absentees */}
            {(aiInsights.data.chronicAbsentees || []).length > 0 && (
              <Card className="p-4">
                <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><X size={13} className="text-red-500" /> Chronic Absentees</h3>
                <div className="space-y-2">
                  {(aiInsights.data.chronicAbsentees || []).map((item: any, i: number) => (
                    <div key={i} className="flex items-center justify-between p-2.5 rounded-lg bg-red-50">
                      <div className="flex items-center gap-2.5">
                        <div className="w-7 h-7 rounded-full bg-gradient-to-br from-red-500 to-pink-500 flex items-center justify-center text-white text-[9px] font-bold">{(item.student?.full_name || '?')[0]}</div>
                        <div><div className="text-xs font-semibold text-gray-800">{item.student?.full_name}</div><div className="text-[9px] text-gray-400">{item.totalAbsences} absences</div></div>
                      </div>
                      <Badge className="text-[9px] bg-red-100 text-red-600">{item.attendancePct}%</Badge>
                    </div>
                  ))}
                </div>
              </Card>
            )}
            {/* Risk Students */}
            {(aiInsights.data.riskStudents || []).length > 0 && (
              <Card className="p-4">
                <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><Shield size={13} className="text-red-500" /> At-Risk Students</h3>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                  {(aiInsights.data.riskStudents || []).map((flag: any) => (
                    <Card key={flag.id} className="p-3" style={{ borderLeft: `3px solid ${flag.risk_level === 'critical' ? '#EF4444' : flag.risk_level === 'high' ? '#F59E0B' : flag.risk_level === 'medium' ? '#3B82F6' : '#22C55E'}` }}>
                      <div className="flex items-center gap-2.5">
                        <div className="w-8 h-8 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#8B5CF6] flex items-center justify-center text-white text-[10px] font-bold">{(flag.student?.full_name || '?')[0]}</div>
                        <div className="min-w-0">
                          <div className="text-xs font-semibold text-gray-800 truncate">{flag.student?.full_name}</div>
                          <div className="text-[9px] text-gray-400">{flag.student?.student_class}</div>
                        </div>
                      </div>
                      <div className="flex items-center justify-between mt-2">
                        <Badge className={`text-[8px] ${flag.risk_level === 'critical' ? 'bg-red-100 text-red-700' : flag.risk_level === 'high' ? 'bg-amber-100 text-amber-700' : flag.risk_level === 'medium' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700'}`}>{flag.risk_level}</Badge>
                        <span className="text-[10px] font-bold">{flag.attendance_pct}%</span>
                      </div>
                      <div className="text-[9px] text-gray-500 mt-1.5">{flag.suggested_action}</div>
                      <div className="flex gap-1 mt-2">
                        <button className="flex-1 py-1 rounded text-[8px] font-semibold bg-amber-50 text-amber-700 hover:bg-amber-100">Notify</button>
                        <button className="flex-1 py-1 rounded text-[8px] font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100">Counsel</button>
                      </div>
                    </Card>
                  ))}
                </div>
              </Card>
            )}
            {/* Recommendations */}
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><Bot size={13} className="text-[#7C3AED]" /> AI Recommendations</h3>
              <div className="space-y-2">
                {(aiInsights.data.recommendations || []).map((rec: string, i: number) => (
                  <div key={i} className="flex items-start gap-2.5 p-2.5 rounded-lg bg-gray-50">
                    <div className="w-1.5 h-1.5 rounded-full bg-[#7C3AED] mt-1.5 flex-shrink-0" />
                    <div className="text-[10px] text-gray-600">{rec}</div>
                  </div>
                ))}
              </div>
            </Card>
            {/* Forecast */}
            {(aiInsights.data.forecast || []).length > 0 && (
              <Card className="p-4">
                <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><TrendingUp size={13} className="text-[#7C3AED]" /> Attendance Forecast & Dropout Probability</h3>
                <div className="overflow-x-auto">
                  <table className="w-full min-w-[500px]">
                    <thead><tr className="text-[10px] font-bold text-gray-400 uppercase">{['Student', 'Current %', 'Projected %', 'Risk Level', 'Dropout Prob'].map(h => <th key={h} className="p-2 text-left">{h}</th>)}</tr></thead>
                    <tbody>
                      {(aiInsights.data.forecast || []).map((f: any, i: number) => (
                        <tr key={i} className="border-t border-gray-100 text-xs">
                          <td className="p-2 font-semibold text-gray-800">{f.studentId?.substring(0, 8)}...</td>
                          <td className="p-2">{f.currentPct}%</td>
                          <td className="p-2">{f.projectedPct}%</td>
                          <td className="p-2">{getStatusBadge(f.riskLevel === 'critical' ? 'absent' : f.riskLevel === 'high' ? 'late' : f.riskLevel === 'medium' ? 'half_day' : 'present')}</td>
                          <td className="p-2 font-bold" style={{ color: f.projectedPct < 50 ? '#EF4444' : f.projectedPct < 75 ? '#F59E0B' : '#22C55E' }}>{Math.round(100 - f.projectedPct)}%</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </Card>
            )}
          </>
        )}
      </div>
    );

    const renderReports = () => (
      <div className="space-y-4">
        <div className="flex flex-wrap items-center gap-2">
          <select value={reportType} onChange={e => setReportType(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs">
            <option value="daily">Daily Report</option><option value="weekly">Weekly Report</option><option value="monthly">Monthly Report</option><option value="annual">Annual Report</option>
          </select>
          <input type="date" value={fromDate} onChange={e => setFromDate(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs" />
          <span className="text-[10px] text-gray-400">to</span>
          <input type="date" value={toDate} onChange={e => setToDate(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs" />
          <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs">
            <option value="">All Classes</option>
            {(cls.data || []).map((c: any) => <option key={c.id} value={c.name}>{c.name}</option>)}
          </select>
          <div className="ml-auto flex gap-1.5">
            <button className="px-3 py-1.5 rounded-lg bg-[#7C3AED] text-white text-[9px] font-semibold">PDF</button>
            <button className="px-3 py-1.5 rounded-lg bg-green-600 text-white text-[9px] font-semibold">Excel</button>
            <button className="px-3 py-1.5 rounded-lg bg-gray-600 text-white text-[9px] font-semibold">CSV</button>
          </div>
        </div>
        {reports.loading ? <LoadingSkeleton rows={6} cols={5} /> : reports.error ? <ErrorState message={reports.error} onRetry={reports.refetch} /> : !reports.data ? <EmptyState message="No report data" /> : (
          <>
            <div className="grid grid-cols-3 sm:grid-cols-6 gap-2">
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">Records</div><div className="text-lg font-extrabold text-gray-900">{reports.data.totalRecords}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">%</div><div className="text-lg font-extrabold text-[#7C3AED]">{reports.data.overallPercentage}%</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">Present</div><div className="text-lg font-extrabold text-green-600">{reports.data.presentCount}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">Absent</div><div className="text-lg font-extrabold text-red-600">{reports.data.absentCount}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">Late</div><div className="text-lg font-extrabold text-amber-600">{reports.data.lateCount}</div></Card>
              <Card className="p-3 text-center"><div className="text-[9px] text-gray-400">Medical</div><div className="text-lg font-extrabold text-purple-600">{reports.data.medicalCount}</div></Card>
            </div>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Class-wise Summary</h3>
              <div className="overflow-x-auto">
                <table className="w-full min-w-[500px]">
                  <thead><tr className="text-[10px] font-bold text-gray-400 uppercase">{['Class', 'Students', 'Present', 'Absent', 'Late', '%'].map(h => <th key={h} className="p-2 text-left">{h}</th>)}</tr></thead>
                  <tbody>
                    {(reports.data.classStats || []).map((cs: any) => (
                      <tr key={cs.class} className="border-t border-gray-100 text-xs">
                        <td className="p-2 font-semibold text-gray-800">{cs.class}</td>
                        <td className="p-2">{cs.total}</td>
                        <td className="p-2 text-green-600 font-semibold">{cs.present}</td>
                        <td className="p-2 text-red-500">{cs.absent}</td>
                        <td className="p-2 text-amber-500">{cs.late}</td>
                        <td className="p-2 font-bold">{cs.total > 0 ? Math.round((cs.present / cs.total) * 100) : 0}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Card>
          </>
        )}
      </div>
    );

    const renderSubjectAttendance = () => (
      <div className="space-y-4">
        <EmptyState message="Subject attendance tracking — select subject to view records" />
      </div>
    );

    const renderMonthlyAttendance = () => (
      <div className="space-y-4">
        <EmptyState message="Monthly attendance report — select date range to generate" />
      </div>
    );

    return (
      <ModulePage title="Attendance Management" desc="Track, monitor, analyze, and manage student attendance across the institution"
        actions={
          <div className="flex gap-1.5 flex-wrap">
            <button onClick={() => { openMarkModal(); }} className="px-3 py-1.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-[10px] font-semibold shadow-sm hover:shadow-md flex items-center gap-1.5">
              <Plus size={12} /> Mark Attendance
            </button>
            <button onClick={() => handleBulkMarkAll('present')} className="px-3 py-1.5 rounded-lg border border-green-200 text-green-700 text-[10px] font-semibold hover:bg-green-50">Bulk</button>
            <button className="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 text-[10px] font-semibold hover:bg-gray-50">Import</button>
            <button className="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 text-[10px] font-semibold hover:bg-gray-50">Export</button>
            <button onClick={() => setActiveTab('reports')} className="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 text-[10px] font-semibold hover:bg-gray-50">Report</button>
            <button className="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 text-[10px] font-semibold hover:bg-gray-50 flex items-center gap-1"><Settings size={11} /> Settings</button>
          </div>
        }>
        <div className="space-y-5">
          {/* Dashboard KPIs row — always visible */}
          {activeTab !== 'student' && activeTab !== 'daily' && activeTab !== 'subject' && activeTab !== 'monthly' && activeTab !== 'analytics' && activeTab !== 'reports' && activeTab !== 'ai' && renderDashboard()}

          {/* Tab navigation */}
          <div className="flex flex-wrap gap-1.5 border-b border-gray-200 pb-1">
            {tabs.map(tab => (
              <button key={tab.key} onClick={() => setActiveTab(tab.key as any)}
                className={`flex items-center gap-1.5 px-3.5 py-2 rounded-t-lg text-[10px] font-semibold transition-all ${activeTab === tab.key ? 'bg-white text-[#7C3AED] border-t border-l border-r border-gray-200 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
                <tab.icon size={13} /> {tab.label}
              </button>
            ))}
            {/* Right side: date filter for tabs */}
            <div className="ml-auto flex items-center gap-2">
              <input type="date" value={attendanceDate} onChange={e => setAttendanceDate(e.target.value)} className="px-2 py-1.5 rounded-lg border border-gray-200 text-[10px]" />
            </div>
          </div>

          {/* Tab Content */}
          {activeTab === 'student' && renderStudentAttendance()}
          {activeTab === 'daily' && renderDailyAttendance()}
          {activeTab === 'subject' && renderSubjectAttendance()}
          {activeTab === 'monthly' && renderMonthlyAttendance()}
          {activeTab === 'analytics' && renderAnalytics()}
          {activeTab === 'reports' && renderReports()}
          {activeTab === 'ai' && renderAiInsights()}
          {activeTab === 'overview' && renderDashboard()}
        </div>

        {/* Mark Attendance Modal */}
        <CrudModal open={modalOpen && activeTab !== 'student'} onClose={() => setModalOpen(false)} title="Mark Attendance">
          <div className="space-y-4">
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Student</label>
              <select value={markForm.student_id} onChange={e => setMarkForm((f: any) => ({ ...f, student_id: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                <option value="">Select student...</option>
                {(studentsList.data || []).map((s: any) => <option key={s.id} value={s.id}>{s.full_name} ({s.roll_number})</option>)}
              </select></div>
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Date</label>
                <input type="date" value={markForm.date} onChange={e => setMarkForm((f: any) => ({ ...f, date: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Status</label>
                <select value={markForm.status} onChange={e => setMarkForm((f: any) => ({ ...f, status: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  {Object.entries(STATUS_LABELS).map(([k, v]) => <option key={k} value={k}>{v}</option>)}
                </select></div>
            </div>
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Check In</label>
                <input type="time" value={markForm.check_in} onChange={e => setMarkForm((f: any) => ({ ...f, check_in: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Check Out</label>
                <input type="time" value={markForm.check_out} onChange={e => setMarkForm((f: any) => ({ ...f, check_out: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
            </div>
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Remarks</label>
              <textarea value={markForm.remarks} onChange={e => setMarkForm((f: any) => ({ ...f, remarks: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" rows={2} /></div>
            {markForm.status === 'absent' && (
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Leave Reason</label>
                <textarea value={markForm.leave_reason} onChange={e => setMarkForm((f: any) => ({ ...f, leave_reason: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" rows={2} /></div>
            )}
            <div className="flex gap-2 pt-2">
              <button onClick={handleMarkAttendance} disabled={saving}
                className="flex-1 py-2.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold disabled:opacity-50">
                {saving ? 'Saving...' : 'Save'}
              </button>
              <button onClick={() => setModalOpen(false)} className="px-4 py-2.5 rounded-lg border border-gray-200 text-gray-500 text-sm font-semibold">Cancel</button>
            </div>
          </div>
        </CrudModal>
      </ModulePage>
    );
  };

  // ====================== GAMIFICATION TAB ======================
  const GamificationTab = () => {
    const [gameView, setGameView] = useState<'games' | 'assignments' | 'leaderboard' | 'achievements'>('games');
    const [games, setGames] = useState<any[]>([]);
    const [assignments, setAssignments] = useState<any[]>([]);
    const [sessions, setSessions] = useState<any[]>([]);
    const [xpData, setXpData] = useState<any[]>([]);
    const [achievementDefs, setAchievementDefs] = useState<any[]>([]);
    const [studentAchievements, setStudentAchievements] = useState<any[]>([]);
    const [leaderboard, setLeaderboard] = useState<any[]>([]);
    const [students, setStudents] = useState<any[]>([]);
    const [classes, setClasses] = useState<any[]>([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);
    // Modal states
    const [gameModal, setGameModal] = useState(false);
    const [assignModal, setAssignModal] = useState(false);
    const [editGame, setEditGame] = useState<any>(null);
    const [awardAchieveModal, setAwardAchieveModal] = useState(false);
    const [awardXpModal, setAwardXpModal] = useState(false);
    // Form states
    const [gameForm, setGameForm] = useState({ title: '', description: '', subject: '', difficulty: 'beginner', game_type: 'quiz', game_url: '', thumbnail_url: '', max_score: 100, duration_minutes: 10, instructions: '' });
    const [assignForm, setAssignForm] = useState({ game_id: '', class_id: '', student_id: '', due_date: '' });
    const [awardForm, setAwardForm] = useState({ student_id: '', achievement_id: '' });
    const [xpForm, setXpForm] = useState({ student_id: '', xp_amount: 50 });

    const loadData = async () => {
      setLoading(true);
      setError(null);
      try {
        const [g, a, s, x, ad, lb, stu, cl] = await Promise.all([
          learningGameApi.getGames(),
          learningGameApi.getAssignments(),
          learningGameApi.getSessions(),
          learningGameApi.getXp(),
          learningGameApi.getAchievementDefs(),
          learningGameApi.getLeaderboard(),
          studentApi.getAll(),
          classApi.getAll(),
        ].map(p => p.catch(() => ({ success: true, data: [] }))));
        setGames(Array.isArray(g.data) ? g.data : []);
        setAssignments(Array.isArray(a.data) ? a.data : []);
        setSessions(Array.isArray(s.data) ? s.data : []);
        setXpData(Array.isArray(x.data) ? x.data : []);
        setAchievementDefs(Array.isArray(ad.data) ? ad.data : []);
        setLeaderboard(Array.isArray(lb.data) ? lb.data : []);
        setStudents(Array.isArray(stu.data) ? stu.data : []);
        setClasses(Array.isArray(cl.data) ? cl.data : []);
      } catch (e: any) { setError(e.message); }
      setLoading(false);
    };

    useEffect(() => { loadData(); }, []);

    const handleAddGame = async () => {
      if (!gameForm.title) return toast.error('Game title required');
      await learningGameApi.createGame(gameForm);
      toast.success('Game created');
      setGameModal(false);
      setGameForm({ title: '', description: '', subject: '', difficulty: 'beginner', game_type: 'quiz', game_url: '', thumbnail_url: '', max_score: 100, duration_minutes: 10, instructions: '' });
      loadData();
    };

    const handleDeleteGame = async (id: string) => {
      await learningGameApi.deleteGame(id);
      toast.success('Game deleted');
      loadData();
    };

    const handleAssignGame = async () => {
      if (!assignForm.game_id) return toast.error('Select a game');
      await learningGameApi.createAssignment({
        game_id: assignForm.game_id,
        class_id: assignForm.class_id || null,
        student_id: assignForm.student_id || null,
        due_date: assignForm.due_date ? new Date(assignForm.due_date).toISOString() : null,
      });
      toast.success('Game assigned');
      setAssignModal(false);
      setAssignForm({ game_id: '', class_id: '', student_id: '', due_date: '' });
      loadData();
    };

    const handleDeleteAssignment = async (id: string) => {
      await learningGameApi.deleteAssignment(id);
      toast.success('Assignment removed');
      loadData();
    };

    const handleAwardAchievement = async () => {
      if (!awardForm.student_id || !awardForm.achievement_id) return toast.error('Select student and achievement');
      await learningGameApi.awardStudentAchievement(awardForm);
      toast.success('Achievement awarded');
      setAwardAchieveModal(false);
      setAwardForm({ student_id: '', achievement_id: '' });
      loadData();
    };

    const handleAwardXp = async () => {
      if (!xpForm.student_id) return toast.error('Select a student');
      await learningGameApi.awardXp(xpForm);
      toast.success(`${xpForm.xp_amount} XP awarded`);
      setAwardXpModal(false);
      setXpForm({ student_id: '', xp_amount: 50 });
      loadData();
    };

    const gameTabs = [
      { key: 'games' as const, label: 'Game Library', icon: Gamepad2 },
      { key: 'assignments' as const, label: 'Assignments', icon: CalendarDays },
      { key: 'leaderboard' as const, label: 'Leaderboard', icon: Medal },
      { key: 'achievements' as const, label: 'Achievements', icon: Trophy },
    ];

    const diffColor = (d: string) => d === 'beginner' ? '#22C55E' : d === 'intermediate' ? '#F59E0B' : '#EF4444';

    if (loading) return <div className="flex items-center justify-center h-64"><div className="animate-spin rounded-full h-8 w-8 border-b-2" style={{ borderColor: CLR.primary }} /></div>;
    if (error) return <ErrorState message={error} onRetry={loadData} />;

    return (
      <ModulePage title={gameTabs.find(t => t.key === gameView)?.label || 'Gamification'} desc="Learning games, XP, leaderboard, and achievements" actions={
        <div className="flex items-center gap-2 flex-wrap">
          {gameView === 'games' && <AddButton onClick={() => { setEditGame(null); setGameForm({ title: '', description: '', subject: '', difficulty: 'beginner', game_type: 'quiz', game_url: '', thumbnail_url: '', max_score: 100, duration_minutes: 10, instructions: '' }); setGameModal(true); }} label="Add Game" />}
          {gameView === 'assignments' && <AddButton onClick={() => setAssignModal(true)} label="Assign Game" />}
          {gameView === 'achievements' && <AddButton onClick={() => setAwardAchieveModal(true)} label="Award Achievement" />}
          <button onClick={() => setAwardXpModal(true)} className="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50"><Star size={14} /> Award XP</button>
          <button onClick={loadData} className="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50"><Sparkles size={14} /> Refresh</button>
        </div>
      }>
        {/* Sub-tabs */}
        <div className="flex items-center gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit">
          {gameTabs.map(t => {
            const Icon = t.icon;
            return (
              <button key={t.key} onClick={() => setGameView(t.key)} className={`flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-all ${gameView === t.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
                <Icon size={14} /> {t.label}
              </button>
            );
          })}
        </div>

        {/* Games Library */}
        {gameView === 'games' && (
          <div>
            {games.length === 0 ? (
              <EmptyState message="No games yet. Add your first learning game." />
            ) : (
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {games.map(game => (
                  <Card key={game.id} className="p-5 hover:shadow-md transition-shadow">
                    <div className="flex items-start justify-between mb-3">
                      <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ background: `${CLR.warning}15`, color: CLR.warning }}><Gamepad2 size={20} /></div>
                      <Badge className="text-[9px]" style={{ background: `${diffColor(game.difficulty)}15`, color: diffColor(game.difficulty) }}>{game.difficulty}</Badge>
                    </div>
                    <h3 className="text-sm font-bold mb-1">{game.title}</h3>
                    <p className="text-[11px] text-gray-400 mb-3 line-clamp-2">{game.description || 'No description'}</p>
                    <div className="flex items-center gap-3 text-[10px] text-gray-400 mb-4">
                      <span>{game.subject || 'General'}</span>
                      <span>{game.game_type}</span>
                      <span>{game.duration_minutes} min</span>
                      <span>Max: {game.max_score}pts</span>
                    </div>
                    <div className="flex items-center gap-2">
                      <button onClick={() => { setEditGame(game); setGameForm({ title: game.title, description: game.description || '', subject: game.subject || '', difficulty: game.difficulty, game_type: game.game_type, game_url: game.game_url || '', thumbnail_url: game.thumbnail_url || '', max_score: game.max_score, duration_minutes: game.duration_minutes, instructions: game.instructions || '' }); setGameModal(true); }} className="flex items-center gap-1 px-3 py-1.5 rounded-lg text-[10px] font-semibold text-gray-500 hover:bg-gray-50 border border-gray-200"><Edit3 size={12} /> Edit</button>
                      <button onClick={() => handleDeleteGame(game.id)} className="flex items-center gap-1 px-3 py-1.5 rounded-lg text-[10px] font-semibold text-red-500 hover:bg-red-50 border border-red-200"><Trash2 size={12} /> Delete</button>
                    </div>
                  </Card>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Assignments */}
        {gameView === 'assignments' && (
          <div>
            {assignments.length === 0 ? (
              <EmptyState message="No assignments yet. Assign a game to a class or student." />
            ) : (
              <div className="space-y-3">
                {assignments.map(a => (
                  <Card key={a.id} className="p-4 flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <div className="w-9 h-9 rounded-lg flex items-center justify-center" style={{ background: `${CLR.accent}15`, color: CLR.accent }}><Gamepad2 size={16} /></div>
                      <div>
                        <div className="text-xs font-bold">{a.learning_games?.title || 'Unknown Game'}</div>
                        <div className="text-[10px] text-gray-400">
                          {a.class_id ? `Class: ${a.class_id}` : ''}
                          {a.student_id ? `Student: ${a.student_id}` : ''}
                          {a.due_date ? ` | Due: ${new Date(a.due_date).toLocaleDateString()}` : ''}
                          <span className="ml-2">Status: {a.status}</span>
                        </div>
                      </div>
                    </div>
                    <button onClick={() => handleDeleteAssignment(a.id)} className="p-2 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50"><Trash2 size={14} /></button>
                  </Card>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Leaderboard */}
        {gameView === 'leaderboard' && (
          <div>
            {leaderboard.length === 0 && xpData.length === 0 ? (
              <EmptyState message="No rankings yet. Award XP to build the leaderboard." />
            ) : (
              <div>
                <div className="flex items-center justify-end mb-3">
                  <button onClick={async () => { await learningGameApi.refreshLeaderboard(); toast.success('Leaderboard refreshed'); loadData(); }} className="flex items-center gap-1 px-3 py-1.5 rounded-lg text-[10px] font-semibold text-gray-500 hover:bg-gray-50 border border-gray-200"><Sparkles size={12} /> Refresh Rankings</button>
                </div>
                <Card className="overflow-hidden">
                  <table className="w-full text-xs">
                    <thead>
                      <tr className="border-b border-gray-100">
                        <th className="text-left p-3 font-semibold text-gray-500">Rank</th>
                        <th className="text-left p-3 font-semibold text-gray-500">Student</th>
                        <th className="text-center p-3 font-semibold text-gray-500">Level</th>
                        <th className="text-right p-3 font-semibold text-gray-500">Total XP</th>
                      </tr>
                    </thead>
                    <tbody>
                      {(leaderboard.length > 0 ? leaderboard : xpData.map((s: any, i: number) => ({ ...s, rank: i + 1 }))).map((entry: any, i: number) => {
                        const student = students.find((st: any) => st.id === entry.student_id);
                        const rankColors = ['#FFD700', '#C0C0C0', '#CD7F32'];
                        const icon = i < 3 ? Medal : null;
                        const Icon = icon;
                        return (
                          <tr key={entry.id || i} className={`border-b border-gray-50 ${i < 3 ? 'bg-gray-50/50' : ''}`}>
                            <td className="p-3">
                              <div className="flex items-center gap-2">
                                {i < 3 ? <Medal size={14} style={{ color: rankColors[i] }} /> : <span className="w-4 text-center">{entry.rank || i + 1}</span>}
                              </div>
                            </td>
                            <td className="p-3 font-semibold">{student?.full_name || student?.name || entry.student_id?.slice(0, 8) || 'Unknown'}</td>
                            <td className="p-3 text-center">
                              <Badge className="text-[9px]" style={{ background: `${CLR.primary}12`, color: CLR.primary }}>Lv.{entry.level || 1}</Badge>
                            </td>
                            <td className="p-3 text-right font-bold" style={{ color: CLR.warning }}>{entry.total_xp?.toLocaleString() || 0} XP</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </Card>
              </div>
            )}
          </div>
        )}

        {/* Achievements */}
        {gameView === 'achievements' && (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
              <h3 className="text-sm font-bold mb-3">Achievement Definitions</h3>
              {achievementDefs.length === 0 ? (
                <EmptyState message="No achievements defined yet. Create achievement definitions first." />
              ) : (
                <div className="space-y-2">
                  {achievementDefs.map(a => (
                    <Card key={a.id} className="p-3 flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ background: `${CLR.warning}15`, color: CLR.warning }}><Trophy size={14} /></div>
                        <div>
                          <div className="text-xs font-bold">{a.name}</div>
                          <div className="text-[10px] text-gray-400">{a.description} {a.xp_reward > 0 && `(${a.xp_reward} XP)`}</div>
                        </div>
                      </div>
                      <button onClick={() => learningGameApi.deleteAchievementDef(a.id).then(loadData)} className="p-1.5 rounded-lg text-gray-400 hover:text-red-500"><Trash2 size={12} /></button>
                    </Card>
                  ))}
                </div>
              )}
            </div>
            <div>
              <h3 className="text-sm font-bold mb-3">Recently Earned</h3>
              <EmptyState message="No achievements earned yet. Award achievements to students." />
            </div>
          </div>
        )}

        {/* Add Game Modal */}
        {gameModal && (
          <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-bold">{editGame ? 'Edit Game' : 'Add Learning Game'}</h2>
                <button onClick={() => setGameModal(false)} className="p-1.5 rounded-lg hover:bg-gray-100"><X size={16} /></button>
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Title</label>
                  <input value={gameForm.title} onChange={e => setGameForm(f => ({ ...f, title: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" placeholder="Math Challenge" />
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Description</label>
                  <textarea value={gameForm.description} onChange={e => setGameForm(f => ({ ...f, description: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" placeholder="Fun math game for kids" rows={2} />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Subject</label>
                    <select value={gameForm.subject} onChange={e => setGameForm(f => ({ ...f, subject: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                      <option value="">General</option>
                      <option value="Mathematics">Mathematics</option>
                      <option value="Science">Science</option>
                      <option value="English">English</option>
                      <option value="History">History</option>
                      <option value="Geography">Geography</option>
                      <option value="Language">Language</option>
                      <option value="Coding">Coding</option>
                    </select>
                  </div>
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Difficulty</label>
                    <select value={gameForm.difficulty} onChange={e => setGameForm(f => ({ ...f, difficulty: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                      <option value="beginner">Beginner</option>
                      <option value="intermediate">Intermediate</option>
                      <option value="advanced">Advanced</option>
                    </select>
                  </div>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Game Type</label>
                    <select value={gameForm.game_type} onChange={e => setGameForm(f => ({ ...f, game_type: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                      <option value="quiz">Quiz</option>
                      <option value="puzzle">Puzzle</option>
                      <option value="flashcard">Flashcard</option>
                      <option value="simulation">Simulation</option>
                      <option value="challenge">Challenge</option>
                      <option value="interactive">Interactive</option>
                    </select>
                  </div>
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">URL</label>
                    <input value={gameForm.game_url} onChange={e => setGameForm(f => ({ ...f, game_url: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" placeholder="https://..." />
                  </div>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Max Score</label>
                    <input type="number" value={gameForm.max_score} onChange={e => setGameForm(f => ({ ...f, max_score: Number(e.target.value) }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" />
                  </div>
                  <div>
                    <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Duration (min)</label>
                    <input type="number" value={gameForm.duration_minutes} onChange={e => setGameForm(f => ({ ...f, duration_minutes: Number(e.target.value) }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" />
                  </div>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Instructions</label>
                  <textarea value={gameForm.instructions} onChange={e => setGameForm(f => ({ ...f, instructions: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" rows={2} />
                </div>
              </div>
              <div className="flex items-center gap-2 mt-5">
                <button onClick={() => setGameModal(false)} className="flex-1 px-4 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600">Cancel</button>
                <button onClick={handleAddGame} className="flex-1 px-4 py-2 rounded-lg text-xs font-semibold text-white" style={{ background: CLR.primary }}>{editGame ? 'Update' : 'Add Game'}</button>
              </div>
            </div>
          </div>
        )}

        {/* Assign Game Modal */}
        {assignModal && (
          <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl p-6 w-full max-w-md">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-bold">Assign Game</h2>
                <button onClick={() => setAssignModal(false)} className="p-1.5 rounded-lg hover:bg-gray-100"><X size={16} /></button>
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Game</label>
                  <select value={assignForm.game_id} onChange={e => setAssignForm(f => ({ ...f, game_id: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">Select a game...</option>
                    {games.map(g => <option key={g.id} value={g.id}>{g.title} ({g.subject || 'General'})</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Class (optional)</label>
                  <select value={assignForm.class_id} onChange={e => setAssignForm(f => ({ ...f, class_id: e.target.value, student_id: '' }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">All Students</option>
                    {classes.map((c: any) => <option key={c.id} value={c.id}>{c.name}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Specific Student (optional)</label>
                  <select value={assignForm.student_id} onChange={e => setAssignForm(f => ({ ...f, student_id: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">Any</option>
                    {students.map((s: any) => <option key={s.id} value={s.id}>{s.full_name || s.name || s.email}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Due Date</label>
                  <input type="date" value={assignForm.due_date} onChange={e => setAssignForm(f => ({ ...f, due_date: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs" />
                </div>
              </div>
              <div className="flex items-center gap-2 mt-5">
                <button onClick={() => setAssignModal(false)} className="flex-1 px-4 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600">Cancel</button>
                <button onClick={handleAssignGame} className="flex-1 px-4 py-2 rounded-lg text-xs font-semibold text-white" style={{ background: CLR.primary }}>Assign</button>
              </div>
            </div>
          </div>
        )}

        {/* Award Achievement Modal */}
        {awardAchieveModal && (
          <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl p-6 w-full max-w-md">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-bold">Award Achievement</h2>
                <button onClick={() => setAwardAchieveModal(false)} className="p-1.5 rounded-lg hover:bg-gray-100"><X size={16} /></button>
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Student</label>
                  <select value={awardForm.student_id} onChange={e => setAwardForm(f => ({ ...f, student_id: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">Select student...</option>
                    {students.map((s: any) => <option key={s.id} value={s.id}>{s.full_name || s.name || s.email}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Achievement</label>
                  <select value={awardForm.achievement_id} onChange={e => setAwardForm(f => ({ ...f, achievement_id: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">Select achievement...</option>
                    {achievementDefs.map(a => <option key={a.id} value={a.id}>{a.name} ({a.xp_reward} XP)</option>)}
                  </select>
                </div>
              </div>
              <div className="flex items-center gap-2 mt-5">
                <button onClick={() => setAwardAchieveModal(false)} className="flex-1 px-4 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600">Cancel</button>
                <button onClick={handleAwardAchievement} className="flex-1 px-4 py-2 rounded-lg text-xs font-semibold text-white" style={{ background: CLR.primary }}>Award</button>
              </div>
            </div>
          </div>
        )}

        {/* Award XP Modal */}
        {awardXpModal && (
          <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl p-6 w-full max-w-md">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-bold">Award XP</h2>
                <button onClick={() => setAwardXpModal(false)} className="p-1.5 rounded-lg hover:bg-gray-100"><X size={16} /></button>
              </div>
              <div className="space-y-3">
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">Student</label>
                  <select value={xpForm.student_id} onChange={e => setXpForm(f => ({ ...f, student_id: e.target.value }))} className="w-full px-3 py-2 rounded-lg border border-gray-200 text-xs">
                    <option value="">Select student...</option>
                    {students.map((s: any) => <option key={s.id} value={s.id}>{s.full_name || s.name || s.email}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide">XP Amount</label>
                  <div className="flex items-center gap-2">
                    {[10, 25, 50, 100, 200].map(amt => (
                      <button key={amt} onClick={() => setXpForm(f => ({ ...f, xp_amount: amt }))} className={`px-3 py-1.5 rounded-lg text-[10px] font-semibold border ${xpForm.xp_amount === amt ? 'text-white' : 'text-gray-600 border-gray-200'}`} style={xpForm.xp_amount === amt ? { background: CLR.primary, borderColor: CLR.primary } : {}}>{amt}</button>
                    ))}
                  </div>
                </div>
              </div>
              <div className="flex items-center gap-2 mt-5">
                <button onClick={() => setAwardXpModal(false)} className="flex-1 px-4 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600">Cancel</button>
                <button onClick={handleAwardXp} className="flex-1 px-4 py-2 rounded-lg text-xs font-semibold text-white" style={{ background: CLR.warning }}>Award {xpForm.xp_amount} XP</button>
              </div>
            </div>
          </div>
        )}
      </ModulePage>
    );
  };

  function AcademicAnalyticsTab() {
    const [mode, setMode] = useState<'overview' | 'students' | 'classes' | 'subjects' | 'exams' | 'attendance' | 'ai-insights' | 'reports'>('overview');
    const [searchTerm, setSearchTerm] = useState('');
    const [reportType, setReportType] = useState('summary');

    const dash = useApi(() => academicAnalyticsApiV2.getDashboard(), []);
    const students = useApi(() => academicAnalyticsApiV2.getStudentAnalytics({ search: searchTerm || undefined }), [searchTerm]);
    const classesAnalytics = useApi(() => academicAnalyticsApiV2.getClassAnalytics(), []);
    const subjectsAnalytics = useApi(() => academicAnalyticsApiV2.getSubjectAnalytics(), []);
    const examAnalytics = useApi(() => academicAnalyticsApiV2.getExamAnalytics(), []);
    const attendanceAnalytics = useApi(() => academicAnalyticsApiV2.getAttendanceAnalytics(), []);
    const aiInsights = useApi(() => academicAnalyticsApiV2.getAiInsights(), []);
    const reports = useApi(() => academicAnalyticsApiV2.getReports(reportType !== 'summary' ? reportType : undefined), [reportType]);

    const d = dash.data?.data || dash.data || {};
    const summary = d.summary || {};
    const NAVS = [
      { key: 'overview', label: 'Overview', icon: LayoutDashboard },
      { key: 'students', label: 'Students', icon: Users },
      { key: 'classes', label: 'Classes', icon: GraduationCap },
      { key: 'subjects', label: 'Subjects', icon: BookOpen },
      { key: 'exams', label: 'Exams', icon: FileText },
      { key: 'attendance', label: 'Attendance', icon: CalendarCheck },
      { key: 'ai-insights', label: 'AI Insights', icon: Bot },
      { key: 'reports', label: 'Reports', icon: FileSpreadsheet },
    ];

    const renderOverview = () => {
      const s = summary;
      const kpis = [
        { icon: TrendingUp, label: 'Academic Score', value: `${s.avgAcademicScore || 0}%`, trend: 'overall', color: '#6D4CFF' },
        { icon: Award, label: 'Pass Rate', value: `${s.passPercentage || 0}%`, trend: 'exams', color: '#22C55E' },
        { icon: BookOpen, label: 'Avg Grade', value: `${s.avgGradeScore || 0}`, trend: 'grades', color: '#3B82F6' },
        { icon: FileText, label: 'Avg Exam', value: `${s.avgExamScore || 0}%`, trend: 'exams', color: '#F59E0B' },
        { icon: ClipboardList, label: 'Avg Assignment', value: `${s.avgAssignmentScore || 0}`, trend: 'assignments', color: '#A855F7' },
        { icon: CalendarCheck, label: 'Attendance Rate', value: `${s.attendanceRate || 0}%`, trend: 'attendance', color: '#22C55E' },
        { icon: Users, label: 'Active Students', value: `${s.totalStudents || 0}`, trend: 'students', color: '#6D4CFF' },
        { icon: AlertTriangle, label: 'At-Risk Students', value: `${s.atRiskStudents || 0}`, trend: 'risk', color: '#EF4444' },
      ];
      return (
        <>
          <div className="grid grid-cols-4 gap-3 mb-6">
            {kpis.map(k => (
              <KpiCard key={k.label} icon={k.icon} label={k.label} value={k.value} color={k.color} bg={`${k.color}10`} />
            ))}
          </div>
          <div className="grid grid-cols-2 gap-6">
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Subject Performance</h4>
              {subjectsAnalytics.loading ? <LoadingSkeleton rows={5} cols={2} /> : subjectsAnalytics.error ? <ErrorState message={subjectsAnalytics.error} /> : (
                <div className="space-y-2">
                  {(subjectsAnalytics.data?.data || subjectsAnalytics.data || []).slice(0, 6).map((sub: any) => (
                    <div key={sub.subject_id} className="flex items-center justify-between">
                      <span className="text-[10px] text-gray-600">{sub.subject_name}</span>
                      <div className="flex items-center gap-2">
                        <div className="w-24 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                          <div className="h-full rounded-full" style={{ width: `${sub.avgScore}%`, background: sub.avgScore >= 75 ? '#22C55E' : sub.avgScore >= 50 ? '#F59E0B' : '#EF4444' }} />
                        </div>
                        <span className="text-[10px] font-semibold text-gray-700 w-8 text-right">{sub.avgScore}%</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Class Performance</h4>
              {classesAnalytics.loading ? <LoadingSkeleton rows={5} cols={2} /> : classesAnalytics.error ? <ErrorState message={classesAnalytics.error} /> : (
                <div className="space-y-2">
                  {(classesAnalytics.data?.data || classesAnalytics.data || []).slice(0, 6).map((cls: any) => (
                    <div key={cls.class_id} className="flex items-center justify-between">
                      <span className="text-[10px] text-gray-600">{cls.class_name}</span>
                      <div className="flex items-center gap-2">
                        <div className="w-24 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                          <div className="h-full rounded-full" style={{ width: `${cls.avgScore}%`, background: cls.avgScore >= 75 ? '#22C55E' : cls.avgScore >= 50 ? '#F59E0B' : '#EF4444' }} />
                        </div>
                        <span className="text-[10px] font-semibold text-gray-700 w-8 text-right">{cls.avgScore}%</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Grade Distribution</h4>
              {(d.gradeDistribution || []).map((g: any) => (
                <div key={g.label} className="flex items-center gap-2 mb-2">
                  <span className="text-[9px] text-gray-500 w-20">{g.label}</span>
                  <div className="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                    <div className="h-full rounded-full" style={{ width: `${g.percentage}%`, background: g.label.startsWith('A') ? '#22C55E' : g.label.startsWith('B') ? '#3B82F6' : g.label.startsWith('C') ? '#F59E0B' : g.label.startsWith('D') ? '#A855F7' : '#EF4444' }} />
                  </div>
                  <span className="text-[9px] font-medium text-gray-600 w-6 text-right">{g.count}</span>
                </div>
              ))}
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Top Performing Students</h4>
              {(d.topStudents || []).length === 0 ? <EmptyState message="No data" /> : (
                <div className="space-y-2">
                  {(d.topStudents || []).slice(0, 5).map((s: any, i: number) => (
                    <div key={s.id || i} className="flex items-center gap-2">
                      <span className="text-[9px] font-bold text-gray-400 w-4">{i + 1}.</span>
                      <div className="w-6 h-6 rounded-full bg-[#6D4CFF] flex items-center justify-center text-white text-[8px] font-bold">{s.full_name?.[0] || '?'}</div>
                      <div className="flex-1">
                        <p className="text-[10px] font-medium text-gray-700">{s.full_name}</p>
                        <p className="text-[8px] text-gray-400">GPA: {s.gpa} | Risk: {s.riskLevel}</p>
                      </div>
                      <span className="text-[10px] font-bold" style={{ color: s.riskLevel === 'low' ? '#22C55E' : s.riskLevel === 'medium' ? '#F59E0B' : '#EF4444' }}>{s.avgGrade}%</span>
                    </div>
                  ))}
                </div>
              )}
            </Card>
            <Card className="p-4 col-span-2">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Performance Trend</h4>
              {(d.performanceTrend || []).length === 0 ? <EmptyState message="No trend data" /> : (
                <div className="flex items-end gap-3 h-24">
                  {(d.performanceTrend || []).map((t: any, i: number) => {
                    const h = Math.max(8, (t.avgScore / 100) * 96);
                    return (
                      <div key={i} className="flex-1 flex flex-col items-center gap-1">
                        <span className="text-[8px] font-medium text-gray-500">{t.avgScore}%</span>
                        <div className="w-full rounded-md" style={{ height: `${h}px`, background: t.avgScore >= 75 ? '#22C55E' : t.avgScore >= 50 ? '#F59E0B' : '#EF4444', opacity: 0.8 }} />
                        <span className="text-[7px] text-gray-400 truncate w-full text-center">{t.label || `Term ${i + 1}`}</span>
                      </div>
                    );
                  })}
                </div>
              )}
            </Card>
          </div>
        </>
      );
    };

    const renderStudents = () => (
      <div>
        <div className="flex items-center gap-2 mb-4">
          <input type="text" placeholder="Search students..." value={searchTerm} onChange={e => setSearchTerm(e.target.value)}
            className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
          <button onClick={() => students.refetch()} className="px-3 py-2 rounded-lg bg-gray-100 text-xs font-semibold text-gray-600"><RotateCcw size={14} /></button>
        </div>
        {students.loading ? <LoadingSkeleton rows={8} cols={6} /> : students.error ? <ErrorState message={students.error} onRetry={students.refetch} /> : (
          <DataTable
            columns={[
              { key: 'roll_number', label: 'Roll No' },
              { key: 'full_name', label: 'Name' },
              { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => <span className="font-semibold">{v}</span> },
              { key: 'avgExamScore', label: 'Exam Avg', render: (v: number) => <span>{v}%</span> },
              { key: 'attendancePct', label: 'Attendance', render: (v: number) => <Badge variant={v >= 85 ? 'success' : v >= 75 ? 'warning' : 'danger'}>{v}%</Badge> },
              { key: 'gpa', label: 'GPA', render: (v: string) => <span className="font-bold">{v}</span> },
              { key: 'riskLevel', label: 'Risk', render: (v: string) => <Badge variant={v === 'low' ? 'success' : v === 'medium' ? 'warning' : 'danger'} className="text-[9px]">{v}</Badge> },
              { key: 'growth', label: 'Growth', render: (v: number) => <span style={{ color: v >= 0 ? '#22C55E' : '#EF4444' }}>{v > 0 ? '+' : ''}{v}%</span> },
            ]}
            data={students.data?.data || students.data || []}
            loading={false}
            emptyMessage="No students found"
          />
        )}
      </div>
    );

    const renderClasses = () => (
      <div className="grid grid-cols-3 gap-4">
        {classesAnalytics.loading ? <LoadingSkeleton rows={4} cols={3} /> : classesAnalytics.error ? <ErrorState message={classesAnalytics.error} /> : (
          (classesAnalytics.data?.data || classesAnalytics.data || []).map((cls: any) => (
            <Card key={cls.class_id} className="p-4">
              <div className="flex items-center justify-between mb-3">
                <h4 className="text-xs font-semibold text-gray-800">{cls.class_name}</h4>
                <Badge variant={cls.avgScore >= 75 ? 'success' : cls.avgScore >= 50 ? 'warning' : 'danger'}>{cls.avgScore}%</Badge>
              </div>
              <div className="space-y-1.5">
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Exam Avg</span><span className="font-medium">{cls.avgExamScore}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Grade Avg</span><span className="font-medium">{cls.avgGradeScore}</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Attendance</span><span className="font-medium">{cls.attendanceRate}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Pass Rate</span><span className="font-medium">{cls.passRate}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Students</span><span className="font-medium">{cls.studentCount}</span></div>
              </div>
            </Card>
          ))
        )}
      </div>
    );

    const renderSubjects = () => (
      <div className="grid grid-cols-3 gap-4">
        {subjectsAnalytics.loading ? <LoadingSkeleton rows={4} cols={3} /> : subjectsAnalytics.error ? <ErrorState message={subjectsAnalytics.error} /> : (
          (subjectsAnalytics.data?.data || subjectsAnalytics.data || []).map((sub: any) => (
            <Card key={sub.subject_id} className="p-4">
              <div className="flex items-center justify-between mb-3">
                <h4 className="text-xs font-semibold text-gray-800">{sub.subject_name}</h4>
                <Badge variant={sub.difficulty === 'easy' ? 'success' : sub.difficulty === 'medium' ? 'warning' : 'danger'}>{sub.difficulty}</Badge>
              </div>
              <div className="space-y-1.5">
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Avg Score</span><span className="font-medium">{sub.avgScore}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Exam Avg</span><span className="font-medium">{sub.avgExamScore}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Grade Avg</span><span className="font-medium">{sub.avgGradeScore}</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Pass Rate</span><span className="font-medium">{sub.passRate}%</span></div>
                <div className="flex justify-between text-[9px]"><span className="text-gray-400">Students</span><span className="font-medium">{sub.totalStudents}</span></div>
              </div>
            </Card>
          ))
        )}
      </div>
    );

    const renderExams = () => (
      <div>
        {examAnalytics.loading ? <LoadingSkeleton rows={6} cols={4} /> : examAnalytics.error ? <ErrorState message={examAnalytics.error} /> : (
          <DataTable
            columns={[
              { key: 'exam_title', label: 'Exam' },
              { key: 'exam_type', label: 'Type' },
              { key: 'total_marks', label: 'Max Marks' },
              { key: 'avgScore', label: 'Avg Score', render: (v: number) => <span className="font-semibold">{v}%</span> },
              { key: 'passRate', label: 'Pass Rate', render: (v: number) => <Badge variant={v >= 75 ? 'success' : v >= 50 ? 'warning' : 'danger'}>{v}%</Badge> },
              { key: 'totalStudents', label: 'Students' },
            ]}
            data={examAnalytics.data?.data || examAnalytics.data || []}
            loading={false}
            emptyMessage="No exam data"
          />
        )}
      </div>
    );

    const renderAttendance = () => {
      const att = attendanceAnalytics.data?.data || attendanceAnalytics.data || {};
      const attSummary = att.summary || {};
      return (
        <>
          {attendanceAnalytics.loading ? <LoadingSkeleton rows={2} cols={4} /> : attendanceAnalytics.error ? <ErrorState message={attendanceAnalytics.error} /> : (
            <>
              <div className="grid grid-cols-5 gap-3 mb-6">
                <KpiCard icon={CalendarCheck} label="Total" value={attSummary.total || 0} color="#6D4CFF" bg="#6D4CFF10" />
                <KpiCard icon={CheckCircle} label="Present" value={attSummary.present || 0} color="#22C55E" bg="#22C55E10" />
                <KpiCard icon={XCircle} label="Absent" value={attSummary.absent || 0} color="#EF4444" bg="#EF444410" />
                <KpiCard icon={Clock} label="Late" value={attSummary.late || 0} color="#F59E0B" bg="#F59E0B10" />
                <KpiCard icon={TrendingUp} label="Rate" value={`${attSummary.rate || 0}%`} color="#3B82F6" bg="#3B82F610" />
              </div>
              {(att.monthlyTrend || []).length > 0 && (
                <Card className="p-4">
                  <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Monthly Attendance Rate</h4>
                  <div className="flex items-end gap-3 h-24">
                    {(att.monthlyTrend || []).map((m: any, i: number) => (
                      <div key={i} className="flex-1 flex flex-col items-center gap-1">
                        <span className="text-[8px] font-medium text-gray-500">{m.rate}%</span>
                        <div className="w-full rounded-md" style={{ height: `${Math.max(8, (m.rate / 100) * 96)}px`, background: m.rate >= 85 ? '#22C55E' : m.rate >= 75 ? '#F59E0B' : '#EF4444', opacity: 0.8 }} />
                        <span className="text-[7px] text-gray-400">{m.month}</span>
                      </div>
                    ))}
                  </div>
                </Card>
              )}
            </>
          )}
        </>
      );
    };

    const renderAiInsights = () => {
      const ai = aiInsights.data?.data || aiInsights.data || {};
      return (
        <>
          {aiInsights.loading ? <LoadingSkeleton rows={4} cols={3} /> : aiInsights.error ? <ErrorState message={aiInsights.error} /> : (
            <div className="space-y-6">
              <div className="grid grid-cols-3 gap-4">
                <KpiCard icon={AlertTriangle} label="At-Risk Students" value={ai.totalAtRisk || 0} color="#EF4444" bg="#FEF2F2" />
                <KpiCard icon={TrendingDown} label="Predicted Failures" value={ai.predictedFailures || 0} color="#F59E0B" bg="#FFFBEB" />
                <KpiCard icon={Lightbulb} label="Suggestions" value={(ai.improvementSuggestions || []).length} color="#3B82F6" bg="#EFF6FF" />
              </div>
              <Card className="p-4">
                <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Improvement Suggestions</h4>
                {((ai.improvementSuggestions || []).length === 0 && (ai.atRiskStudents || []).length === 0) ? <EmptyState message="All clear" /> : (
                  <div className="space-y-4">
                    {(ai.improvementSuggestions || []).map((s: string, i: number) => (
                      <div key={i} className="flex items-start gap-2">
                        <Lightbulb size={14} className="text-[#F59E0B] mt-0.5" />
                        <p className="text-[10px] text-gray-600">{s}</p>
                      </div>
                    ))}
                  </div>
                )}
              </Card>
              {(ai.atRiskStudents || []).length > 0 && (
                <Card className="p-4">
                  <h4 className="text-[11px] font-semibold text-gray-700 mb-3">At-Risk Students</h4>
                  <DataTable
                    columns={[
                      { key: 'roll_number', label: 'Roll No' },
                      { key: 'student_name', label: 'Name' },
                      { key: 'attendanceRate', label: 'Att %', render: (v: number) => <Badge variant={v >= 85 ? 'success' : 'warning'}>{v}%</Badge> },
                      { key: 'avgExamScore', label: 'Exam Avg', render: (v: number) => <span>{v}%</span> },
                      { key: 'avgAssignmentScore', label: 'Assignment Avg', render: (v: number) => <span>{v}</span> },
                      { key: 'overallScore', label: 'Overall', render: (v: number) => <span className="font-bold">{v}%</span> },
                      { key: 'riskLevel', label: 'Risk', render: (v: string) => <Badge variant={v === 'critical' ? 'danger' : v === 'high' ? 'warning' : 'success'} className="text-[9px]">{v}</Badge> },
                    ]}
                    data={ai.atRiskStudents || []}
                    loading={false}
                    emptyMessage="No at-risk students"
                  />
                </Card>
              )}
            </div>
          )}
        </>
      );
    };

    const renderReports = () => (
      <div>
        <div className="flex items-center gap-2 mb-4">
          <select value={reportType} onChange={e => setReportType(e.target.value)}
            className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
            <option value="summary">Summary</option>
            <option value="student-performance">Student Performance</option>
            <option value="class-performance">Class Performance</option>
            <option value="subject-performance">Subject Performance</option>
            <option value="examination">Examination</option>
          </select>
          <button onClick={() => reports.refetch()} className="px-3 py-2 rounded-lg bg-gray-100 text-xs font-semibold text-gray-600"><RotateCcw size={14} /></button>
          <button onClick={async () => {
            const res = await academicAnalyticsApiV2.exportReport(reportType !== 'summary' ? reportType : undefined, 'json');
            if (res.success) toast.success('Report exported');
          }} className="px-3 py-2 rounded-lg text-white text-xs font-semibold" style={{ background: '#6D4CFF' }}>
            <Download size={14} className="inline mr-1" /> Export
          </button>
        </div>
        {reports.loading ? <LoadingSkeleton rows={6} cols={5} /> : reports.error ? <ErrorState message={reports.error} /> : (
          <DataTable
            columns={[
              { key: reportType === 'student-performance' ? 'full_name' : reportType === 'class-performance' ? 'class_name' : reportType === 'subject-performance' ? 'subject_name' : 'exam_title', label: 'Name' },
              { key: 'avgScore', label: 'Avg Score', render: (v: number) => <span className="font-semibold">{v}%</span> },
              { key: 'passRate', label: 'Pass Rate', render: (v: number) => <Badge variant={v >= 75 ? 'success' : 'warning'}>{v}%</Badge> },
              { key: 'totalStudents', label: 'Count' },
            ]}
            data={
              (reports.data?.data?.students || reports.data?.data?.classes || reports.data?.data?.subjects || reports.data?.data?.exams || reports.data?.data || [])
            }
            loading={false}
            emptyMessage="No report data"
          />
        )}
      </div>
    );

    return (
      <ModulePage title="Academic Analytics" desc="Comprehensive academic performance analytics, student insights, and AI-powered recommendations">
        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key as any)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>
        {dash.loading && mode === 'overview' ? <LoadingSkeleton rows={4} cols={4} /> : (
          <>
            {mode === 'overview' && renderOverview()}
            {mode === 'students' && renderStudents()}
            {mode === 'classes' && renderClasses()}
            {mode === 'subjects' && renderSubjects()}
            {mode === 'exams' && renderExams()}
            {mode === 'attendance' && renderAttendance()}
            {mode === 'ai-insights' && renderAiInsights()}
            {mode === 'reports' && renderReports()}
          </>
        )}
      </ModulePage>
    );
  }

  function AiTeachingTab() {
    const [mode, setMode] = useState<'assistants' | 'support' | 'tools' | 'content' | 'analytics' | 'knowledge' | 'reports'>('assistants');
    const [chatOpen, setChatOpen] = useState(false);
    const [messages, setMessages] = useState<{ role: string; text: string }[]>([]);
    const [chatInput, setChatInput] = useState('');
    const [filterSearch, setFilterSearch] = useState('');
    const [filterType, setFilterType] = useState('');
    const [filterStatus, setFilterStatus] = useState('');
    const [genType, setGenType] = useState('lesson');
    const [genForm, setGenForm] = useState({ title: '', subject: '', topic: '', class: '', duration: 45 });
    const [kbSearch, setKbSearch] = useState('');

    const dash = useApi(() => aiTeachingApiV2.getDashboard(), []);
    const assistants = useApi(() => aiTeachingApiV2.getAssistants({ search: filterSearch || undefined, type: filterType || undefined, status: filterStatus || undefined }), [filterSearch, filterType, filterStatus]);
    const convos = useApi(() => aiTeachingApiV2.getConversations({ limit: 50 }), []);
    const support = useApi(() => aiTeachingApiV2.getStudentSupport(), []);
    const tools = useApi(() => aiTeachingApiV2.getTeacherTools(), []);
    const analytics = useApi(() => aiTeachingApiV2.getAnalytics(), []);
    const kb = useApi(() => aiTeachingApiV2.getKnowledgeBase({ search: kbSearch || undefined }), [kbSearch]);
    const reports = useApi(() => aiTeachingApiV2.getReports(), []);

    const dd = dash.data?.data || dash.data || {};
    const NAVS = [
      { key: 'assistants', label: 'AI Assistants', icon: Bot },
      { key: 'support', label: 'Student Support', icon: GraduationCap },
      { key: 'tools', label: 'Teacher Tools', icon: Wrench },
      { key: 'content', label: 'Content Gen', icon: FileText },
      { key: 'analytics', label: 'Analytics', icon: BarChart3 },
      { key: 'knowledge', label: 'Knowledge Base', icon: Library },
      { key: 'reports', label: 'Reports', icon: FileSpreadsheet },
    ];

    const ASSISTANTS_LIST = [
      { name: 'AI Subject Tutor', desc: 'Personalized subject tutoring with adaptive learning paths', usage: 1284, accuracy: 94, icon: GraduationCap, color: '#6D4CFF' },
      { name: 'AI Homework Assistant', desc: 'Step-by-step homework help and problem solving', usage: 3452, accuracy: 92, icon: BookOpen, color: '#22C55E' },
      { name: 'AI Quiz Generator', desc: 'Auto-generate quizzes from any topic or curriculum', usage: 876, accuracy: 96, icon: ClipboardList, color: '#F59E0B' },
      { name: 'AI Lesson Planner', desc: 'Create comprehensive lesson plans aligned to standards', usage: 654, accuracy: 95, icon: CalendarDays, color: '#3B82F6' },
      { name: 'AI Content Creator', desc: 'Generate educational content, notes, and resources', usage: 2341, accuracy: 93, icon: FileText, color: '#A855F7' },
      { name: 'AI Grading Assistant', desc: 'Auto-grade assignments with detailed feedback', usage: 1876, accuracy: 91, icon: Award, color: '#EF4444' },
      { name: 'AI Attendance Assistant', desc: 'Smart attendance tracking with insights', usage: 4321, accuracy: 98, icon: CalendarCheck, color: '#22C55E' },
      { name: 'AI Parent Communication', desc: 'Automated parent updates and communication', usage: 987, accuracy: 97, icon: MessageSquare, color: '#6D4CFF' },
    ];

    const QUICK_PROMPTS = ['Generate Lesson Plan', 'Create Quiz', 'Explain Topic', 'Create Assignment', 'Summarize Chapter', 'Generate Notes', 'Analyze Performance'];

    const handleSendMessage = async () => {
      if (!chatInput.trim()) return;
      setMessages(prev => [...prev, { role: 'user', text: chatInput }]);
      setChatInput('');
      const res = await aiTeachingApiV2.sendMessage({ query: chatInput });
      if (res.success) {
        setMessages(prev => [...prev, { role: 'assistant', text: res.data?.response || 'Processing your request...' }]);
      }
    };

    const handleGenerate = async () => {
      if (genType === 'lesson') await aiTeachingApiV2.generateLesson(genForm);
      else if (genType === 'quiz') await aiTeachingApiV2.generateQuiz(genForm);
      else await aiTeachingApiV2.generateContent({ ...genForm, content_type: genType });
      toast.success(`${genType} generated successfully`);
    };

    const renderKpiCards = () => {
      const kpis = [
        { icon: Bot, label: 'Active Assistants', value: dd.activeAssistants ?? 0, trend: '+0%', color: '#6D4CFF', bg: '#6D4CFF10', chart: [] },
        { icon: MessageSquare, label: 'Q\'s Answered Today', value: dd.questionsAnsweredToday ?? 0, trend: '+0%', color: '#22C55E', bg: '#22C55E10', chart: [] },
        { icon: BookOpen, label: 'AI Generated Lessons', value: dd.aiGeneratedLessons ?? 0, trend: '+0%', color: '#3B82F6', bg: '#3B82F610', chart: [] },
        { icon: ClipboardList, label: 'Assignments Generated', value: dd.assignmentsGenerated ?? 0, trend: '+0%', color: '#F59E0B', bg: '#F59E0B10', chart: [] },
        { icon: Clock, label: 'Time Saved (hrs)', value: dd.timeSavedMinutes ? Math.round(dd.timeSavedMinutes / 60) : 0, trend: '+0%', color: '#A855F7', bg: '#A855F710', chart: [] },
        { icon: Users, label: 'Student Interactions', value: dd.studentInteractions ?? 0, trend: '+0%', color: '#6D4CFF', bg: '#6D4CFF10', chart: [] },
        { icon: TrendingUp, label: 'AI Accuracy Score', value: dd.aiAccuracyScore ? `${dd.aiAccuracyScore}%` : '0%', trend: '+0%', color: '#22C55E', bg: '#22C55E10', chart: [] },
        { icon: Target, label: 'Teacher Adoption', value: dd.teacherAdoptionRate ? `${dd.teacherAdoptionRate}%` : '0%', trend: '+0%', color: '#3B82F6', bg: '#3B82F610', chart: [] },
      ];
      return (
        <div className="grid grid-cols-4 gap-3 mb-6">
          {kpis.map(k => <KpiCard key={k.label} {...k} />)}
        </div>
      );
    };

    const renderFilters = () => (
      <div className="flex items-center gap-2 mb-4 p-3 bg-white rounded-xl border border-gray-100">
        <Search size={14} className="text-gray-400" />
        <input type="text" placeholder="Search by name, subject, teacher..." value={filterSearch}
          onChange={e => setFilterSearch(e.target.value)} className="flex-1 px-2 py-1.5 text-xs border-0 outline-none bg-transparent" />
        <select value={filterType} onChange={e => setFilterType(e.target.value)} className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium text-gray-600 bg-white">
          <option value="">All Types</option>
          <option value="tutor">Tutor</option>
          <option value="homework">Homework</option>
          <option value="quiz">Quiz</option>
          <option value="lesson">Lesson</option>
          <option value="content">Content</option>
          <option value="grading">Grading</option>
          <option value="attendance">Attendance</option>
          <option value="communication">Communication</option>
        </select>
        <select value={filterStatus} onChange={e => setFilterStatus(e.target.value)} className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium text-gray-600 bg-white">
          <option value="">All Status</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
          <option value="draft">Draft</option>
        </select>
      </div>
    );

    const renderAssistants = () => (
      <div>
        {renderFilters()}
        <div className="grid grid-cols-4 gap-4">
          {ASSISTANTS_LIST.map((a, i) => {
            const Icon = a.icon;
            return (
              <Card key={i} className="p-4 hover:shadow-md transition-all group">
                <div className="flex items-start justify-between mb-3">
                  <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ background: `${a.color}15`, color: a.color }}>
                    <Icon size={20} />
                  </div>
                  <button className="opacity-0 group-hover:opacity-100 transition-opacity p-1.5 rounded-lg hover:bg-gray-100 text-gray-400">
                    <Settings size={14} />
                  </button>
                </div>
                <h4 className="text-xs font-bold text-gray-800 mb-1">{a.name}</h4>
                <p className="text-[9px] text-gray-400 mb-3 leading-relaxed">{a.desc}</p>
                <div className="flex items-center justify-between mb-3">
                  <span className="text-[9px] text-gray-500"><Users size={10} className="inline mr-1" />{a.usage.toLocaleString()} uses</span>
                  <Badge variant={a.accuracy >= 95 ? 'success' : a.accuracy >= 90 ? 'warning' : 'danger'} className="text-[8px]">{a.accuracy}%</Badge>
                </div>
                <div className="flex gap-2">
                  <button className="flex-1 py-1.5 rounded-lg text-[10px] font-semibold text-white transition-all hover:shadow-md active:scale-[0.97]"
                    style={{ background: 'linear-gradient(135deg, #6D4CFF, #8B5CF6)' }}
                    onClick={() => { setChatOpen(true); setMessages([]); }}>
                    <Play size={12} className="inline mr-1" /> Launch
                  </button>
                  <button className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium text-gray-600 hover:bg-gray-50 transition-all">
                    <Settings size={12} />
                  </button>
                </div>
              </Card>
            );
          })}
        </div>
      </div>
    );

    const renderChat = () => {
      if (!chatOpen) return null;
      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm" onClick={() => setChatOpen(false)}>
          <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }}
            className="bg-white rounded-2xl shadow-2xl w-[600px] h-[600px] flex flex-col overflow-hidden" onClick={e => e.stopPropagation()}>
            <div className="flex items-center justify-between p-4 border-b border-gray-100">
              <div className="flex items-center gap-2">
                <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center">
                  <Bot size={16} className="text-white" />
                </div>
                <div>
                  <h3 className="text-xs font-bold text-gray-800">AI Teaching Assistant</h3>
                  <p className="text-[9px] text-gray-400">Ask me anything about teaching & learning</p>
                </div>
              </div>
              <button onClick={() => setChatOpen(false)} className="w-7 h-7 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400">×</button>
            </div>
            <div className="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-50/50">
              {messages.length === 0 && (
                <div className="text-center py-8">
                  <Bot size={40} className="mx-auto text-[#6D4CFF] mb-3 opacity-50" />
                  <p className="text-xs text-gray-400 mb-4">Choose a prompt to get started:</p>
                  <div className="flex flex-wrap justify-center gap-2 max-w-md mx-auto">
                    {QUICK_PROMPTS.map(p => (
                      <button key={p} onClick={() => { setMessages(prev => [...prev, { role: 'user', text: p }]); }}
                        className="px-3 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium text-gray-600 hover:border-[#6D4CFF] hover:text-[#6D4CFF] transition-all bg-white">
                        {p}
                      </button>
                    ))}
                  </div>
                </div>
              )}
              {messages.map((m, i) => (
                <motion.div key={i} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}
                  className={`flex gap-2 ${m.role === 'user' ? 'justify-end' : ''}`}>
                  {m.role === 'assistant' && <div className="w-6 h-6 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center flex-shrink-0"><Bot size={12} className="text-white" /></div>}
                  <div className={`max-w-[80%] p-3 rounded-xl text-[11px] leading-relaxed ${m.role === 'user' ? 'bg-[#6D4CFF] text-white rounded-tr-sm' : 'bg-white border border-gray-100 rounded-tl-sm'}`}>
                    {m.text}
                  </div>
                  {m.role === 'user' && <div className="w-6 h-6 rounded-lg bg-gray-200 flex items-center justify-center flex-shrink-0"><Users size={12} className="text-gray-500" /></div>}
                </motion.div>
              ))}
            </div>
            <div className="p-3 border-t border-gray-100 bg-white">
              <div className="flex items-center gap-2 p-2 rounded-xl border border-gray-200 bg-gray-50">
                <button className="p-1.5 rounded-lg hover:bg-white text-gray-400 transition-colors"><Paperclip size={14} /></button>
                <button className="p-1.5 rounded-lg hover:bg-white text-gray-400 transition-colors"><ImageIcon size={14} /></button>
                <button className="p-1.5 rounded-lg hover:bg-white text-gray-400 transition-colors"><FileText size={14} /></button>
                <input type="text" placeholder="Ask the AI Teaching Assistant..." value={chatInput}
                  onChange={e => setChatInput(e.target.value)} onKeyDown={e => e.key === 'Enter' && handleSendMessage()}
                  className="flex-1 px-2 py-1 text-xs border-0 outline-none bg-transparent" />
                <button onClick={handleSendMessage}
                  className="p-2 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] text-white hover:shadow-md active:scale-95 transition-all">
                  <Send size={14} />
                </button>
              </div>
              <p className="text-[8px] text-gray-400 text-center mt-1.5">AI responses are generated for educational purposes. Verify important information.</p>
            </div>
          </motion.div>
        </div>
      );
    };

    const renderStudentSupport = () => {
      const sd = support.data?.data || support.data || {};
      return (
        <div className="grid grid-cols-3 gap-4">
          <Card className="p-4 col-span-2">
            <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Student Activity & Queries</h4>
            {support.loading ? <LoadingSkeleton rows={6} cols={3} /> : support.error ? <ErrorState message={support.error} /> : (
              <DataTable
                columns={[
                  { key: 'user_id', label: 'Student', render: (v: string) => <span className="text-[10px] font-mono">{v?.substring(0, 8)}...</span> },
                  { key: 'query', label: 'Query', render: (v: string) => <span className="text-[10px] line-clamp-1">{v}</span> },
                  { key: 'created_at', label: 'Time', render: (v: string) => <span className="text-[9px] text-gray-400">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                ]}
                data={(sd.recentActivity || []).slice(0, 15)}
                loading={false}
                emptyMessage="No recent queries"
              />
            )}
          </Card>
          <div className="space-y-3">
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-2">Student Metrics</h4>
              <div className="space-y-2">
                <div className="flex justify-between text-[10px]"><span className="text-gray-500">Total Queries</span><span className="font-bold">{sd.totalQueries || 0}</span></div>
                <div className="flex justify-between text-[10px]"><span className="text-gray-500">Active Students</span><span className="font-bold">{sd.uniqueStudents || 0}</span></div>
              </div>
              <div className="mt-3 pt-3 border-t border-gray-100">
                <h5 className="text-[10px] font-semibold text-gray-600 mb-2">Weak Subjects</h5>
                {(sd.weakSubjects || []).length === 0 ? <p className="text-[9px] text-gray-400">No data</p> : (
                  (sd.weakSubjects || []).map((ws: any, i: number) => (
                    <div key={i} className="flex items-center justify-between text-[10px] mb-1">
                      <span className="text-gray-600">{ws.subject}</span>
                      <span className="font-medium text-gray-800">{ws.count} queries</span>
                    </div>
                  ))
                )}
              </div>
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] font-semibold text-gray-700 mb-2">AI Tutor Tools</h4>
              <div className="space-y-1.5">
                {[
                  { label: 'AI Tutor', icon: GraduationCap },
                  { label: 'Doubt Solving', icon: HelpCircle },
                  { label: 'Homework Help', icon: BookOpen },
                  { label: 'Concept Explanation', icon: Lightbulb },
                  { label: 'Practice Questions', icon: ClipboardList },
                  { label: 'Exam Preparation', icon: Target },
                ].map(t => (
                  <button key={t.label} className="flex items-center gap-2 w-full p-2 rounded-lg hover:bg-gray-50 text-[10px] text-gray-600 transition-colors">
                    <t.icon size={12} className="text-[#6D4CFF]" />
                    {t.label}
                  </button>
                ))}
              </div>
            </Card>
          </div>
        </div>
      );
    };

    const renderTeacherTools = () => {
      const td = tools.data?.data || tools.data || {};
      return (
        <div className="grid grid-cols-4 gap-4">
          {[
            { label: 'AI Lesson Planner', icon: CalendarDays, desc: 'Plan comprehensive lessons', color: '#6D4CFF' },
            { label: 'Question Generator', icon: HelpCircle, desc: 'Generate questions from topics', color: '#22C55E' },
            { label: 'Quiz Generator', icon: ClipboardList, desc: 'Auto-create quizzes', color: '#F59E0B' },
            { label: 'Assignment Generator', icon: FileText, desc: 'Create assignments instantly', color: '#3B82F6' },
            { label: 'Exam Paper Generator', icon: FileSpreadsheet, desc: 'Generate exam papers', color: '#A855F7' },
            { label: 'Rubric Generator', icon: Award, desc: 'Create grading rubrics', color: '#EF4444' },
            { label: 'Grading Assistant', icon: CheckCircle, desc: 'Auto-grade with feedback', color: '#22C55E' },
            { label: 'Feedback Generator', icon: MessageSquare, desc: 'Generate student feedback', color: '#6D4CFF' },
          ].map((t, i) => (
            <Card key={i} className="p-4 hover:shadow-md transition-all cursor-pointer group">
              <div className="w-9 h-9 rounded-xl flex items-center justify-center mb-3" style={{ background: `${t.color}15`, color: t.color }}>
                <t.icon size={18} />
              </div>
              <h4 className="text-xs font-bold text-gray-800 mb-1">{t.label}</h4>
              <p className="text-[9px] text-gray-400 mb-3">{t.desc}</p>
              <div className="flex items-center gap-2">
                <span className="text-[9px] text-gray-500">{td.totalLessons || 0} created</span>
                <button className="ml-auto px-2.5 py-1 rounded-lg text-[9px] font-semibold text-white opacity-0 group-hover:opacity-100 transition-all"
                  style={{ background: 'linear-gradient(135deg, #6D4CFF, #8B5CF6)' }}>Use Tool</button>
              </div>
            </Card>
          ))}
        </div>
      );
    };

    const renderContentGeneration = () => (
      <div className="grid grid-cols-3 gap-6">
        <Card className="p-4 col-span-2">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-4">Generate Educational Content</h4>
          <div className="space-y-3">
            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="text-[10px] font-semibold text-gray-600 mb-1 block">Content Type</label>
                <select value={genType} onChange={e => setGenType(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                  <option value="lesson">Lesson Plan</option>
                  <option value="quiz">Quiz</option>
                  <option value="assignment">Assignment</option>
                  <option value="notes">Study Notes</option>
                  <option value="worksheet">Worksheet</option>
                  <option value="exam">Exam Paper</option>
                  <option value="slides">Presentation Slides</option>
                </select>
              </div>
              <div>
                <label className="text-[10px] font-semibold text-gray-600 mb-1 block">Subject</label>
                <select value={genForm.subject} onChange={e => setGenForm(f => ({ ...f, subject: e.target.value }))} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                  <option value="">Select Subject</option>
                  <option value="mathematics">Mathematics</option>
                  <option value="physics">Physics</option>
                  <option value="chemistry">Chemistry</option>
                  <option value="biology">Biology</option>
                  <option value="english">English</option>
                  <option value="history">History</option>
                </select>
              </div>
            </div>
            <div>
              <label className="text-[10px] font-semibold text-gray-600 mb-1 block">Title</label>
              <input type="text" value={genForm.title} onChange={e => setGenForm(f => ({ ...f, title: e.target.value }))}
                placeholder="Enter a title for your content" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            </div>
            <div>
              <label className="text-[10px] font-semibold text-gray-600 mb-1 block">Topic / Description</label>
              <textarea value={genForm.topic} onChange={e => setGenForm(f => ({ ...f, topic: e.target.value }))}
                placeholder="Describe what content you want to generate..." className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-24 resize-none" />
            </div>
            <button onClick={handleGenerate}
              className="w-full py-2.5 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold hover:shadow-md active:scale-[0.98] transition-all">
              <Zap size={14} className="inline mr-1.5" /> Generate {genType === 'lesson' ? 'Lesson Plan' : genType === 'quiz' ? 'Quiz' : genType === 'assignment' ? 'Assignment' : genType === 'notes' ? 'Study Notes' : genType === 'worksheet' ? 'Worksheet' : genType === 'exam' ? 'Exam Paper' : 'Slides'}
            </button>
          </div>
        </Card>
        <div className="space-y-3">
          <Card className="p-4">
            <h4 className="text-[11px] font-semibold text-gray-700 mb-2">Available Content</h4>
            <div className="space-y-2">
              {[
                { label: 'Lesson Plans', count: dd.aiGeneratedLessons || 0 },
                { label: 'Quizzes', count: dd.assignmentsGenerated || 0 },
                { label: 'Worksheets', count: 45 },
                { label: 'Exam Papers', count: 23 },
                { label: 'Study Notes', count: 89 },
                { label: 'Presentations', count: 34 },
              ].map(c => (
                <div key={c.label} className="flex items-center justify-between text-[10px]">
                  <span className="text-gray-600">{c.label}</span>
                  <Badge variant="default" className="text-[9px]">{c.count}</Badge>
                </div>
              ))}
            </div>
          </Card>
          <Card className="p-4">
            <h4 className="text-[11px] font-semibold text-gray-700 mb-2">Quick Actions</h4>
            <div className="space-y-1.5">
              {[
                { label: 'Generate Lesson Plan', icon: CalendarDays, color: '#6D4CFF' },
                { label: 'Create Quiz', icon: ClipboardList, color: '#22C55E' },
                { label: 'Create Assignment', icon: FileText, color: '#F59E0B' },
                { label: 'Generate Notes', icon: BookOpen, color: '#3B82F6' },
              ].map(a => (
                <button key={a.label} onClick={() => { setGenType(a.label.toLowerCase().includes('lesson') ? 'lesson' : a.label.toLowerCase().includes('quiz') ? 'quiz' : a.label.toLowerCase().includes('notes') ? 'notes' : 'assignment'); }}
                  className="flex items-center gap-2 w-full p-2 rounded-lg hover:bg-gray-50 text-[10px] text-gray-600 transition-colors">
                  <a.icon size={12} style={{ color: a.color }} />
                  {a.label}
                </button>
              ))}
            </div>
          </Card>
        </div>
      </div>
    );

    const renderAnalyticsView = () => {
      const ad = analytics.data?.data || analytics.data || {};
      const usageTrend = ad.usageTrend || [];
      const convStats = ad.conversationStats || {};
      const contentStats = ad.contentStats || {};
      return (
        <>
          {analytics.loading ? <LoadingSkeleton rows={6} cols={4} /> : analytics.error ? <ErrorState message={analytics.error} onRetry={analytics.refetch} /> : (
            <div className="grid grid-cols-2 gap-4">
              <Card className="p-4">
                <h4 className="text-[11px] font-semibold text-gray-700 mb-3">AI Usage Trend</h4>
                {usageTrend.length === 0 ? <EmptyState message="No data yet" /> : (
                  <ResponsiveContainer width="100%" height={180}>
                    <AreaChart data={usageTrend}>
                      <defs><linearGradient id="usageGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#6D4CFF" stopOpacity={0.3}/><stop offset="95%" stopColor="#6D4CFF" stopOpacity={0}/></linearGradient></defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="date" tick={{ fontSize: 9 }} tickFormatter={(v: string) => v?.substring(5) || ''} />
                      <YAxis tick={{ fontSize: 9 }} />
                      <Tooltip />
                      <Area type="monotone" dataKey="count" stroke="#6D4CFF" fill="url(#usageGrad)" strokeWidth={2} />
                    </AreaChart>
                  </ResponsiveContainer>
                )}
              </Card>
              <Card className="p-4">
                <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Student Interactions</h4>
                {usageTrend.length === 0 ? <EmptyState message="No data yet" /> : (
                  <ResponsiveContainer width="100%" height={180}>
                    <AreaChart data={usageTrend}>
                      <defs><linearGradient id="interactGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#22C55E" stopOpacity={0.3}/><stop offset="95%" stopColor="#22C55E" stopOpacity={0}/></linearGradient></defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="date" tick={{ fontSize: 9 }} tickFormatter={(v: string) => v?.substring(5) || ''} />
                      <YAxis tick={{ fontSize: 9 }} />
                      <Tooltip />
                      <Area type="monotone" dataKey="count" stroke="#22C55E" fill="url(#interactGrad)" strokeWidth={2} />
                    </AreaChart>
                  </ResponsiveContainer>
                )}
              </Card>
              <Card className="p-4">
                <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Content Generation Stats</h4>
                <div className="grid grid-cols-2 gap-3">
                  <div className="p-3 rounded-xl bg-gray-50 text-center"><div className="text-lg font-extrabold text-gray-800">{contentStats.total || 0}</div><div className="text-[9px] text-gray-500">Total Content</div></div>
                  <div className="p-3 rounded-xl bg-green-50 text-center"><div className="text-lg font-extrabold text-green-600">{contentStats.published || 0}</div><div className="text-[9px] text-green-500">Published</div></div>
                  <div className="p-3 rounded-xl bg-gray-50 text-center"><div className="text-lg font-extrabold text-gray-800">{convStats.total || 0}</div><div className="text-[9px] text-gray-500">Conversations</div></div>
                  <div className="p-3 rounded-xl bg-purple-50 text-center"><div className="text-lg font-extrabold text-[#6D4CFF]">{convStats.uniqueUsers || 0}</div><div className="text-[9px] text-purple-500">Active Users</div></div>
                </div>
              </Card>
              <Card className="p-4">
                <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Assistant Accuracy</h4>
                {(ad.assistantAccuracy || []).length === 0 ? <EmptyState message="No data" /> : (
                  <div className="space-y-2">
                    {(ad.assistantAccuracy || []).slice(0, 6).map((a: any, i: number) => (
                      <div key={i} className="flex items-center justify-between">
                        <span className="text-[10px] text-gray-600">{a.name}</span>
                        <div className="flex items-center gap-2">
                          <div className="w-20 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                            <div className="h-full rounded-full" style={{ width: `${a.accuracy}%`, background: a.accuracy >= 95 ? '#22C55E' : a.accuracy >= 90 ? '#F59E0B' : '#EF4444' }} />
                          </div>
                          <span className="text-[10px] font-semibold text-gray-700 w-8 text-right">{a.accuracy}%</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </Card>
            </div>
          )}
        </>
      );
    };

    const renderKnowledgeBase = () => (
      <div className="grid grid-cols-3 gap-4">
        <Card className="p-4 col-span-2">
          <div className="flex items-center justify-between mb-3">
            <h4 className="text-[11px] font-semibold text-gray-700">Knowledge Base Documents</h4>
            <button className="px-3 py-1.5 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] text-white text-[10px] font-semibold hover:shadow-md transition-all">
              <Upload size={12} className="inline mr-1" /> Upload
            </button>
          </div>
          <div className="relative mb-3">
            <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
            <input type="text" placeholder="Search knowledge base..." value={kbSearch}
              onChange={e => setKbSearch(e.target.value)} className="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-lg text-xs" />
          </div>
          {kb.loading ? <LoadingSkeleton rows={6} cols={3} /> : kb.error ? <ErrorState message={kb.error} /> : (
            <DataTable
              columns={[
                { key: 'title', label: 'Document' },
                { key: 'document_type', label: 'Type', render: (v: string) => <Badge className="text-[9px]">{v || 'document'}</Badge> },
                { key: 'created_at', label: 'Added', render: (v: string) => <span className="text-[9px] text-gray-400">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <button onClick={() => aiTeachingApiV2.deleteKnowledgeDoc(row.id).then(() => kb.refetch())} className="text-[#EF4444] text-[10px] hover:underline">Delete</button>
                )},
              ]}
              data={(kb.data as any)?.data || kb.data || []}
              loading={false}
              emptyMessage="No documents in knowledge base. Upload your first document."
            />
          )}
        </Card>
        <div className="space-y-3">
          <Card className="p-4">
            <h4 className="text-[11px] font-semibold text-gray-700 mb-2">Document Types</h4>
            <div className="space-y-2">
              {[
                { label: 'Textbooks', count: 12, icon: BookOpen },
                { label: 'Notes', count: 45, icon: FileText },
                { label: 'PDFs', count: 23, icon: FileText },
                { label: 'Question Banks', count: 34, icon: ClipboardList },
                { label: 'Policies', count: 8, icon: Shield },
                { label: 'Curriculum', count: 15, icon: BookOpen },
              ].map(d => (
                <div key={d.label} className="flex items-center justify-between text-[10px]">
                  <span className="flex items-center gap-1.5 text-gray-600"><d.icon size={12} className="text-[#6D4CFF]" />{d.label}</span>
                  <Badge variant="default" className="text-[9px]">{d.count}</Badge>
                </div>
              ))}
            </div>
          </Card>
          <Card className="p-4">
            <h4 className="text-[11px] font-semibold text-gray-700 mb-2">AI Knowledge Retrieval</h4>
            <p className="text-[9px] text-gray-400 mb-3">Upload documents for semantic search and AI-powered retrieval</p>
            <div className="space-y-1.5">
              {['Vector Search', 'Semantic Search', 'AI Retrieval'].map(f => (
                <div key={f} className="flex items-center gap-2">
                  <CheckCircle size={12} className="text-[#22C55E]" />
                  <span className="text-[10px] text-gray-600">{f}</span>
                </div>
              ))}
            </div>
          </Card>
        </div>
      </div>
    );

    const renderReports = () => {
      const reportTypes = [
        { key: 'usage', label: 'AI Usage Report', icon: BarChart3, color: '#6D4CFF' },
        { key: 'learning', label: 'Student Learning Report', icon: GraduationCap, color: '#22C55E' },
        { key: 'productivity', label: 'Teacher Productivity Report', icon: TrendingUp, color: '#3B82F6' },
        { key: 'content', label: 'Content Generation Report', icon: FileText, color: '#F59E0B' },
        { key: 'improvement', label: 'Performance Improvement Report', icon: Target, color: '#A855F7' },
      ];
      return (
        <div className="grid grid-cols-3 gap-4">
          {reportTypes.map(r => (
            <Card key={r.key} className="p-4 hover:shadow-md transition-all cursor-pointer group">
              <div className="w-10 h-10 rounded-xl flex items-center justify-center mb-3" style={{ background: `${r.color}15`, color: r.color }}>
                <r.icon size={20} />
              </div>
              <h4 className="text-xs font-bold text-gray-800 mb-1">{r.label}</h4>
              <p className="text-[9px] text-gray-400 mb-3">View and export {r.label.toLowerCase()}</p>
              <div className="flex gap-2">
                <button className="flex-1 py-1.5 rounded-lg text-[10px] font-semibold text-white transition-all"
                  style={{ background: 'linear-gradient(135deg, #6D4CFF, #8B5CF6)' }}
                  onClick={async () => { const res = await aiTeachingApiV2.getReports(r.key); if (res.success) toast.success('Report generated'); }}>
                  <Eye size={12} className="inline mr-1" /> View
                </button>
                <button className="px-2.5 py-1.5 rounded-lg border border-gray-200 text-[10px] font-medium text-gray-600 hover:bg-gray-50 transition-all">
                  <Download size={12} />
                </button>
              </div>
              <div className="flex items-center gap-2 mt-3 pt-3 border-t border-gray-100 text-[9px] text-gray-400">
                <span>Export: PDF</span>
                <span className="w-1 h-1 rounded-full bg-gray-300" />
                <span>Excel</span>
                <span className="w-1 h-1 rounded-full bg-gray-300" />
                <span>CSV</span>
              </div>
            </Card>
          ))}
        </div>
      );
    };

    return (
      <ModulePage title="AI Teaching Assistants"
        desc="AI-powered assistants for teaching, learning, grading, content generation, and student support."
        actions={
          <div className="flex items-center gap-2">
            <button className="px-3.5 py-2 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] text-white text-[11px] font-semibold hover:shadow-md active:scale-[0.97] transition-all">
              <Plus size={14} className="inline mr-1.5" /> Create AI Assistant
            </button>
            <button onClick={() => setMode('knowledge')} className="px-3 py-2 rounded-lg border border-gray-200 text-[11px] font-semibold text-gray-600 hover:bg-gray-50 transition-all">
              <Library size={14} className="inline mr-1.5" /> Knowledge Base
            </button>
            <button className="px-3 py-2 rounded-lg border border-gray-200 text-[11px] font-semibold text-gray-600 hover:bg-gray-50 transition-all">
              <Settings size={14} className="inline mr-1.5" /> Settings
            </button>
            <button onClick={() => setMode('analytics')} className="px-3 py-2 rounded-lg border border-gray-200 text-[11px] font-semibold text-gray-600 hover:bg-gray-50 transition-all">
              <BarChart3 size={14} className="inline mr-1.5" /> Analytics
            </button>
            <button onClick={() => setMode('reports')} className="px-3 py-2 rounded-lg border border-gray-200 text-[11px] font-semibold text-gray-600 hover:bg-gray-50 transition-all">
              <FileSpreadsheet size={14} className="inline mr-1.5" /> Reports
            </button>
          </div>
        }>
        {/* Tab Navigation */}
        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key as any)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>

        {/* KPI Dashboard */}
        {mode === 'assistants' && renderKpiCards()}

        {/* Main Content */}
        {mode === 'assistants' && renderAssistants()}
        {mode === 'support' && renderStudentSupport()}
        {mode === 'tools' && renderTeacherTools()}
        {mode === 'content' && renderContentGeneration()}
        {mode === 'analytics' && renderAnalyticsView()}
        {mode === 'knowledge' && renderKnowledgeBase()}
        {mode === 'reports' && renderReports()}

        {/* AI Chat Interface */}
        {renderChat()}

        {/* Role Access Info */}
        <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-purple-100">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              {[
                { role: 'Admin', access: 'Full Access', color: '#6D4CFF' },
                { role: 'Principal', access: 'Analytics + Monitoring', color: '#22C55E' },
                { role: 'Teacher', access: 'Teaching Tools + AI Content', color: '#3B82F6' },
                { role: 'Student', access: 'AI Tutor + Learning Support', color: '#F59E0B' },
                { role: 'Parent', access: 'Learning Progress Insights', color: '#A855F7' },
              ].map(r => (
                <div key={r.role} className="text-center">
                  <div className="text-[9px] font-bold" style={{ color: r.color }}>{r.role}</div>
                  <div className="text-[7px] text-gray-400">{r.access}</div>
                </div>
              ))}
            </div>
            <Badge variant="purple" className="text-[9px]">Enterprise Plan</Badge>
          </div>
        </div>
      </ModulePage>
    );
  }

  // ====================== PREDICTIVE AI TAB ======================
  function PredictiveAITab() {
    const [mode, setMode] = useState<'risk' | 'students' | 'attendance' | 'academic' | 'dropout' | 'interventions' | 'insights' | 'reports'>('risk');
    const [acYear, setAcYear] = useState('');
    const [cls, setCls] = useState('');
    const [section, setSection] = useState('');
    const [subject, setSubject] = useState('');
    const [student, setStudent] = useState('');
    const [predType, setPredType] = useState('');
    const [riskFilter, setRiskFilter] = useState('');
    const [dateRange, setDateRange] = useState('');
    const [searchQ, setSearchQ] = useState('');

    const dash = useApi(() => predictiveAiApiV2.getDashboard(), []);
    const riskAnalysis = useApi(() => predictiveAiApiV2.getRiskAnalysis(), []);
    const predictions = useApi(() => predictiveAiApiV2.getStudentPredictions({ search: searchQ || undefined, class: cls || undefined, risk: riskFilter || undefined }), [searchQ, cls, riskFilter]);
    const attendForecast = useApi(() => predictiveAiApiV2.getAttendanceForecast(), []);
    const academicForecast = useApi(() => predictiveAiApiV2.getAcademicForecast(), []);
    const dropoutPred = useApi(() => predictiveAiApiV2.getDropoutPrediction(), []);
    const interventions = useApi(() => predictiveAiApiV2.getInterventions(), []);
    const analytics = useApi(() => predictiveAiApiV2.getAnalytics(), []);
    const insights = useApi(() => predictiveAiApiV2.getAiInsights(), []);
    const reportsData = useApi(() => predictiveAiApiV2.getReports(), []);
    const sidebar = useApi(() => predictiveAiApiV2.getSidebar(), []);

    const dd = dash.data?.data || dash.data || {};
    const rd = riskAnalysis.data?.data || riskAnalysis.data || {};
    const ad = analytics.data?.data || analytics.data || {};
    const sd = sidebar.data?.data || sidebar.data || {};

    const NAVS = [
      { key: 'risk', label: 'Risk Analysis', icon: AlertTriangle },
      { key: 'students', label: 'Student Predictions', icon: Users },
      { key: 'attendance', label: 'Attendance Forecasting', icon: CalendarCheck },
      { key: 'academic', label: 'Academic Forecasting', icon: TrendingUp },
      { key: 'dropout', label: 'Dropout Prediction', icon: GraduationCap },
      { key: 'interventions', label: 'Intervention Center', icon: Activity },
      { key: 'insights', label: 'AI Insights', icon: Brain },
      { key: 'reports', label: 'Reports', icon: FileText },
    ];

    const KPI_CONFIG = [
      { icon: AlertTriangle, label: 'Students At Risk', value: dd.studentsAtRisk ?? 0, trend: dd.trends?.studentsAtRisk?.direction === 'up' ? `+${dd.trends?.studentsAtRisk?.pct}%` : `-${dd.trends?.studentsAtRisk?.pct}%`, color: '#EF4444', bg: '#FEF2F2', chart: dd.sparklines?.atRisk },
      { icon: Award, label: 'Predicted Pass Rate', value: `${dd.predictedPassRate ?? 0}%`, trend: dd.trends?.predictedPassRate?.direction === 'up' ? `+${dd.trends?.predictedPassRate?.pct}%` : `-${dd.trends?.predictedPassRate?.pct}%`, color: '#22C55E', bg: '#F0FDF4', chart: dd.sparklines?.passRate },
      { icon: AlertTriangle, label: 'Predicted Dropout Risk', value: `${dd.predictedDropoutRisk ?? 0}%`, trend: dd.trends?.dropoutRisk?.direction === 'down' ? `+${dd.trends?.dropoutRisk?.pct}%` : `-${dd.trends?.dropoutRisk?.pct}%`, color: '#F59E0B', bg: '#FFFBEB', chart: dd.sparklines?.dropout },
      { icon: CalendarCheck, label: 'Attendance Forecast', value: `${dd.attendanceForecast ?? 0}%`, trend: dd.trends?.attendanceForecast?.direction === 'up' ? `+${dd.trends?.attendanceForecast?.pct}%` : `-${dd.trends?.attendanceForecast?.pct}%`, color: '#3B82F6', bg: '#EFF6FF', chart: dd.sparklines?.attendance },
      { icon: TrendingUp, label: 'Performance Forecast', value: `${dd.performanceForecast ?? 0}%`, trend: dd.trends?.performanceForecast?.direction === 'up' ? `+${dd.trends?.performanceForecast?.pct}%` : `-${dd.trends?.performanceForecast?.pct}%`, color: '#8B5CF6', bg: '#F5F3FF', chart: dd.sparklines?.performance },
      { icon: Activity, label: 'Academic Health Score', value: dd.academicHealthScore ?? 0, trend: dd.trends?.healthScore?.direction === 'up' ? `+${dd.trends?.healthScore?.pct}%` : `-${dd.trends?.healthScore?.pct}%`, color: '#06B6D4', bg: '#ECFEFF', chart: dd.sparklines?.health },
      { icon: Brain, label: 'AI Prediction Accuracy', value: `${dd.aiPredictionAccuracy ?? 0}%`, trend: dd.trends?.accuracy?.direction === 'up' ? `+${dd.trends?.accuracy?.pct}%` : `-${dd.trends?.accuracy?.pct}%`, color: '#6D4CFF', bg: '#EDE9FE', chart: dd.sparklines?.accuracy },
      { icon: Target, label: 'Intervention Success Rate', value: `${dd.interventionSuccessRate ?? 0}%`, trend: dd.trends?.interventionSuccess?.direction === 'up' ? `+${dd.trends?.interventionSuccess?.pct}%` : `-${dd.trends?.interventionSuccess?.pct}%`, color: '#22C55E', bg: '#F0FDF4', chart: dd.sparklines?.intervention },
    ];

    const renderRiskAnalysis = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-4 gap-3">
          {[
            { label: 'Critical Risk', value: rd.distribution?.critical ?? 0, color: '#7C3AED', bg: '#F5F3FF' },
            { label: 'High Risk', value: rd.distribution?.high ?? 0, color: '#EF4444', bg: '#FEF2F2' },
            { label: 'Medium Risk', value: rd.distribution?.medium ?? 0, color: '#F59E0B', bg: '#FFFBEB' },
            { label: 'Low Risk', value: rd.distribution?.low ?? 0, color: '#22C55E', bg: '#F0FDF4' },
          ].map(s => (
            <div key={s.label} className="card p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">{s.label}</div>
              <div className="text-3xl font-extrabold mt-1" style={{ color: s.color }}>{s.value}</div>
              <div className="mt-2 w-full h-1.5 rounded-full bg-gray-100 overflow-hidden">
                <div className="h-full rounded-full transition-all" style={{ width: `${Math.min(100, s.value)}%`, background: s.color }} />
              </div>
            </div>
          ))}
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Risk Distribution</h4>
            <ResponsiveContainer width="100%" height={260}>
              <RePieChart>
                <Pie data={rd.distribution?.values?.map((v: number, i: number) => ({ name: rd.distribution?.labels?.[i], value: v, color: rd.distribution?.colors?.[i] })) || []} cx="50%" cy="50%" innerRadius={60} outerRadius={100} dataKey="value" paddingAngle={3}>
                  {(rd.distribution?.values || []).map((_: number, i: number) => (
                    <Cell key={i} fill={rd.distribution?.colors?.[i] || '#6D4CFF'} />
                  ))}
                </Pie>
                <Tooltip />
              </RePieChart>
            </ResponsiveContainer>
            <div className="flex justify-center gap-4 mt-3">
              {['Low Risk', 'Medium Risk', 'High Risk', 'Critical'].map((l, i) => (
                <div key={l} className="flex items-center gap-1.5">
                  <div className="w-2.5 h-2.5 rounded-full" style={{ background: rd.distribution?.colors?.[i] || '#6D4CFF' }} />
                  <span className="text-[10px] text-gray-500">{l}</span>
                </div>
              ))}
            </div>
          </Card>

          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Class Risk Comparison</h4>
            <ResponsiveContainer width="100%" height={260}>
              <BarChart data={rd.classComparison || []}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                <XAxis dataKey="className" tick={{ fontSize: 10 }} />
                <YAxis tick={{ fontSize: 10 }} />
                <Tooltip contentStyle={{ fontSize: 11 }} />
                <Bar dataKey="riskScore" name="Risk Score" fill="#6D4CFF" radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </Card>
        </div>

        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <h4 className="text-xs font-semibold text-gray-700">Student Risk Details</h4>
            <Badge variant="purple" className="text-[9px]">AI Powered</Badge>
          </div>
          {rd.students ? (
            <DataTable
              columns={[
                { key: 'full_name', label: 'Name' },
                { key: 'roll_number', label: 'Roll No' },
                { key: 'class_id', label: 'Class' },
                { key: 'attendance_pct', label: 'Attendance %', render: (v: number) => <span className="font-semibold">{v ?? '—'}%</span> },
                { key: 'avg_grade', label: 'Avg Grade', render: (v: number) => <span style={{ color: (v || 0) >= 70 ? '#22C55E' : '#EF4444' }}>{v ?? '—'}</span> },
                { key: 'gpa', label: 'GPA', render: (v: string) => <span className="font-bold">{v || '—'}</span> },
                { key: 'predictedPassProbability', label: 'Pass Prob', render: (v: number) => <Badge variant={(v || 0) >= 70 ? 'success' : 'danger'} className="text-[9px]">{v}%</Badge> },
                { key: 'risk_level', label: 'Risk Level', render: (v: string) => (
                  <Badge variant={v === 'critical' ? 'danger' : v === 'high' ? 'warning' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || 'low'}</Badge>
                )},
                { key: 'aiRecommendation', label: 'AI Recommendation', render: (v: string) => <span className="text-[9px] text-gray-500 max-w-[140px] inline-block truncate">{v}</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold hover:bg-[#6D4CFF20]">View</button>
                    <button className="px-2 py-1 rounded-lg bg-[#F59E0B10] text-[#F59E0B] text-[9px] font-semibold hover:bg-[#F59E0B20]">Intervene</button>
                  </div>
                )},
              ]}
              data={rd.students || []}
              loading={riskAnalysis.loading}
              emptyMessage="No risk data available"
            />
          ) : riskAnalysis.loading ? <LoadingSkeleton rows={5} cols={7} /> : <EmptyState message="No risk analysis data" />}
        </Card>
      </div>
    );

    const renderStudentPredictions = () => {
      const preds = predictions.data?.data || predictions.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search by name, roll number..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <select value={riskFilter} onChange={e => setRiskFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Risks</option>
              <option value="low">Low Risk</option>
              <option value="medium">Medium Risk</option>
              <option value="high">High Risk</option>
              <option value="critical">Critical</option>
            </select>
            <button onClick={() => predictions.refetch()} className="px-3 py-2 rounded-lg bg-gray-100 text-xs font-semibold text-gray-600"><RotateCcw size={14} /></button>
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'full_name', label: 'Student', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold">{v?.charAt(0)}</div>
                    <div><div className="text-xs font-semibold">{v}</div><div className="text-[9px] text-gray-400">{row.roll_number}</div></div>
                  </div>
                )},
                { key: 'class', label: 'Class', render: (v: string) => <span className="text-[11px]">{v || '—'}</span> },
                { key: 'attendancePct', label: 'Attendance', render: (v: number) => <Badge variant={(v || 0) >= 85 ? 'success' : (v || 0) >= 75 ? 'warning' : 'danger'} className="text-[9px]">{v ?? '—'}%</Badge> },
                { key: 'assignmentScore', label: 'Assignment', render: (v: number) => <span className="text-[11px] font-semibold">{v ?? '—'}</span> },
                { key: 'examScore', label: 'Exam', render: (v: number) => <span className="text-[11px] font-semibold">{v ?? '—'}</span> },
                { key: 'gpa', label: 'GPA', render: (v: string) => <span className="font-bold text-[11px]">{v || '—'}</span> },
                { key: 'predictedFinalScore', label: 'Predicted', render: (v: number) => <span className="text-[11px] font-bold">{v ?? '—'}</span> },
                { key: 'predictedPassProbability', label: 'Pass Prob', render: (v: number) => (
                  <div className="flex items-center gap-1.5">
                    <div className="w-12 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                      <div className="h-full rounded-full" style={{ width: `${v || 0}%`, background: (v || 0) >= 70 ? '#22C55E' : (v || 0) >= 50 ? '#F59E0B' : '#EF4444' }} />
                    </div>
                    <span className="text-[9px] font-semibold">{v ?? '—'}%</span>
                  </div>
                )},
                { key: 'riskLevel', label: 'Risk', render: (v: string) => (
                  <Badge variant={v === 'critical' ? 'danger' : v === 'high' ? 'warning' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || 'low'}</Badge>
                )},
                { key: 'aiRecommendation', label: 'AI Rec', render: (v: string) => <span className="text-[9px] text-gray-500 max-w-[120px] inline-block truncate">{v}</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button className="p-1 rounded-lg hover:bg-gray-100 text-gray-400"><Eye size={12} /></button>
                    <button className="p-1 rounded-lg hover:bg-gray-100 text-gray-400"><Bell size={12} /></button>
                  </div>
                )},
              ]}
              data={preds.length > 0 ? preds : []}
              loading={predictions.loading}
              emptyMessage="No student predictions available"
            />
          </Card>
        </div>
      );
    };

    const renderAttendanceForecast = () => {
      const af = attendForecast.data?.data || attendForecast.data || {};
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Attendance Trend & Forecast (Next 30 Days)</h4>
              <ResponsiveContainer width="100%" height={280}>
                <AreaChart data={af.dailyTrend || []}>
                  <defs>
                    <linearGradient id="attendGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#6D4CFF" stopOpacity={0.3}/><stop offset="95%" stopColor="#6D4CFF" stopOpacity={0}/></linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="date" tick={{ fontSize: 8 }} tickFormatter={(v: string) => v?.slice(5) || ''} interval={5} />
                  <YAxis domain={[60, 100]} tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11 }} />
                  <Area type="monotone" dataKey="pct" stroke="#6D4CFF" fill="url(#attendGrad)" strokeWidth={2} dot={false} />
                </AreaChart>
              </ResponsiveContainer>
              <div className="flex items-center justify-center gap-4 mt-2">
                <div className="flex items-center gap-1.5"><div className="w-3 h-0.5 rounded bg-[#6D4CFF]" /><span className="text-[9px] text-gray-400">Actual</span></div>
                <div className="flex items-center gap-1.5"><div className="w-3 h-0.5 rounded bg-[#6D4CFF] border-dashed" style={{ borderTop: '2px dashed #6D4CFF', height: 0 }} /><span className="text-[9px] text-gray-400">Predicted</span></div>
              </div>
            </Card>

            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Monthly Attendance Forecast</h4>
              <ResponsiveContainer width="100%" height={280}>
                <BarChart data={af.monthlyForecast || []}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="month" tick={{ fontSize: 9 }} />
                  <YAxis domain={[60, 100]} tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11 }} />
                  <Bar dataKey="predicted" name="Predicted" fill="#8B5CF6" radius={[4, 4, 0, 0]} />
                  <Bar dataKey="lower" name="Lower Bound" fill="#C4B5FD" radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </Card>
          </div>

          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Class Attendance Prediction</h4>
            <DataTable
              columns={[
                { key: 'className', label: 'Class' },
                { key: 'current', label: 'Current %', render: (v: number) => <span className="font-semibold">{v}%</span> },
                { key: 'predicted', label: 'Predicted %', render: (v: number) => <span className="font-semibold">{v}%</span> },
                { key: 'change', label: 'Change', render: (v: number) => (
                  <Badge variant={v >= 0 ? 'success' : 'danger'} className="text-[9px]">{v > 0 ? '+' : ''}{v}%</Badge>
                )},
              ]}
              data={af.classForecast || []}
              loading={attendForecast.loading}
              emptyMessage="No class forecast data"
            />
          </Card>
        </div>
      );
    };

    const renderAcademicForecast = () => {
      const ac = academicForecast.data?.data || academicForecast.data || {};
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Performance Trend Forecast</h4>
              <ResponsiveContainer width="100%" height={280}>
                <AreaChart data={ac.performanceTrend || []}>
                  <defs>
                    <linearGradient id="perfGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#22C55E" stopOpacity={0.3}/><stop offset="95%" stopColor="#22C55E" stopOpacity={0}/></linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                  <YAxis domain={[50, 100]} tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11 }} />
                  <Area type="monotone" dataKey="actual" stroke="#22C55E" fill="url(#perfGrad)" strokeWidth={2} dot={{ r: 3 }} connectNulls />
                  <Area type="monotone" dataKey="predicted" stroke="#6D4CFF" fill="none" strokeWidth={2} strokeDasharray="5 5" dot={{ r: 3 }} />
                </AreaChart>
              </ResponsiveContainer>
            </Card>

            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">GPA Growth Forecast</h4>
              <ResponsiveContainer width="100%" height={280}>
                <AreaChart data={ac.gpaForecast || []}>
                  <defs>
                    <linearGradient id="gpaGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#8B5CF6" stopOpacity={0.3}/><stop offset="95%" stopColor="#8B5CF6" stopOpacity={0}/></linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="semester" tick={{ fontSize: 10 }} />
                  <YAxis domain={[4, 10]} tick={{ fontSize: 10 }} />
                  <Tooltip contentStyle={{ fontSize: 11 }} />
                  <Area type="monotone" dataKey="actual" stroke="#8B5CF6" fill="url(#gpaGrad)" strokeWidth={2} dot={{ r: 3 }} connectNulls />
                  <Area type="monotone" dataKey="predicted" stroke="#22C55E" fill="none" strokeWidth={2} strokeDasharray="5 5" dot={{ r: 3 }} />
                </AreaChart>
              </ResponsiveContainer>
            </Card>
          </div>

          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Subject-wise Prediction</h4>
            <DataTable
              columns={[
                { key: 'subject', label: 'Subject' },
                { key: 'currentAvg', label: 'Current Avg', render: (v: number) => <span className="font-semibold">{v}</span> },
                { key: 'predictedNext', label: 'Predicted Next', render: (v: number) => <span className="font-semibold">{v}</span> },
                { key: 'trend', label: 'Trend', render: (v: string) => (
                  <Badge variant={v === 'up' ? 'success' : 'danger'} className="text-[9px]">{v === 'up' ? '↑ Improving' : '↓ Declining'}</Badge>
                )},
              ]}
              data={ac.subjectPrediction || []}
              loading={academicForecast.loading}
              emptyMessage="No subject predictions available"
            />
          </Card>
        </div>
      );
    };

    const renderDropoutPrediction = () => {
      const dp = dropoutPred.data?.data || dropoutPred.data || {};
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-3 gap-4">
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Overall Dropout Risk</div>
              <div className="text-3xl font-extrabold mt-1" style={{ color: (dp.overallRisk || 0) > 50 ? '#EF4444' : '#F59E0B' }}>{dp.overallRisk ?? '—'}%</div>
              <div className="mt-2 w-full h-1.5 rounded-full bg-gray-100 overflow-hidden">
                <div className="h-full rounded-full" style={{ width: `${dp.overallRisk || 0}%`, background: (dp.overallRisk || 0) > 50 ? '#EF4444' : '#F59E0B' }} />
              </div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Students At Risk</div>
              <div className="text-3xl font-extrabold mt-1 text-[#EF4444]">{dp.totalAtRisk ?? 0}</div>
              <div className="text-[9px] text-gray-400 mt-1">Need immediate intervention</div>
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] text-gray-500 font-medium mb-2">Probability Distribution</h4>
              <div className="space-y-1.5">
                {(dp.probabilityDistribution || []).map((d: any) => (
                  <div key={d.range} className="flex items-center gap-2">
                    <span className="text-[9px] text-gray-500 w-14">{d.range}</span>
                    <div className="flex-1 h-2 rounded-full bg-gray-100 overflow-hidden">
                      <div className="h-full rounded-full bg-[#6D4CFF]" style={{ width: `${Math.min(100, (d.count || 0) * 2)}%` }} />
                    </div>
                    <span className="text-[9px] font-semibold w-8 text-right">{d.count}</span>
                  </div>
                ))}
              </div>
            </Card>
          </div>

          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Student Dropout Risk Analysis</h4>
            <DataTable
              columns={[
                { key: 'full_name', label: 'Student', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#EF4444] to-[#F59E0B] flex items-center justify-center text-white text-[9px] font-bold">{v?.charAt(0)}</div>
                    <div><div className="text-xs font-semibold">{v}</div><div className="text-[9px] text-gray-400">{row.roll_number}</div></div>
                  </div>
                )},
                { key: 'gpa', label: 'GPA', render: (v: string) => <span className="font-bold text-[11px]">{v || '—'}</span> },
                { key: 'attendancePct', label: 'Attendance', render: (v: number) => <span className="text-[11px] font-semibold">{v ?? '—'}%</span> },
                { key: 'dropoutProbability', label: 'Dropout Prob', render: (v: number) => (
                  <div className="flex items-center gap-1.5">
                    <div className="w-16 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                      <div className="h-full rounded-full" style={{ width: `${v || 0}%`, background: (v || 0) > 60 ? '#EF4444' : (v || 0) > 30 ? '#F59E0B' : '#22C55E' }} />
                    </div>
                    <span className="text-[9px] font-semibold">{v ?? '—'}%</span>
                  </div>
                )},
                { key: 'riskLevel', label: 'Risk', render: (v: string) => (
                  <Badge variant={v === 'critical' ? 'danger' : v === 'high' ? 'warning' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || 'low'}</Badge>
                )},
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold">View</button>
                    <button className="px-2 py-1 rounded-lg bg-[#EF444410] text-[#EF4444] text-[9px] font-semibold">Intervene</button>
                  </div>
                )},
              ]}
              data={dp.students || []}
              loading={dropoutPred.loading}
              emptyMessage="No dropout prediction data"
            />
          </Card>
        </div>
      );
    };

    const renderInterventions = () => {
      const iv = interventions.data?.data || interventions.data || {};
      const plans = iv.plans || [];
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-3 gap-4">
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Overall Success Rate</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">{iv.overallSuccessRate ?? 0}%</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Active Interventions</div>
              <div className="text-3xl font-extrabold mt-1 text-[#6D4CFF]">{iv.totalActive ?? 0}</div>
            </Card>
            <Card className="p-4">
              <h4 className="text-[11px] text-gray-500 font-medium mb-2">Status Distribution</h4>
              <div className="space-y-1">
                {Object.entries(iv.statusDistribution || {}).map(([k, v]) => (
                  <div key={k} className="flex items-center justify-between text-[10px]">
                    <span className="capitalize text-gray-500">{k}</span>
                    <span className="font-semibold">{v as number}</span>
                  </div>
                ))}
              </div>
            </Card>
          </div>

          <Card className="p-5">
            <div className="flex items-center justify-between mb-4">
              <h4 className="text-xs font-semibold text-gray-700">Intervention Plans</h4>
              <button className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ Create Plan</button>
            </div>
            <DataTable
              columns={[
                { key: 'student_name', label: 'Student', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
                { key: 'type', label: 'Type', render: (v: string) => <Badge className="text-[9px]">{v || 'General'}</Badge> },
                { key: 'status', label: 'Status', render: (v: string) => (
                  <Badge variant={v === 'completed' ? 'success' : v === 'active' ? 'warning' : 'danger'} className="text-[9px] capitalize">{v || 'pending'}</Badge>
                )},
                { key: 'improvementRate', label: 'Improvement', render: (v: number) => <span className="font-semibold text-[11px]">{v ?? '—'}%</span> },
                { key: 'successProbability', label: 'Success Prob', render: (v: number) => (
                  <div className="flex items-center gap-1.5">
                    <div className="w-12 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                      <div className="h-full rounded-full" style={{ width: `${v || 0}%`, background: (v || 0) > 70 ? '#22C55E' : '#F59E0B' }} />
                    </div>
                    <span className="text-[9px] font-semibold">{v ?? '—'}%</span>
                  </div>
                )},
                { key: 'created_at', label: 'Created', render: (v: string) => <span className="text-[9px] text-gray-400">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'id', label: '', render: (_: string) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Edit</button>
                    <button className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold">View</button>
                  </div>
                )},
              ]}
              data={plans}
              loading={interventions.loading}
              emptyMessage="No intervention plans yet"
            />
          </Card>
        </div>
      );
    };

    const renderAiInsights = () => {
      const ins = insights.data?.data || insights.data || {};
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {[
              { label: 'Failure Risk Prediction', data: ins.failureRiskPrediction, color: '#EF4444' },
              { label: 'Dropout Risk Prediction', data: ins.dropoutRiskPrediction, color: '#F59E0B' },
              { label: 'Attendance Risk Prediction', data: ins.attendanceRiskPrediction, color: '#3B82F6' },
              { label: 'Academic Success Probability', data: ins.academicSuccessProbability, color: '#22C55E' },
            ].map(card => (
              <Card key={card.label} className="p-4">
                <h4 className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-3">{card.label}</h4>
                {card.data && Object.entries(card.data).filter(([k]) => k !== 'trend').map(([k, v]) => (
                  <div key={k} className="flex items-center justify-between py-1">
                    <span className="text-[10px] text-gray-500 capitalize">{k.replace(/([A-Z])/g, ' $1').trim()}</span>
                    <span className="text-[11px] font-bold">{v as number}%</span>
                  </div>
                ))}
                {card.data?.trend && (
                  <Badge variant={card.data.trend === 'improving' || card.data.trend === 'decreasing' ? 'success' : 'warning'} className="text-[8px] mt-2">{card.data.trend}</Badge>
                )}
              </Card>
            ))}
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Subject Difficulty Analysis</h4>
              <DataTable
                columns={[
                  { key: 'subject', label: 'Subject' },
                  { key: 'difficultyScore', label: 'Difficulty', render: (v: number) => (
                    <div className="flex items-center gap-1.5">
                      <div className="w-12 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                        <div className="h-full rounded-full bg-[#6D4CFF]" style={{ width: `${v || 0}%` }} />
                      </div>
                      <span className="text-[9px] font-semibold">{v ?? '—'}</span>
                    </div>
                  )},
                  { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => <span className="font-semibold text-[11px]">{v ?? '—'}</span> },
                  { key: 'failingPct', label: 'Failing %', render: (v: number) => <Badge variant={v > 20 ? 'danger' : 'warning'} className="text-[9px]">{v ?? '—'}%</Badge> },
                ]}
                data={ins.subjectDifficulty || []}
                loading={insights.loading}
                emptyMessage="No subject difficulty data"
              />
            </Card>

            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Learning Gap Detection</h4>
              <div className="space-y-3">
                {(ins.learningGaps || []).map((gap: any) => (
                  <div key={gap.topic} className="flex items-start gap-3 p-2 rounded-lg bg-gray-50">
                    <div className="flex-1">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-semibold text-gray-700">{gap.topic}</span>
                        <span className="text-[9px] text-gray-400">{gap.subject}</span>
                      </div>
                      <div className="flex items-center gap-2 mt-1">
                        <div className="flex-1 h-1.5 rounded-full bg-gray-200 overflow-hidden">
                          <div className="h-full rounded-full bg-[#EF4444]" style={{ width: `${gap.gapPct || 0}%` }} />
                        </div>
                        <span className="text-[9px] font-semibold text-[#EF4444]">{gap.gapPct}% gap</span>
                      </div>
                      <div className="text-[9px] text-gray-400 mt-0.5">{gap.studentsAffected} students affected</div>
                    </div>
                  </div>
                ))}
              </div>
            </Card>
          </div>

          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Parent Engagement Impact</h4>
            <DataTable
              columns={[
                { key: 'level', label: 'Engagement Level', render: (_: string, row: any, i?: number) => {
                  const labels = ['High Engagement', 'Medium Engagement', 'Low Engagement'];
                  return <span className="font-semibold text-[11px]">{labels[i || 0]}</span>;
                }},
                { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => <span className="font-semibold text-[11px]">{v ?? '—'}</span> },
                { key: 'attendancePct', label: 'Attendance', render: (v: number) => <span className="font-semibold text-[11px]">{v ?? '—'}%</span> },
                { key: 'improvementRate', label: 'Improvement Rate', render: (v: number) => <span className="font-semibold text-[11px]">{v ?? '—'}%</span> },
              ]}
              data={[
                { ...ins.parentEngagementImpact?.highEngagement, level: 'high' },
                { ...ins.parentEngagementImpact?.mediumEngagement, level: 'medium' },
                { ...ins.parentEngagementImpact?.lowEngagement, level: 'low' },
              ]}
              loading={insights.loading}
              emptyMessage="No parent engagement data"
            />
          </Card>
        </div>
      );
    };

    const renderReports = () => {
      const rps = (reportsData.data || []) as any[];
      return (
        <div className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {(Array.isArray(rps) ? rps : []).map((r: any) => (
              <Card key={r.key} className="p-5 hover:shadow-md transition-shadow cursor-pointer">
                <div className="flex items-start gap-3">
                  <div className="w-10 h-10 rounded-xl bg-[#6D4CFF10] flex items-center justify-center text-[#6D4CFF]">
                    {r.icon === 'Users' ? <Users size={18} /> : r.icon === 'AlertTriangle' ? <AlertTriangle size={18} /> :
                     r.icon === 'CalendarCheck' ? <CalendarCheck size={18} /> : r.icon === 'TrendingUp' ? <TrendingUp size={18} /> :
                     r.icon === 'Activity' ? <Activity size={18} /> : <Brain size={18} />}
                  </div>
                  <div className="flex-1">
                    <h4 className="text-xs font-semibold text-gray-800">{r.label}</h4>
                    <p className="text-[9px] text-gray-400 mt-0.5">AI-generated predictive report</p>
                    <div className="flex gap-2 mt-3">
                      <button onClick={async () => { const res = await predictiveAiApiV2.getReports(r.key); if (res.success) toast.success('Report generated'); }} className="px-2.5 py-1 rounded-lg bg-[#6D4CFF] text-white text-[9px] font-semibold hover:bg-[#5A3EF0]">Generate</button>
                      <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600 hover:bg-gray-50"><Download size={10} className="inline mr-1" />Export</button>
                    </div>
                  </div>
                </div>
              </Card>
            ))}
          </div>
        </div>
      );
    };

    const renderRightSidebar = () => (
      <div className="space-y-4">
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">AI Prediction Overview</h4>
          <div className="space-y-3">
            <div className="flex justify-between text-[10px]"><span className="text-gray-500">Prediction Accuracy</span><span className="font-bold">{sd.overview?.predictionAccuracy ?? 0}%</span></div>
            <div className="flex justify-between text-[10px]"><span className="text-gray-500">Active Predictions</span><span className="font-bold">{sd.overview?.activePredictions ?? 0}</span></div>
            <div className="flex justify-between text-[10px]"><span className="text-gray-500">Students Monitored</span><span className="font-bold">{sd.overview?.studentsMonitored ?? 0}</span></div>
            <div className="flex justify-between text-[10px]"><span className="text-gray-500">AI Confidence Score</span><span className="font-bold">{sd.overview?.aiConfidenceScore ?? 0}%</span></div>
          </div>
          {sd.overview?.doughnutData && (
            <div className="mt-3">
              <ResponsiveContainer width="100%" height={120}>
                <RePieChart>
                  <Pie data={sd.overview.doughnutData} cx="50%" cy="50%" innerRadius={30} outerRadius={50} dataKey="value" paddingAngle={2}>
                    {(sd.overview.doughnutData || []).map((entry: any, i: number) => (
                      <Cell key={i} fill={entry.color} />
                    ))}
                  </Pie>
                </RePieChart>
              </ResponsiveContainer>
              <div className="flex justify-center gap-2 mt-1">
                {(sd.overview.doughnutData || []).map((d: any) => (
                  <div key={d.name} className="flex items-center gap-1">
                    <div className="w-2 h-2 rounded-full" style={{ background: d.color }} />
                    <span className="text-[8px] text-gray-400">{d.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </Card>

        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">High Priority Students</h4>
          {(sd.highPriorityStudents || []).length > 0 ? (
            <div className="space-y-2">
              {(sd.highPriorityStudents || []).map((s: any) => (
                <div key={s.id} className="flex items-center gap-2 p-2 rounded-lg bg-red-50">
                  <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#EF4444] to-[#F59E0B] flex items-center justify-center text-white text-[9px] font-bold">{s.full_name?.charAt(0)}</div>
                  <div className="flex-1 min-w-0">
                    <div className="text-[10px] font-semibold truncate">{s.full_name}</div>
                    <div className="text-[8px] text-red-500">Risk Score: {s.riskScore}%</div>
                    <div className="text-[8px] text-gray-400 truncate">{s.predictedOutcome}</div>
                  </div>
                  <Badge variant="danger" className="text-[7px]">Alert</Badge>
                </div>
              ))}
            </div>
          ) : <EmptyState message="No high priority students" />}
        </Card>

        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">AI Recommendations</h4>
          <div className="space-y-2">
            {sd.recommendations && [
              { label: 'Students Needing Intervention', value: sd.recommendations.studentsNeedingIntervention, color: '#EF4444' },
              { label: 'Attendance Concerns', value: sd.recommendations.attendanceConcerns, color: '#F59E0B' },
              { label: 'Academic Decline Warnings', value: sd.recommendations.academicDeclineWarnings, color: '#F59E0B' },
              { label: 'Parent Meeting Recommendations', value: sd.recommendations.parentMeetingRecommendations, color: '#6D4CFF' },
              { label: 'Personalized Action Plans', value: sd.recommendations.personalizedActionPlans, color: '#22C55E' },
            ].map(item => (
              <div key={item.label} className="flex items-center justify-between p-1.5 rounded-lg bg-gray-50">
                <span className="text-[9px] text-gray-600">{item.label}</span>
                <span className="text-[11px] font-bold" style={{ color: item.color }}>{item.value ?? 0}</span>
              </div>
            ))}
          </div>
        </Card>
      </div>
    );

    const renderContent = () => {
      switch (mode) {
        case 'risk': return renderRiskAnalysis();
        case 'students': return renderStudentPredictions();
        case 'attendance': return renderAttendanceForecast();
        case 'academic': return renderAcademicForecast();
        case 'dropout': return renderDropoutPrediction();
        case 'interventions': return renderInterventions();
        case 'insights': return renderAiInsights();
        case 'reports': return renderReports();
        default: return renderRiskAnalysis();
      }
    };

    return (
      <ModulePage title="Predictive AI" desc="Predict student outcomes, attendance trends, academic performance, and institutional risks using AI.">
        {/* Header Actions */}
        <div className="flex flex-wrap items-center gap-2 mb-6">
          <button className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5 hover:opacity-90 transition-opacity">
            <Zap size={14} /> Run Prediction
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <FileText size={14} /> Generate Forecast Report
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <Brain size={14} /> AI Insights
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <Settings size={14} /> Model Settings
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <Download size={14} /> Export Predictions
          </button>
        </div>

        {/* KPI Cards */}
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-6">
          {KPI_CONFIG.map(k => (
            <KpiCard key={k.label} {...k} />
          ))}
        </div>

        {/* Filters */}
        <div className="flex flex-wrap items-center gap-2 mb-6 p-3 rounded-xl bg-white border border-gray-100 shadow-sm">
          <select value={acYear} onChange={e => setAcYear(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[100px]">
            <option value="">Academic Year</option>
            <option value="2024-25">2024-25</option>
            <option value="2025-26">2025-26</option>
          </select>
          <select value={cls} onChange={e => setCls(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[80px]">
            <option value="">Class</option>
            {['10A','10B','9A','9B','11A','11B','12A','12B'].map(c => <option key={c} value={c}>{c}</option>)}
          </select>
          <select value={section} onChange={e => setSection(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[80px]">
            <option value="">Section</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
          </select>
          <select value={subject} onChange={e => setSubject(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[90px]">
            <option value="">Subject</option>
            <option value="Math">Mathematics</option>
            <option value="Science">Science</option>
            <option value="English">English</option>
          </select>
          <select value={riskFilter} onChange={e => setRiskFilter(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[90px]">
            <option value="">Risk Level</option>
            <option value="low">Low Risk</option>
            <option value="medium">Medium Risk</option>
            <option value="high">High Risk</option>
            <option value="critical">Critical</option>
          </select>
          <select value={predType} onChange={e => setPredType(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[100px]">
            <option value="">Prediction Type</option>
            <option value="performance">Performance</option>
            <option value="attendance">Attendance</option>
            <option value="dropout">Dropout</option>
          </select>
          <input type="text" placeholder="Search student..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 min-w-[120px] px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px]" />
          <button className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">Apply</button>
          <button onClick={() => { setAcYear(''); setCls(''); setSection(''); setSubject(''); setRiskFilter(''); setPredType(''); setSearchQ(''); }} className="px-3 py-1.5 rounded-lg border border-gray-200 text-[10px] font-semibold text-gray-500 hover:bg-gray-50">Reset</button>
        </div>

        {/* Tab Navigation */}
        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key as any)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>

        {/* Main Content + Sidebar */}
        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3">
            {dash.loading ? <LoadingSkeleton rows={8} cols={4} /> : renderContent()}
          </div>
          <div className="xl:col-span-1">
            {sidebar.loading ? <LoadingSkeleton rows={6} cols={1} /> : renderRightSidebar()}
          </div>
        </div>

        {/* Quick Actions */}
        <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-[#6D4CFF20]">
          <h4 className="text-[11px] font-semibold text-gray-600 mb-3">Quick Actions</h4>
          <div className="flex flex-wrap gap-2">
            {[
              { icon: Zap, label: 'Run Prediction' },
              { icon: FileText, label: 'Generate Forecast' },
              { icon: AlertTriangle, label: 'Risk Students' },
              { icon: Activity, label: 'Intervention Plans' },
              { icon: Bell, label: 'Parent Alerts' },
              { icon: Brain, label: 'AI Insights' },
              { icon: Download, label: 'Export Reports' },
              { icon: Settings, label: 'Model Settings' },
            ].map(a => (
              <button key={a.label} className="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 hover:border-[#6D4CFF30] hover:text-[#6D4CFF] transition-all">
                <a.icon size={12} /> {a.label}
              </button>
            ))}
          </div>
        </div>

        {/* Role-Based Access Footer */}
        <div className="mt-6 p-3 rounded-xl bg-gray-50 border border-gray-100 flex flex-wrap items-center justify-between">
          <div className="flex items-center gap-4 text-[9px] text-gray-400">
            <span className="font-semibold text-gray-500">Role-Based Access:</span>
            <span><Badge variant="purple" className="text-[8px]">Admin: Full Access</Badge></span>
            <span><Badge variant="purple" className="text-[8px]">Principal: Monitoring + Reports</Badge></span>
            <span><Badge className="text-[8px]">Teacher: Predictions + Interventions</Badge></span>
            <span><Badge className="text-[8px]">Counselor: Risk + Support</Badge></span>
          </div>
          <Badge variant="purple" className="text-[8px]">AI Enterprise Plan</Badge>
        </div>
      </ModulePage>
    );
  }

  // ====================== MODULE RENDERER ======================
  const renderModule = () => {
    switch (activeTab) {
      case 'students': return <StudentTab students={students} />;
      case 'staff': return <StaffTab staffList={staffList} />;
      case 'classes': return <ClassTab />;
      case 'exams': return <ExamTab />;
      case 'fees': return <FeeTab />;
      case 'timetable': return <TimetableTab />;
      case 'gamification': return <GamificationTab />;
      case 'attendance': return <AttendanceTab />;
      case 'reports': return <ReportsTab />;
      case 'ai-insights': return <AiInsightsTab />;
      case 'audit': return <AuditModule />;
      case 'scholarships': return <ScholarshipTab />;
      case 'accounts': return <AccountsTab />;
      case 'payroll': return <PayrollTab />;
      case 'library': return <LibraryTab />;
      case 'assignments': return <AssignmentsTab />;
      case 'transport': return <TransportTab />;
      case 'hostel': return <HostelTab />;
      case 'health': return <HealthModule />;
      case 'inventory': return <InventoryModule />;
      case 'events': return <EventsModule />;
      case 'alumni': return <AlumniModule />;
      case 'part-time-jobs': return <PartTimeJobsModule />;
      case 'career': return <CareerModule />;
      case 'store': return <StoreTab />;
      case 'admission': return <AdmissionModule />;
      case 'bulk-import': return renderBulkImportDashboard();
      case 'parents': return <ParentsModule />;
      case 'communication': return <CommunicationTab />;
      case 'collaboration': return <CollaborationTab />;
      case 'risk-detection': return <RiskDetectionTab />;
      case 'teacher-ai': return <TeacherPerformanceTab />;
      case 'intelligence': return <InstitutionIntelligenceTab />;
      case 'esports': return <EsportsTab />;
      case 'biometrics': return <BiometricsTab />;
      case 'academic-setup': return <AcademicManagementTab />;
      case 'homework': return <HomeworkTab />;
      case 'promotion': return <PromotionTab />;
      case 'academic-analytics': return <AcademicAnalyticsTab />;
      case 'ai-assistant': return <AiTeachingTab />;
      case 'predictive-ai': return <PredictiveAITab />;
      case 'analytics': return <AnalyticsTab />;
      case 'roles': return <RolesTab />;
      case 'credentials': return <CredentialsTab />;
      case 'credential-mgmt': return <CredentialMgmtTab />;
      case 'validation-audit': return <ValidationAuditTab />;
      case 'config': return <ConfigureModule moduleConfigs={moduleConfigs} />;
      default:
        const defaults: Record<string, { icon: any; title: string; desc: string }> = {
          'academic-analytics': { icon: BarChart3, title: 'Academic Analytics', desc: 'Academic performance analytics and insights' },
          'ai-assistant': { icon: Bot, title: 'AI Teaching Assistants', desc: 'AI-powered teaching assistants' },
          'predictive-ai': { icon: Brain, title: 'Predictive AI', desc: 'Predictive analytics and forecasting' },
        };
        const def = defaults[activeTab];
        return <PlaceholderModule icon={def?.icon || Settings} title={def?.title || activeTab.replace(/-/g, ' ')} desc={def?.desc || 'Module management'} color={def ? undefined : CLR.primary} />;
    }
  };

  // ====================== TAB COMPONENTS ======================
  function ClassTab() {
    const [v, setV] = useState<'table' | 'cards'>('table');
    const [sQ, setSQ] = useState('');
    const [sG, setSG] = useState('');
    const [sS, setSS] = useState('');
    const [m, setM] = useState<{ type: string; d?: any } | null>(null);
    const [cr, setCr] = useState(false);
    const [selC, setSelC] = useState<any>(null);
    const [profTab, setProfTab] = useState('overview');
    const [profData, setProfData] = useState<any>(null);
    const cls = classesV2;
    const dash = classDashData;

    const dashSum = dash.data?.summary || {};
    const cData = (cls.data || []).filter((c: any) => {
      if (sQ && !c.name.toLowerCase().includes(sQ.toLowerCase()) && !c.room_number?.toLowerCase().includes(sQ.toLowerCase())) return false;
      if (sG && c.grade_level !== sG) return false;
      if (sS && c.status !== sS) return false;
      return true;
    });

    const loadProf = async (c: any) => {
      setSelC(c); setProfTab('overview');
      const [studRes, attRes, perfRes, aiRes] = await Promise.all([
        classApiV2.getStudents(c.id), classApiV2.getAttendanceTrend(c.id),
        classApiV2.getPerformance(c.id), classApiV2.getAiInsights(c.id),
      ]);
      setProfData({ students: studRes.data || [], attendance: attRes.data || [], performance: perfRes.data || [], ai: aiRes.data || {} });
    };

    const rfs = () => { cls.refetch(); dash.refetch(); if (selC) loadProf(selC); };

    const grades = [...new Set((cls.data || []).map((c: any) => c.grade_level).filter(Boolean))];

    const renderKpis = () => (
      <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
        {[
          { icon: School, label: 'Total Classes', val: dashSum.totalClasses || 0, c: '#7C3AED' },
          { icon: BookOpen, label: 'Sections', val: dashSum.totalSections || 0, c: '#8B5CF6' },
          { icon: Users, label: 'Students', val: dashSum.totalStudents || 0, c: '#3B82F6' },
          { icon: Activity, label: 'Occupancy', val: `${dashSum.occupancyRate || 0}%`, c: '#22C55E' },
          { icon: CheckCircle2, label: 'Attendance', val: `${dashSum.attendanceRate || 0}%`, c: '#F59E0B' },
          { icon: Brain, label: 'AI Score', val: `${dashSum.performanceAvg || 0}%`, c: '#EF4444' },
        ].map((k, i) => (
          <motion.div key={i} initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: i * 0.05 }}
            className="relative overflow-hidden rounded-xl p-4 backdrop-blur-sm border" style={{ background: 'linear-gradient(135deg, rgba(124,58,237,0.08), rgba(139,92,246,0.04))', borderColor: 'rgba(124,58,237,0.15)' }}>
            <div className="absolute -top-3 -right-3 w-16 h-16 rounded-full opacity-10" style={{ background: k.c }} />
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-lg flex items-center justify-center" style={{ background: `${k.c}15`, color: k.c }}><k.icon size={18} /></div>
              <div><div className="text-[10px] font-medium text-gray-500">{k.label}</div><div className="text-lg font-bold" style={{ color: k.c }}>{k.val}</div></div>
            </div>
          </motion.div>
        ))}
      </div>
    );

    const renderCharts = () => {
      const attTrend = dash.data?.attendanceTrend || [];
      const clsPerf = dash.data?.classPerformance || [];
      return (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
          <Card className="p-4"><h3 className="font-bold text-sm mb-3 flex items-center gap-2"><Activity size={14} className="text-[#7C3AED]" />Attendance Trend</h3>
            {attTrend.length > 0 ? <div className="h-48"><ResponsiveContainer width="100%" height="100%"><AreaChart data={attTrend}><CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" /><XAxis dataKey="date" tick={{ fontSize: 9 }} /><YAxis domain={[0, 100]} tick={{ fontSize: 9 }} /><Tooltip /><Area type="monotone" dataKey="rate" stroke="#7C3AED" fill="url(#colorAtt)" strokeWidth={2} /></AreaChart><defs><linearGradient id="colorAtt" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#7C3AED" stopOpacity={0.3} /><stop offset="95%" stopColor="#7C3AED" stopOpacity={0} /></linearGradient></defs></ResponsiveContainer></div> : <EmptyState message="No attendance data yet" />}
          </Card>
          <Card className="p-4"><h3 className="font-bold text-sm mb-3 flex items-center gap-2"><BarChart3 size={14} className="text-[#8B5CF6]" />Class Performance</h3>
            {clsPerf.length > 0 ? <div className="h-48"><ResponsiveContainer width="100%" height="100%"><BarChart data={clsPerf}><CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" /><XAxis dataKey="name" tick={{ fontSize: 8 }} /><YAxis domain={[0, 100]} tick={{ fontSize: 9 }} /><Tooltip /><Bar dataKey="performance" fill="#8B5CF6" radius={[4, 4, 0, 0]} /><Bar dataKey="attendance" fill="#22C55E" radius={[4, 4, 0, 0]} /></BarChart></ResponsiveContainer></div> : <EmptyState message="No performance data yet" />}
          </Card>
        </div>
      );
    };

    const renderToolbar = () => (
      <div className="flex flex-wrap items-center gap-3 mb-4">
        <div className="relative flex-1 min-w-[200px]">
          <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
          <input value={sQ} onChange={e => setSQ(e.target.value)} placeholder="Search classes..." className="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#7C3AED] focus:ring-1 focus:ring-[#7C3AED]/20" />
        </div>
        <select value={sG} onChange={e => setSG(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="">All Grades</option>{grades.map(g => <option key={g} value={g}>{g}</option>)}</select>
        <select value={sS} onChange={e => setSS(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="">All Status</option><option value="active">Active</option><option value="archived">Archived</option></select>
        <div className="flex bg-gray-100 rounded-lg p-0.5"><button onClick={() => setV('table')} className={`px-3 py-1.5 rounded-md text-[10px] font-semibold transition-all ${v === 'table' ? 'bg-white shadow-sm' : 'text-gray-400'}`}><List size={14} /></button><button onClick={() => setV('cards')} className={`px-3 py-1.5 rounded-md text-[10px] font-semibold transition-all ${v === 'cards' ? 'bg-white shadow-sm' : 'text-gray-400'}`}><Layout size={14} /></button></div>
        <button onClick={() => setM({ type: 'add' })} className="px-4 py-2 rounded-lg text-xs font-semibold text-white" style={{ background: 'linear-gradient(135deg, #7C3AED, #8B5CF6)' }}>+ Add Class</button>
      </div>
    );

    const renderTable = () => (
      <div className="overflow-x-auto rounded-xl border border-gray-100">
        <table className="w-full text-xs">
          <thead><tr className="bg-gray-50/80">
            {['Class Name', 'Section', 'Grade', 'Class Teacher', 'Students', 'Capacity', 'Room', 'Attendance', 'Performance', 'Status', 'Actions'].map(h => <th key={h} className="text-left px-4 py-3 font-semibold text-gray-500 text-[10px] uppercase tracking-wider">{h}</th>)}
          </tr></thead>
          <tbody>{cData.map((c: any, i: number) => (
            <tr key={c.id} className={`border-t border-gray-50 hover:bg-[#7C3AED]/[0.02] transition-colors ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/30'}`}>
              <td className="px-4 py-3"><span className="font-semibold text-gray-900 cursor-pointer hover:text-[#7C3AED]" onClick={() => loadProf(c)}>{c.name}</span></td>
              <td className="px-4 py-3 text-gray-500">{c.section || '—'}</td>
              <td className="px-4 py-3"><span className="px-2 py-0.5 rounded-full text-[9px] font-medium bg-[#7C3AED]/10 text-[#7C3AED]">{c.grade_level || '—'}</span></td>
              <td className="px-4 py-3 text-gray-500">{c.class_teacher?.full_name || '—'}</td>
              <td className="px-4 py-3 font-semibold">{c.student_count || 0}</td>
              <td className="px-4 py-3 text-gray-500">{c.capacity || 30}</td>
              <td className="px-4 py-3 text-gray-500">{c.room_number || '—'}</td>
              <td className="px-4 py-3">{c.attendance_pct != null ? <span className={`font-semibold ${(c.attendance_pct || 0) >= 75 ? 'text-green-600' : 'text-orange-500'}`}>{c.attendance_pct}%</span> : '—'}</td>
              <td className="px-4 py-3">{c.performance_pct != null ? <span className={`font-semibold ${(c.performance_pct || 0) >= 60 ? 'text-green-600' : 'text-red-500'}`}>{c.performance_pct}%</span> : '—'}</td>
              <td className="px-4 py-3"><Badge variant={c.status === 'active' ? 'success' : 'warning'} className="text-[9px]">{c.status}</Badge></td>
              <td className="px-4 py-3"><div className="flex items-center gap-1"><button onClick={() => loadProf(c)} className="p-1.5 rounded-md hover:bg-[#7C3AED]/10 text-[#7C3AED]"><Eye size={14} /></button><button onClick={() => setM({ type: 'edit', d: c })} className="p-1.5 rounded-md hover:bg-blue-50 text-blue-500"><Edit3 size={14} /></button><button onClick={async () => { if (confirm('Delete this class?')) { await classApiV2.deleteClass(c.id); rfs(); } }} className="p-1.5 rounded-md hover:bg-red-50 text-red-400"><Trash2 size={14} /></button></div></td>
            </tr>
          ))}</tbody>
        </table>
        {cData.length === 0 && <div className="p-8"><EmptyState message="No classes found" /></div>}
      </div>
    );

    const renderCards = () => (
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {cData.map((c: any, i: number) => (
          <motion.div key={c.id} initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: i * 0.03 }}
            className="rounded-xl border overflow-hidden cursor-pointer hover:shadow-lg transition-all" style={{ borderColor: 'rgba(124,58,237,0.12)' }} onClick={() => loadProf(c)}>
            <div className="p-4" style={{ background: 'linear-gradient(135deg, rgba(124,58,237,0.06), rgba(139,92,246,0.03))' }}>
              <div className="flex items-center justify-between mb-3"><School size={20} className="text-[#7C3AED]" /><Badge variant={c.status === 'active' ? 'success' : 'warning'} className="text-[9px]">{c.status}</Badge></div>
              <div className="text-sm font-bold">{c.name} {c.section ? `(${c.section})` : ''}</div>
              <div className="text-[10px] text-gray-400 mt-0.5">{c.grade_level || '—'} • Room {c.room_number || '—'} • {c.class_teacher?.full_name || 'No teacher'}</div>
            </div>
            <div className="p-4 grid grid-cols-3 gap-3 text-center">
              <div><div className="text-sm font-bold text-[#7C3AED]">{c.student_count || 0}</div><div className="text-[9px] text-gray-400">Students</div></div>
              <div><div className="text-sm font-bold text-green-600">{c.capacity || 30}</div><div className="text-[9px] text-gray-400">Capacity</div></div>
              <div><div className="text-sm font-bold text-amber-500">{c.attendance_pct ?? '—'}%</div><div className="text-[9px] text-gray-400">Attend.</div></div>
            </div>
          </motion.div>
        ))}
        {cData.length === 0 && <div className="col-span-full"><EmptyState message="No classes found" /></div>}
      </div>
    );

    const renderSidebar = () => (
      <div className="space-y-4">
        <Card className="p-4"><h4 className="font-bold text-xs mb-3 flex items-center gap-2"><Zap size={12} className="text-[#7C3AED]" />Quick Actions</h4>
          <div className="space-y-2">{[{ icon: Plus, label: 'Add Class', action: () => setM({ type: 'add' }) }, { icon: Users, label: 'Assign Teacher', action: () => toast.info('Select a class first') }, { icon: Download, label: 'Export Classes', action: () => toast.success('Classes exported') }].map((a, i) => (
            <button key={i} onClick={a.action} className="w-full flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 text-[10px] font-medium text-gray-600 transition-colors"><a.icon size={14} className="text-gray-400" />{a.label}</button>
          ))}</div>
        </Card>
        {dash.data?.recentSnapshots?.length > 0 && <Card className="p-4"><h4 className="font-bold text-xs mb-3">Recent Activity</h4>
          <div className="space-y-2">{dash.data.recentSnapshots.slice(0, 5).map((s: any) => (
            <div key={s.id} className="flex items-center justify-between p-2 rounded-lg bg-gray-50"><span className="text-[9px] text-gray-500">{s.date}</span><span className="text-[9px] font-semibold">{s.attendance_pct}%</span></div>
          ))}</div>
        </Card>}
      </div>
    );

    const renderProfile = () => {
      if (!selC) return null;
      const p = profData || { students: [], attendance: [], performance: [], ai: {} };
      const profTabs = [
        { key: 'overview', label: 'Overview' }, { key: 'students', label: `Students (${p.students.length})` },
        { key: 'attendance', label: 'Attendance' }, { key: 'performance', label: 'Performance' },
        { key: 'ai', label: 'AI Insights' },
      ];
      return (
        <div className="space-y-4">
          <div className="flex items-center justify-between"><div><button onClick={() => { setSelC(null); setProfData(null); }} className="text-[10px] text-[#7C3AED] hover:underline flex items-center gap-1"><ChevronRight size={12} className="rotate-180" /> Back to Classes</button><h2 className="text-lg font-bold mt-1">{selC.name} {selC.section ? `(${selC.section})` : ''}</h2><p className="text-[10px] text-gray-400">{selC.grade_level || '—'} • Room {selC.room_number || '—'} • Teacher: {selC.class_teacher?.full_name || 'Unassigned'}</p></div>
            <Badge variant={selC.status === 'active' ? 'success' : 'warning'} className="text-[9px]">{selC.status}</Badge>
          </div>
          <div className="flex gap-1 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">{profTabs.map(t => (
            <button key={t.key} onClick={() => setProfTab(t.key)} className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${profTab === t.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>{t.label}</button>
          ))}</div>
          {profTab === 'overview' && <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <Card className="p-4 lg:col-span-2"><h3 className="font-bold text-sm mb-3">Attendance Trend</h3>{p.attendance.length > 0 ? <div className="h-48"><ResponsiveContainer><AreaChart data={p.attendance}><CartesianGrid strokeDasharray="3 3" /><XAxis dataKey="date" tick={{ fontSize: 9 }} /><YAxis domain={[0, 100]} /><Tooltip /><Area type="monotone" dataKey="rate" stroke="#7C3AED" fill="url(#attG)" strokeWidth={2} /></AreaChart></ResponsiveContainer></div> : <EmptyState message="No data" />}</Card>
            <div className="space-y-4">
              <Card className="p-4"><h3 className="font-bold text-xs mb-3">AI Class Health</h3>{p.ai?.healthScore != null ? <div className="text-center"><div className="text-3xl font-bold text-[#7C3AED]">{p.ai.healthScore}</div><div className="text-[10px] text-gray-400">{p.ai.healthLabel}</div></div> : <EmptyState message="No AI data" />}</Card>
              <Card className="p-4"><h3 className="font-bold text-xs mb-3">Quick Actions</h3><div className="space-y-1.5">{[{ l: 'Manage Students', a: () => setProfTab('students') }, { l: 'Assign Teacher', a: async () => { const r = await classApiV2.assignClassTeacher(selC.id, '00000000-0000-0000-0000-000000000002'); toast.success('Teacher assigned'); } }, { l: 'Archive Class', a: async () => { await classApiV2.archiveClass(selC.id); rfs(); } }].map((a, i) => (<button key={i} onClick={a.a} className="w-full text-left p-2 rounded-lg hover:bg-gray-50 text-[10px] font-medium text-gray-600">{a.l}</button>))}</div></Card>
            </div>
          </div>}
          {profTab === 'students' && <Card className="p-4"><DataTable columns={[{ key: 'full_name', label: 'Name', render: (v: string) => <span className="font-semibold text-xs">{v}</span> }, { key: 'roll_number', label: 'Roll' }, { key: 'email', label: 'Email' }, { key: 'gender', label: 'Gender' }, { key: 'status', label: 'Status', render: (v: string) => <Badge className="text-[9px]">{v}</Badge> }]} data={p.students} loading={false} emptyMessage="No students in this class" /></Card>}
          {profTab === 'attendance' && <Card className="p-4"><DataTable columns={[{ key: 'date', label: 'Date', render: (v: string) => v }, { key: 'attendance_pct', label: 'Rate', render: (v: number) => <Badge variant={v >= 75 ? 'success' : 'warning'} className="text-[9px]">{v}%</Badge> }, { key: 'present_count', label: 'Present' }, { key: 'absent_count', label: 'Absent' }]} data={p.attendance} loading={false} emptyMessage="No attendance data" /></Card>}
          {profTab === 'performance' && <Card className="p-4"><DataTable columns={[{ key: 'term', label: 'Term' }, { key: 'academic_year', label: 'Year' }, { key: 'avg_score', label: 'Avg Score', render: (v: number) => <span className="font-semibold">{v}</span> }, { key: 'pass_rate', label: 'Pass Rate', render: (v: number) => <Badge variant={v >= 60 ? 'success' : 'danger'} className="text-[9px]">{v}%</Badge> }, { key: 'highest_score', label: 'Highest' }, { key: 'lowest_score', label: 'Lowest' }]} data={p.performance} loading={false} emptyMessage="No performance data" /></Card>}
          {profTab === 'ai' && <Card className="p-4"><div className="space-y-4">
            <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">{[
              { l: 'Health Score', v: p.ai?.healthScore || '—', c: '#7C3AED' }, { l: 'Attendance', v: `${p.ai?.avgAttendance || 0}%`, c: '#22C55E' },
              { l: 'Performance', v: `${p.ai?.avgPerformance || 0}%`, c: '#3B82F6' }, { l: 'Pass Rate', v: `${p.ai?.passRate || 0}%`, c: '#F59E0B' },
            ].map((s, i) => (<div key={i} className="p-3 rounded-lg bg-gray-50"><div className="text-xs font-semibold" style={{ color: s.c }}>{s.v}</div><div className="text-[9px] text-gray-400">{s.l}</div></div>))}</div>
            {p.ai?.insights?.length > 0 && <div><h4 className="font-bold text-xs mb-2">AI Insights</h4><div className="space-y-2">{p.ai.insights.map((ins: any, i: number) => (
              <div key={i} className={`p-3 rounded-lg text-[10px] ${ins.type === 'warning' ? 'bg-amber-50 text-amber-700' : ins.type === 'danger' ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`}><strong>{ins.title}:</strong> {ins.message}</div>
            ))}</div></div>}
            {p.ai?.recommendations?.length > 0 && <div><h4 className="font-bold text-xs mb-2">Recommendations</h4><div className="space-y-1">{p.ai.recommendations.map((r: string, i: number) => <div key={i} className="flex items-center gap-2 text-[10px] text-gray-600"><Sparkles size={12} className="text-[#7C3AED]" />{r}</div>)}</div></div>}
          </div></Card>}
        </div>
      );
    };

    if (selC) return renderProfile();

    return (
      <ModulePage title="Class Management" desc="Manage classes, sections, teachers, and student assignments">
        {dash.loading ? <LoadingSkeleton rows={2} cols={6} /> : renderKpis()}
        {renderCharts()}
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          <div className="lg:col-span-3">{renderToolbar()}{v === 'table' ? renderTable() : renderCards()}</div>
          <div className="lg:col-span-1">{renderSidebar()}</div>
        </div>

        <CrudModal open={!!m} onClose={() => setM(null)} title={m?.type === 'add' ? 'Add Class' : 'Edit Class'}>
          {m?.type === 'add' && <div className="space-y-3">
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Class Name</label><input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div className="grid grid-cols-2 gap-3"><div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Section</label><input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Grade Level</label><input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div></div>
            <div className="grid grid-cols-2 gap-3"><div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Capacity</label><input type="number" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Room Number</label><input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div></div>
            <button onClick={async () => { setCr(true); const r = await classApiV2.createClass({ name: 'New Class', section: 'A', grade_level: 'Grade 1', capacity: 30 }); if (r.success) { toast.success('Class created'); rfs(); setM(null); } setCr(false); }} className="w-full py-2.5 rounded-lg text-white text-xs font-semibold" style={{ background: 'linear-gradient(135deg, #7C3AED, #8B5CF6)' }}>{cr ? 'Creating...' : 'Create Class'}</button>
          </div>}
          {m?.type === 'edit' && <div className="space-y-3">
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Class Name</label><input type="text" defaultValue={m.d?.name} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div className="grid grid-cols-2 gap-3"><div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Section</label><input type="text" defaultValue={m.d?.section} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Grade Level</label><input type="text" defaultValue={m.d?.grade_level} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div></div>
            <div className="grid grid-cols-2 gap-3"><div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Capacity</label><input type="number" defaultValue={m.d?.capacity} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
            <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Room Number</label><input type="text" defaultValue={m.d?.room_number} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div></div>
            <button onClick={async () => { setCr(true); await classApiV2.updateClass(m.d.id, { name: m.d.name }); toast.success('Class updated'); rfs(); setM(null); setCr(false); }} className="w-full py-2.5 rounded-lg text-white text-xs font-semibold" style={{ background: 'linear-gradient(135deg, #7C3AED, #8B5CF6)' }}>{cr ? 'Updating...' : 'Update Class'}</button>
          </div>}
        </CrudModal>
      </ModulePage>
    );
  }

  function ExamTab() {
    const [view, setView] = useState<'dashboard' | 'exam-list' | 'timetable' | 'results' | 'grades' | 'performance' | 'insights'>('dashboard');
    const [modalMode, setModalMode] = useState<'add' | 'edit' | null>(null);
    const [editId, setEditId] = useState<string | null>(null);
    const [selectedExam, setSelectedExam] = useState('');
    const [selectedStudent, setSelectedStudent] = useState('');
    const [filterClass, setFilterClass] = useState('');
    const [filterStatus, setFilterStatus] = useState('');
    const [filterType, setFilterType] = useState('');
    const [page, setPage] = useState(1);
    const [marksForm, setMarksForm] = useState({ exam_id: '', student_id: '', subject_id: '', marks_obtained: '', total_marks: '', remarks: '' });
    const [bulkMarks, setBulkMarks] = useState<any[]>([]);
    const [form, setForm] = useState<any>({ title: '', exam_type: 'midterm', description: '', total_marks: 100, passing_marks: 35, class_id: '', section: '', term: '', academic_year: String(new Date().getFullYear()), start_date: '', end_date: '', status: 'draft' });

    const dashboard = useApi(() => examApiV2.getDashboard(), []);
    const exams = useApi(() => examApiV2.getExams({ page, limit: 20, class_id: filterClass || undefined, status: filterStatus || undefined, exam_type: filterType || undefined }), [page, filterClass, filterStatus, filterType]);
    const schedules = useApi(() => selectedExam ? examApiV2.getSchedules(selectedExam) : Promise.resolve({ success: true, data: [] }), [selectedExam]);
    const results = useApi(() => examApiV2.getResults({ exam_id: selectedExam || undefined, page: 1, limit: 100 }), [selectedExam]);
    const analytics = useApi(() => examApiV2.getAnalytics(), [view]);
    const aiInsights = useApi(() => examApiV2.getAiInsights(), [view]);
    const readiness = useApi(() => examApiV2.getReadinessScores(), [view]);
    const performance = useApi(() => selectedStudent ? examApiV2.getStudentPerformance(selectedStudent) : Promise.resolve({ success: true, data: null }), [selectedStudent]);
    const classes = useApi(() => classApi.getAll(), []);
    const invigilators = useApi(() => examApiV2.getInvigilators(), []);
    const gradeDefs = useApi(() => examApiV2.getGradeDefinitions(), []);

    const ds = dashboard.data || {};
    const NAVS = [
      { key: 'dashboard', label: 'Dashboard', icon: LayoutDashboard },
      { key: 'exam-list', label: 'Exam List', icon: ClipboardList },
      { key: 'timetable', label: 'Timetable', icon: CalendarDays },
      { key: 'results', label: 'Results', icon: FileText },
      { key: 'grades', label: 'Grades', icon: Award },
      { key: 'performance', label: 'Performance', icon: TrendingUp },
      { key: 'insights', label: 'AI Insights', icon: Bot },
    ];

    const openAddModal = () => {
      setEditId(null);
      setForm({ title: '', exam_type: 'midterm', description: '', total_marks: 100, passing_marks: 35, class_id: '', section: '', term: '', academic_year: String(new Date().getFullYear()), start_date: '', end_date: '', status: 'draft' });
      setModalMode('add');
    };

    const openEditModal = (exam: any) => {
      setEditId(exam.id);
      setForm({
        title: exam.title || '', exam_type: exam.exam_type || 'midterm', description: exam.description || '',
        total_marks: exam.total_marks || 100, passing_marks: exam.passing_marks || 35,
        class_id: exam.class_id || '', section: exam.section || '',
        term: exam.term || '', academic_year: exam.academic_year || String(new Date().getFullYear()),
        start_date: exam.start_date ? exam.start_date.split('T')[0] : '',
        end_date: exam.end_date ? exam.end_date.split('T')[0] : '',
        status: exam.status || 'draft',
      });
      setModalMode('edit');
    };

    const handleSaveExam = async () => {
      if (!form.title || !form.class_id || !form.start_date) { toast.error('Fill required fields'); return; }
      const res = editId ? await examApiV2.updateExam(editId, form) : await examApiV2.createExam(form);
      if (res.success) { toast.success(editId ? 'Updated' : 'Created'); setModalMode(null); exams.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleDeleteExam = async (id: string) => {
      if (!confirm('Delete this exam?')) return;
      const res = await examApiV2.deleteExam(id);
      if (res.success) { toast.success('Deleted'); exams.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleStatusChange = async (id: string, status: string) => {
      const res = await examApiV2.updateExamStatus(id, status);
      if (res.success) { toast.success(`Status: ${status}`); exams.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleEnterMarks = async () => {
      if (!marksForm.exam_id || !marksForm.student_id || !marksForm.subject_id || !marksForm.marks_obtained) {
        toast.error('Fill all required fields');
        return;
      }
      const res = await examApiV2.enterMarks(marksForm);
      if (res.success) { toast.success('Marks saved'); setMarksForm({ exam_id: selectedExam, student_id: '', subject_id: '', marks_obtained: '', total_marks: '', remarks: '' }); results.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleBulkMarks = async () => {
      if (!bulkMarks.length || !selectedExam) { toast.error('No marks data'); return; }
      const res = await examApiV2.bulkEnterMarks({ exam_id: selectedExam, results: bulkMarks });
      if (res.success) { toast.success(`${res.data?.count || 0} marks saved`); results.refetch(); setBulkMarks([]); }
      else toast.error(res.error || 'Failed');
    };

    const handlePublish = async () => {
      if (!selectedExam) return;
      const res = await examApiV2.publishResults(selectedExam);
      if (res.success) { toast.success('Results published'); dashboard.refetch(); exams.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleLock = async () => {
      if (!selectedExam) return;
      const res = await examApiV2.lockResults(selectedExam);
      if (res.success) { toast.success('Results locked'); dashboard.refetch(); exams.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const openMarksModal = (examId: string) => {
      setSelectedExam(examId);
      setMarksForm({ exam_id: examId, student_id: '', subject_id: '', marks_obtained: '', total_marks: '', remarks: '' });
    };

    const renderDashboard = () => {
      const summary = ds.summary || {};
      const subjectAreas = ds.subjectAreas || [];
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            <KpiCard icon={ClipboardList} label="Total Exams" value={summary.totalExams || 0} color="#7C3AED" bg="#7C3AED10" />
            <KpiCard icon={Clock} label="Upcoming" value={summary.upcoming || 0} color="#F59E0B" bg="#F59E0B10" />
            <KpiCard icon={CheckCircle2} label="Completed" value={summary.completed || 0} color="#10B981" bg="#10B98110" />
            <KpiCard icon={FileText} label="Results Published" value={summary.published || 0} color="#3B82F6" bg="#3B82F610" />
            <KpiCard icon={Users} label="Students Assessed" value={summary.studentsAssessed || 0} color="#8B5CF6" bg="#8B5CF610" />
            <KpiCard icon={TrendingUp} label="Avg Score" value={summary.avgScore ? `${summary.avgScore}%` : '—'} color="#EC4899" bg="#EC489910" />
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Subject Performance</h3>
              {subjectAreas.length > 0 ? (
                <ResponsiveContainer width="100%" height={280}>
                  <BarChart data={subjectAreas}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                    <XAxis dataKey="subject_name" tick={{ fontSize: 10 }} />
                    <YAxis tick={{ fontSize: 10 }} domain={[0, 100]} />
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                    <Bar dataKey="avg_marks" fill="#7C3AED" radius={[4, 4, 0, 0]} name="Avg Marks" />
                    <Bar dataKey="pass_rate" fill="#10B981" radius={[4, 4, 0, 0]} name="Pass Rate" />
                  </BarChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No performance data yet" />}
            </Card>
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Exam Distribution</h3>
              {subjectAreas.length > 0 ? (
                <ResponsiveContainer width="100%" height={280}>
                  <RePieChart>
                    <Pie data={subjectAreas} dataKey="avg_marks" nameKey="subject_name" cx="50%" cy="50%" outerRadius={90} label={({ subject_name }: any) => subject_name?.slice(0, 12)}>
                      {subjectAreas.map((_: any, i: number) => <Cell key={i} fill={['#7C3AED', '#8B5CF6', '#A78BFA', '#C4B5FD', '#DDD6FE', '#EDE9FE'][i % 6]} />)}
                    </Pie>
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  </RePieChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No data" />}
            </Card>
          </div>
        </div>
      );
    };

    const renderExamList = () => {
      const items = Array.isArray(exams.data?.data || exams.data) ? (exams.data?.data || exams.data || []) : [];
      const totalPages = exams.data?.totalPages || 1;
      return (
        <div className="space-y-4">
          <div className="flex flex-wrap gap-3 items-center">
            <div className="flex-1 flex flex-wrap gap-2">
              <select value={filterClass} onChange={e => { setFilterClass(e.target.value); setPage(1); }}
                className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
                <option value="">All Classes</option>
                {(classes.data || []).map((c: any) => <option key={c.id} value={c.id}>{c.name}</option>)}
              </select>
              <select value={filterStatus} onChange={e => { setFilterStatus(e.target.value); setPage(1); }}
                className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
                <option value="">All Status</option>
                <option value="draft">Draft</option>
                <option value="scheduled">Scheduled</option>
                <option value="ongoing">Ongoing</option>
                <option value="completed">Completed</option>
              </select>
              <select value={filterType} onChange={e => { setFilterType(e.target.value); setPage(1); }}
                className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white">
                <option value="">All Types</option>
                <option value="midterm">Midterm</option>
                <option value="final">Final</option>
                <option value="quiz">Quiz</option>
                <option value="test">Test</option>
                <option value="practical">Practical</option>
                <option value="other">Other</option>
              </select>
            </div>
            <AddButton onClick={openAddModal} label="Add Exam" />
          </div>
          <Card className="border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm overflow-hidden">
            {exams.loading ? <LoadingSkeleton rows={5} /> :
              exams.error ? <ErrorState message={exams.error} onRetry={exams.refetch} /> :
                items.length === 0 ? <div className="p-8"><EmptyState message="No exams found" /></div> :
                  <div className="overflow-x-auto">
                    <table className="w-full text-left">
                      <thead><tr className="border-b border-gray-100 bg-gray-50/50">
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Title</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Type</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Class</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Marks</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Start</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                      </tr></thead>
                      <tbody>
                        {items.map((exam: any) => (
                          <tr key={exam.id} className="border-b border-gray-50 hover:bg-purple-50/40 transition-colors">
                            <td className="p-3 text-sm font-medium text-gray-800">{exam.title}</td>
                            <td className="p-3"><Badge className="text-[9px] capitalize">{exam.exam_type || exam.type}</Badge></td>
                            <td className="p-3 text-xs text-gray-600">{exam.class_name || exam.class_id?.slice(0, 8) || '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{exam.total_marks || 100}</td>
                            <td className="p-3 text-xs text-gray-600">{exam.start_date ? new Date(exam.start_date).toLocaleDateString() : '—'}</td>
                            <td className="p-3">
                              <Badge variant={exam.status === 'completed' ? 'success' : exam.status === 'scheduled' || exam.status === 'ongoing' ? 'info' : 'warning'}
                                className="text-[9px] capitalize">{exam.status || 'draft'}</Badge>
                            </td>
                            <td className="p-3">
                              <div className="flex gap-1.5">
                                <button onClick={() => openEditModal(exam)} className="p-1.5 rounded-lg hover:bg-purple-100 text-purple-600 transition-colors"
                                  title="Edit"><Edit3 size={14} /></button>
                                <button onClick={() => handleStatusChange(exam.id, exam.status === 'draft' ? 'scheduled' : exam.status === 'scheduled' ? 'ongoing' : 'completed')}
                                  className="p-1.5 rounded-lg hover:bg-blue-100 text-blue-600 transition-colors" title="Advance Status"><Zap size={14} /></button>
                                <button onClick={() => { setSelectedExam(exam.id); setView('timetable'); }}
                                  className="p-1.5 rounded-lg hover:bg-green-100 text-green-600 transition-colors" title="Schedule"><CalendarDays size={14} /></button>
                                <button onClick={() => openMarksModal(exam.id)}
                                  className="p-1.5 rounded-lg hover:bg-amber-100 text-amber-600 transition-colors" title="Enter Marks"><Edit3 size={14} /></button>
                                <button onClick={() => handleDeleteExam(exam.id)} className="p-1.5 rounded-lg hover:bg-red-100 text-red-500 transition-colors"
                                  title="Delete"><Trash2 size={14} /></button>
                              </div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>}
            {totalPages > 1 && (
              <div className="flex justify-center gap-2 p-4 border-t border-gray-100">
                <button onClick={() => setPage(p => Math.max(1, p - 1))} disabled={page === 1}
                  className="px-3 py-1.5 text-xs rounded-lg border border-gray-200 disabled:opacity-40">Prev</button>
                <span className="px-3 py-1.5 text-xs text-gray-600">{page} / {totalPages}</span>
                <button onClick={() => setPage(p => Math.min(totalPages, p + 1))} disabled={page === totalPages}
                  className="px-3 py-1.5 text-xs rounded-lg border border-gray-200 disabled:opacity-40">Next</button>
              </div>
            )}
          </Card>
          <CrudModal open={modalMode !== null} onClose={() => setModalMode(null)} title={editId ? 'Edit Exam' : 'Add Exam'}>
            <div className="space-y-4">
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Title *</label>
                  <input value={form.title} onChange={e => setForm((f: any) => ({ ...f, title: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Type</label>
                  <select value={form.exam_type} onChange={e => setForm((f: any) => ({ ...f, exam_type: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white">
                    <option value="midterm">Midterm</option>
                    <option value="final">Final</option>
                    <option value="quiz">Quiz</option>
                    <option value="test">Test</option>
                    <option value="practical">Practical</option>
                    <option value="other">Other</option>
                  </select></div>
              </div>
              <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Description</label>
                <textarea value={form.description} onChange={e => setForm((f: any) => ({ ...f, description: e.target.value }))}
                  className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" rows={2} /></div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Class *</label>
                  <select value={form.class_id} onChange={e => setForm((f: any) => ({ ...f, class_id: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white">
                    <option value="">Select class...</option>
                    {(classes.data || []).map((c: any) => <option key={c.id} value={c.id}>{c.name}</option>)}
                  </select></div>
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Section</label>
                  <input value={form.section} onChange={e => setForm((f: any) => ({ ...f, section: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Total Marks</label>
                  <input type="number" value={form.total_marks} onChange={e => setForm((f: any) => ({ ...f, total_marks: Number(e.target.value) }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Passing Marks</label>
                  <input type="number" value={form.passing_marks} onChange={e => setForm((f: any) => ({ ...f, passing_marks: Number(e.target.value) }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Start Date</label>
                  <input type="date" value={form.start_date} onChange={e => setForm((f: any) => ({ ...f, start_date: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">End Date</label>
                  <input type="date" value={form.end_date} onChange={e => setForm((f: any) => ({ ...f, end_date: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Term</label>
                  <input value={form.term} onChange={e => setForm((f: any) => ({ ...f, term: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
                <div><label className="text-[11px] font-semibold text-gray-600 mb-1 block">Academic Year</label>
                  <input value={form.academic_year} onChange={e => setForm((f: any) => ({ ...f, academic_year: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" /></div>
              </div>
              <div className="flex gap-2 pt-2">
                <button onClick={handleSaveExam}
                  className="flex-1 py-2.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold">Save</button>
                <button onClick={() => setModalMode(null)}
                  className="px-4 py-2.5 rounded-lg border border-gray-200 text-gray-500 text-sm font-semibold">Cancel</button>
              </div>
            </div>
          </CrudModal>
        </div>
      );
    };

    const renderTimetable = () => {
      const items = schedules.data || [];
      return (
        <div className="space-y-4">
          <div className="flex flex-wrap gap-2 items-center">
            <select value={selectedExam} onChange={e => setSelectedExam(e.target.value)}
              className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white flex-1 max-w-xs">
              <option value="">Select exam...</option>
              {((Array.isArray(exams.data?.data || exams.data) ? (exams.data?.data || exams.data || []) : [])).map((e: any) => (
                <option key={e.id} value={e.id}>{e.title}</option>
              ))}
            </select>
            <AddButton onClick={async () => {
              if (!selectedExam) { toast.error('Select an exam first'); return; }
              await examApiV2.createSchedule({ exam_id: selectedExam, subject_id: '', date: '', start_time: '', end_time: '', room: '' });
              schedules.refetch();
            }} label="Add Slot" />
          </div>
          {!selectedExam ? <EmptyState message="Select an exam to view timetable" /> :
            schedules.loading ? <LoadingSkeleton rows={4} /> :
              schedules.error ? <ErrorState message={schedules.error} onRetry={schedules.refetch} /> :
                items.length === 0 ? <EmptyState message="No schedules defined" /> :
                  <div className="overflow-x-auto">
                    <table className="w-full text-left">
                      <thead><tr className="border-b border-gray-100 bg-gray-50/50">
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Subject</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Date</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Time</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Room</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Invigilator</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Actions</th>
                      </tr></thead>
                      <tbody>
                        {items.map((s: any) => (
                          <tr key={s.id} className="border-b border-gray-50 hover:bg-purple-50/40 transition-colors">
                            <td className="p-3 text-sm font-medium text-gray-800">{s.subject_name || s.subject_id?.slice(0, 8) || '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{s.date ? new Date(s.date).toLocaleDateString() : '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{s.start_time && s.end_time ? `${s.start_time} - ${s.end_time}` : '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{s.room || '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{s.invigilator_name || '—'}</td>
                            <td className="p-3">
                              <button onClick={() => examApiV2.deleteSchedule(s.id).then(() => { toast.success('Deleted'); schedules.refetch(); })}
                                className="p-1.5 rounded-lg hover:bg-red-100 text-red-500 transition-colors" title="Remove"><Trash2 size={14} /></button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>}
        </div>
      );
    };

    const renderResults = () => {
      const items = results.data?.data || results.data || [];
      const arr = Array.isArray(items) ? items : [];
      return (
        <div className="space-y-4">
          <div className="flex flex-wrap gap-2 items-center">
            <select value={selectedExam} onChange={e => { setSelectedExam(e.target.value); setView('results'); }}
              className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white flex-1 max-w-xs">
              <option value="">Select exam...</option>
              {((Array.isArray(exams.data?.data || exams.data) ? (exams.data?.data || exams.data || []) : [])).map((e: any) => (
                <option key={e.id} value={e.id}>{e.title}</option>
              ))}
            </select>
            {selectedExam && (
              <div className="flex gap-2">
                <button onClick={handlePublish} className="px-3 py-2 rounded-lg bg-green-500 text-white text-xs font-semibold hover:bg-green-600">Publish</button>
                <button onClick={handleLock} className="px-3 py-2 rounded-lg bg-red-500 text-white text-xs font-semibold hover:bg-red-600">Lock</button>
              </div>
            )}
          </div>
          {selectedExam && (
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Enter Marks</h3>
              <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
                <div><label className="text-[10px] font-semibold text-gray-500 mb-1 block">Student ID</label>
                  <input value={marksForm.student_id} onChange={e => setMarksForm((f: any) => ({ ...f, student_id: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" placeholder="Student ID" /></div>
                <div><label className="text-[10px] font-semibold text-gray-500 mb-1 block">Subject ID</label>
                  <input value={marksForm.subject_id} onChange={e => setMarksForm((f: any) => ({ ...f, subject_id: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" placeholder="Subject ID" /></div>
                <div><label className="text-[10px] font-semibold text-gray-500 mb-1 block">Marks</label>
                  <input type="number" value={marksForm.marks_obtained} onChange={e => setMarksForm((f: any) => ({ ...f, marks_obtained: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
                <div><label className="text-[10px] font-semibold text-gray-500 mb-1 block">Total</label>
                  <input type="number" value={marksForm.total_marks} onChange={e => setMarksForm((f: any) => ({ ...f, total_marks: e.target.value }))}
                    className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
                <div className="flex items-end">
                  <button onClick={handleEnterMarks}
                    className="w-full py-2 rounded-lg bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700">Save</button>
                </div>
              </div>
            </Card>
          )}
          <Card className="border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm overflow-hidden">
            {results.loading ? <LoadingSkeleton rows={5} /> :
              results.error ? <ErrorState message={results.error} onRetry={results.refetch} /> :
                arr.length === 0 ? <div className="p-8"><EmptyState message="No results yet" /></div> :
                  <div className="overflow-x-auto">
                    <table className="w-full text-left">
                      <thead><tr className="border-b border-gray-100 bg-gray-50/50">
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Student</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Subject</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Marks</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Grade</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Status</th>
                      </tr></thead>
                      <tbody>
                        {arr.map((r: any) => (
                          <tr key={r.id} className="border-b border-gray-50 hover:bg-purple-50/40 transition-colors">
                            <td className="p-3 text-sm font-medium text-gray-800">{r.student_name || r.student_id?.slice(0, 8)}</td>
                            <td className="p-3 text-xs text-gray-600">{r.subject_name || r.subject_id?.slice(0, 8)}</td>
                            <td className="p-3 text-xs text-gray-600">{r.marks_obtained ?? '—'} / {r.total_marks ?? '—'}</td>
                            <td className="p-3"><Badge className="text-[9px]">{r.grade || '—'}</Badge></td>
                            <td className="p-3">
                              <Badge variant={r.is_published ? 'success' : 'warning'} className="text-[9px]">{r.is_published ? 'Published' : 'Draft'}</Badge>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>}
          </Card>
        </div>
      );
    };

    const renderGrades = () => {
      const items = gradeDefs.data || [];
      return (
        <div className="space-y-4">
          <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
            <h3 className="text-sm font-semibold text-gray-700 mb-4">Grade Definitions</h3>
            {gradeDefs.loading ? <LoadingSkeleton rows={3} /> :
              gradeDefs.error ? <ErrorState message={gradeDefs.error} onRetry={gradeDefs.refetch} /> :
                items.length === 0 ? <EmptyState message="No grade definitions" /> :
                  <div className="overflow-x-auto">
                    <table className="w-full text-left">
                      <thead><tr className="border-b border-gray-100 bg-gray-50/50">
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Grade</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Min %</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Max %</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Points</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Description</th>
                      </tr></thead>
                      <tbody>
                        {items.map((g: any) => (
                          <tr key={g.id} className="border-b border-gray-50 hover:bg-purple-50/40">
                            <td className="p-3 text-sm font-bold text-purple-700">{g.grade}</td>
                            <td className="p-3 text-xs text-gray-600">{g.min_percentage}%</td>
                            <td className="p-3 text-xs text-gray-600">{g.max_percentage}%</td>
                            <td className="p-3 text-xs text-gray-600">{g.grade_points || '—'}</td>
                            <td className="p-3 text-xs text-gray-500">{g.description || '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>}
          </Card>
        </div>
      );
    };

    const renderPerformance = () => {
      const perf = performance.data;
      return (
        <div className="space-y-4">
          <div className="flex flex-wrap gap-2 items-center">
            <input value={selectedStudent} onChange={e => setSelectedStudent(e.target.value)}
              className="px-3 py-2 border border-gray-200 rounded-lg text-xs bg-white flex-1 max-w-xs" placeholder="Enter student ID..." />
            <button onClick={() => { if (selectedStudent) performance.refetch(); else toast.error('Enter student ID'); }}
              className="px-4 py-2 rounded-lg bg-purple-600 text-white text-xs font-semibold">Load</button>
          </div>
          {selectedStudent && perf && (
            <div className="space-y-4">
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <KpiCard icon={Award} label="Overall GPA" value={perf.overallGpa || '—'} color="#7C3AED" bg="#7C3AED10" />
                <KpiCard icon={TrendingUp} label="Avg Score" value={perf.avgScore ? `${perf.avgScore}%` : '—'} color="#10B981" bg="#10B98110" />
                <KpiCard icon={FileText} label="Exams Taken" value={perf.examsTaken || 0} color="#3B82F6" bg="#3B82F610" />
                <KpiCard icon={Star} label="Rank" value={perf.rank || '—'} color="#F59E0B" bg="#F59E0B10" />
              </div>
              {perf.subjectScores && perf.subjectScores.length > 0 && (
                <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
                  <h3 className="text-sm font-semibold text-gray-700 mb-4">Subject Scores</h3>
                  <ResponsiveContainer width="100%" height={250}>
                    <BarChart data={perf.subjectScores}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                      <XAxis dataKey="subject_name" tick={{ fontSize: 10 }} />
                      <YAxis tick={{ fontSize: 10 }} />
                      <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                      <Bar dataKey="score" fill="#7C3AED" radius={[4, 4, 0, 0]} name="Score" />
                    </BarChart>
                  </ResponsiveContainer>
                </Card>
              )}
              {perf.recentExams && perf.recentExams.length > 0 && (
                <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
                  <h3 className="text-sm font-semibold text-gray-700 mb-4">Recent Exams</h3>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left">
                      <thead><tr className="border-b border-gray-100 bg-gray-50/50">
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Exam</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Subject</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Score</th>
                        <th className="p-3 text-[10px] font-semibold text-gray-500 uppercase">Grade</th>
                      </tr></thead>
                      <tbody>
                        {perf.recentExams.map((r: any, i: number) => (
                          <tr key={i} className="border-b border-gray-50">
                            <td className="p-3 text-xs text-gray-800">{r.exam_title || '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{r.subject_name || '—'}</td>
                            <td className="p-3 text-xs text-gray-600">{r.marks_obtained ?? '—'} / {r.total_marks ?? '—'}</td>
                            <td className="p-3"><Badge className="text-[9px]">{r.grade || '—'}</Badge></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </Card>
              )}
            </div>
          )}
          {selectedStudent && !perf && performance.loading && <LoadingSkeleton rows={3} />}
        </div>
      );
    };

    const renderAiInsights = () => {
      const insights = aiInsights.data || {};
      const atRisk = insights.atRiskStudents || [];
      const weakSubjects = insights.weakSubjects || [];
      const recommendations = insights.recommendations || [];
      const readinessData = readiness.data || [];
      const rd = Array.isArray(readinessData) ? readinessData : [];
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">At-Risk Students</h3>
              {atRisk.length === 0 ? <EmptyState message="No at-risk students identified" /> :
                <div className="space-y-2">
                  {atRisk.map((s: any, i: number) => (
                    <div key={i} className="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                      <div>
                        <p className="text-xs font-medium text-gray-800">{s.student_name || `Student ${s.student_id?.slice(0, 8)}`}</p>
                        <p className="text-[10px] text-gray-500">Risk: {s.risk_score || s.risk_level || 'High'}</p>
                      </div>
                      <Badge variant="danger" className="text-[9px]">Intervention Needed</Badge>
                    </div>
                  ))}
                </div>}
            </Card>
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Weak Subjects</h3>
              {weakSubjects.length === 0 ? <EmptyState message="No weak subjects identified" /> :
                <div className="space-y-2">
                  {weakSubjects.map((s: any, i: number) => (
                    <div key={i} className="flex items-center justify-between p-3 bg-amber-50 rounded-lg">
                      <p className="text-xs font-medium text-gray-800">{s.subject_name || s}</p>
                      <Badge variant="warning" className="text-[9px]">Avg: {s.avgScore || s.avg_marks || '—'}%</Badge>
                    </div>
                  ))}
                </div>}
            </Card>
          </div>
          {rd.length > 0 && (
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Readiness Scores</h3>
              <ResponsiveContainer width="100%" height={250}>
                <BarChart data={rd}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="student_name" tick={{ fontSize: 9 }} />
                  <YAxis tick={{ fontSize: 10 }} domain={[0, 100]} />
                  <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  <Bar dataKey="readiness_score" fill="#8B5CF6" radius={[4, 4, 0, 0]} name="Readiness" />
                </BarChart>
              </ResponsiveContainer>
            </Card>
          )}
          {recommendations.length > 0 && (
            <Card className="p-5 border border-gray-100 rounded-xl bg-white/80 backdrop-blur-sm">
              <h3 className="text-sm font-semibold text-gray-700 mb-4">Recommendations</h3>
              <div className="space-y-2">
                {recommendations.map((r: any, i: number) => (
                  <div key={i} className="flex gap-3 p-3 bg-purple-50 rounded-lg">
                    <Sparkles size={16} className="text-purple-600 mt-0.5 shrink-0" />
                    <p className="text-xs text-gray-700">{r.recommendation || r}</p>
                  </div>
                ))}
              </div>
            </Card>
          )}
        </div>
      );
    };

    return (
      <ModulePage title="Examinations Management" desc="Comprehensive exam lifecycle management with analytics and AI insights"
        actions={
          <div className="flex gap-2">
            {view === 'exam-list' && <AddButton onClick={openAddModal} label="Add Exam" />}
          </div>
        }>
        <div className="flex gap-1 flex-wrap mb-6 p-1 bg-gray-100/60 rounded-xl">
          {NAVS.map(n => (
            <button key={n.key} onClick={() => setView(n.key as any)}
              className={`flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-medium transition-all ${view === n.key ? 'bg-white text-purple-700 shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}>
              <n.icon size={14} />
              {n.label}
            </button>
          ))}
        </div>
        {view === 'dashboard' && renderDashboard()}
        {view === 'exam-list' && renderExamList()}
        {view === 'timetable' && renderTimetable()}
        {view === 'results' && renderResults()}
        {view === 'grades' && renderGrades()}
        {view === 'performance' && renderPerformance()}
        {view === 'insights' && renderAiInsights()}
      </ModulePage>
    );
  }

  function FeeTab() {
    const [mode, setMode] = useState<'structures' | 'students' | 'invoices' | 'collections' | 'scholarships' | 'analytics' | 'insights' | 'reports'>('structures');
    const [acYear, setAcYear] = useState('');
    const [cls, setCls] = useState('');
    const [section, setSection] = useState('');
    const [feeCat, setFeeCat] = useState('');
    const [payStatus, setPayStatus] = useState('');
    const [payMethod, setPayMethod] = useState('');
    const [searchQ, setSearchQ] = useState('');
    const [showForm, setShowForm] = useState(false);

    const dash = useApi(() => feeManagementApiV2.getDashboard(), []);
    const structures = useApi(() => feeManagementApiV2.getFeeStructures(), []);
    const studentFees = useApi(() => feeManagementApiV2.getStudentFees({ search: searchQ || undefined, status: payStatus || undefined, class: cls || undefined }), [searchQ, payStatus, cls]);
    const invoices = useApi(() => feeManagementApiV2.getInvoices(payStatus || undefined), [payStatus]);
    const transactions = useApi(() => feeManagementApiV2.getTransactions(50), []);
    const scholarships = useApi(() => feeManagementApiV2.getScholarships(), []);
    const analytics = useApi(() => feeManagementApiV2.getFinancialAnalytics(), []);
    const insights = useApi(() => feeManagementApiV2.getAiInsights(), []);
    const reportsData = useApi(() => feeManagementApiV2.getReports(), []);
    const sidebar = useApi(() => feeManagementApiV2.getSidebar(), []);

    const dd = dash.data?.data || dash.data || {};
    const sd = sidebar.data?.data || sidebar.data || {};
    const ad = analytics.data?.data || analytics.data || {};

    const NAVS = [
      { key: 'structures', label: 'Fee Structures', icon: DollarSign },
      { key: 'students', label: 'Student Fees', icon: Users },
      { key: 'invoices', label: 'Invoices', icon: FileText },
      { key: 'collections', label: 'Collections', icon: TrendingUp },
      { key: 'scholarships', label: 'Scholarships', icon: Award },
      { key: 'analytics', label: 'Financial Analytics', icon: BarChart3 },
      { key: 'insights', label: 'AI Insights', icon: Brain },
      { key: 'reports', label: 'Reports', icon: FileSpreadsheet },
    ];

    const KPI_CONFIG = [
      { icon: DollarSign, label: 'Total Fee Collection', value: `$${(dd.totalCollected / 1000).toFixed(1)}K`, trend: `+${dd.trends?.collection?.pct || 12}%`, color: '#22C55E', bg: '#F0FDF4', chart: dd.sparklines?.collection },
      { icon: AlertTriangle, label: 'Pending Fee Amount', value: `$${(dd.totalPending / 1000).toFixed(1)}K`, trend: `-${dd.trends?.pending?.pct || 8}%`, color: '#F59E0B', bg: '#FFFBEB', chart: dd.sparklines?.pending },
      { icon: TrendingUp, label: 'Fees Collected This Month', value: `$${(dd.monthCollected / 1000).toFixed(1)}K`, trend: `+${dd.trends?.monthly?.pct || 15}%`, color: '#3B82F6', bg: '#EFF6FF', chart: dd.sparklines?.monthly },
      { icon: Clock, label: 'Overdue Payments', value: `$${(dd.overdue / 1000).toFixed(1)}K`, trend: `-${dd.trends?.overdue?.pct || 5}%`, color: '#EF4444', bg: '#FEF2F2', chart: dd.sparklines?.overdue },
      { icon: Target, label: 'Collection Rate', value: `${dd.collectionRate ?? 0}%`, trend: `+${dd.trends?.rate?.pct || 3}%`, color: '#6D4CFF', bg: '#F5F3FF', chart: dd.sparklines?.rate },
      { icon: Award, label: 'Scholarship Amount', value: `$${(dd.scholarshipAmount / 1000).toFixed(1)}K`, trend: `+${dd.trends?.scholarship?.pct || 10}%`, color: '#A855F7', bg: '#FAF5FF', chart: dd.sparklines?.scholarship },
      { icon: Library, label: 'Active Fee Structures', value: dd.activeStructures ?? 0, trend: `${dd.trends?.structures?.pct || 0}%`, color: '#06B6D4', bg: '#ECFEFF', chart: dd.sparklines?.structures },
      { icon: BarChart3, label: 'Revenue Forecast', value: `$${(dd.revenueForecast / 1000).toFixed(1)}K`, trend: `+${dd.trends?.forecast?.pct || 12}%`, color: '#8B5CF6', bg: '#F5F3FF', chart: dd.sparklines?.forecast },
    ];

    const renderStructures = () => (
      <Card className="p-0 overflow-hidden">
        <DataTable
          columns={[
            { key: 'name', label: 'Structure Name', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
            { key: 'class_name', label: 'Class', render: (v: string) => <span className="text-[11px]">{v || 'All'}</span> },
            { key: 'academic_year', label: 'Academic Year', render: (v: string) => <span className="text-[11px]">{v || '2024-25'}</span> },
            { key: 'tuitionFee', label: 'Tuition', render: (v: number) => <span className="text-[11px] font-semibold">${(v || 0).toLocaleString()}</span> },
            { key: 'transportFee', label: 'Transport', render: (v: number) => <span className="text-[11px]">${(v || 0).toLocaleString()}</span> },
            { key: 'hostelFee', label: 'Hostel', render: (v: number) => <span className="text-[11px]">${(v || 0).toLocaleString()}</span> },
            { key: 'examFee', label: 'Exam', render: (v: number) => <span className="text-[11px]">${(v || 0).toLocaleString()}</span> },
            { key: 'totalAmount', label: 'Total', render: (v: number) => <span className="text-xs font-bold text-[#6D4CFF]">${(v || 0).toLocaleString()}</span> },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'warning'} className="text-[9px] capitalize">{v || 'active'}</Badge> },
            { key: 'id', label: '', render: (_: string, row: any) => (
              <div className="flex gap-1">
                <button className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold">View</button>
                <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600">Edit</button>
                <button className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[9px] font-semibold">Archive</button>
              </div>
            )},
          ]}
          data={structures.data?.data || structures.data || []}
          loading={structures.loading}
          emptyMessage="No fee structures created yet"
        />
      </Card>
    );

    const renderStudentFees = () => {
      const sf = studentFees.data?.data || studentFees.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search by name, admission number..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <select value={payStatus} onChange={e => setPayStatus(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Status</option>
              <option value="paid">Paid</option>
              <option value="partial">Partial</option>
              <option value="pending">Pending</option>
              <option value="overdue">Overdue</option>
            </select>
            <select value={cls} onChange={e => setCls(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Classes</option>
              {['10A','10B','9A','9B','11A','11B'].map(c => <option key={c} value={c}>{c}</option>)}
            </select>
            <button onClick={() => studentFees.refetch()} className="px-3 py-2 rounded-lg bg-gray-100 text-xs font-semibold text-gray-600"><RotateCcw size={14} /></button>
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'full_name', label: 'Student', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold">{v?.charAt(0)}</div>
                    <div><div className="text-xs font-semibold">{v}</div><div className="text-[9px] text-gray-400">{row.admission_number}</div></div>
                  </div>
                )},
                { key: 'class', label: 'Class', render: (v: string) => <span className="text-[11px]">{v || '—'}</span> },
                { key: 'totalFee', label: 'Total Fee', render: (v: number) => <span className="text-[11px] font-semibold">${(v || 0).toLocaleString()}</span> },
                { key: 'paidAmount', label: 'Paid', render: (v: number) => <span className="text-[11px] font-semibold text-[#22C55E]">${(v || 0).toLocaleString()}</span> },
                { key: 'pendingAmount', label: 'Pending', render: (v: number) => <span className="text-[11px] font-semibold text-[#EF4444]">${(v || 0).toLocaleString()}</span> },
                { key: 'dueDate', label: 'Due Date', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'status', label: 'Status', render: (v: string) => {
                  const map: Record<string, 'success' | 'warning' | 'danger'> = { paid: 'success', partial: 'warning', pending: 'warning', overdue: 'danger' };
                  return <Badge variant={map[v] || 'warning'} className="text-[9px] capitalize">{v || 'pending'}</Badge>;
                }},
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button onClick={() => toast.success('Payment collected')} className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold">Collect</button>
                    <button className="p-1 rounded-lg hover:bg-gray-100 text-gray-400"><Eye size={12} /></button>
                    <button className="p-1 rounded-lg hover:bg-amber-100 text-amber-600"><Bell size={12} /></button>
                  </div>
                )},
              ]}
              data={sf.length > 0 ? sf : []}
              loading={studentFees.loading}
              emptyMessage="No student fee records found"
            />
          </Card>
        </div>
      );
    };

    const renderInvoices = () => {
      const inv = invoices.data?.data || invoices.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center justify-between">
            <select value={payStatus} onChange={e => setPayStatus(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Invoices</option>
              <option value="paid">Paid</option>
              <option value="pending">Pending</option>
              <option value="overdue">Overdue</option>
              <option value="cancelled">Cancelled</option>
            </select>
            <button onClick={() => setShowForm(true)} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5">+ Create Invoice</button>
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'invoiceNumber', label: 'Invoice #', render: (v: string) => <span className="text-[10px] font-mono font-semibold">{v || '—'}</span> },
                { key: 'studentName', label: 'Student', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
                { key: 'feeType', label: 'Fee Type', render: (v: string) => <Badge className="text-[9px]">{v || 'Tuition'}</Badge> },
                { key: 'dueDate', label: 'Due Date', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'amount', label: 'Amount', render: (v: number) => <span className="text-[11px] font-semibold">${(v || 0).toLocaleString()}</span> },
                { key: 'discount', label: 'Discount', render: (v: number) => <span className="text-[11px] text-[#22C55E]">${(v || 0).toLocaleString()}</span> },
                { key: 'finalAmount', label: 'Final', render: (v: number) => <span className="text-xs font-bold text-[#6D4CFF]">${(v || 0).toLocaleString()}</span> },
                { key: 'status', label: 'Status', render: (v: string) => {
                  const map: Record<string, 'success' | 'warning' | 'danger'> = { paid: 'success', pending: 'warning', overdue: 'danger', cancelled: 'danger' };
                  return <Badge variant={map[v] || 'warning'} className="text-[9px] capitalize">{v || 'pending'}</Badge>;
                }},
                { key: 'id', label: '', render: (_: string) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold">Send</button>
                    <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline" /></button>
                  </div>
                )},
              ]}
              data={inv.length > 0 ? inv : []}
              loading={invoices.loading}
              emptyMessage="No invoices found"
            />
          </Card>
        </div>
      );
    };

    const renderCollections = () => {
      const txns = transactions.data?.data || transactions.data || [];
      return (
        <div className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            {[
              { label: 'Online Payments', icon: Globe, value: Math.round(dd.totalCollected * 0.55), color: '#6D4CFF' },
              { label: 'UPI Payments', icon: Smartphone, value: Math.round(dd.totalCollected * 0.2), color: '#22C55E' },
              { label: 'Cash Collection', icon: DollarSign, value: Math.round(dd.totalCollected * 0.15), color: '#F59E0B' },
              { label: 'Cheque Collection', icon: FileText, value: Math.round(dd.totalCollected * 0.1), color: '#3B82F6' },
            ].map(c => (
              <Card key={c.label} className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-xl flex items-center justify-center" style={{ background: `${c.color}15`, color: c.color }}><c.icon size={16} /></div>
                  <div><div className="text-[10px] text-gray-500">{c.label}</div><div className="text-sm font-bold">${(c.value / 1000).toFixed(1)}K</div></div>
                </div>
              </Card>
            ))}
          </div>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Recent Transactions</h4>
            <DataTable
              columns={[
                { key: 'studentName', label: 'Student', render: (v: string) => <span className="text-xs font-semibold">{v}</span> },
                { key: 'amountPaid', label: 'Amount', render: (v: number) => <span className="font-semibold text-[11px] text-[#22C55E]">${(v || 0).toLocaleString()}</span> },
                { key: 'paymentMethod', label: 'Method', render: (v: string) => <Badge className="text-[9px] capitalize">{v || 'cash'}</Badge> },
                { key: 'paymentDate', label: 'Date', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleString() : '—'}</span> },
                { key: 'status', label: 'Status', render: (v: string) => <Badge variant="success" className="text-[9px] capitalize">{v || 'completed'}</Badge> },
              ]}
              data={txns.length > 0 ? txns : []}
              loading={transactions.loading}
              emptyMessage="No recent transactions"
            />
          </Card>
        </div>
      );
    };

    const renderScholarships = () => {
      const sch = scholarships.data?.data || scholarships.data || [];
      return (
        <div className="space-y-4">
          <div className="grid grid-cols-3 gap-4">
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Total Scholarships</div>
              <div className="text-3xl font-extrabold mt-1 text-[#6D4CFF]">{sch.length}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Approved</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">{sch.filter((s: any) => s.approvalStatus === 'approved').length}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Total Amount Approved</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">${(sch.reduce((s: number, sc: any) => s + (sc.amountCovered || 0), 0) / 1000).toFixed(1)}K</div>
            </Card>
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'name', label: 'Scholarship Name', render: (v: string) => <span className="text-xs font-semibold">{v || '—'}</span> },
                { key: 'eligibleStudents', label: 'Eligible Students', render: (v: number) => <span className="text-[11px] font-semibold">{v ?? '—'}</span> },
                { key: 'amountCovered', label: 'Amount Covered', render: (v: number) => <span className="text-[11px] font-semibold">${(v || 0).toLocaleString()}</span> },
                { key: 'approvalStatus', label: 'Approval Status', render: (v: string) => (
                  <Badge variant={v === 'approved' ? 'success' : v === 'pending' ? 'warning' : 'danger'} className="text-[9px] capitalize">{v || 'pending'}</Badge>
                )},
                { key: 'remainingBalance', label: 'Remaining Balance', render: (v: number) => <span className="text-[11px]">${(v || 0).toLocaleString()}</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button onClick={async () => { await feeManagementApiV2.approveScholarship(row.id); scholarships.refetch(); toast.success('Scholarship approved'); }} className="px-2 py-1 rounded-lg bg-[#22C55E10] text-[#22C55E] text-[9px] font-semibold">Approve</button>
                    <button className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[9px] font-semibold">Reject</button>
                  </div>
                )},
              ]}
              data={sch.length > 0 ? sch : []}
              loading={scholarships.loading}
              emptyMessage="No scholarships configured"
            />
          </Card>
        </div>
      );
    };

    const renderAnalytics = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Monthly Fee Collection Trend</h4>
            <ResponsiveContainer width="100%" height={260}>
              <AreaChart data={ad.monthlyCollection || []}>
                <defs><linearGradient id="feeGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#6D4CFF" stopOpacity={0.3}/><stop offset="95%" stopColor="#6D4CFF" stopOpacity={0}/></linearGradient></defs>
                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                <XAxis dataKey="month" tick={{ fontSize: 9 }} />
                <YAxis tick={{ fontSize: 10 }} />
                <Tooltip contentStyle={{ fontSize: 11 }} />
                <Area type="monotone" dataKey="amount" stroke="#6D4CFF" fill="url(#feeGrad)" strokeWidth={2} dot={{ r: 3 }} />
                <Area type="monotone" dataKey="forecast" stroke="#A855F7" fill="none" strokeWidth={2} strokeDasharray="5 5" dot={{ r: 3 }} />
              </AreaChart>
            </ResponsiveContainer>
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Collection Rate Analysis</h4>
            <ResponsiveContainer width="100%" height={260}>
              <BarChart data={ad.collectionRateTrend || []}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                <XAxis dataKey="month" tick={{ fontSize: 9 }} />
                <YAxis domain={[0, 100]} tick={{ fontSize: 10 }} />
                <Tooltip contentStyle={{ fontSize: 11 }} />
                <Bar dataKey="rate" name="Collection Rate" fill="#6D4CFF" radius={[4, 4, 0, 0]} />
                <Bar dataKey="target" name="Target" fill="#C4B5FD" radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </Card>
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Payment Method Distribution</h4>
            <ResponsiveContainer width="100%" height={260}>
              <RePieChart>
                <Pie data={(ad.paymentMethodDistribution || []).map((d: any) => ({ ...d, value: d.amount }))} cx="50%" cy="50%" innerRadius={60} outerRadius={100} dataKey="amount" paddingAngle={3}>
                  {(ad.paymentMethodDistribution || []).map((_: any, i: number) => (
                    <Cell key={i} fill={['#6D4CFF','#22C55E','#F59E0B','#3B82F6','#EF4444','#A855F7'][i]} />
                  ))}
                </Pie>
                <Tooltip />
              </RePieChart>
            </ResponsiveContainer>
            <div className="flex flex-wrap justify-center gap-3 mt-3">
              {(ad.paymentMethodDistribution || []).map((d: any, i: number) => (
                <div key={d.method} className="flex items-center gap-1.5">
                  <div className="w-2.5 h-2.5 rounded-full" style={{ background: ['#6D4CFF','#22C55E','#F59E0B','#3B82F6','#EF4444','#A855F7'][i] }} />
                  <span className="text-[9px] text-gray-500">{d.method} ({d.pct}%)</span>
                </div>
              ))}
            </div>
          </Card>
          <Card className="p-5">
            <h4 className="text-xs font-semibold text-gray-700 mb-4">Class-wise Revenue</h4>
            <ResponsiveContainer width="100%" height={260}>
              <BarChart data={ad.classWiseRevenue || []}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                <XAxis dataKey="className" tick={{ fontSize: 9 }} />
                <YAxis tick={{ fontSize: 10 }} />
                <Tooltip contentStyle={{ fontSize: 11 }} />
                <Bar dataKey="collected" name="Collected" fill="#22C55E" radius={[4, 4, 0, 0]} stackId="a" />
                <Bar dataKey="pending" name="Pending" fill="#EF4444" radius={[4, 4, 0, 0]} stackId="a" />
              </BarChart>
            </ResponsiveContainer>
          </Card>
        </div>
      </div>
    );

    const renderAiInsights = () => {
      const ins = insights.data?.data || insights.data || {};
      return (
        <div className="space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="p-4">
              <h4 className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2">Revenue Forecast</h4>
              <div className="text-lg font-extrabold text-[#6D4CFF]">{ins.revenueForecast || '—'}</div>
              <div className="text-[9px] text-gray-400 mt-1">Expected next quarter</div>
            </Card>
            <Card className="p-4">
              <h4 className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2">Collection Prediction</h4>
              <div className="text-lg font-extrabold text-[#22C55E]">{ins.collectionPrediction || '—'}</div>
              <div className="text-[9px] text-gray-400 mt-1">Based on current trends</div>
            </Card>
            <Card className="p-4">
              <h4 className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-2">Defaulter Risk</h4>
              <div className="flex items-center gap-3 mt-1">
                {ins.defaulterRisk && ['high', 'medium', 'low'].map(k => (
                  <div key={k} className="text-center">
                    <div className="text-sm font-extrabold capitalize" style={{ color: k === 'high' ? '#EF4444' : k === 'medium' ? '#F59E0B' : '#22C55E' }}>{ins.defaulterRisk[k as keyof typeof ins.defaulterRisk]}%</div>
                    <div className="text-[8px] text-gray-400 capitalize">{k}</div>
                  </div>
                ))}
              </div>
            </Card>
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-3">Budget Recommendations</h4>
              <div className="space-y-2">
                {(ins.budgetRecommendations || []).map((r: string, i: number) => (
                  <div key={i} className="flex items-start gap-2 p-2 rounded-lg bg-gray-50">
                    <div className="w-5 h-5 rounded-full bg-[#6D4CFF15] flex items-center justify-center text-[#6D4CFF] text-[9px] font-bold mt-0.5">{i + 1}</div>
                    <span className="text-[10px] text-gray-600">{r}</span>
                  </div>
                ))}
              </div>
            </Card>
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-3">Collection Strategies</h4>
              <div className="space-y-2">
                {(ins.collectionStrategies || []).map((s: string, i: number) => (
                  <div key={i} className="flex items-start gap-2 p-2 rounded-lg bg-gray-50">
                    <div className="w-5 h-5 rounded-full bg-[#22C55E15] flex items-center justify-center text-[#22C55E] text-[9px] font-bold mt-0.5">{i + 1}</div>
                    <span className="text-[10px] text-gray-600">{s}</span>
                  </div>
                ))}
              </div>
            </Card>
          </div>
        </div>
      );
    };

    const renderReports = () => {
      const rps = (reportsData.data || []) as any[];
      return (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {(Array.isArray(rps) ? rps : []).map((r: any) => {
            const Icon = r.icon === 'DollarSign' ? DollarSign : r.icon === 'AlertTriangle' ? AlertTriangle :
              r.icon === 'TrendingUp' ? TrendingUp : r.icon === 'Award' ? Award :
              r.icon === 'Activity' ? Activity : BarChart3;
            return (
              <Card key={r.key} className="p-5 hover:shadow-md transition-shadow cursor-pointer">
                <div className="flex items-start gap-3">
                  <div className="w-10 h-10 rounded-xl bg-[#6D4CFF10] flex items-center justify-center text-[#6D4CFF]"><Icon size={18} /></div>
                  <div className="flex-1">
                    <h4 className="text-xs font-semibold text-gray-800">{r.label}</h4>
                    <p className="text-[9px] text-gray-400 mt-0.5">Financial report</p>
                    <div className="flex gap-2 mt-3">
                      <button onClick={async () => { const res = await feeManagementApiV2.getReports(r.key); if (res.success) toast.success('Report generated'); }} className="px-2.5 py-1 rounded-lg bg-[#6D4CFF] text-white text-[9px] font-semibold">Generate</button>
                      <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600 hover:bg-gray-50"><Download size={10} className="inline mr-1" />Export</button>
                    </div>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>
      );
    };

    const renderRightSidebar = () => (
      <div className="space-y-4">
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Fee Collection Overview</h4>
          <div className="space-y-2">
            {sd.overview && [
              { label: 'Collected Amount', value: `$${(sd.overview.collectedAmount / 1000).toFixed(1)}K`, color: '#22C55E' },
              { label: 'Pending Amount', value: `$${(sd.overview.pendingAmount / 1000).toFixed(1)}K`, color: '#F59E0B' },
              { label: 'Overdue Amount', value: `$${(sd.overview.overdueAmount / 1000).toFixed(1)}K`, color: '#EF4444' },
              { label: 'Scholarship Amount', value: `$${(sd.overview.scholarshipAmount / 1000).toFixed(1)}K`, color: '#6D4CFF' },
            ].map(item => (
              <div key={item.label} className="flex justify-between py-1.5 border-b border-gray-50 last:border-0">
                <span className="text-[10px] text-gray-500">{item.label}</span>
                <span className="text-[10px] font-bold" style={{ color: item.color }}>{item.value}</span>
              </div>
            ))}
          </div>
          {sd.overview?.doughnutData && (
            <div className="mt-3">
              <ResponsiveContainer width="100%" height={130}>
                <RePieChart>
                  <Pie data={sd.overview.doughnutData} cx="50%" cy="50%" innerRadius={35} outerRadius={55} dataKey="value" paddingAngle={2}>
                    {(sd.overview.doughnutData || []).map((entry: any, i: number) => (
                      <Cell key={i} fill={entry.color} />
                    ))}
                  </Pie>
                </RePieChart>
              </ResponsiveContainer>
              <div className="flex flex-wrap justify-center gap-2 mt-1">
                {(sd.overview.doughnutData || []).map((d: any) => (
                  <div key={d.name} className="flex items-center gap-1">
                    <div className="w-2 h-2 rounded-full" style={{ background: d.color }} />
                    <span className="text-[8px] text-gray-400">{d.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Recent Transactions</h4>
          {(sd.recentTransactions || []).length > 0 ? (
            <div className="space-y-2">
              {(sd.recentTransactions || []).map((t: any) => (
                <div key={t.id} className="flex items-center gap-2 p-2 rounded-lg bg-gray-50">
                  <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#22C55E] to-[#06B6D4] flex items-center justify-center text-white text-[9px] font-bold">{t.studentName?.charAt(0)}</div>
                  <div className="flex-1 min-w-0">
                    <div className="text-[10px] font-semibold truncate">{t.studentName}</div>
                    <div className="text-[8px] text-gray-400">{t.paymentMethod} • {t.paymentDate ? new Date(t.paymentDate).toLocaleDateString() : ''}</div>
                  </div>
                  <span className="text-[10px] font-bold text-[#22C55E]">${(t.amountPaid || 0).toLocaleString()}</span>
                </div>
              ))}
            </div>
          ) : <EmptyState message="No recent transactions" />}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">AI Financial Insights</h4>
          <div className="space-y-2 text-[10px]">
            <div className="flex justify-between"><span className="text-gray-500">Expected Collection</span><span className="font-semibold text-[#6D4CFF]">{sd.aiInsights?.revenueForecast || '—'}</span></div>
            <div className="flex justify-between"><span className="text-gray-500">Collection Prediction</span><span className="font-semibold text-[#22C55E]">{sd.aiInsights?.collectionPrediction || '—'}</span></div>
            <div className="flex justify-between"><span className="text-gray-500">Financial Trend</span><Badge variant={sd.aiInsights?.financialTrend === 'up' ? 'success' : 'warning'} className="text-[8px]">{sd.aiInsights?.financialTrend === 'up' ? 'Growing' : 'Stable'}</Badge></div>
          </div>
        </Card>
      </div>
    );

    const renderContent = () => {
      switch (mode) {
        case 'structures': return renderStructures();
        case 'students': return renderStudentFees();
        case 'invoices': return renderInvoices();
        case 'collections': return renderCollections();
        case 'scholarships': return renderScholarships();
        case 'analytics': return renderAnalytics();
        case 'insights': return renderAiInsights();
        case 'reports': return renderReports();
        default: return renderStructures();
      }
    };

    return (
      <ModulePage title="Fee Management" desc="Manage fee structures, collections, invoices, payments, dues, scholarships, and financial analytics.">
        {/* Header Actions */}
        <div className="flex flex-wrap items-center gap-2 mb-6">
          <button onClick={() => setShowForm(true)} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5 hover:opacity-90 transition-opacity">
            <Plus size={14} /> Create Fee Structure
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <FileText size={14} /> Generate Invoices
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <DollarSign size={14} /> Collect Payment
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <Upload size={14} /> Import Fees
          </button>
          <button className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50 transition-all">
            <Download size={14} /> Export Reports
          </button>
        </div>

        {/* KPI Cards */}
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-6">
          {KPI_CONFIG.map(k => (
            <KpiCard key={k.label} {...k} />
          ))}
        </div>

        {/* Filters */}
        <div className="flex flex-wrap items-center gap-2 mb-6 p-3 rounded-xl bg-white border border-gray-100 shadow-sm">
          <select value={acYear} onChange={e => setAcYear(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[100px]">
            <option value="">Academic Year</option>
            <option value="2024-25">2024-25</option>
            <option value="2025-26">2025-26</option>
          </select>
          <select value={cls} onChange={e => setCls(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[80px]">
            <option value="">Class</option>
            {['10A','10B','9A','9B','11A','11B','12A'].map(c => <option key={c} value={c}>{c}</option>)}
          </select>
          <select value={section} onChange={e => setSection(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white">
            <option value="">Section</option>
            <option value="A">A</option>
            <option value="B">B</option>
          </select>
          <select value={feeCat} onChange={e => setFeeCat(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[90px]">
            <option value="">Fee Category</option>
            <option value="tuition">Tuition</option>
            <option value="transport">Transport</option>
            <option value="hostel">Hostel</option>
            <option value="exam">Examination</option>
          </select>
          <select value={payStatus} onChange={e => setPayStatus(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[90px]">
            <option value="">Payment Status</option>
            <option value="paid">Paid</option>
            <option value="partial">Partial</option>
            <option value="pending">Pending</option>
            <option value="overdue">Overdue</option>
          </select>
          <select value={payMethod} onChange={e => setPayMethod(e.target.value)} className="px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px] bg-white min-w-[100px]">
            <option value="">Payment Method</option>
            <option value="online">Online</option>
            <option value="upi">UPI</option>
            <option value="card">Card</option>
            <option value="cash">Cash</option>
            <option value="cheque">Cheque</option>
          </select>
          <input type="text" placeholder="Search student..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 min-w-[120px] px-2.5 py-1.5 border border-gray-200 rounded-lg text-[10px]" />
          <button className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">Apply</button>
          <button onClick={() => { setAcYear(''); setCls(''); setSection(''); setFeeCat(''); setPayStatus(''); setPayMethod(''); setSearchQ(''); }} className="px-3 py-1.5 rounded-lg border border-gray-200 text-[10px] font-semibold text-gray-500 hover:bg-gray-50">Reset</button>
        </div>

        {/* Tab Navigation */}
        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key as any)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>

        {/* Main Content + Sidebar */}
        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3">
            {dash.loading ? <LoadingSkeleton rows={6} cols={4} /> : renderContent()}
          </div>
          <div className="xl:col-span-1">
            {sidebar.loading ? <LoadingSkeleton rows={5} cols={1} /> : renderRightSidebar()}
          </div>
        </div>

        {/* Quick Actions */}
        <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-[#6D4CFF20]">
          <h4 className="text-[11px] font-semibold text-gray-600 mb-3">Quick Actions</h4>
          <div className="flex flex-wrap gap-2">
            {[
              { icon: DollarSign, label: 'Collect Payment' },
              { icon: FileText, label: 'Generate Invoice' },
              { icon: Bell, label: 'Send Reminder' },
              { icon: Plus, label: 'Create Fee Structure' },
              { icon: AlertTriangle, label: 'View Defaulters' },
              { icon: BarChart3, label: 'Revenue Analytics' },
              { icon: Download, label: 'Export Report' },
              { icon: Brain, label: 'AI Insights' },
            ].map(a => (
              <button key={a.label} className="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 hover:border-[#6D4CFF30] hover:text-[#6D4CFF] transition-all">
                <a.icon size={12} /> {a.label}
              </button>
            ))}
          </div>
        </div>

        {/* Role-Based Access Footer */}
        <div className="mt-6 p-3 rounded-xl bg-gray-50 border border-gray-100 flex flex-wrap items-center justify-between">
          <div className="flex items-center gap-4 text-[9px] text-gray-400">
            <span className="font-semibold text-gray-500">Role-Based Access:</span>
            <span><Badge variant="purple" className="text-[8px]">Admin: Full Access</Badge></span>
            <span><Badge variant="purple" className="text-[8px]">Finance Manager: Fee & Revenue</Badge></span>
            <span><Badge className="text-[8px]">Principal: Financial Analytics</Badge></span>
            <span><Badge className="text-[8px]">Parent: Pay Fees</Badge></span>
          </div>
          <Badge variant="purple" className="text-[8px]">Finance Enterprise Plan</Badge>
        </div>
      </ModulePage>
    );
  }

  function RolesTab() {
    const [mode, setMode] = useState<string>('roles');
    const [searchQ, setSearchQ] = useState('');
    const [roleFilter, setRoleFilter] = useState('');
    const [statusFilter, setStatusFilter] = useState('');

    const dash = useApi(() => rolesApiV2.getDashboard(), []);
    const roles = useApi(() => rolesApiV2.getRoles(), []);
    const permissions = useApi(() => rolesApiV2.getPermissions(), []);
    const users = useApi(() => rolesApiV2.getUsers({ search: searchQ, role: roleFilter, status: statusFilter }), [searchQ, roleFilter, statusFilter]);
    const auditLogs = useApi(() => rolesApiV2.getAuditLogs(), []);
    const analytics = useApi(() => rolesApiV2.getAnalytics(), []);
    const sidebar = useApi(() => rolesApiV2.getSidebar(), []);

    const dd = dash.data?.data || dash.data || {};
    const sd = sidebar.data?.data || sidebar.data || {};
    const ad = analytics.data?.data || analytics.data || {};

    const NAVS = [
      { key: 'roles', label: 'Roles', icon: Shield },
      { key: 'users', label: 'Users', icon: Users },
      { key: 'permissions', label: 'Permissions', icon: Key },
      { key: 'audit', label: 'Audit Log', icon: Activity },
      { key: 'analytics', label: 'Analytics', icon: BarChart3 },
      { key: 'reports', label: 'Reports', icon: FileText },
    ];

    const KPI_CONFIG = [
      { icon: Shield, label: 'Total Roles', value: dd.totalRoles ?? 0, trend: `+${dd.customRoles || 0} custom`, color: '#6D4CFF', bg: '#F5F3FF' },
      { icon: ShieldCheck, label: 'System Roles', value: dd.systemRoles ?? 0, trend: `+${dd.totalRoles || 0} total`, color: '#3B82F6', bg: '#EFF6FF' },
      { icon: Users, label: 'Total Users', value: dd.totalUsers ?? 0, trend: `${dd.activeUsers || 0} active`, color: '#22C55E', bg: '#F0FDF4' },
      { icon: UserCog, label: 'Active Users', value: dd.activeUsers ?? 0, trend: `${((dd.activeUsers / (dd.totalUsers || 1)) * 100).toFixed(0)}%`, color: '#06B6D4', bg: '#ECFEFF' },
      { icon: Key, label: 'Permissions', value: dd.totalPermissions ?? 0, trend: `managed`, color: '#A855F7', bg: '#FAF5FF' },
      { icon: UserX, label: 'Disabled Users', value: dd.disabledUsers ?? 0, trend: `${((dd.disabledUsers / (dd.totalUsers || 1)) * 100).toFixed(0)}%`, color: '#F59E0B', bg: '#FFFBEB' },
      { icon: Activity, label: 'Recent Changes', value: dd.recentChanges ?? 0, trend: `this month`, color: '#EF4444', bg: '#FEF2F2' },
      { icon: ShieldCheck, label: 'Custom Roles', value: dd.customRoles ?? 0, trend: `created`, color: '#8B5CF6', bg: '#F5F3FF' },
    ];

    const renderRoles = () => {
      const items = roles.data?.data || roles.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search roles..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <AddButton onClick={() => toast.success('Role creation form coming soon')} label="Create Role" />
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'name', label: 'Role Name', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold"><Shield size={12} /></div>
                    <div><div className="text-xs font-semibold">{v}</div><div className="text-[9px] text-gray-400">{row.description || 'No description'}</div></div>
                  </div>
                )},
                { key: 'is_system', label: 'Type', render: (v: boolean) => <Badge variant={v ? 'purple' : 'default'} className="text-[9px]">{v ? 'System' : 'Custom'}</Badge> },
                { key: 'role_permissions', label: 'Permissions', render: (v: any[]) => <span className="text-[10px] font-medium text-gray-500">{v?.length || 0} permissions</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button onClick={() => toast.success('Editing role: ' + row.name)} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold">Edit</button>
                    <button onClick={() => toast.success('Assigning permissions to ' + row.name)} className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Key size={10} className="inline mr-1" />Permissions</button>
                    {!row.is_system && <button onClick={() => toast.success('Role deleted')} className="px-2 py-1 rounded-lg bg-red-50 text-[#EF4444] text-[9px] font-semibold">Delete</button>}
                  </div>
                )},
              ]}
              data={items.length > 0 ? items : []}
              loading={roles.loading}
              emptyMessage="No roles created yet"
            />
          </Card>
        </div>
      );
    };

    const renderUsers = () => {
      const usrs = users.data?.data || users.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search users..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <select value={roleFilter} onChange={e => setRoleFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Roles</option>
              <option value="admin">Admin</option>
              <option value="principal">Principal</option>
              <option value="teacher">Teacher</option>
              <option value="staff">Staff</option>
              <option value="student">Student</option>
              <option value="parent">Parent</option>
            </select>
            <select value={statusFilter} onChange={e => setStatusFilter(e.target.value)} className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Status</option>
              <option value="active">Active</option>
              <option value="pending">Pending</option>
              <option value="disabled">Disabled</option>
            </select>
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'full_name', label: 'User', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold">{v?.charAt(0)}</div>
                    <div><div className="text-xs font-semibold">{v}</div><div className="text-[9px] text-gray-400">{row.email}</div></div>
                  </div>
                )},
                { key: 'role', label: 'Role', render: (v: string) => <Badge variant="purple" className="text-[9px] capitalize">{v || '—'}</Badge> },
                { key: 'status', label: 'Status', render: (v: string) => {
                  const map: Record<string, 'success' | 'warning' | 'danger'> = { active: 'success', pending: 'warning', disabled: 'danger' };
                  return <Badge variant={map[v] || 'warning'} className="text-[9px] capitalize">{v || 'pending'}</Badge>;
                }},
                { key: 'last_login', label: 'Last Login', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : 'Never'}</span> },
                { key: 'created_at', label: 'Created', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <select value={row.role} onChange={e => rolesApiV2.updateUserRole(row.id, { role: e.target.value }).then(() => { users.refetch(); toast.success('Role updated'); })} className="px-2 py-1 border border-gray-200 rounded-lg text-[9px] bg-white">
                      <option value="admin">Admin</option>
                      <option value="principal">Principal</option>
                      <option value="teacher">Teacher</option>
                      <option value="staff">Staff</option>
                      <option value="student">Student</option>
                      <option value="parent">Parent</option>
                    </select>
                    {row.status !== 'disabled' ? (
                      <button onClick={() => rolesApiV2.updateUserRole(row.id, { status: 'disabled' }).then(() => { users.refetch(); toast.success('User disabled'); })} className="p-1 rounded-lg hover:bg-red-50 text-gray-400"><UserX size={12} /></button>
                    ) : (
                      <button onClick={() => rolesApiV2.updateUserRole(row.id, { status: 'active' }).then(() => { users.refetch(); toast.success('User enabled'); })} className="p-1 rounded-lg hover:bg-green-50 text-green-500"><CheckCircle size={12} /></button>
                    )}
                  </div>
                )},
              ]}
              data={usrs.length > 0 ? usrs : []}
              loading={users.loading}
              emptyMessage="No users found"
            />
          </Card>
        </div>
      );
    };

    const renderPermissions = () => {
      const perms = permissions.data?.data || permissions.data || [];
      const grouped = (Array.isArray(perms) ? perms : []).reduce((acc: any, p: any) => {
        const mod = p.module || 'General';
        if (!acc[mod]) acc[mod] = [];
        acc[mod].push(p);
        return acc;
      }, {});

      return (
        <div className="space-y-4">
          <div className="flex items-center justify-between">
            <h3 className="text-sm font-semibold text-gray-700">All Permissions</h3>
            <AddButton onClick={() => toast.success('Permission creation form coming soon')} label="Add Permission" />
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {Object.entries(grouped).map(([module, perms]: [string, any]) => (
              <Card key={module} className="p-4">
                <h4 className="text-[11px] font-semibold text-[#6D4CFF] mb-3 capitalize">{module.replace(/_/g, ' ')}</h4>
                <div className="space-y-1.5">
                  {perms.map((p: any) => (
                    <div key={p.id} className="flex items-center gap-2 p-1.5 rounded-lg hover:bg-gray-50">
                      <div className="w-5 h-5 rounded bg-[#6D4CFF10] flex items-center justify-center"><Key size={10} className="text-[#6D4CFF]" /></div>
                      <span className="text-[10px] text-gray-600">{p.name}</span>
                      <span className="ml-auto text-[8px] text-gray-400">{p.action || 'access'}</span>
                    </div>
                  ))}
                </div>
              </Card>
            ))}
          </div>
          {Object.keys(grouped).length === 0 && <EmptyState message="No permissions configured" />}
        </div>
      );
    };

    const renderAuditLog = () => {
      const logs = auditLogs.data?.data || auditLogs.data || [];
      return (
        <Card className="p-0 overflow-hidden">
          <DataTable
            columns={[
              { key: 'users', label: 'User', render: (v: any) => <span className="text-xs font-semibold">{v?.full_name || '—'}</span> },
              { key: 'action', label: 'Action', render: (v: string) => <Badge variant="purple" className="text-[9px]">{v || 'change'}</Badge> },
              { key: 'details', label: 'Details', render: (v: any) => <span className="text-[10px] text-gray-500">{v ? JSON.stringify(v) : '—'}</span> },
              { key: 'created_at', label: 'Date', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleString() : '—'}</span> },
            ]}
            data={Array.isArray(logs) ? logs : []}
            loading={auditLogs.loading}
            emptyMessage="No audit logs found"
          />
        </Card>
      );
    };

    const renderAnalyticsView = () => {
      const changesByMonth = ad.changesByMonth || {};
      const months = Object.keys(changesByMonth);
      const chartData = months.map(m => ({ month: m, changes: changesByMonth[m] }));
      const roleDist = ad.roleDistribution || {};

      return (
        <div className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Total Roles</div>
              <div className="text-3xl font-extrabold mt-1 text-[#6D4CFF]">{ad.totalRoles ?? 0}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Active Users</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">{ad.activeUsers ?? 0}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Pending Users</div>
              <div className="text-3xl font-extrabold mt-1 text-[#F59E0B]">{ad.pendingUsers ?? 0}</div>
            </Card>
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Role Distribution</h4>
              {Object.keys(roleDist).length > 0 ? (
                <ResponsiveContainer width="100%" height={260}>
                  <RePieChart>
                    <Pie data={Object.entries(roleDist).map(([k, v]) => ({ name: k, value: v }))} cx="50%" cy="50%" outerRadius={90} dataKey="value" label={({ name }: any) => name}>
                      {Object.keys(roleDist).map((_, i) => <Cell key={i} fill={['#7C3AED','#8B5CF6','#A78BFA','#C4B5FD','#DDD6FE','#EDE9FE','#6D4CFF','#4F2DB8'][i % 8]} />)}
                    </Pie>
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  </RePieChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No role distribution data" />}
            </Card>
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Changes Over Time</h4>
              {chartData.length > 0 ? (
                <ResponsiveContainer width="100%" height={260}>
                  <AreaChart data={chartData}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                    <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                    <YAxis tick={{ fontSize: 10 }} />
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                    <Area type="monotone" dataKey="changes" stroke="#6D4CFF" fill="#6D4CFF20" strokeWidth={2} />
                  </AreaChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No change history data" />}
            </Card>
          </div>
        </div>
      );
    };

    const renderReports = () => {
      const rps = [
        { key: 'user-roles', label: 'User Roles Report', icon: Shield, desc: 'Complete user role assignments' },
        { key: 'permissions', label: 'Permissions Report', icon: Key, desc: 'All permissions and access rights' },
        { key: 'audit', label: 'Audit Trail Report', icon: Activity, desc: 'Role change history and audit trail' },
        { key: 'summary', label: 'Roles Summary', icon: BarChart3, desc: 'Summary of all roles and assignments' },
      ];
      return (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {rps.map(r => {
            const Icon = r.icon;
            return (
              <Card key={r.key} className="p-5 hover:shadow-md transition-shadow cursor-pointer">
                <div className="flex items-start gap-3">
                  <div className="w-10 h-10 rounded-xl bg-[#6D4CFF10] flex items-center justify-center text-[#6D4CFF]"><Icon size={18} /></div>
                  <div className="flex-1">
                    <h4 className="text-xs font-semibold text-gray-800">{r.label}</h4>
                    <p className="text-[9px] text-gray-400 mt-0.5">{r.desc}</p>
                    <div className="flex gap-2 mt-3">
                      <button onClick={() => toast.success('Report generated: ' + r.label)} className="px-2.5 py-1 rounded-lg bg-[#6D4CFF] text-white text-[9px] font-semibold">Generate</button>
                      <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline mr-1" />Export</button>
                    </div>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>
      );
    };

    const renderRightSidebar = () => (
      <div className="space-y-4">
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Roles Overview</h4>
          {(sd.stats || []).map((s: any) => (
            <div key={s.label} className="flex justify-between py-1.5 border-b border-gray-50 last:border-0">
              <span className="text-[10px] text-gray-500">{s.label}</span>
              <span className="text-[10px] font-bold text-[#6D4CFF]">{s.value}</span>
            </div>
          ))}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Role Distribution</h4>
          {Object.keys(roleDist).length > 0 ? (
            <div className="space-y-2">
              {Object.entries(roleDist).map(([role, count]: [string, any]) => (
                <div key={role} className="flex items-center gap-2">
                  <div className="flex-1">
                    <div className="flex justify-between text-[9px]">
                      <span className="capitalize text-gray-600">{role}</span>
                      <span className="font-semibold">{count}</span>
                    </div>
                    <div className="w-full h-1.5 bg-gray-100 rounded-full mt-0.5 overflow-hidden">
                      <div className="h-full rounded-full bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6]" style={{ width: `${(Number(count) / (totalRoleDist || 1)) * 100}%` }} />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : <EmptyState message="No data" />}
          {ad.changesByMonth && <div className="mt-3 pt-3 border-t border-gray-100">
            <div className="text-[10px] text-gray-500 font-medium">Recent Activity</div>
            <div className="text-lg font-extrabold text-[#6D4CFF]">{Object.values(ad.changesByMonth as Record<string, number>).reduce((a: number, b: number) => a + b, 0) || 0}</div>
            <div className="text-[8px] text-gray-400">Total changes this period</div>
          </div>}
        </Card>
      </div>
    );

    const roleDist = ad.roleDistribution || {};
    const totalRoleDist = Object.values(roleDist).reduce((a: number, b: any) => a + Number(b), 0);

    const renderContent = () => {
      switch (mode) {
        case 'roles': return renderRoles();
        case 'users': return renderUsers();
        case 'permissions': return renderPermissions();
        case 'audit': return renderAuditLog();
        case 'analytics': return renderAnalyticsView();
        case 'reports': return renderReports();
        default: return renderRoles();
      }
    };

    return (
      <ModulePage title="Roles & Permissions" desc="Manage roles, permissions, user assignments, audit logs, and access control.">
        <div className="flex flex-wrap items-center gap-2 mb-6">
          <button onClick={() => setMode('roles')} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5">
            <Shield size={14} /> Manage Roles
          </button>
          <button onClick={() => setMode('permissions')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <Key size={14} /> Permissions
          </button>
          <button onClick={() => setMode('users')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <Users size={14} /> User Roles
          </button>
          <button onClick={() => setMode('audit')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <Activity size={14} /> Audit Trail
          </button>
        </div>

        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-6">
          {KPI_CONFIG.map(k => <KpiCard key={k.label} {...k} />)}
        </div>

        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>

        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3">
            {dash.loading ? <LoadingSkeleton rows={6} cols={4} /> : renderContent()}
          </div>
          <div className="xl:col-span-1">
            {sidebar.loading ? <LoadingSkeleton rows={5} cols={1} /> : renderRightSidebar()}
          </div>
        </div>

        <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-[#6D4CFF20]">
          <h4 className="text-[11px] font-semibold text-gray-600 mb-3">Quick Actions</h4>
          <div className="flex flex-wrap gap-2">
            {[
              { icon: Shield, label: 'Create Role' },
              { icon: Key, label: 'Manage Permissions' },
              { icon: Users, label: 'Assign Roles' },
              { icon: UserCheck, label: 'Bulk Role Update' },
              { icon: Activity, label: 'View Audit Log' },
              { icon: BarChart3, label: 'Analytics' },
              { icon: Download, label: 'Export Report' },
              { icon: ShieldCheck, label: 'Review Access' },
            ].map(a => (
              <button key={a.label} onClick={() => toast.success(a.label)} className="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 hover:border-[#6D4CFF30] hover:text-[#6D4CFF] transition-all">
                <a.icon size={12} /> {a.label}
              </button>
            ))}
          </div>
        </div>

        <div className="mt-6 p-3 rounded-xl bg-gray-50 border border-gray-100 flex flex-wrap items-center justify-between">
          <div className="flex items-center gap-4 text-[9px] text-gray-400">
            <span className="font-semibold text-gray-500">Role-Based Access:</span>
            <span><Badge variant="purple" className="text-[8px]">Admin: Full Access</Badge></span>
            <span><Badge variant="purple" className="text-[8px]">Principal: User Management</Badge></span>
            <span><Badge className="text-[8px]">Staff: View Only</Badge></span>
            <span><Badge className="text-[8px]">Teacher: Basic Roles</Badge></span>
          </div>
          <Badge variant="purple" className="text-[8px]">Security Enterprise Plan</Badge>
        </div>
      </ModulePage>
    );
  }

  function CredentialMgmtTab() {
    const [view, setView] = useState<'list' | 'history'>('list');
    const [searchQ, setSearchQ] = useState('');
    const [roleFilter, setRoleFilter] = useState<string>('');
    const [selected, setSelected] = useState<Set<string>>(new Set());
    const [selectAll, setSelectAll] = useState(false);
    const [newPasswords, setNewPasswords] = useState<Record<string, string>>({});

    const users = useApi(() => credentialMgmtApi.list(), []);
    const historyData = useApi(() => credentialApi.getHistory(), []);

    const filtered = (users.data || []).filter((u: any) => {
      if (roleFilter && u.role !== roleFilter) return false;
      if (searchQ) {
        const q = searchQ.toLowerCase();
        if (!u.full_name?.toLowerCase().includes(q) && !u.email?.toLowerCase().includes(q)) return false;
      }
      return true;
    });

    const toggleSelect = (id: string) => {
      const next = new Set(selected);
      if (next.has(id)) next.delete(id); else next.add(id);
      setSelected(next);
      setSelectAll(false);
    };

    const toggleSelectAll = () => {
      if (selectAll) { setSelected(new Set()); setSelectAll(false); }
      else { setSelected(new Set(filtered.map((u: any) => u.id))); setSelectAll(true); }
    };

    const handleRegenerate = async (userId: string) => {
      if (!window.confirm('Regenerate password for this user? The new password will be shown once.')) return;
      try {
        const res = await credentialMgmtApi.regeneratePassword(userId);
        if (res.success && res.data) {
          setNewPasswords(prev => ({ ...prev, [res.data.email]: res.data.password }));
          toast.success('Password regenerated. New password shown in table below.');
          users.refetch();
        } else {
          toast.error(res.error || 'Failed to regenerate password');
        }
      } catch (e: any) { toast.error(e.message); }
    };

    const handleBulkRegenerate = async () => {
      if (selected.size === 0) { toast.error('No users selected'); return; }
      if (!window.confirm(`Regenerate passwords for ${selected.size} users?`)) return;
      try {
        const res = await credentialMgmtApi.bulkRegenerate([...selected]);
        if (res.success && res.data) {
          const pw: Record<string, string> = {};
          (res.data.results || []).forEach((r: any) => { if (r.password) pw[r.email] = r.password; });
          setNewPasswords(pw);
          toast.success(`Passwords regenerated for ${Object.keys(pw).length} users`);
        } else {
          toast.error(res.error || 'Failed to regenerate passwords');
        }
        setSelected(new Set());
        users.refetch();
      } catch (e: any) { toast.error(e.message); }
    };

    const handleBulkEmail = async () => {
      if (selected.size === 0) { toast.error('No users selected'); return; }
      try {
        const res = await credentialMgmtApi.bulkEmail([...selected]);
        if (res.success && res.data) {
          toast.success(`Credentials queued for ${res.data.emailed_count} users`);
        } else {
          toast.error(res.error || 'Failed to send credentials');
        }
        setSelected(new Set());
        users.refetch();
      } catch (e: any) { toast.error(e.message); }
    };

    return (
      <ModulePage title="Credential Management" desc="Manage user login credentials, regenerate passwords, and send credentials via email.">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-3">
            <div className="relative">
              <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
              <input type="text" placeholder="Search users..." value={searchQ} onChange={e => setSearchQ(e.target.value)}
                className="pl-8 pr-3 py-2 border border-gray-200 rounded-lg text-xs w-60" />
            </div>
            <select value={roleFilter} onChange={e => setRoleFilter(e.target.value)}
              className="px-3 py-2 border border-gray-200 rounded-lg text-xs">
              <option value="">All Roles</option>
              <option value="admin">Admin</option>
              <option value="teacher">Teacher</option>
              <option value="staff">Staff</option>
              <option value="student">Student</option>
              <option value="parent">Parent</option>
            </select>
            <div className="flex items-center gap-1 bg-gray-100 rounded-lg p-0.5">
              <button onClick={() => setView('list')}
                className={`px-3 py-1.5 rounded-md text-xs font-semibold transition-all ${view === 'list' ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500 hover:text-gray-700'}`}>
                <List size={14} className="inline mr-1" />Users
              </button>
              <button onClick={() => setView('history')}
                className={`px-3 py-1.5 rounded-md text-xs font-semibold transition-all ${view === 'history' ? 'bg-white shadow-sm text-gray-800' : 'text-gray-500 hover:text-gray-700'}`}>
                <Clock size={14} className="inline mr-1" />History
              </button>
            </div>
          </div>
          <div className="flex items-center gap-2">
            {selected.size > 0 && (
              <>
                <span className="text-xs text-gray-500">{selected.size} selected</span>
                <button onClick={handleBulkEmail}
                  className="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600 hover:bg-gray-50 flex items-center gap-1">
                  <Send size={12} /> Email Credentials
                </button>
                <button onClick={handleBulkRegenerate}
                  className="px-3 py-1.5 rounded-lg bg-orange-50 text-orange-600 text-xs font-semibold hover:bg-orange-100 flex items-center gap-1">
                  <RefreshCw size={12} /> Bulk Regenerate
                </button>
              </>
            )}
          </div>
        </div>

        {view === 'list' ? (
          <div className="rounded-xl border border-gray-100 overflow-hidden">
            <div className="overflow-x-auto">
              <table className="data-table">
                <thead>
                  <tr>
                    <th className="w-10">
                      <input type="checkbox" checked={selectAll} onChange={toggleSelectAll}
                        className="rounded border-gray-300" />
                    </th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th>Credentials Sent</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {users.loading ? (
                    <tr><td colSpan={8} className="text-center py-8"><Loader2 size={20} className="animate-spin mx-auto text-gray-400" /></td></tr>
                  ) : filtered.length === 0 ? (
                    <tr><td colSpan={8} className="text-center py-8 text-gray-400 text-sm">No users found</td></tr>
                  ) : filtered.map((u: any) => (
                    <tr key={u.id}>
                      <td><input type="checkbox" checked={selected.has(u.id)} onChange={() => toggleSelect(u.id)}
                        className="rounded border-gray-300" /></td>
                      <td><span className="text-xs font-semibold">{u.full_name}</span></td>
                      <td><span className="text-xs text-gray-500">{u.email}</span></td>
                      <td><Badge className="text-[9px]">{u.role}</Badge></td>
                      <td>
                        <span className={`inline-flex items-center gap-1 text-[10px] font-medium ${u.status === 'active' ? 'text-green-600' : 'text-red-500'}`}>
                          <span className={`w-1.5 h-1.5 rounded-full ${u.status === 'active' ? 'bg-green-500' : 'bg-red-500'}`} />
                          {u.status}
                        </span>
                      </td>
                      <td>
                        {newPasswords[u.email] ? (
                          <span className="font-mono text-[10px] bg-yellow-50 text-yellow-700 px-1.5 py-0.5 rounded">{newPasswords[u.email]}</span>
                        ) : (
                          <span className="text-[10px] text-gray-400">••••••••</span>
                        )}
                      </td>
                      <td>
                        {u.credentials_sent ? (
                          <span className="text-[10px] text-green-600 flex items-center gap-1"><CheckCircle size={10} /> Sent</span>
                        ) : (
                          <span className="text-[10px] text-gray-400">—</span>
                        )}
                      </td>
                      <td>
                        <button onClick={() => handleRegenerate(u.id)}
                          className="px-2 py-1 rounded-md bg-gray-50 text-gray-500 text-[10px] font-semibold hover:bg-gray-100 flex items-center gap-1">
                          <RefreshCw size={10} /> Reset
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div className="px-4 py-2 border-t border-gray-100 flex items-center justify-between">
              <span className="text-[10px] text-gray-400">{filtered.length} user(s)</span>
              <span className="text-[10px] text-gray-400">Last updated: {new Date().toLocaleTimeString()}</span>
            </div>
          </div>
        ) : (
          <div className="rounded-xl border border-gray-100 overflow-hidden">
            <div className="overflow-x-auto">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Date</th>
                    <th>Created By</th>
                  </tr>
                </thead>
                <tbody>
                  {historyData.loading ? (
                    <tr><td colSpan={6} className="text-center py-8"><Loader2 size={20} className="animate-spin mx-auto text-gray-400" /></td></tr>
                  ) : (historyData.data || []).length === 0 ? (
                    <tr><td colSpan={6} className="text-center py-8 text-gray-400 text-sm">No credential history</td></tr>
                  ) : (historyData.data || []).map((h: any, i: number) => (
                    <tr key={h.id || i}>
                      <td><span className="text-xs font-semibold">{h.full_name}</span></td>
                      <td><span className="text-xs text-gray-500">{h.email}</span></td>
                      <td><Badge className="text-[9px]">{h.role}</Badge></td>
                      <td><span className="text-[10px] text-gray-600">{h.action || h.created_by || 'Created'}</span></td>
                      <td><span className="text-[10px] text-gray-400">{h.created_at ? new Date(h.created_at).toLocaleDateString() : '—'}</span></td>
                      <td><span className="text-[10px] text-gray-400">{h.created_by || 'System'}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </ModulePage>
    );
  }

  function CredentialsTab() {
    const [mode, setMode] = useState<string>('dashboard');
    const [searchQ, setSearchQ] = useState('');

    const dash = useApi(() => credentialsApiV2.getDashboard(), []);
    const certificates = useApi(() => credentialsApiV2.getCertificates(), []);
    const creds = useApi(() => credentialsApiV2.getCredentials(), []);
    const transcripts = useApi(() => credentialsApiV2.getTranscripts(), []);
    const badges = useApi(() => credentialsApiV2.getBadges(), []);
    const analytics = useApi(() => credentialsApiV2.getAnalytics(), []);
    const sidebar = useApi(() => credentialsApiV2.getSidebar(), []);

    const dd = dash.data?.data || dash.data || {};
    const sd = sidebar.data?.data || sidebar.data || {};
    const ad = analytics.data?.data || analytics.data || {};

    const NAVS = [
      { key: 'dashboard', label: 'Dashboard', icon: LayoutDashboard },
      { key: 'certificates', label: 'Certificates', icon: Award },
      { key: 'credentials', label: 'Credentials', icon: BadgeCheck },
      { key: 'transcripts', label: 'Transcripts', icon: ScrollText },
      { key: 'badges', label: 'Badges', icon: Medal },
      { key: 'analytics', label: 'Analytics', icon: BarChart3 },
      { key: 'reports', label: 'Reports', icon: FileText },
    ];

    const KPI_CONFIG = [
      { icon: Award, label: 'Certificates', value: dd.totalCertificates ?? 0, trend: `${dd.verifiedCertificates || 0} verified`, color: '#6D4CFF', bg: '#F5F3FF' },
      { icon: BadgeCheck, label: 'Credentials', value: dd.totalCredentials ?? 0, trend: `issued`, color: '#22C55E', bg: '#F0FDF4' },
      { icon: ScrollText, label: 'Transcripts', value: dd.totalTranscripts ?? 0, trend: `available`, color: '#3B82F6', bg: '#EFF6FF' },
      { icon: Medal, label: 'Badges', value: dd.totalBadges ?? 0, trend: `earned`, color: '#F59E0B', bg: '#FFFBEB' },
      { icon: ShieldCheck, label: 'Verified', value: dd.verifiedCertificates ?? 0, trend: `${((dd.verifiedCertificates / (dd.totalCertificates || 1)) * 100).toFixed(0)}% rate`, color: '#A855F7', bg: '#FAF5FF' },
      { icon: Clock, label: 'Pending Verification', value: dd.pendingVerification ?? 0, trend: `awaiting`, color: '#F59E0B', bg: '#FFFBEB' },
      { icon: Activity, label: 'Recent Issuances', value: dd.recentIssuances ?? 0, trend: `30 days`, color: '#06B6D4', bg: '#ECFEFF' },
      { icon: TrendingUp, label: 'Issuance Rate', value: `${dd.issuanceRate ?? 0}%`, trend: `growth`, color: '#8B5CF6', bg: '#F5F3FF' },
    ];

    const renderCertificateList = () => {
      const items = certificates.data?.data || certificates.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search certificates..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <AddButton onClick={() => toast.success('Certificate creation form coming soon')} label="Issue Certificate" />
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'title', label: 'Certificate', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-lg bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold"><Award size={12} /></div>
                    <div><div className="text-xs font-semibold">{v || '—'}</div><div className="text-[9px] text-gray-400">{row.certificate_type}</div></div>
                  </div>
                )},
                { key: 'student', label: 'Student', render: (v: any, row: any) => <span className="text-[11px]">{row.student?.full_name || '—'}</span> },
                { key: 'certificate_type', label: 'Type', render: (v: string) => <Badge className="text-[9px]">{v || 'Certificate'}</Badge> },
                { key: 'blockchain_hash', label: 'Blockchain', render: (v: string) => <span className="text-[8px] font-mono text-gray-400">{v ? v.slice(0, 12) + '...' : '—'}</span> },
                { key: 'issued_date', label: 'Issued', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'status', label: 'Status', render: (v: string) => {
                  const map: Record<string, 'success' | 'warning' | 'default' | 'danger'> = { verified: 'success', active: 'success', revoked: 'danger' };
                  return <Badge variant={map[v] || 'default'} className="text-[9px] capitalize">{v || 'active'}</Badge>;
                }},
                { key: 'id', label: '', render: (_: string, row: any) => (
                  <div className="flex gap-1">
                    <button onClick={() => toast.success('Verifying certificate via blockchain')} className="px-2 py-1 rounded-lg bg-[#6D4CFF10] text-[#6D4CFF] text-[9px] font-semibold"><ShieldCheck size={10} className="inline mr-1" />Verify</button>
                    <button className="p-1 rounded-lg hover:bg-gray-100 text-gray-400"><Download size={12} /></button>
                    {row.blockchain_hash && <button onClick={() => toast.success('Certificate shared')} className="p-1 rounded-lg hover:bg-blue-50 text-blue-400"><Globe size={12} /></button>}
                  </div>
                )},
              ]}
              data={items.length > 0 ? items : []}
              loading={certificates.loading}
              emptyMessage="No digital certificates issued"
            />
          </Card>
        </div>
      );
    };

    const renderCredentialList = () => {
      const items = creds.data?.data || creds.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <input type="text" placeholder="Search credentials..." value={searchQ} onChange={e => setSearchQ(e.target.value)} className="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-xs" />
            <AddButton onClick={() => toast.success('Credential creation form coming soon')} label="Issue Credential" />
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'title', label: 'Credential', render: (v: string, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-lg bg-gradient-to-br from-[#22C55E] to-[#06B6D4] flex items-center justify-center text-white text-[9px] font-bold"><BadgeCheck size={12} /></div>
                    <div><div className="text-xs font-semibold">{v || '—'}</div><div className="text-[9px] text-gray-400">{row.credential_type}</div></div>
                  </div>
                )},
                { key: 'student', label: 'Student', render: (v: any, row: any) => <span className="text-[11px]">{row.student?.full_name || '—'}</span> },
                { key: 'issuer', label: 'Issuer', render: (v: string) => <span className="text-[10px]">{v || 'Institution'}</span> },
                { key: 'credential_type', label: 'Type', render: (v: string) => <Badge className="text-[9px]">{v || 'Verifiable'}</Badge> },
                { key: 'issued_date', label: 'Issued', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'id', label: '', render: (_: string) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Eye size={10} className="inline mr-1" />View</button>
                    <button className="p-1 rounded-lg hover:bg-gray-100 text-gray-400"><Download size={12} /></button>
                  </div>
                )},
              ]}
              data={items.length > 0 ? items : []}
              loading={creds.loading}
              emptyMessage="No verifiable credentials issued"
            />
          </Card>
        </div>
      );
    };

    const renderTranscriptList = () => {
      const items = transcripts.data?.data || transcripts.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <AddButton onClick={() => toast.success('Transcript generation form coming soon')} label="Generate Transcript" />
          </div>
          <Card className="p-0 overflow-hidden">
            <DataTable
              columns={[
                { key: 'student', label: 'Student', render: (v: any, row: any) => (
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#3B82F6] to-[#06B6D4] flex items-center justify-center text-white text-[9px] font-bold">{row.student?.full_name?.charAt(0)}</div>
                    <span className="text-xs font-semibold">{row.student?.full_name || '—'}</span>
                  </div>
                )},
                { key: 'issued_date', label: 'Issued', render: (v: string) => <span className="text-[10px] text-gray-500">{v ? new Date(v).toLocaleDateString() : '—'}</span> },
                { key: 'qr_code', label: 'QR Code', render: (v: string) => v ? <Badge className="text-[8px]"><QrCode size={10} className="inline mr-1" />Available</Badge> : <span className="text-[9px] text-gray-400">—</span> },
                { key: 'id', label: '', render: (_: string) => (
                  <div className="flex gap-1">
                    <button className="px-2 py-1 rounded-lg bg-[#3B82F610] text-[#3B82F6] text-[9px] font-semibold"><Eye size={10} className="inline mr-1" />View</button>
                    <button className="px-2 py-1 rounded-lg bg-gray-100 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline mr-1" />PDF</button>
                  </div>
                )},
              ]}
              data={items.length > 0 ? items : []}
              loading={transcripts.loading}
              emptyMessage="No academic transcripts generated"
            />
          </Card>
        </div>
      );
    };

    const renderBadgeList = () => {
      const items = badges.data?.data || badges.data || [];
      return (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <AddButton onClick={() => toast.success('Badge creation form coming soon')} label="Issue Badge" />
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {(Array.isArray(items) ? items : []).map((b: any) => (
              <Card key={b.id} className="p-4 flex items-start gap-3 hover:shadow-md transition-shadow">
                <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-[#F59E0B] to-[#F97316] flex items-center justify-center text-white"><Medal size={22} /></div>
                <div className="flex-1 min-w-0">
                  <h4 className="text-xs font-semibold">{b.badge_name || 'Badge'}</h4>
                  <div className="text-[9px] text-gray-400 mt-0.5">{b.student?.full_name || '—'}</div>
                  <div className="flex items-center gap-2 mt-2">
                    <Badge className="text-[8px]">{b.badge_type || 'Skill'}</Badge>
                    <span className="text-[8px] text-gray-400">{b.issued_date ? new Date(b.issued_date).toLocaleDateString() : '—'}</span>
                  </div>
                </div>
                {b.badge_url && <a href={b.badge_url} target="_blank" rel="noopener noreferrer" className="text-gray-300 hover:text-[#6D4CFF]"><Globe size={14} /></a>}
              </Card>
            ))}
          </div>
          {items.length === 0 && !badges.loading && <EmptyState message="No badges issued yet" />}
        </div>
      );
    };

    const renderAnalyticsView = () => {
      const monthly = ad.monthlyIssuance || {};
      const months = Object.keys(monthly);
      const chartData = months.map(m => ({ month: m, issuances: monthly[m] }));
      const certsByType = ad.certificatesByType || {};

      return (
        <div className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Certificates</div>
              <div className="text-3xl font-extrabold mt-1 text-[#6D4CFF]">{ad.totalCertificates ?? 0}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Total Credentials</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">{ad.totalCredentials ?? 0}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Total Badges</div>
              <div className="text-3xl font-extrabold mt-1 text-[#F59E0B]">{ad.totalBadges ?? 0}</div>
            </Card>
            <Card className="p-4 text-center">
              <div className="text-[11px] text-gray-500 font-medium">Verified</div>
              <div className="text-3xl font-extrabold mt-1 text-[#22C55E]">{ad.verifiedCount ?? 0}</div>
            </Card>
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Monthly Issuance Trend</h4>
              {chartData.length > 0 ? (
                <ResponsiveContainer width="100%" height={260}>
                  <AreaChart data={chartData}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                    <XAxis dataKey="month" tick={{ fontSize: 10 }} />
                    <YAxis tick={{ fontSize: 10 }} />
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                    <Area type="monotone" dataKey="issuances" stroke="#6D4CFF" fill="#6D4CFF20" strokeWidth={2} />
                  </AreaChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No issuance data" />}
            </Card>
            <Card className="p-5">
              <h4 className="text-xs font-semibold text-gray-700 mb-4">Certificates by Type</h4>
              {Object.keys(certsByType).length > 0 ? (
                <ResponsiveContainer width="100%" height={260}>
                  <RePieChart>
                    <Pie data={Object.entries(certsByType).map(([k, v]) => ({ name: k, value: v }))} cx="50%" cy="50%" outerRadius={90} dataKey="value" label={({ name }: any) => name}>
                      {Object.keys(certsByType).map((_, i) => <Cell key={i} fill={['#7C3AED','#8B5CF6','#A78BFA','#C4B5FD','#DDD6FE','#EDE9FE','#6D4CFF'][i % 7]} />)}
                    </Pie>
                    <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8 }} />
                  </RePieChart>
                </ResponsiveContainer>
              ) : <EmptyState message="No certificate types data" />}
            </Card>
          </div>
        </div>
      );
    };

    const renderReports = () => {
      const rps = [
        { key: 'certificates', label: 'Certificate Report', icon: Award, desc: 'All digital certificates issued' },
        { key: 'credentials', label: 'Credential Report', icon: BadgeCheck, desc: 'Verifiable credentials summary' },
        { key: 'badges', label: 'Badge Report', icon: Medal, desc: 'Skill badges and achievements' },
        { key: 'summary', label: 'Digital Credentials Summary', icon: FileText, desc: 'Complete overview of all credentials' },
      ];
      return (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {rps.map(r => {
            const Icon = r.icon;
            return (
              <Card key={r.key} className="p-5 hover:shadow-md transition-shadow cursor-pointer">
                <div className="flex items-start gap-3">
                  <div className="w-10 h-10 rounded-xl bg-[#6D4CFF10] flex items-center justify-center text-[#6D4CFF]"><Icon size={18} /></div>
                  <div className="flex-1">
                    <h4 className="text-xs font-semibold text-gray-800">{r.label}</h4>
                    <p className="text-[9px] text-gray-400 mt-0.5">{r.desc}</p>
                    <div className="flex gap-2 mt-3">
                      <button onClick={() => toast.success('Report generated: ' + r.label)} className="px-2.5 py-1 rounded-lg bg-[#6D4CFF] text-white text-[9px] font-semibold">Generate</button>
                      <button className="px-2.5 py-1 rounded-lg border border-gray-200 text-[9px] font-semibold text-gray-600"><Download size={10} className="inline mr-1" />Export</button>
                    </div>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>
      );
    };

    const renderRightSidebar = () => (
      <div className="space-y-4">
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Credentials Overview</h4>
          {(sd.stats || []).map((s: any) => (
            <div key={s.label} className="flex justify-between py-1.5 border-b border-gray-50 last:border-0">
              <span className="text-[10px] text-gray-500">{s.label}</span>
              <span className="text-[10px] font-bold text-[#6D4CFF]">{s.value}</span>
            </div>
          ))}
          {ad.certificatesByType && (
            <div className="mt-3 pt-3 border-t border-gray-100">
              <div className="text-[9px] text-gray-500 font-medium mb-2">By Type</div>
              {Object.entries(ad.certificatesByType as Record<string, number>).map(([type, count]) => (
                <div key={type} className="flex justify-between py-1 text-[9px]">
                  <span className="capitalize text-gray-500">{type.replace(/_/g, ' ')}</span>
                  <span className="font-semibold">{count}</span>
                </div>
              ))}
            </div>
          )}
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Recent Activity</h4>
          <div className="text-2xl font-extrabold text-[#6D4CFF]">{dd.recentIssuances ?? 0}</div>
          <div className="text-[9px] text-gray-400">Issuances in last 30 days</div>
          <div className="mt-2 flex items-center gap-2">
            <span className="text-[9px] text-gray-500">Issuance Rate:</span>
            <Badge variant="success" className="text-[8px]">{dd.issuanceRate ?? 0}%</Badge>
          </div>
        </Card>
        <Card className="p-4">
          <h4 className="text-[11px] font-semibold text-gray-700 mb-3">Verification</h4>
          <div className="flex items-center gap-2 p-2 rounded-lg bg-gray-50">
            <input type="text" placeholder="Enter blockchain hash..." className="flex-1 px-2 py-1 border border-gray-200 rounded text-[9px] bg-white" />
            <button onClick={() => toast.success('Verification check initiated')} className="px-2 py-1 rounded bg-[#6D4CFF] text-white text-[8px] font-semibold"><ShieldCheck size={10} className="inline mr-1" />Verify</button>
          </div>
        </Card>
      </div>
    );

    const renderContent = () => {
      switch (mode) {
        case 'dashboard': return renderCertificateList();
        case 'certificates': return renderCertificateList();
        case 'credentials': return renderCredentialList();
        case 'transcripts': return renderTranscriptList();
        case 'badges': return renderBadgeList();
        case 'analytics': return renderAnalyticsView();
        case 'reports': return renderReports();
        default: return renderCertificateList();
      }
    };

    return (
      <ModulePage title="Digital Credentials" desc="Issue and manage digital certificates, verifiable credentials, academic transcripts, and skill badges.">
        <div className="flex flex-wrap items-center gap-2 mb-6">
          <button onClick={() => setMode('certificates')} className="px-4 py-2 rounded-xl bg-gradient-to-r from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-semibold flex items-center gap-1.5">
            <Award size={14} /> Issue Certificate
          </button>
          <button onClick={() => setMode('credentials')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <BadgeCheck size={14} /> Issue Credential
          </button>
          <button onClick={() => setMode('badges')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <Medal size={14} /> Issue Badge
          </button>
          <button onClick={() => setMode('transcripts')} className="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 flex items-center gap-1.5 hover:bg-gray-50">
            <ScrollText size={14} /> Transcripts
          </button>
        </div>

        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-6">
          {KPI_CONFIG.map(k => <KpiCard key={k.label} {...k} />)}
        </div>

        <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
          {NAVS.map(nav => (
            <button key={nav.key} onClick={() => setMode(nav.key)}
              className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${mode === nav.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
              <nav.icon size={12} className="inline mr-1.5" /> {nav.label}
            </button>
          ))}
        </div>

        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3">
            {dash.loading ? <LoadingSkeleton rows={6} cols={4} /> : renderContent()}
          </div>
          <div className="xl:col-span-1">
            {sidebar.loading ? <LoadingSkeleton rows={5} cols={1} /> : renderRightSidebar()}
          </div>
        </div>

        <div className="mt-8 p-4 rounded-xl bg-gradient-to-r from-[#6D4CFF08] to-[#8B5CF608] border border-[#6D4CFF20]">
          <h4 className="text-[11px] font-semibold text-gray-600 mb-3">Quick Actions</h4>
          <div className="flex flex-wrap gap-2">
            {[
              { icon: Award, label: 'Issue Certificate' },
              { icon: BadgeCheck, label: 'Issue Credential' },
              { icon: Medal, label: 'Issue Badge' },
              { icon: ScrollText, label: 'Generate Transcript' },
              { icon: ShieldCheck, label: 'Verify Certificate' },
              { icon: Globe, label: 'Share on Blockchain' },
              { icon: Download, label: 'Export Report' },
              { icon: QrCode, label: 'Generate QR Code' },
            ].map(a => (
              <button key={a.label} onClick={() => toast.success(a.label)} className="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-[10px] font-semibold text-gray-600 flex items-center gap-1.5 hover:border-[#6D4CFF30] hover:text-[#6D4CFF] transition-all">
                <a.icon size={12} /> {a.label}
              </button>
            ))}
          </div>
        </div>

        <div className="mt-6 p-3 rounded-xl bg-gray-50 border border-gray-100 flex flex-wrap items-center justify-between">
          <div className="flex items-center gap-4 text-[9px] text-gray-400">
            <span className="font-semibold text-gray-500">Role-Based Access:</span>
            <span><Badge variant="purple" className="text-[8px]">Admin: Full Access</Badge></span>
            <span><Badge variant="purple" className="text-[8px]">Admin: Issue & Verify</Badge></span>
            <span><Badge className="text-[8px]">Staff: View Credentials</Badge></span>
            <span><Badge className="text-[8px]">Student: View Own</Badge></span>
          </div>
          <Badge variant="purple" className="text-[8px]">Credentials Enterprise Plan</Badge>
        </div>
      </ModulePage>
    );
  }

  function TimetableTab() {
    const [viewMode, setViewMode] = useState<'overview' | 'class' | 'teacher' | 'room' | 'calendar' | 'conflicts' | 'generate' | 'analytics' | 'templates' | 'availability'>('overview');
    const [selectedClass, setSelectedClass] = useState('');
    const [selectedTeacher, setSelectedTeacher] = useState('');
    const [selectedRoom, setSelectedRoom] = useState('');
    const [modalMode, setModalMode] = useState<'add' | 'edit' | null>(null);
    const [editId, setEditId] = useState<string | null>(null);
    const [genClass, setGenClass] = useState('');
    const [genTerm, setGenTerm] = useState('');
    const [genLoading, setGenLoading] = useState(false);
    const [swapMode, setSwapMode] = useState(false);
    const [swapFirst, setSwapFirst] = useState<string | null>(null);
    const [moveEntryId, setMoveEntryId] = useState<string | null>(null);
    const [moveDay, setMoveDay] = useState(1);
    const [moveStart, setMoveStart] = useState('08:00');
    const [moveEnd, setMoveEnd] = useState('08:45');
    const [tmplName, setTmplName] = useState('');
    const [tmplDesc, setTmplDesc] = useState('');
    const [availTeacher, setAvailTeacher] = useState('');
    const [availDay, setAvailDay] = useState(1);
    const [availStart, setAvailStart] = useState('08:00');
    const [availEnd, setAvailEnd] = useState('17:00');
    const [calYear, setCalYear] = useState(new Date().getFullYear());
    const [calFormOpen, setCalFormOpen] = useState(false);
    const [calTitle, setCalTitle] = useState('');
    const [calType, setCalType] = useState('holiday');
    const [calDate, setCalDate] = useState('');
    const [form, setForm] = useState({ class_id: '', teacher_id: '', subject_id: '', day_of_week: 1, start_time: '08:00', end_time: '08:45', room: '', entry_type: 'regular', color: '#7C3AED' });

    const dashboard = useApi(() => timetableApiV2.getDashboard(), []);
    const classes = useApi(() => timetableApiV2.getClasses(), []);
    const teachers = useApi(() => timetableApiV2.getTeachers(), []);
    const subjects = useApi(() => timetableApiV2.getSubjects(), []);
    const conflicts = useApi(() => timetableApiV2.getConflicts(), [viewMode]);
    const analytics = useApi(() => timetableApiV2.getAnalytics(), [viewMode]);
    const templates = useApi(() => timetableApiV2.getTemplates(), [viewMode]);
    const availability = useApi(() => timetableApiV2.getTeacherAvailability(), [viewMode]);
    const calendarEvents = useApi(() => timetableApiV2.getAcademicCalendar(calYear), [calYear, viewMode]);
    const aiSuggestions = useApi(() => timetableApiV2.getAiSuggestions(), []);

    const entries = useApi(() => {
      if (viewMode === 'class' && selectedClass) return timetableApiV2.getEntries({ class_id: selectedClass });
      if (viewMode === 'teacher' && selectedTeacher) return timetableApiV2.getEntries({ teacher_id: selectedTeacher });
      if (viewMode === 'room' && selectedRoom) return timetableApiV2.getEntries({ room: selectedRoom });
      return Promise.resolve({ success: true, data: [] });
    }, [viewMode, selectedClass, selectedTeacher, selectedRoom]);

    const teachersMap = Object.fromEntries((teachers.data || []).map((t: any) => [t.id, t]));
    const subjectsMap = Object.fromEntries((subjects.data || []).map((s: any) => [s.id, s]));
    const classesMap = Object.fromEntries((classes.data || []).map((c: any) => [c.id, c]));

    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const DAYS_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    const timeSlots = useMemo(() => {
      const timeline = entries.data || [];
      const times = new Set<string>();
      timeline.forEach((e: any) => { times.add(e.start_time); times.add(e.end_time); });
      if (times.size === 0) {
        for (let h = 8; h <= 16; h++) { times.add(`${h.toString().padStart(2, '0')}:00`); times.add(`${h.toString().padStart(2, '0')}:30`); }
      }
      return Array.from(times).sort();
    }, [entries.data]);

    const gridData = useMemo(() => {
      const arr: any[] = entries.data || [];
      const g: Record<string, Record<number, any[]>> = {};
      arr.forEach((e: any) => {
        if (!g[e.start_time]) g[e.start_time] = {};
        if (!g[e.start_time][e.day_of_week]) g[e.start_time][e.day_of_week] = [];
        g[e.start_time][e.day_of_week].push(e);
      });
      return g;
    }, [entries.data]);

    const today = new Date().getDay();
    const ds = dashboard.data?.summary || {};
    const daysArr = [1, 2, 3, 4, 5];

    const openAddModal = (day?: number, prefill?: any) => {
      setEditId(null);
      setForm({
        class_id: prefill?.class_id || (viewMode === 'class' && selectedClass ? selectedClass : ''),
        teacher_id: prefill?.teacher_id || (viewMode === 'teacher' && selectedTeacher ? selectedTeacher : ''),
        subject_id: prefill?.subject_id || '',
        day_of_week: day || prefill?.day_of_week || 1,
        start_time: prefill?.start_time || '08:00',
        end_time: prefill?.end_time || '08:45',
        room: prefill?.room || '',
        entry_type: prefill?.entry_type || 'regular',
        color: prefill?.color || '#7C3AED',
      });
      setModalMode('add');
    };

    const openEditModal = (entry: any) => {
      setEditId(entry.id);
      setForm({
        class_id: entry.class_id || '', teacher_id: entry.teacher_id || '',
        subject_id: entry.subject_id || '', day_of_week: entry.day_of_week,
        start_time: entry.start_time, end_time: entry.end_time,
        room: entry.room || '', entry_type: entry.entry_type || 'regular',
        color: entry.color || '#7C3AED',
      });
      setModalMode('edit');
    };

    const handleSave = async () => {
      if (!form.subject_id || !form.teacher_id || !form.class_id) { toast.error('Fill required fields'); return; }
      const res = editId ? await timetableApiV2.updateEntry(editId, form) : await timetableApiV2.createEntry(form);
      if (res.success) { toast.success(editId ? 'Updated' : 'Created'); setModalMode(null); entries.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleDelete = async (id: string) => {
      if (!confirm('Delete this entry?')) return;
      const res = await timetableApiV2.deleteEntry(id);
      if (res.success) { toast.success('Deleted'); entries.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleSwap = async (entryId: string) => {
      if (!swapFirst) { setSwapFirst(entryId); toast.info('Select the second entry to swap'); return; }
      const res = await timetableApiV2.swapPeriods(swapFirst, entryId);
      if (res.success) { toast.success('Swapped'); setSwapFirst(null); setSwapMode(false); entries.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Swap failed');
      setSwapFirst(null);
    };

    const handleMove = async () => {
      if (!moveEntryId) return;
      const res = await timetableApiV2.moveEntry(moveEntryId, moveDay, moveStart, moveEnd);
      if (res.success) { toast.success('Entry moved'); setMoveEntryId(null); entries.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Move failed');
    };

    const handleGenerate = async () => {
      if (!genClass || !genTerm) { toast.error('Select class and term'); return; }
      setGenLoading(true);
      const res = await timetableApiV2.generateTimetable(genClass, genTerm, String(calYear));
      if (res.success) { toast.success(`Generated ${res.data?.generated || 0} entries`); entries.refetch(); dashboard.refetch(); }
      else toast.error(res.error || 'Generation failed');
      setGenLoading(false);
    };

    const handleSaveTemplate = async () => {
      if (!tmplName || !selectedClass) { toast.error('Enter name and select class'); return; }
      const res = await timetableApiV2.saveTemplate({ name: tmplName, description: tmplDesc, template_data: entries.data || [] });
      if (res.success) { toast.success('Template saved'); templates.refetch(); setTmplName(''); setTmplDesc(''); }
      else toast.error(res.error || 'Failed');
    };

    const handleApplyTemplate = async (tmplId: string, cId: string) => {
      const res = await timetableApiV2.applyTemplate(tmplId, cId);
      if (res.success) { toast.success('Template applied'); entries.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleAddAvailability = async () => {
      if (!availTeacher) { toast.error('Select teacher'); return; }
      const res = await timetableApiV2.setTeacherAvailability({ teacher_id: availTeacher, day_of_week: availDay, start_time: availStart, end_time: availEnd });
      if (res.success) { toast.success('Availability set'); availability.refetch(); }
      else toast.error(res.error || 'Failed');
    };

    const handleAddCalendarEvent = async () => {
      if (!calTitle || !calDate) { toast.error('Enter title and date'); return; }
      const res = await timetableApiV2.createCalendarEvent({ title: calTitle, event_type: calType, start_date: calDate, end_date: calDate, is_holiday: calType === 'holiday', affects_schedule: true });
      if (res.success) { toast.success('Event added'); calendarEvents.refetch(); setCalFormOpen(false); setCalTitle(''); setCalDate(''); }
      else toast.error(res.error || 'Failed');
    };

    const getEntryColor = (entry: any) => entry.color || '#7C3AED';
    const findConflictsIn = (arr: any[]) => {
      const ids = new Set<string>();
      for (let i = 0; i < arr.length; i++) for (let j = i + 1; j < arr.length; j++) {
        const a = arr[i], b = arr[j];
        if (a.start_time < b.end_time && b.start_time < a.end_time) { ids.add(a.id); ids.add(b.id); }
      }
      return ids;
    };

    const navModes = [
      { key: 'overview', label: 'Dashboard', icon: LayoutDashboard },
      { key: 'class', label: 'By Class', icon: School },
      { key: 'teacher', label: 'By Teacher', icon: Users },
      { key: 'room', label: 'By Room', icon: MapPin },
      { key: 'calendar', label: 'Calendar', icon: CalendarDays },
      { key: 'conflicts', label: 'Conflicts', icon: AlertTriangle },
      { key: 'generate', label: 'AI Generate', icon: Zap },
      { key: 'analytics', label: 'Analytics', icon: BarChart3 },
      { key: 'templates', label: 'Templates', icon: Copy },
      { key: 'availability', label: 'Availability', icon: Clock },
    ];

    const renderGridTable = () => {
      if (entries.loading) return <LoadingSkeleton rows={6} cols={6} />;
      if (entries.error) return <ErrorState message={entries.error} onRetry={entries.refetch} />;
      if (viewMode === 'class' && !selectedClass) return <EmptyState message="Select a class" />;
      if (viewMode === 'teacher' && !selectedTeacher) return <EmptyState message="Select a teacher" />;
      if (viewMode === 'room' && !selectedRoom) return <EmptyState message="Select a room" />;
      if ((entries.data || []).length === 0) return <EmptyState message="No entries for this selection. Add one to get started." />;
      return (
        <div className="overflow-x-auto rounded-xl border border-gray-200 bg-white">
          <table className="w-full min-w-[700px] border-collapse">
            <thead>
              <tr>
                <th className="sticky left-0 bg-gray-50 z-10 p-3 border-b border-r border-gray-200 min-w-[80px]">
                  <div className="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Time</div>
                </th>
                {daysArr.map(d => (
                  <th key={d} className={`p-3 border-b border-r border-gray-200 text-center ${d === today ? 'bg-[#F3F0FF]' : 'bg-gray-50'}`}>
                    <div className="text-[10px] font-bold text-gray-400 uppercase">{DAYS_SHORT[d]}</div>
                    <div className={`text-xs font-bold ${d === today ? 'text-[#6D4CFF]' : 'text-gray-600'}`}>{DAYS[d]}</div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {timeSlots.map(time => (
                <tr key={time} className="group">
                  <td className="sticky left-0 bg-white z-10 p-2 border-b border-r border-gray-200">
                    <div className="text-[10px] font-mono text-gray-400 whitespace-nowrap">{time}</div>
                  </td>
                  {daysArr.map(d => {
                    const cellEntries = gridData[time]?.[d] || [];
                    const conflictIds = findConflictsIn(cellEntries);
                    return (
                      <td key={d} className={`p-1.5 border-b border-r border-gray-100 align-top ${d === today ? 'bg-[#FBF9FF]' : ''}`}>
                        {cellEntries.length === 0 ? (
                          <div className="h-12 flex items-center justify-center">
                            <button onClick={() => openAddModal(d, { day_of_week: d, start_time: time, end_time: timeSlots[timeSlots.indexOf(time) + 1] || '09:30' })}
                              className="w-6 h-6 rounded-full border border-dashed border-gray-200 flex items-center justify-center text-gray-300 opacity-0 group-hover:opacity-100 hover:border-[#6D4CFF] hover:text-[#6D4CFF] transition-all">
                              <Plus size={12} />
                            </button>
                          </div>
                        ) : (
                          cellEntries.map((entry: any) => {
                            const subj = subjectsMap[entry.subject_id];
                            const tchr = teachersMap[entry.teacher_id];
                            const cls = classesMap[entry.class_id];
                            const c = getEntryColor(entry);
                            const isConflict = conflictIds.has(entry.id);
                            const isSwapSelected = swapFirst === entry.id;
                            return (
                              <div key={entry.id}
                                onClick={() => swapMode ? handleSwap(entry.id) : openEditModal(entry)}
                                className={`group/entry relative mb-1 p-2 rounded-lg cursor-pointer transition-all border-l-4 ${isConflict ? 'ring-1 ring-red-300 bg-red-50' : 'hover:shadow-md hover:-translate-y-0.5'} ${isSwapSelected ? 'ring-2 ring-[#6D4CFF]' : ''}`}
                                style={{ borderLeftColor: c, background: isConflict ? '#FEF2F2' : `${c}08` }}>
                                <div className="flex items-center justify-between">
                                  <div className="text-[11px] font-bold text-gray-800 truncate">{subj?.name || 'Subject'}</div>
                                  {entry.entry_type !== 'regular' && <Badge className="text-[7px] px-1 py-0">{entry.entry_type}</Badge>}
                                </div>
                                <div className="text-[9px] text-gray-400 truncate flex items-center gap-1">
                                  <School size={9} /> {tchr?.full_name || '—'}
                                </div>
                                {viewMode === 'teacher' && cls && <div className="text-[9px] text-gray-400 truncate">{cls.name} {cls.section || ''}</div>}
                                {viewMode === 'class' && entry.room && <div className="text-[9px] text-gray-300 truncate">Room {entry.room}</div>}
                                <div className="text-[9px] text-gray-300 flex items-center gap-1 mt-0.5">
                                  <Clock size={9} /> {entry.start_time?.substring(0, 5)}-{entry.end_time?.substring(0, 5)}
                                </div>
                                {entry.substitute_teacher_id && <Badge className="text-[7px] mt-0.5 bg-amber-100 text-amber-700">Sub</Badge>}
                                {isConflict && <div className="text-[8px] text-red-500 font-semibold mt-0.5">⚠ Conflict</div>}
                              </div>
                            );
                          })
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    };

    const renderOverview = () => (
      <div className="space-y-5">
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          <KpiCard icon={CalendarDays} label="Total Entries" value={ds.totalEntries} color="#7C3AED" bg="#7C3AED15" />
          <KpiCard icon={GraduationCap} label="Teachers" value={ds.totalTeachersAssigned} color="#22C55E" bg="#22C55E15" />
          <KpiCard icon={MapPin} label="Rooms Used" value={ds.totalRoomsUsed} color="#3B82F6" bg="#3B82F615" />
          <KpiCard icon={Activity} label="Workload" value={`${ds.teacherWorkload || 0}%`} color="#F59E0B" bg="#F59E0B15" />
          <KpiCard icon={Brain} label="AI Score" value={ds.aiScore != null ? `${ds.aiScore}%` : '—'} color={ds.aiScore >= 70 ? '#22C55E' : ds.aiScore >= 40 ? '#F59E0B' : '#EF4444'} bg="#7C3AED15" />
        </div>
        <div className="grid grid-cols-2 gap-3">
          <Card className="p-4">
            <h3 className="font-bold text-xs mb-3">Day Distribution</h3>
            <ResponsiveContainer width="100%" height={180}>
              <BarChart data={DAYS.slice(1, 6).map((d, i) => ({ day: d.substring(0, 3), count: dashboard.data?.dayDistribution?.[i + 1] || 0 }))}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                <XAxis dataKey="day" tick={{ fontSize: 10 }} />
                <YAxis tick={{ fontSize: 10 }} />
                <Tooltip />
                <Bar dataKey="count" fill="#7C3AED" radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </Card>
          <Card className="p-4">
            <h3 className="font-bold text-xs mb-3">Entry Types</h3>
            <ResponsiveContainer width="100%" height={180}>
              <RePieChart>
                <Pie data={Object.entries(dashboard.data?.entriesByType || {}).map(([k, v]) => ({ name: k, value: v as number }))} dataKey="value" cx="50%" cy="50%" outerRadius={60} label={({ name, percent }: any) => `${name} ${((percent || 0) * 100).toFixed(0)}%`}>
                  {Object.keys(dashboard.data?.entriesByType || {}).map((_, i) => <Cell key={i} fill={['#7C3AED', '#22C55E', '#F59E0B', '#3B82F6', '#EC4899'][i]} />)}
                </Pie>
                <Tooltip />
              </RePieChart>
            </ResponsiveContainer>
          </Card>
        </div>
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <Card className="p-3.5">
            <div className="text-[10px] font-semibold text-gray-400 uppercase">Weekly Sessions</div>
            <div className="text-xl font-extrabold text-gray-900 mt-1">{ds.weeklySessions || 0}</div>
          </Card>
          <Card className="p-3.5">
            <div className="text-[10px] font-semibold text-gray-400 uppercase">Avg/Week</div>
            <div className="text-xl font-extrabold text-gray-900 mt-1">{ds.avgWeeklySessions || 0}</div>
          </Card>
          <Card className="p-3.5">
            <div className="text-[10px] font-semibold text-gray-400 uppercase">Conflicts</div>
            <div className="text-xl font-extrabold text-gray-900 mt-1">{ds.unresolvedConflicts || 0}</div>
          </Card>
          <Card className="p-3.5">
            <div className="text-[10px] font-semibold text-gray-400 uppercase">AI Suggestions</div>
            <div className="text-xl font-extrabold text-gray-900 mt-1">{(aiSuggestions.data || []).length}</div>
          </Card>
        </div>
        {aiSuggestions.data && aiSuggestions.data.length > 0 && (
          <Card className="p-4">
            <h3 className="font-bold text-xs mb-3 flex items-center gap-2"><Bot size={14} className="text-[#7C3AED]" /> AI Suggestions</h3>
            <div className="space-y-2">
              {aiSuggestions.data.slice(0, 5).map((s: any, i: number) => (
                <div key={i} className="flex items-start gap-3 p-2.5 rounded-lg bg-gray-50">
                  <div className={`w-2 h-2 rounded-full mt-1 flex-shrink-0 ${s.severity === 'critical' ? 'bg-red-500' : s.severity === 'warning' ? 'bg-amber-500' : 'bg-blue-500'}`} />
                  <div className="min-w-0">
                    <div className="text-xs font-semibold text-gray-800">{s.title}</div>
                    <div className="text-[10px] text-gray-400">{s.message}</div>
                  </div>
                  {s.count && <Badge className="text-[9px] ml-auto flex-shrink-0">{s.count}</Badge>}
                </div>
              ))}
            </div>
          </Card>
        )}
      </div>
    );

    const renderCalendar = () => (
      <div className="space-y-4">
        <div className="flex items-center gap-3">
          <select value={calYear} onChange={e => setCalYear(Number(e.target.value))} className="px-3 py-2 rounded-lg border border-gray-200 text-xs font-medium">
            {[2024, 2025, 2026, 2027, 2028].map(y => <option key={y} value={y}>{y}</option>)}
          </select>
          <button onClick={() => setCalFormOpen(true)} className="px-3 py-2 rounded-lg bg-[#7C3AED] text-white text-xs font-semibold hover:shadow-md">Add Event</button>
        </div>
        {calendarEvents.loading ? <LoadingSkeleton rows={4} cols={3} /> : calendarEvents.error ? <ErrorState message={calendarEvents.error} onRetry={calendarEvents.refetch} /> : (!calendarEvents.data || calendarEvents.data.length === 0) ? (
          <EmptyState message="No calendar events for this year" />
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {calendarEvents.data.map((ev: any) => (
              <Card key={ev.id} className="p-3.5" style={{ borderLeft: `3px solid ${ev.color || '#7C3AED'}` }}>
                <div className="flex items-center justify-between">
                  <div className="text-xs font-bold text-gray-800">{ev.title}</div>
                  <Badge className="text-[9px]">{ev.event_type}</Badge>
                </div>
                <div className="text-[10px] text-gray-400 mt-1">{ev.start_date}{ev.end_date !== ev.start_date ? ` — ${ev.end_date}` : ''}</div>
                {ev.description && <div className="text-[10px] text-gray-500 mt-1">{ev.description}</div>}
                {ev.is_holiday && <Badge className="text-[9px] mt-1 bg-red-100 text-red-600">Holiday</Badge>}
              </Card>
            ))}
          </div>
        )}
        <CrudModal open={calFormOpen} onClose={() => setCalFormOpen(false)} title="Add Calendar Event">
          <div className="space-y-4">
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Title</label>
              <input value={calTitle} onChange={e => setCalTitle(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Type</label>
              <select value={calType} onChange={e => setCalType(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                <option value="holiday">Holiday</option><option value="exam">Exam</option><option value="event">Event</option><option value="meeting">Meeting</option>
              </select></div>
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Date</label>
              <input type="date" value={calDate} onChange={e => setCalDate(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
            <button onClick={handleAddCalendarEvent} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold">Add Event</button>
          </div>
        </CrudModal>
      </div>
    );

    const renderConflicts = () => (
      <div className="space-y-4">
        <div className="flex items-center gap-2">
          <Badge className="text-xs px-3 py-1">{conflicts.data?.length || 0} unresolved</Badge>
        </div>
        {conflicts.loading ? <LoadingSkeleton rows={4} cols={4} /> : conflicts.error ? <ErrorState message={conflicts.error} onRetry={conflicts.refetch} /> : (!conflicts.data || conflicts.data.length === 0) ? <EmptyState message="No conflicts detected" /> : (
          <div className="space-y-2">
            {conflicts.data.map((c: any) => (
              <Card key={c.id} className="p-3.5 flex items-start justify-between">
                <div>
                  <div className="flex items-center gap-2">
                    <Badge className={`text-[9px] ${c.severity === 'critical' ? 'bg-red-100 text-red-700' : c.severity === 'warning' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}`}>{c.conflict_type}</Badge>
                    <Badge className="text-[9px]">{c.severity}</Badge>
                  </div>
                  <div className="text-xs text-gray-600 mt-1">{c.description}</div>
                  <div className="text-[10px] text-gray-400 mt-0.5">{c.created_at?.substring(0, 10)}</div>
                </div>
                <button onClick={async () => { const r = await timetableApiV2.resolveConflict(c.id); if (r.success) { toast.success('Resolved'); conflicts.refetch(); } }} className="px-3 py-1.5 rounded-lg text-[10px] font-semibold bg-green-50 text-green-600 hover:bg-green-100">Resolve</button>
              </Card>
            ))}
          </div>
        )}
      </div>
    );

    const renderGenerate = () => (
      <Card className="p-5 max-w-lg">
        <h3 className="font-bold text-sm mb-1">AI Timetable Generator</h3>
        <p className="text-xs text-gray-400 mb-4">Automatically generate an optimized weekly schedule based on subject-teacher mappings.</p>
        <div className="space-y-4">
          <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Class *</label>
            <select value={genClass} onChange={e => setGenClass(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
              <option value="">Select class...</option>
              {(classes.data || []).map((c: any) => <option key={c.id} value={c.id}>{c.name} {c.section || ''}</option>)}
            </select></div>
          <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Term *</label>
            <input value={genTerm} onChange={e => setGenTerm(e.target.value)} placeholder="e.g. Term 1" className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
          <button onClick={handleGenerate} disabled={genLoading}
            className="w-full py-3 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold hover:shadow-lg disabled:opacity-50 flex items-center justify-center gap-2">
            {genLoading ? <><Zap size={14} className="animate-spin" /> Generating...</> : <><Zap size={14} /> Generate Timetable</>}
          </button>
        </div>
      </Card>
    );

    const renderAnalytics = () => {
      const a = analytics.data;
      if (analytics.loading) return <LoadingSkeleton rows={4} cols={4} />;
      if (analytics.error) return <ErrorState message={analytics.error} onRetry={analytics.refetch} />;
      if (!a) return <EmptyState message="No analytics data" />;
      return (
        <div className="space-y-5">
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Total Entries</div><div className="text-xl font-extrabold mt-1">{a.totalEntries}</div></Card>
            <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Teachers</div><div className="text-xl font-extrabold mt-1">{a.uniqueTeachers}</div></Card>
            <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Rooms</div><div className="text-xl font-extrabold mt-1">{a.uniqueRooms}</div></Card>
            <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400">Subjects</div><div className="text-xl font-extrabold mt-1">{a.uniqueSubjects}</div></Card>
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Daily Distribution</h3>
              <ResponsiveContainer width="100%" height={200}>
                <BarChart data={a.dailyDistribution || []}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="day" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 10 }} />
                  <Tooltip />
                  <Bar dataKey="count" fill="#7C3AED" radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </Card>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Teacher Workload</h3>
              <ResponsiveContainer width="100%" height={200}>
                <BarChart data={(a.teacherWorkload || []).slice(0, 10)} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis dataKey="id" tick={false} width={0} />
                  <Tooltip />
                  <Bar dataKey="count" fill="#22C55E" radius={[0, 4, 4, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </Card>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Room Utilization</h3>
              <ResponsiveContainer width="100%" height={200}>
                <BarChart data={(a.roomUtilization || []).slice(0, 10)} layout="vertical">
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis type="number" tick={{ fontSize: 10 }} />
                  <YAxis dataKey="room" tick={{ fontSize: 9 }} width={50} />
                  <Tooltip />
                  <Bar dataKey="count" fill="#3B82F6" radius={[0, 4, 4, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </Card>
            <Card className="p-4">
              <h3 className="font-bold text-xs mb-3">Subject Distribution</h3>
              <ResponsiveContainer width="100%" height={200}>
                <RePieChart>
                  <Pie data={(a.subjectDistribution || []).slice(0, 8)} dataKey="count" cx="50%" cy="50%" outerRadius={60} label={({ id }: any) => subjectsMap[id]?.name?.substring(0, 8) || String(id || '').substring(0, 6)}>
                    {(a.subjectDistribution || []).slice(0, 8).map((_: any, i: number) => <Cell key={i} fill={['#7C3AED', '#22C55E', '#F59E0B', '#3B82F6', '#EC4899', '#14B8A6', '#EF4444', '#A855F7'][i]} />)}
                  </Pie>
                  <Tooltip />
                </RePieChart>
              </ResponsiveContainer>
            </Card>
          </div>
        </div>
      );
    };

    const renderTemplates = () => (
      <div className="space-y-4">
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Card className="p-4">
            <h3 className="font-bold text-xs mb-3">Save Current as Template</h3>
            <div className="space-y-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Template Name</label>
                <input value={tmplName} onChange={e => setTmplName(e.target.value)} placeholder="e.g. Grade 5 Standard" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Description</label>
                <input value={tmplDesc} onChange={e => setTmplDesc(e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button onClick={handleSaveTemplate} className="w-full py-2 rounded-lg bg-[#7C3AED] text-white text-xs font-semibold">Save Template</button>
            </div>
          </Card>
          <Card className="p-4">
            <h3 className="font-bold text-xs mb-3">Saved Templates</h3>
            {templates.loading ? <LoadingSkeleton rows={3} cols={1} /> : templates.error ? <ErrorState message={templates.error} onRetry={templates.refetch} /> : (!templates.data || templates.data.length === 0) ? <EmptyState message="No templates saved" /> : (
              <div className="space-y-2">
                {templates.data.map((t: any) => (
                  <div key={t.id} className="flex items-center justify-between p-2.5 rounded-lg bg-gray-50">
                    <div>
                      <div className="text-xs font-semibold text-gray-800">{t.name}</div>
                      {t.description && <div className="text-[9px] text-gray-400">{t.description}</div>}
                    </div>
                    <button onClick={() => { const cId = prompt('Enter class ID to apply to'); if (cId) handleApplyTemplate(t.id, cId); }}
                      className="px-2.5 py-1.5 rounded-lg text-[9px] font-semibold bg-[#7C3AED]/10 text-[#7C3AED] hover:bg-[#7C3AED]/20">Apply</button>
                  </div>
                ))}
              </div>
            )}
          </Card>
        </div>
      </div>
    );

    const renderAvailability = () => (
      <div className="space-y-4">
        <Card className="p-4 max-w-lg">
          <h3 className="font-bold text-xs mb-3">Set Teacher Availability</h3>
          <div className="space-y-3">
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Teacher</label>
              <select value={availTeacher} onChange={e => setAvailTeacher(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                <option value="">Select...</option>
                {(teachers.data || []).map((t: any) => <option key={t.id} value={t.id}>{t.full_name}</option>)}
              </select></div>
            <div className="grid grid-cols-3 gap-2">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Day</label>
                <select value={availDay} onChange={e => setAvailDay(Number(e.target.value))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  {daysArr.map(d => <option key={d} value={d}>{DAYS_SHORT[d]}</option>)}
                </select></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">From</label>
                <input type="time" value={availStart} onChange={e => setAvailStart(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">To</label>
                <input type="time" value={availEnd} onChange={e => setAvailEnd(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
            </div>
            <button onClick={handleAddAvailability} className="w-full py-2 rounded-lg bg-[#7C3AED] text-white text-xs font-semibold">Set Availability</button>
          </div>
        </Card>
        <Card className="p-4">
          <h3 className="font-bold text-xs mb-3">All Availability</h3>
          {availability.loading ? <LoadingSkeleton rows={3} cols={3} /> : availability.error ? <ErrorState message={availability.error} onRetry={availability.refetch} /> : (!availability.data || availability.data.length === 0) ? <EmptyState message="No availability set" /> : (
            <div className="space-y-1.5">
              {availability.data.map((a: any, i: number) => (
                <div key={a.id || i} className="flex items-center gap-3 p-2 rounded-lg bg-gray-50 text-xs">
                  <div className="w-7 h-7 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#8B5CF6] flex items-center justify-center text-white text-[9px] font-bold">{(teachersMap[a.teacher_id]?.full_name || '?')[0]}</div>
                  <span className="font-semibold text-gray-800">{teachersMap[a.teacher_id]?.full_name || 'Unknown'}</span>
                  <span className="text-gray-400">{DAYS_SHORT[a.day_of_week]}</span>
                  <span className="text-gray-400">{a.start_time?.substring(0, 5)}-{a.end_time?.substring(0, 5)}</span>
                  {!a.is_available && <Badge className="text-[9px] bg-red-100 text-red-600">Unavailable</Badge>}
                </div>
              ))}
            </div>
          )}
        </Card>
      </div>
    );

    return (
      <ModulePage title="Timetable" desc="Smart scheduling with AI-powered conflict detection and analytics">
        <div className="space-y-5">
          {/* Navigation tabs */}
          <div className="flex flex-wrap gap-1.5">
            {navModes.map(m => (
              <button key={m.key} onClick={() => { setViewMode(m.key as any); setSelectedClass(''); setSelectedTeacher(''); setSelectedRoom(''); }}
                className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-[10px] font-semibold transition-all ${viewMode === m.key ? 'bg-[#7C3AED] text-white shadow-sm' : 'bg-white text-gray-500 border border-gray-200 hover:border-[#7C3AED] hover:text-[#7C3AED]'}`}>
                <m.icon size={13} /> {m.label}
              </button>
            ))}
            <div className="ml-auto flex gap-1.5">
              <button onClick={() => setSwapMode(!swapMode)}
                className={`px-3 py-2 rounded-lg text-[10px] font-semibold border transition-all ${swapMode ? 'bg-amber-50 border-amber-300 text-amber-700' : 'bg-white border-gray-200 text-gray-500'}`}>
                {swapMode ? (swapFirst ? 'Select second entry' : 'Select first entry') : 'Swap Periods'}
              </button>
              {swapMode && <button onClick={() => { setSwapMode(false); setSwapFirst(null); }} className="px-3 py-2 rounded-lg text-[10px] font-semibold bg-red-50 border border-red-200 text-red-600">Cancel</button>}
            </div>
          </div>

          {/* Selectors for grid modes */}
          {viewMode === 'class' && (
            <div className="flex items-center gap-3">
              <select value={selectedClass} onChange={e => setSelectedClass(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs font-medium focus:border-[#7C3AED]">
                <option value="">Select a class...</option>
                {(classes.data || []).map((c: any) => <option key={c.id} value={c.id}>{c.name} {c.section || ''} ({c.grade_level || ''})</option>)}
              </select>
              <div className="flex gap-1.5 ml-auto">{daysArr.map(d => (
                <button key={d} onClick={() => openAddModal(d)} className="w-7 h-7 rounded-lg border border-gray-200 flex items-center justify-center text-gray-400 hover:border-[#7C3AED] hover:text-[#7C3AED] transition-all" title={`Add ${DAYS[d]} entry`}><Plus size={12} /></button>
              ))}</div>
            </div>
          )}
          {viewMode === 'teacher' && (
            <div className="flex items-center gap-3">
              <select value={selectedTeacher} onChange={e => setSelectedTeacher(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs font-medium focus:border-[#7C3AED]">
                <option value="">Select a teacher...</option>
                {(teachers.data || []).map((t: any) => <option key={t.id} value={t.id}>{t.full_name}</option>)}
              </select>
            </div>
          )}
          {viewMode === 'room' && (
            <div className="flex items-center gap-3">
              <select value={selectedRoom} onChange={e => setSelectedRoom(e.target.value)} className="px-3 py-2 rounded-lg border border-gray-200 text-xs font-medium focus:border-[#7C3AED]">
                <option value="">Select a room...</option>
                {[...new Set((entries.data || []).map((e: any) => e.room).filter(Boolean))].map(r => <option key={r} value={r}>{r}</option>)}
              </select>
            </div>
          )}

          {/* Content */}
          {(viewMode === 'class' || viewMode === 'teacher' || viewMode === 'room') && renderGridTable()}
          {viewMode === 'overview' && renderOverview()}
          {viewMode === 'calendar' && renderCalendar()}
          {viewMode === 'conflicts' && renderConflicts()}
          {viewMode === 'generate' && renderGenerate()}
          {viewMode === 'analytics' && renderAnalytics()}
          {viewMode === 'templates' && renderTemplates()}
          {viewMode === 'availability' && renderAvailability()}

          {/* Summary Stats for grid views */}
          {(viewMode === 'class' || viewMode === 'teacher' || viewMode === 'room') && entries.data && entries.data.length > 0 && (
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400 uppercase">Total</div><div className="text-xl font-extrabold text-gray-900 mt-1">{entries.data.length}</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400 uppercase">Subjects</div><div className="text-xl font-extrabold text-gray-900 mt-1">{new Set(entries.data.map((e: any) => e.subject_id)).size}</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400 uppercase">{viewMode === 'teacher' ? 'Classes' : 'Teachers'}</div><div className="text-xl font-extrabold text-gray-900 mt-1">{new Set(entries.data.map((e: any) => viewMode === 'teacher' ? e.class_id : e.teacher_id)).size}</div></Card>
              <Card className="p-3.5"><div className="text-[10px] font-semibold text-gray-400 uppercase">Days</div><div className="text-xl font-extrabold text-gray-900 mt-1">{new Set(entries.data.map((e: any) => e.day_of_week)).size}</div></Card>
            </div>
          )}
        </div>

        {/* Move modal */}
        <CrudModal open={!!moveEntryId} onClose={() => setMoveEntryId(null)} title="Move Entry">
          <div className="space-y-4">
            <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Day</label>
              <select value={moveDay} onChange={e => setMoveDay(Number(e.target.value))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                {daysArr.map(d => <option key={d} value={d}>{DAYS[d]}</option>)}
              </select></div>
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Start Time</label>
                <input type="time" value={moveStart} onChange={e => setMoveStart(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">End Time</label>
                <input type="time" value={moveEnd} onChange={e => setMoveEnd(e.target.value)} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
            </div>
            <button onClick={handleMove} className="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold">Move Entry</button>
          </div>
        </CrudModal>

        {/* Add/Edit Entry Modal */}
        <CrudModal open={modalMode !== null} onClose={() => setModalMode(null)} title={editId ? 'Edit Entry' : 'Add Entry'}>
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Class *</label>
                <select value={form.class_id} onChange={e => setForm(f => ({ ...f, class_id: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  <option value="">Select...</option>
                  {(classes.data || []).map((c: any) => <option key={c.id} value={c.id}>{c.name} {c.section || ''}</option>)}
                </select></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Subject *</label>
                <select value={form.subject_id} onChange={e => setForm(f => ({ ...f, subject_id: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  <option value="">Select...</option>
                  {(subjects.data || []).map((s: any) => <option key={s.id} value={s.id}>{s.name} ({s.code})</option>)}
                </select></div>
            </div>
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Teacher *</label>
                <select value={form.teacher_id} onChange={e => setForm(f => ({ ...f, teacher_id: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  <option value="">Select...</option>
                  {(teachers.data || []).map((t: any) => <option key={t.id} value={t.id}>{t.full_name}</option>)}
                </select></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Type</label>
                <select value={form.entry_type} onChange={e => setForm(f => ({ ...f, entry_type: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  <option value="regular">Regular</option><option value="lab">Lab</option><option value="remedial">Remedial</option><option value="substitute">Substitute</option>
                </select></div>
            </div>
            <div className="grid grid-cols-2 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Day *</label>
                <select value={form.day_of_week} onChange={e => setForm(f => ({ ...f, day_of_week: parseInt(e.target.value) }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm">
                  {[1,2,3,4,5,6,0].map(d => <option key={d} value={d}>{DAYS[d]}</option>)}
                </select></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Room</label>
                <input value={form.room} onChange={e => setForm(f => ({ ...f, room: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" placeholder="e.g. 2A" /></div>
            </div>
            <div className="grid grid-cols-3 gap-3">
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">From</label>
                <input type="time" value={form.start_time} onChange={e => setForm(f => ({ ...f, start_time: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">To</label>
                <input type="time" value={form.end_time} onChange={e => setForm(f => ({ ...f, end_time: e.target.value }))} className="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm" /></div>
              <div><label className="text-xs font-semibold text-gray-700 mb-1 block">Color</label>
                <input type="color" value={form.color} onChange={e => setForm(f => ({ ...f, color: e.target.value }))} className="w-full h-[42px] rounded-lg border border-gray-200 cursor-pointer" /></div>
            </div>
            <div className="flex gap-3 pt-2">
              {swapMode && <button onClick={() => { handleSwap(editId || ''); }} className="px-4 py-2.5 rounded-lg border border-amber-200 text-amber-600 text-xs font-semibold hover:bg-amber-50">Swap</button>}
              <button onClick={() => { if (editId) { setMoveEntryId(editId); setModalMode(null); } }} className="px-4 py-2.5 rounded-lg border border-blue-200 text-blue-600 text-xs font-semibold hover:bg-blue-50">Move</button>
              {editId && <button onClick={() => handleDelete(editId)} className="px-4 py-2.5 rounded-lg border border-red-200 text-red-500 text-xs font-semibold hover:bg-red-50">Delete</button>}
              <button onClick={handleSave} className="flex-1 py-2.5 rounded-lg bg-gradient-to-r from-[#7C3AED] to-[#8B5CF6] text-white text-sm font-semibold hover:shadow-lg active:scale-[0.98] transition-all">
                {editId ? 'Update' : 'Create'}
              </button>
            </div>
          </div>
        </CrudModal>
      </ModulePage>
    );
  }

  function ReportsTab() {
    return (
      <ModulePage title="Reports" desc="Academic, attendance, and fee reports">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
          <Card className="p-5">
            <h3 className="text-sm font-bold mb-1">Academic Report</h3>
            {academicReport.loading ? <LoadingSkeleton rows={2} cols={1} /> : academicReport.error ? <ErrorState message={academicReport.error} onRetry={academicReport.refetch} /> : (
              <div className="space-y-2 mt-3">
                <div className="flex justify-between text-xs"><span className="text-gray-400">Average Score</span><span className="font-bold">{academicReport.data?.averageScore || '—'}</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Students Tracked</span><span className="font-bold">{academicReport.data?.totalStudents || dashStats.totalStudents}</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Pass Rate</span><span className="font-bold">{academicReport.data?.passRate || '—'}</span></div>
              </div>
            )}
          </Card>
          <Card className="p-5">
            <h3 className="text-sm font-bold mb-1">Attendance Report</h3>
            {attendanceReport.loading ? <LoadingSkeleton rows={2} cols={1} /> : attendanceReport.error ? <ErrorState message={attendanceReport.error} onRetry={attendanceReport.refetch} /> : (
              <div className="space-y-2 mt-3">
                <div className="flex justify-between text-xs"><span className="text-gray-400">Average</span><span className="font-bold">{attendanceReport.data?.average || '—'}%</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Present Today</span><span className="font-bold">{attendanceReport.data?.presentToday || '—'}</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Absent Today</span><span className="font-bold">{attendanceReport.data?.absentToday || '—'}</span></div>
              </div>
            )}
          </Card>
          <Card className="p-5">
            <h3 className="text-sm font-bold mb-1">Fee Report</h3>
            {feeReport.loading ? <LoadingSkeleton rows={2} cols={1} /> : feeReport.error ? <ErrorState message={feeReport.error} onRetry={feeReport.refetch} /> : (
              <div className="space-y-2 mt-3">
                <div className="flex justify-between text-xs"><span className="text-gray-400">Total Collected</span><span className="font-bold">${(feeReport.data?.totalCollected || 0).toLocaleString()}</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Collection Rate</span><span className="font-bold">{feeReport.data?.collectionRate || '—'}%</span></div>
                <div className="flex justify-between text-xs"><span className="text-gray-400">Pending</span><span className="font-bold">${(feeReport.data?.pendingAmount || 0).toLocaleString()}</span></div>
              </div>
            )}
          </Card>
        </div>
      </ModulePage>
    );
  }

  function RiskDetectionTab() {
    const [rdTab, setRdTab] = useState('overview');
    const assessments = riskAssessments;
    const alerts = riskAlerts;
    const insights = riskInsights;

    const rdStudents = (assessments.data?.students || []);
    const rdSummary = assessments.data?.summary || { total: 0, atRisk: 0, critical: 0, high: 0, medium: 0, low: 0 };
    const rdAlerts = (alerts.data || []);
    const rdInsights = insights.data;

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <KpiCard icon={Users} label="Total Students" value={rdSummary.total} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={AlertTriangle} label="At Risk (High+Critical)" value={rdSummary.atRisk} trend={rdSummary.atRisk > 0 ? `Critical: ${rdSummary.critical}` : '+0'} color={CLR.danger} bg={`${CLR.danger}10`} />
          <KpiCard icon={Bell} label="Active Alerts" value={rdAlerts.length} color={CLR.warning} bg={`${CLR.warning}10`} />
          <KpiCard icon={TrendingUp} label="Declining Students" value={rdInsights?.overview?.decliningCount || 0} color={CLR.info} bg={`${CLR.info}10`} />
        </div>

        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-sm">Risk Distribution</h3>
          </div>
          <div className="flex items-end gap-2 h-32">
            {[
              { label: 'Low', value: rdSummary.low, color: CLR.success },
              { label: 'Medium', value: rdSummary.medium, color: CLR.warning },
              { label: 'High', value: rdSummary.high, color: CLR.danger },
              { label: 'Critical', value: rdSummary.critical, color: '#DC2626' },
            ].map(b => (
              <div key={b.label} className="flex-1 flex flex-col items-center gap-2">
                <div className="w-full rounded-lg transition-all duration-500" style={{ height: `${Math.max((b.value / Math.max(rdSummary.total, 1)) * 100, 4)}%`, background: b.color, opacity: 0.8 }} />
                <span className="text-[10px] font-semibold text-gray-500">{b.label}: {b.value}</span>
              </div>
            ))}
          </div>
        </Card>

        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-sm">Predictive Insights</h3>
            <button className="text-[10px] text-[#6D4CFF] font-semibold hover:underline" onClick={() => setRdTab('insights')}>View All</button>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="p-3 rounded-xl bg-red-50 border border-red-100">
              <div className="text-[10px] text-red-600 font-semibold mb-1">Dropout Risk</div>
              <div className="text-xl font-extrabold text-red-700">{rdInsights?.overview?.dropoutRiskCount || 0}</div>
              <div className="text-[10px] text-red-500 mt-0.5">students at high risk</div>
            </div>
            <div className="p-3 rounded-xl bg-amber-50 border border-amber-100">
              <div className="text-[10px] text-amber-600 font-semibold mb-1">Attendance Issues</div>
              <div className="text-xl font-extrabold text-amber-700">{rdInsights?.overview?.attendanceIssueCount || 0}</div>
              <div className="text-[10px] text-amber-500 mt-0.5">students with low/declining attendance</div>
            </div>
            <div className="p-3 rounded-xl bg-blue-50 border border-blue-100">
              <div className="text-[10px] text-blue-600 font-semibold mb-1">Performance Decline</div>
              <div className="text-xl font-extrabold text-blue-700">{rdInsights?.overview?.decliningCount || 0}</div>
              <div className="text-[10px] text-blue-500 mt-0.5">students with declining grades</div>
            </div>
          </div>
        </Card>
      </div>
    );

    const renderStudentList = () => (
      <DataTable
        columns={[
          { key: 'student', label: 'Student', render: (_: any, row: any) => row.student?.fullName || '—' },
          { key: 'student', label: 'Class', render: (_: any, row: any) => row.student?.class || '—' },
          { key: 'riskScore', label: 'Risk Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
          { key: 'riskLevel', label: 'Level', render: (v: string) => <Badge variant={v === 'critical' || v === 'high' ? 'danger' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || '—'}</Badge> },
          { key: 'attendancePct', label: 'Attendance', render: (v: number) => `${v ?? '—'}%` },
          { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => `${v ?? '—'}%` },
          { key: 'attendanceTrend', label: 'Att. Trend', render: (v: string) => <span className={`text-[10px] font-semibold ${v === 'declining' ? 'text-red-500' : v === 'improving' ? 'text-green-500' : 'text-gray-400'}`}>{v || '—'}</span> },
          { key: 'gradeTrend', label: 'Grade Trend', render: (v: string) => <span className={`text-[10px] font-semibold ${v === 'declining' ? 'text-red-500' : v === 'improving' ? 'text-green-500' : 'text-gray-400'}`}>{v || '—'}</span> },
        ]}
        data={rdStudents}
        loading={assessments.loading}
        error={assessments.error}
        onRetry={assessments.refetch}
        emptyMessage="No student risk assessments available"
      />
    );

    const renderAlerts = () => (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h3 className="font-bold text-sm">Active Alerts</h3>
          <button
            onClick={async () => {
              const res = await riskDetectionApi.generateAlerts();
              if (res.success) { alerts.refetch(); assessments.refetch(); toast.success(`${res.data?.length || 0} alert(s) generated`); }
              else toast.error('Failed to generate alerts');
            }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0] transition-colors"
          >
            Generate Alerts
          </button>
        </div>
        <DataTable
          columns={[
            { key: 'title', label: 'Title', render: (v: string, row: any) => <span className="font-semibold">{v || 'Alert'}</span> },
            { key: 'student', label: 'Student', render: (_: any, row: any) => row.student?.full_name || '—' },
            { key: 'severity', label: 'Severity', render: (v: string) => <Badge variant={v === 'critical' ? 'danger' : v === 'high' ? 'danger' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || '—'}</Badge> },
            { key: 'risk_score', label: 'Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
            { key: 'created_at', label: 'Created', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
            { key: 'id', label: 'Action', render: (_: string, row: any) => !row.is_resolved ? (
              <button
                onClick={async (e) => { e.stopPropagation();
                  const res = await riskDetectionApi.resolveAlert(row.id);
                  if (res.success) { alerts.refetch(); toast.success('Alert resolved'); }
                  else toast.error('Failed to resolve'); }}
                className="text-[10px] text-[#6D4CFF] font-semibold hover:underline"
              >
                Resolve
              </button>
            ) : <span className="text-[10px] text-gray-400">Resolved</span> },
          ]}
          data={rdAlerts}
          loading={alerts.loading}
          error={alerts.error}
          onRetry={alerts.refetch}
          emptyMessage="No alerts generated yet"
        />
      </div>
    );

    const renderInsights = () => (
      <div className="space-y-6">
        {rdInsights?.dropoutCandidates && rdInsights.dropoutCandidates.length > 0 && (
          <div>
            <h3 className="font-bold text-sm mb-3 text-red-600">Dropout Risk Candidates</h3>
            <DataTable
              columns={[
                { key: 'studentName', label: 'Student' },
                { key: 'class', label: 'Class' },
                { key: 'riskScore', label: 'Risk Score', render: (v: number) => <span className="font-bold text-red-600">{v ?? '—'}</span> },
                { key: 'reasons', label: 'Factors', render: (v: string[]) => <span className="text-[10px] text-gray-500">{(v || []).slice(0, 2).join(', ')}</span> },
                { key: 'recommendation', label: 'Action', render: (v: string) => <span className="text-[10px] text-gray-500 max-w-[200px] truncate">{v || '—'}</span> },
              ]}
              data={rdInsights.dropoutCandidates}
              loading={false}
              emptyMessage="No dropout risk candidates"
            />
          </div>
        )}

        {rdInsights?.decliningPerformance && rdInsights.decliningPerformance.length > 0 && (
          <div>
            <h3 className="font-bold text-sm mb-3 text-amber-600">Declining Academic Performance</h3>
            <DataTable
              columns={[
                { key: 'studentName', label: 'Student' },
                { key: 'class', label: 'Class' },
                { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => `${v ?? '—'}%` },
                { key: 'riskScore', label: 'Risk Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
              ]}
              data={rdInsights.decliningPerformance}
              loading={false}
              emptyMessage="No declining performance data"
            />
          </div>
        )}

        {rdInsights?.attendanceIssues && rdInsights.attendanceIssues.length > 0 && (
          <div>
            <h3 className="font-bold text-sm mb-3 text-amber-600">Attendance Issues</h3>
            <DataTable
              columns={[
                { key: 'studentName', label: 'Student' },
                { key: 'class', label: 'Class' },
                { key: 'attendancePct', label: 'Attendance', render: (v: number) => `${v ?? '—'}%` },
                { key: 'attendanceTrend', label: 'Trend', render: (v: string) => <span className={`text-[10px] font-semibold ${v === 'declining' ? 'text-red-500' : v === 'improving' ? 'text-green-500' : 'text-gray-400'}`}>{v || '—'}</span> },
                { key: 'riskScore', label: 'Risk Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
              ]}
              data={rdInsights.attendanceIssues}
              loading={false}
              emptyMessage="No attendance issues"
            />
          </div>
        )}

        {(!rdInsights?.dropoutCandidates?.length && !rdInsights?.decliningPerformance?.length && !rdInsights?.attendanceIssues?.length) && (
          <EmptyState message="No predictive insights available. Analyze students first." />
        )}
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'students', label: 'Student Risk Analysis' },
      { key: 'alerts', label: `Alerts (${rdAlerts.length})` },
      { key: 'insights', label: 'Predictive Insights' },
    ];

    return (
      <ModulePage title="Risk Detection" desc="Risk detection and early warning system — identify at-risk students, monitor performance decline, and prevent dropouts">
        {assessments.loading && alerts.loading ? <LoadingSkeleton rows={4} cols={3} /> : assessments.error ? <ErrorState message={assessments.error} onRetry={assessments.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setRdTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all ${rdTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}
                >
                  {tab.label}
                </button>
              ))}
            </div>

            {rdTab === 'overview' && renderOverview()}
            {rdTab === 'students' && renderStudentList()}
            {rdTab === 'alerts' && renderAlerts()}
            {rdTab === 'insights' && renderInsights()}
          </>
        )}
      </ModulePage>
    );
  }

  function TeacherPerformanceTab() {
    const [tpTab, setTpTab] = useState('overview');
    const perf = teacherPerformance;
    const obs = teacherObservations;
    const reviews = teacherReviews;
    const retention = teacherRetention;

    const tpTeachers = (perf.data?.teachers || []);
    const tpSummary = perf.data?.summary || { totalTeachers: 0, excellent: 0, good: 0, average: 0, belowAverage: 0, poor: 0, averageScore: 0 };
    const tpObservations = (obs.data || []);
    const tpReviews = (reviews.data || []);
    const tpRetention = retention.data;

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-5 gap-4">
          <KpiCard icon={Users} label="Total Teachers" value={tpSummary.totalTeachers} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={Star} label="Excellent" value={tpSummary.excellent} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={Target} label="Needs Support" value={tpSummary.belowAverage + tpSummary.poor} color={CLR.danger} bg={`${CLR.danger}10`} />
          <KpiCard icon={Activity} label="Avg Score" value={`${tpSummary.averageScore}%`} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={Bell} label="Retention Risk" value={tpRetention?.summary?.critical + tpRetention?.summary?.high || 0} color={CLR.warning} bg={`${CLR.warning}10`} />
        </div>

        <Card className="p-5">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-sm">Performance Distribution</h3>
          </div>
          <div className="flex items-end gap-2 h-32">
            {[
              { label: 'Excellent', value: tpSummary.excellent, color: CLR.success },
              { label: 'Good', value: tpSummary.good, color: '#6D4CFF' },
              { label: 'Average', value: tpSummary.average, color: CLR.warning },
              { label: 'Below Avg', value: tpSummary.belowAverage, color: CLR.danger },
              { label: 'Poor', value: tpSummary.poor, color: '#DC2626' },
            ].map(b => (
              <div key={b.label} className="flex-1 flex flex-col items-center gap-2">
                <div className="w-full rounded-lg transition-all duration-500" style={{ height: `${Math.max((b.value / Math.max(tpSummary.totalTeachers, 1)) * 100, 4)}%`, background: b.color, opacity: 0.8 }} />
                <span className="text-[10px] font-semibold text-gray-500 text-center">{b.label}: {b.value}</span>
              </div>
            ))}
          </div>
        </Card>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-4 rounded-xl bg-green-50 border border-green-100">
            <div className="flex items-center gap-2 mb-2"><Star size={14} className="text-green-600" /><span className="text-[10px] font-bold text-green-700">Top Performers</span></div>
            {perf.data?.insights?.topPerformers?.slice(0, 3).map((t: any, i: number) => (
              <div key={i} className="flex items-center justify-between py-1.5 border-b border-green-100 last:border-0">
                <span className="text-[11px] font-medium text-gray-700">{t.teacherName}</span>
                <span className="text-[10px] font-bold text-green-600">{t.compositeScore}%</span>
              </div>
            )) || <div className="text-[11px] text-gray-400 py-2">No data</div>}
          </div>
          <div className="p-4 rounded-xl bg-amber-50 border border-amber-100">
            <div className="flex items-center gap-2 mb-2"><Target size={14} className="text-amber-600" /><span className="text-[10px] font-bold text-amber-700">Needs Support</span></div>
            {perf.data?.insights?.needsSupport?.slice(0, 3).map((t: any, i: number) => (
              <div key={i} className="flex items-center justify-between py-1.5 border-b border-amber-100 last:border-0">
                <span className="text-[11px] font-medium text-gray-700">{t.teacherName}</span>
                <span className="text-[10px] font-bold text-amber-600">{t.compositeScore}%</span>
              </div>
            )) || <div className="text-[11px] text-gray-400 py-2">No data</div>}
          </div>
          <div className="p-4 rounded-xl bg-red-50 border border-red-100">
            <div className="flex items-center gap-2 mb-2"><Bell size={14} className="text-red-600" /><span className="text-[10px] font-bold text-red-700">Retention Risk</span></div>
            {tpRetention?.predictions?.filter((p: any) => p.riskLevel === 'critical' || p.riskLevel === 'high').slice(0, 3).map((p: any, i: number) => (
              <div key={i} className="flex items-center justify-between py-1.5 border-b border-red-100 last:border-0">
                <span className="text-[11px] font-medium text-gray-700">{p.teacherName}</span>
                <Badge variant="danger" className="text-[9px]">{p.riskLevel}</Badge>
              </div>
            )) || <div className="text-[11px] text-gray-400 py-2">No data</div>}
          </div>
        </div>
      </div>
    );

    const renderTeachers = () => (
      <DataTable
        columns={[
          { key: 'teacher', label: 'Teacher', render: (_: any, row: any) => row.teacher?.fullName || '—' },
          { key: 'teacher', label: 'Subject', render: (_: any, row: any) => row.teacher?.subject || '—' },
          { key: 'metrics', label: 'Composite', render: (m: any) => <span className="font-bold">{m?.compositeScore ?? '—'}</span> },
          { key: 'level', label: 'Rating', render: (v: string) => <Badge variant={v === 'excellent' ? 'success' : v === 'good' ? 'info' : v === 'average' ? 'warning' : 'danger'} className="text-[9px]">{v || '—'}</Badge> },
          { key: 'metrics', label: 'Effectiveness', render: (m: any) => `${m?.effectivenessScore ?? '—'}%` },
          { key: 'metrics', label: 'Engagement', render: (m: any) => `${m?.engagementScore ?? '—'}%` },
          { key: 'metrics', label: 'Feedback', render: (m: any) => `${m?.studentFeedbackAvg ?? '—'}%` },
          { key: 'metrics', label: 'Observation', render: (m: any) => `${m?.observationAvg ?? '—'}%` },
        ]}
        data={tpTeachers}
        loading={perf.loading}
        error={perf.error}
        onRetry={perf.refetch}
        emptyMessage="No teacher performance data available"
      />
    );

    const renderObservations = () => (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h3 className="font-bold text-sm">Classroom Observations</h3>
          <button onClick={() => toast.info('Observation form coming soon')}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0] transition-colors"
          >+ New Observation</button>
        </div>
        <DataTable
          columns={[
            { key: 'teacherName', label: 'Teacher' },
            { key: 'teacherSubject', label: 'Subject' },
            { key: 'observation_date', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
            { key: 'lesson_topic', label: 'Lesson', render: (v: string) => <span className="max-w-[150px] truncate">{v || '—'}</span> },
            { key: 'overall_rating', label: 'Rating', render: (v: number) => v ? <span className="font-bold">{v}/5</span> : '—' },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'completed' ? 'success' : v === 'scheduled' ? 'warning' : 'danger'} className="text-[9px]">{v || '—'}</Badge> },
          ]}
          data={tpObservations}
          loading={obs.loading}
          error={obs.error}
          onRetry={obs.refetch}
          emptyMessage="No observations recorded"
        />
      </div>
    );

    const renderReviews = () => (
      <DataTable
        columns={[
          { key: 'teacherName', label: 'Teacher' },
          { key: 'teacherSubject', label: 'Subject' },
          { key: 'review_period', label: 'Period' },
          { key: 'rating', label: 'Rating', render: (v: number) => v ? <span className="font-bold">{v}/5</span> : '—' },
          { key: 'effectiveness_score', label: 'Effectiveness', render: (v: number) => v ? `${v}%` : '—' },
          { key: 'engagement_score', label: 'Engagement', render: (v: number) => v ? `${v}%` : '—' },
          { key: 'reviewerName', label: 'Reviewer' },
          { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'submitted' ? 'success' : v === 'draft' ? 'warning' : 'info'} className="text-[9px]">{v || '—'}</Badge> },
        ]}
        data={tpReviews}
        loading={reviews.loading}
        error={reviews.error}
        onRetry={reviews.refetch}
        emptyMessage="No performance reviews yet"
      />
    );

    const renderRetention = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <KpiCard icon={Users} label="Total Teachers" value={tpRetention?.summary?.total || 0} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={AlertTriangle} label="Critical Risk" value={tpRetention?.summary?.critical || 0} color="#DC2626" bg="#FEE2E2" />
          <KpiCard icon={AlertTriangle} label="High Risk" value={tpRetention?.summary?.high || 0} color={CLR.danger} bg={`${CLR.danger}10`} />
          <KpiCard icon={TrendingUp} label="Avg Retention" value={`${tpRetention?.summary?.averageRetentionScore || 0}%`} color={CLR.success} bg={`${CLR.success}10`} />
        </div>
        <DataTable
          columns={[
            { key: 'teacherName', label: 'Teacher' },
            { key: 'retentionScore', label: 'Retention Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
            { key: 'riskLevel', label: 'Risk Level', render: (v: string) => <Badge variant={v === 'critical' || v === 'high' ? 'danger' : v === 'medium' ? 'warning' : 'success'} className="text-[9px]">{v || '—'}</Badge> },
            { key: 'compositeScore', label: 'Performance', render: (v: number) => `${v ?? '—'}%` },
            { key: 'factors', label: 'Factors', render: (v: string[]) => <span className="text-[10px] text-gray-500">{(v || []).slice(0, 2).join(', ')}</span> },
            { key: 'recommendation', label: 'Action', render: (v: string) => <span className="text-[10px] text-gray-500 max-w-[200px] truncate">{v || '—'}</span> },
          ]}
          data={tpRetention?.predictions || []}
          loading={retention.loading}
          error={retention.error}
          onRetry={retention.refetch}
          emptyMessage="No retention predictions available"
        />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'teachers', label: 'Performance Analysis' },
      { key: 'observations', label: `Observations (${tpObservations.length})` },
      { key: 'reviews', label: `Reviews (${tpReviews.length})` },
      { key: 'retention', label: 'Retention Prediction' },
    ];

    return (
      <ModulePage title="Teacher Performance AI" desc="AI-powered teacher performance analysis, effectiveness ratings, observation management, and retention prediction">
        {perf.loading ? <LoadingSkeleton rows={4} cols={4} /> : perf.error ? <ErrorState message={perf.error} onRetry={perf.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setTpTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${tpTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}
                >
                  {tab.label}
                </button>
              ))}
            </div>

            {tpTab === 'overview' && renderOverview()}
            {tpTab === 'teachers' && renderTeachers()}
            {tpTab === 'observations' && renderObservations()}
            {tpTab === 'reviews' && renderReviews()}
            {tpTab === 'retention' && renderRetention()}
          </>
        )}
      </ModulePage>
    );
  }

  function InstitutionIntelligenceTab() {
    const [iiTab, setIiTab] = useState('overview');
    const d = institutionIntelligence;
    const data = d.data;
    const ov = data?.overview;
    const ac = data?.academic;
    const op = data?.operational;
    const bm = data?.benchmarks;
    const tr = data?.trends;
    const pr = data?.peers;

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <KpiCard icon={GraduationCap} label="Total Students" value={ov?.metrics?.totalStudents || 0} trend={ov?.changes?.totalStudents?.change ? `${ov.changes.totalStudents.change > 0 ? '+' : ''}${ov.changes.totalStudents.change}%` : undefined}
            color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={Users} label="Teachers" value={ov?.metrics?.totalTeachers || 0} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={School} label="Classes" value={ov?.metrics?.totalClasses || 0} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={TrendingUp} label="Avg Attendance" value={ov?.metrics?.attendanceRate ? `${ov.metrics.attendanceRate}%` : '—'} trend={ov?.changes?.attendanceRate?.change ? `${ov.changes.attendanceRate.change > 0 ? '+' : ''}${ov.changes.attendanceRate.change}%` : undefined}
            color={CLR.warning} bg={`${CLR.warning}10`} />
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Key Metrics</h3>
            <div className="space-y-3">
              {[
                { label: 'Average Grade', value: ov?.metrics?.avgGrade, suffix: '%' },
                { label: 'Pass Rate', value: ov?.metrics?.passRate, suffix: '%' },
                { label: 'Student-Teacher Ratio', value: ov?.metrics?.studentTeacherRatio, suffix: ':1' },
                { label: 'Avg Class Size', value: ov?.metrics?.avgClassSize, suffix: ' students' },
                { label: 'Total Alumni', value: ov?.metrics?.totalAlumni },
                { label: 'Fees Collected (YTD)', value: ov?.metrics?.totalFeesCollected, prefix: '$' },
              ].map(item => (
                <div key={item.label} className="flex items-center justify-between py-1.5 border-b border-gray-50 last:border-0">
                  <span className="text-[11px] text-gray-500">{item.label}</span>
                  <span className="text-xs font-bold">{item.prefix || ''}{item.value ?? '—'}{item.suffix || ''}</span>
                </div>
              ))}
            </div>
          </Card>

          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Benchmark Score</h3>
            <div className="flex items-center justify-center h-32">
              <div className="text-center">
                <div className="text-5xl font-extrabold" style={{ color: (bm?.overallScore || 0) >= 70 ? CLR.success : (bm?.overallScore || 0) >= 50 ? CLR.warning : CLR.danger }}>
                  {bm?.overallScore ?? '—'}
                </div>
                <div className="text-[11px] text-gray-400 mt-1">Overall Benchmark Score</div>
              </div>
            </div>
            <div className="grid grid-cols-3 gap-2 mt-4">
              {(bm?.categoryScores || []).map((c: any) => (
                <div key={c.category} className="text-center p-2 rounded-lg bg-gray-50">
                  <div className="text-xs font-bold">{c.score}</div>
                  <div className="text-[9px] text-gray-400 capitalize">{c.category}</div>
                </div>
              ))}
            </div>
          </Card>
        </div>

        {tr?.trends && tr.trends.length > 1 && (
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-3">Growth Projection</h3>
            <div className="grid grid-cols-3 gap-4">
              <div className="p-3 rounded-xl bg-[#F3F0FF]">
                <div className="text-[10px] text-gray-500">Projected Students</div>
                <div className="text-lg font-extrabold text-[#6D4CFF]">{tr.projectNextQuarter?.projectedStudents || '—'}</div>
                <div className="text-[9px] text-gray-400">Next quarter</div>
              </div>
              <div className="p-3 rounded-xl bg-green-50">
                <div className="text-[10px] text-gray-500">Projected Teachers</div>
                <div className="text-lg font-extrabold text-green-600">{tr.projectNextQuarter?.projectedTeachers || '—'}</div>
                <div className="text-[9px] text-gray-400">Next quarter</div>
              </div>
              <div className="p-3 rounded-xl bg-amber-50">
                <div className="text-[10px] text-gray-500">Projected Attendance</div>
                <div className="text-lg font-extrabold text-amber-600">{tr.projectNextQuarter?.projectedAttendance || '—'}%</div>
                <div className="text-[9px] text-gray-400">Next quarter</div>
              </div>
            </div>
          </Card>
        )}
      </div>
    );

    const renderAcademic = () => (
      <div className="space-y-6">
        <Card className="p-5">
          <h3 className="font-bold text-sm mb-4">Subject Performance</h3>
          <DataTable
            columns={[
              { key: 'subject', label: 'Subject' },
              { key: 'average', label: 'Avg Score', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
              { key: 'passRate', label: 'Pass Rate', render: (v: number) => `${v ?? '—'}%` },
              { key: 'count', label: 'Records' },
            ]}
            data={ac?.subjectPerformance || []}
            loading={d.loading}
            error={d.error}
            onRetry={d.refetch}
            emptyMessage="No academic data available"
          />
        </Card>

        {ac?.attendanceTrend && ac.attendanceTrend.length > 0 && (
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Attendance Trend (Monthly)</h3>
            <DataTable
              columns={[
                { key: 'month', label: 'Month' },
                { key: 'rate', label: 'Rate', render: (v: number) => `${v ?? '—'}%` },
              ]}
              data={ac.attendanceTrend.slice(-12)}
              loading={false}
              emptyMessage="No attendance trend data"
            />
          </Card>
        )}

        {ac?.examStats && ac.examStats.length > 0 && (
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Exam Performance</h3>
            <DataTable
              columns={[
                { key: 'exam', label: 'Exam' },
                { key: 'totalStudents', label: 'Students' },
                { key: 'passRate', label: 'Pass Rate', render: (v: number) => `${v ?? '—'}%` },
                { key: 'averageMarks', label: 'Avg Marks', render: (v: number) => `${v ?? '—'}` },
              ]}
              data={ac.examStats}
              loading={false}
              emptyMessage="No exam data available"
            />
          </Card>
        )}
      </div>
    );

    const renderOperational = () => (
      <div className="space-y-6">
        <Card className="p-5">
          <h3 className="font-bold text-sm mb-4">Class Utilization</h3>
          <DataTable
            columns={[
              { key: 'className', label: 'Class' },
              { key: 'gradeLevel', label: 'Grade' },
              { key: 'capacity', label: 'Capacity' },
              { key: 'enrolled', label: 'Enrolled' },
              { key: 'utilization', label: 'Utilization', render: (v: number) => <span className="font-bold">{v ?? '—'}%</span> },
            ]}
            data={op?.classSizes || []}
            loading={d.loading}
            emptyMessage="No class data"
          />
        </Card>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Gender Distribution</h3>
            <DataTable
              columns={[
                { key: 'gender', label: 'Gender', render: (v: string) => <span className="capitalize">{v}</span> },
                { key: 'count', label: 'Count' },
                { key: 'pct', label: '%', render: (v: number) => `${v ?? '—'}%` },
              ]}
              data={op?.genderDistribution || []}
              loading={false}
              emptyMessage="No gender data"
            />
          </Card>

          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Fee Collection</h3>
            <div className="space-y-3">
              <div className="flex justify-between py-2 border-b"><span className="text-[11px] text-gray-500">Total Due</span><span className="text-xs font-bold">${(op?.feeCollection?.totalAmount || 0).toLocaleString()}</span></div>
              <div className="flex justify-between py-2 border-b"><span className="text-[11px] text-gray-500">Collected</span><span className="text-xs font-bold text-green-600">${(op?.feeCollection?.totalPaid || 0).toLocaleString()}</span></div>
              <div className="flex justify-between py-2 border-b"><span className="text-[11px] text-gray-500">Pending</span><span className="text-xs font-bold text-red-500">${(op?.feeCollection?.pendingAmount || 0).toLocaleString()}</span></div>
              <div className="flex justify-between py-2"><span className="text-[11px] text-gray-500">Collection Rate</span><span className="text-xs font-bold">{op?.feeCollection?.collectionRate || 0}%</span></div>
            </div>
          </Card>
        </div>

        <Card className="p-5">
          <h3 className="font-bold text-sm mb-4">Library & Staff</h3>
          <div className="grid grid-cols-3 gap-4">
            <div className="text-center p-3 rounded-xl bg-blue-50"><div className="text-lg font-extrabold text-blue-600">{op?.staffCount || 0}</div><div className="text-[10px] text-gray-500">Staff Members</div></div>
            <div className="text-center p-3 rounded-xl bg-purple-50"><div className="text-lg font-extrabold text-purple-600">{op?.libraryStats?.totalBooks || 0}</div><div className="text-[10px] text-gray-500">Library Books</div></div>
            <div className="text-center p-3 rounded-xl bg-teal-50"><div className="text-lg font-extrabold text-teal-600">{op?.libraryStats?.booksPerStudent || 0}</div><div className="text-[10px] text-gray-500">Books/Student</div></div>
          </div>
        </Card>
      </div>
    );

    const renderBenchmarks = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
          {(bm?.categoryScores || []).map((c: any) => (
            <Card key={c.category} className="p-5 text-center">
              <div className="text-[10px] text-gray-400 font-semibold uppercase mb-2">{c.category}</div>
              <div className="text-4xl font-extrabold" style={{ color: c.score >= 70 ? CLR.success : c.score >= 50 ? CLR.warning : CLR.danger }}>{c.score}</div>
              <div className="text-[10px] text-gray-400 mt-1">out of 100</div>
            </Card>
          ))}
        </div>

        <DataTable
          columns={[
            { key: 'metricName', label: 'Metric' },
            { key: 'category', label: 'Category', render: (v: string) => <Badge variant="info" className="text-[9px] capitalize">{v}</Badge> },
            { key: 'orgValue', label: 'Your Value', render: (v: number) => <span className="font-bold">{v ?? '—'}</span> },
            { key: 'peerAvg', label: 'Peer Avg', render: (v: number) => <span className="text-gray-500">{v ?? '—'}</span> },
            { key: 'percentileRank', label: 'Percentile', render: (v: number) => <span className="font-semibold">{v ?? '—'}th</span> },
            { key: 'score', label: 'Score', render: (v: number) => <span className={`font-bold ${v >= 70 ? 'text-green-600' : v >= 50 ? 'text-amber-600' : 'text-red-600'}`}>{v ?? '—'}</span> },
          ]}
          data={bm?.benchmarks || []}
          loading={d.loading}
          emptyMessage="No benchmark data available yet — analyze your institution first"
        />
      </div>
    );

    const renderTrends = () => (
      <div className="space-y-6">
        {tr?.trends && tr.trends.length > 0 ? (
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Historical Trends</h3>
            <DataTable
              columns={[
                { key: 'period', label: 'Period' },
                { key: 'totalStudents', label: 'Students' },
                { key: 'totalTeachers', label: 'Teachers' },
                { key: 'avgAttendance', label: 'Attendance', render: (v: number) => `${v ?? '—'}%` },
                { key: 'avgGrade', label: 'Avg Grade', render: (v: number) => `${v ?? '—'}` },
                { key: 'passRate', label: 'Pass Rate', render: (v: number) => `${v ?? '—'}%` },
              ]}
              data={tr.trends}
              loading={false}
              emptyMessage="No trend data"
            />
          </Card>
        ) : (
          <EmptyState message="No trend data available yet. Data will accumulate as snapshots are taken monthly." />
        )}

        {tr?.projectNextQuarter && (
          <Card className="p-5">
            <h3 className="font-bold text-sm mb-4">Next Quarter Projection</h3>
            <div className="grid grid-cols-3 gap-4">
              <div className="p-4 rounded-xl bg-[#F3F0FF] text-center">
                <div className="text-xl font-extrabold text-[#6D4CFF]">{tr.projectNextQuarter.projectedStudents}</div>
                <div className="text-[10px] text-gray-500">Projected Students</div>
              </div>
              <div className="p-4 rounded-xl bg-green-50 text-center">
                <div className="text-xl font-extrabold text-green-600">{tr.projectNextQuarter.projectedTeachers}</div>
                <div className="text-[10px] text-gray-500">Projected Teachers</div>
              </div>
              <div className="p-4 rounded-xl bg-amber-50 text-center">
                <div className="text-xl font-extrabold text-amber-600">{tr.projectNextQuarter.projectedAttendance}%</div>
                <div className="text-[10px] text-gray-500">Projected Attendance</div>
              </div>
            </div>
          </Card>
        )}
      </div>
    );

    const renderPeers = () => (
      <div className="space-y-6">
        {pr?.mySchool && (
          <Card className="p-5 border-2 border-[#6D4CFF]">
            <div className="flex items-center gap-2 mb-3"><Sparkles size={14} className="text-[#6D4CFF]" /><span className="font-bold text-sm">My Institution</span></div>
            <div className="grid grid-cols-4 gap-4 text-center">
              <div><div className="text-lg font-extrabold text-[#6D4CFF]">{pr.mySchool.totalStudents}</div><div className="text-[9px] text-gray-400">Students</div></div>
              <div><div className="text-lg font-extrabold">{pr.mySchool.avgAttendance || '—'}</div><div className="text-[9px] text-gray-400">Attendance %</div></div>
              <div><div className="text-lg font-extrabold">{pr.mySchool.avgGrade || '—'}</div><div className="text-[9px] text-gray-400">Avg Grade</div></div>
              <div><div className="text-lg font-extrabold">{pr.mySchool.passRate || '—'}</div><div className="text-[9px] text-gray-400">Pass Rate %</div></div>
            </div>
          </Card>
        )}

        <DataTable
          columns={[
            { key: 'name', label: 'Peer Institution' },
            { key: 'totalStudents', label: 'Students' },
            { key: 'totalTeachers', label: 'Teachers' },
            { key: 'avgAttendance', label: 'Attendance', render: (v: number) => v ? `${v}%` : '—' },
            { key: 'passRate', label: 'Pass Rate', render: (v: number) => v ? `${v}%` : '—' },
            { key: 'studentTeacherRatio', label: 'S:T Ratio', render: (v: number) => v ? `${v}:1` : '—' },
            { key: 'avgClassSize', label: 'Class Size', render: (v: number) => v || '—' },
          ]}
          data={pr?.peers || []}
          loading={d.loading}
          emptyMessage="No peer data available"
        />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'academic', label: 'Academic' },
      { key: 'operational', label: 'Operational' },
      { key: 'benchmarks', label: 'Benchmarks' },
      { key: 'trends', label: 'Trends' },
      { key: 'peers', label: 'Peer Comparison' },
    ];

    return (
      <ModulePage title="Institution Intelligence" desc="Cross-institution intelligence and benchmarking — compare your school against peers and track growth">
        {d.loading ? <LoadingSkeleton rows={4} cols={4} /> : d.error ? <ErrorState message={d.error} onRetry={d.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setIiTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${iiTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}
                >
                  {tab.label}
                </button>
              ))}
            </div>
            {iiTab === 'overview' && renderOverview()}
            {iiTab === 'academic' && renderAcademic()}
            {iiTab === 'operational' && renderOperational()}
            {iiTab === 'benchmarks' && renderBenchmarks()}
            {iiTab === 'trends' && renderTrends()}
            {iiTab === 'peers' && renderPeers()}
          </>
        )}
      </ModulePage>
    );
  }

  function EsportsTab() {
    const [espTab, setEspTab] = useState('overview');
    const dash = esportsDash;
    const leagues = esportsLeagues;
    const teams = esportsTeams;
    const matches = esportsMatches;
    const streams = esportsStreams;
    const curriculum = esportsCurriculum;

    const [espModal, setEspModal] = useState<{ type: string; data?: any } | null>(null);
    const lForm = useForm({ name: '', game: '', description: '', platform: '', season: '', max_teams: 8, format: 'round_robin', rules: '', prize_pool: '', start_date: '', end_date: '', status: 'upcoming' });
    const tForm = useForm({ name: '', tag: '', league_id: '', color: '#6D4CFF', max_players: 5 });
    const mForm = useForm({ league_id: '', tournament_id: '', team1_id: '', team2_id: '', round: 1, scheduled_at: '' });
    const cForm = useForm({ title: '', description: '', game: '', category: 'other', resource_url: '', duration_minutes: 60, difficulty: 'beginner' });
    const sForm = useForm({ title: '', description: '', platform: 'twitch', stream_url: '', embed_url: '', game: '', scheduled_at: '' });

    const [creating, setCreating] = useState(false);

    const refreshAll = () => { leagues.refetch(); teams.refetch(); matches.refetch(); streams.refetch(); curriculum.refetch(); dash.refetch(); };

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-5 gap-4">
          <KpiCard icon={Gamepad2} label="Total Leagues" value={dash.data?.summary?.totalLeagues || 0} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={Activity} label="Active Leagues" value={dash.data?.summary?.activeLeagues || 0} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={Users} label="Total Teams" value={dash.data?.summary?.totalTeams || 0} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={CalendarDays} label="Upcoming Matches" value={dash.data?.summary?.upcomingMatches || 0} color={CLR.warning} bg={`${CLR.warning}10`} />
          <KpiCard icon={Activity} label="Live Now" value={dash.data?.summary?.liveStreams || 0} color={CLR.danger} bg={`${CLR.danger}10`} />
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {dash.data?.recentLeagues?.length > 0 && (
            <Card className="p-5">
              <h3 className="font-bold text-sm mb-3">Recent Leagues</h3>
              <div className="space-y-2">
                {dash.data.recentLeagues.map((l: any) => (
                  <div key={l.id} className="flex items-center justify-between p-2.5 rounded-lg bg-gray-50">
                    <div>
                      <div className="text-xs font-semibold">{l.name}</div>
                      <div className="text-[10px] text-gray-400">{l.game} • {l.season || 'N/A'}</div>
                    </div>
                    <Badge variant={l.status === 'active' ? 'success' : l.status === 'registration' ? 'info' : l.status === 'upcoming' ? 'warning' : 'danger'} className="text-[9px]">{l.status}</Badge>
                  </div>
                ))}
              </div>
            </Card>
          )}
          {dash.data?.upcomingMatches?.length > 0 && (
            <Card className="p-5">
              <h3 className="font-bold text-sm mb-3">Upcoming Matches</h3>
              <div className="space-y-2">
                {dash.data.upcomingMatches.map((m: any) => (
                  <div key={m.id} className="flex items-center justify-between p-2.5 rounded-lg bg-gray-50">
                    <div className="flex items-center gap-2">
                      <span className="text-xs font-semibold">{m.team1Name}</span>
                      <span className="text-[10px] text-gray-400">vs</span>
                      <span className="text-xs font-semibold">{m.team2Name}</span>
                    </div>
                    <div className="text-[10px] text-gray-400">{m.scheduled_at ? new Date(m.scheduled_at).toLocaleDateString() : 'TBD'}</div>
                  </div>
                ))}
              </div>
            </Card>
          )}
        </div>
      </div>
    );

    const renderLeagues = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { lForm.reset(); setEspModal({ type: 'league' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ New League</button>
        </div>
        <DataTable
          columns={[
            { key: 'name', label: 'League', render: (v: string, r: any) => <div><div className="font-semibold text-xs">{v}</div><div className="text-[10px] text-gray-400">{r.game}</div></div> },
            { key: 'season', label: 'Season' },
            { key: 'format', label: 'Format', render: (v: string) => <span className="capitalize text-[10px]">{(v || '').replace(/_/g, ' ')}</span> },
            { key: 'max_teams', label: 'Max Teams' },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : v === 'registration' ? 'info' : v === 'upcoming' ? 'warning' : 'danger'} className="text-[9px]">{v}</Badge> },
            { key: 'start_date', label: 'Start', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          ]}
          data={leagues.data || []}
          loading={leagues.loading}
          error={leagues.error}
          onRetry={leagues.refetch}
          emptyMessage="No esports leagues yet"
        />
      </div>
    );

    const renderTeams = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { tForm.reset(); setEspModal({ type: 'team' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ New Team</button>
        </div>
        <DataTable
          columns={[
            { key: 'name', label: 'Team', render: (v: string, r: any) => <div className="flex items-center gap-2"><div className="w-3 h-3 rounded-full" style={{ background: r.color || CLR.primary }} /><span className="font-semibold text-xs">{v}</span></div> },
            { key: 'tag', label: 'Tag', render: (v: string) => v ? <span className="text-[10px] font-mono bg-gray-100 px-1.5 py-0.5 rounded">{v}</span> : '—' },
            { key: 'league', label: 'League', render: (_: any, r: any) => r.league?.name || '—' },
            { key: 'playerCount', label: 'Players' },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'danger'} className="text-[9px]">{v}</Badge> },
          ]}
          data={teams.data || []}
          loading={teams.loading}
          error={teams.error}
          onRetry={teams.refetch}
          emptyMessage="No esports teams yet"
        />
      </div>
    );

    const renderMatches = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { mForm.reset(); setEspModal({ type: 'match' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ Schedule Match</button>
        </div>
        <DataTable
          columns={[
            { key: 'team1Name', label: 'Team 1', render: (v: string, r: any) => <span className="font-semibold text-xs">{v}{r.team1Tag ? ` (${r.team1Tag})` : ''}</span> },
            { key: 'score', label: 'Score', render: (_: any, r: any) => r.status === 'completed' ? <span className="font-bold">{r.team1_score} - {r.team2_score}</span> : <span className="text-[10px] text-gray-400">vs</span> },
            { key: 'team2Name', label: 'Team 2', render: (v: string, r: any) => <span className="font-semibold text-xs">{v}{r.team2Tag ? ` (${r.team2Tag})` : ''}</span> },
            { key: 'tournamentName', label: 'Tournament', render: (v: string) => v || '—' },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'completed' ? 'success' : v === 'in_progress' ? 'info' : v === 'scheduled' ? 'warning' : 'danger'} className="text-[9px]">{v}</Badge> },
            { key: 'scheduled_at', label: 'Date', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          ]}
          data={matches.data || []}
          loading={matches.loading}
          error={matches.error}
          onRetry={matches.refetch}
          emptyMessage="No matches scheduled"
        />
      </div>
    );

    const renderStreams = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { sForm.reset(); setEspModal({ type: 'stream' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ Add Stream</button>
        </div>
        <DataTable
          columns={[
            { key: 'title', label: 'Title', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
            { key: 'platform', label: 'Platform', render: (v: string) => <Badge variant="info" className="text-[9px] capitalize">{v}</Badge> },
            { key: 'game', label: 'Game' },
            { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'live' ? 'danger' : v === 'upcoming' ? 'warning' : 'success'} className="text-[9px]">{v}</Badge> },
            { key: 'scheduled_at', label: 'Scheduled', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          ]}
          data={streams.data || []}
          loading={streams.loading}
          error={streams.error}
          onRetry={streams.refetch}
          emptyMessage="No live streams"
        />
      </div>
    );

    const renderCurriculum = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { cForm.reset(); setEspModal({ type: 'curriculum' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold hover:bg-[#5A3EF0]">+ Add Resource</button>
        </div>
        <DataTable
          columns={[
            { key: 'title', label: 'Title', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
            { key: 'game', label: 'Game' },
            { key: 'category', label: 'Category', render: (v: string) => <Badge variant="info" className="text-[9px] capitalize">{v}</Badge> },
            { key: 'difficulty', label: 'Difficulty', render: (v: string) => <Badge variant={v === 'advanced' ? 'danger' : v === 'intermediate' ? 'warning' : 'success'} className="text-[9px]">{v}</Badge> },
            { key: 'duration_minutes', label: 'Duration', render: (v: number) => v ? `${v} min` : '—' },
            { key: 'resource_url', label: 'URL', render: (v: string) => v ? <a href={v} target="_blank" rel="noopener noreferrer" className="text-[#6D4CFF] text-[10px] hover:underline">View</a> : '—' },
          ]}
          data={curriculum.data || []}
          loading={curriculum.loading}
          error={curriculum.error}
          onRetry={curriculum.refetch}
          emptyMessage="No gaming curriculum resources"
        />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'leagues', label: `Leagues (${(leagues.data || []).length})` },
      { key: 'teams', label: `Teams (${(teams.data || []).length})` },
      { key: 'matches', label: `Matches (${(matches.data || []).length})` },
      { key: 'curriculum', label: 'Curriculum' },
      { key: 'streams', label: 'Live Streams' },
    ];

    return (
      <ModulePage title="Esports" desc="Esports league and tournament management — organize leagues, manage teams, schedule matches, and stream events">
        {dash.loading ? <LoadingSkeleton rows={4} cols={4} /> : dash.error ? <ErrorState message={dash.error} onRetry={dash.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setEspTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${espTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}
                >
                  {tab.label}
                </button>
              ))}
            </div>
            {espTab === 'overview' && renderOverview()}
            {espTab === 'leagues' && renderLeagues()}
            {espTab === 'teams' && renderTeams()}
            {espTab === 'matches' && renderMatches()}
            {espTab === 'curriculum' && renderCurriculum()}
            {espTab === 'streams' && renderStreams()}
          </>
        )}

        <CrudModal open={!!espModal} onClose={() => setEspModal(null)} title={espModal?.type === 'league' ? 'Create League' : espModal?.type === 'team' ? 'Create Team' : espModal?.type === 'match' ? 'Schedule Match' : espModal?.type === 'stream' ? 'Add Live Stream' : 'Add Resource'}>
          {espModal?.type === 'league' && (
            <div className="space-y-3">
              {[{ k: 'name', l: 'League Name' }, { k: 'game', l: 'Game' }, { k: 'description', l: 'Description' }, { k: 'platform', l: 'Platform' }, { k: 'season', l: 'Season' }, { k: 'rules', l: 'Rules' }, { k: 'prize_pool', l: 'Prize Pool' }].map(f => (
                <div key={f.k}><label className="text-[10px] font-semibold text-gray-600 mb-1 block">{f.l}</label>
                <input type="text" value={lForm.values[f.k as keyof typeof lForm.values] as string} onChange={e => lForm.handleChange(f.k, e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs focus:outline-none focus:border-[#6D4CFF]" /></div>
              ))}
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Format</label>
                <select value={lForm.values.format} onChange={e => lForm.handleChange('format', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="round_robin">Round Robin</option><option value="single_elimination">Single Elimination</option><option value="double_elimination">Double Elimination</option><option value="swiss">Swiss</option></select></div>
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Max Teams</label>
                <input type="number" value={lForm.values.max_teams} onChange={e => lForm.handleChange('max_teams', parseInt(e.target.value))} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Start Date</label>
                <input type="date" value={lForm.values.start_date} onChange={e => lForm.handleChange('start_date', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">End Date</label>
                <input type="date" value={lForm.values.end_date} onChange={e => lForm.handleChange('end_date', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              </div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await esportsApi.createLeague(lForm.values); if (r.success) { toast.success('League created'); refreshAll(); setEspModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create League'}</button>
            </div>
          )}
          {espModal?.type === 'team' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">League</label>
              <select value={tForm.values.league_id} onChange={e => tForm.handleChange('league_id', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="">Select league</option>{(leagues.data || []).map((l: any) => <option key={l.id} value={l.id}>{l.name} ({l.game})</option>)}
              </select></div>
              {[{ k: 'name', l: 'Team Name' }, { k: 'tag', l: 'Tag (e.g., T1)' }].map(f => (
                <div key={f.k}><label className="text-[10px] font-semibold text-gray-600 mb-1 block">{f.l}</label>
                <input type="text" value={tForm.values[f.k as keyof typeof tForm.values] as string} onChange={e => tForm.handleChange(f.k, e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              ))}
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Team Color</label>
              <input type="color" value={tForm.values.color} onChange={e => tForm.handleChange('color', e.target.value)} className="w-full h-10 rounded-lg border border-gray-200 cursor-pointer" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await esportsApi.createTeam(tForm.values); if (r.success) { toast.success('Team created'); refreshAll(); setEspModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Team'}</button>
            </div>
          )}
          {espModal?.type === 'match' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">League</label>
              <select value={mForm.values.league_id} onChange={e => { mForm.handleChange('league_id', e.target.value); mForm.handleChange('tournament_id', ''); }} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="">Select league</option>{(leagues.data || []).map((l: any) => <option key={l.id} value={l.id}>{l.name}</option>)}
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Team 1</label>
              <select value={mForm.values.team1_id} onChange={e => mForm.handleChange('team1_id', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="">Select team</option>{(teams.data || []).filter((t: any) => t.id !== mForm.values.team2_id).map((t: any) => <option key={t.id} value={t.id}>{t.name}</option>)}
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Team 2</label>
              <select value={mForm.values.team2_id} onChange={e => mForm.handleChange('team2_id', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="">Select team</option>{(teams.data || []).filter((t: any) => t.id !== mForm.values.team1_id).map((t: any) => <option key={t.id} value={t.id}>{t.name}</option>)}
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Scheduled Date</label>
              <input type="datetime-local" value={mForm.values.scheduled_at} onChange={e => mForm.handleChange('scheduled_at', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await esportsApi.createMatch(mForm.values); if (r.success) { toast.success('Match scheduled'); refreshAll(); setEspModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Scheduling...' : 'Schedule Match'}</button>
            </div>
          )}
          {espModal?.type === 'stream' && (
            <div className="space-y-3">
              {[{ k: 'title', l: 'Stream Title' }, { k: 'description', l: 'Description' }, { k: 'stream_url', l: 'Stream URL' }, { k: 'embed_url', l: 'Embed URL' }, { k: 'game', l: 'Game' }].map(f => (
                <div key={f.k}><label className="text-[10px] font-semibold text-gray-600 mb-1 block">{f.l}</label>
                <input type="text" value={sForm.values[f.k as keyof typeof sForm.values] as string} onChange={e => sForm.handleChange(f.k, e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              ))}
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Platform</label>
              <select value={sForm.values.platform} onChange={e => sForm.handleChange('platform', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="twitch">Twitch</option><option value="youtube">YouTube</option><option value="facebook">Facebook</option><option value="custom">Custom</option></select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Schedule At</label>
              <input type="datetime-local" value={sForm.values.scheduled_at} onChange={e => sForm.handleChange('scheduled_at', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await esportsApi.createStream(sForm.values); if (r.success) { toast.success('Stream added'); refreshAll(); setEspModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Adding...' : 'Add Stream'}</button>
            </div>
          )}
          {espModal?.type === 'curriculum' && (
            <div className="space-y-3">
              {[{ k: 'title', l: 'Title' }, { k: 'description', l: 'Description' }, { k: 'game', l: 'Game' }, { k: 'resource_url', l: 'Resource URL' }].map(f => (
                <div key={f.k}><label className="text-[10px] font-semibold text-gray-600 mb-1 block">{f.l}</label>
                <input type="text" value={cForm.values[f.k as keyof typeof cForm.values] as string} onChange={e => cForm.handleChange(f.k, e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              ))}
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Category</label>
                <select value={cForm.values.category} onChange={e => cForm.handleChange('category', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="strategy">Strategy</option><option value="coding">Coding</option><option value="design">Design</option><option value="analysis">Analysis</option><option value="sportsmanship">Sportsmanship</option><option value="other">Other</option></select></div>
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Difficulty</label>
                <select value={cForm.values.difficulty} onChange={e => cForm.handleChange('difficulty', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs"><option value="beginner">Beginner</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option></select></div>
              </div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Duration (minutes)</label>
              <input type="number" value={cForm.values.duration_minutes} onChange={e => cForm.handleChange('duration_minutes', parseInt(e.target.value))} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await esportsApi.createCurriculum(cForm.values); if (r.success) { toast.success('Resource added'); refreshAll(); setEspModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Adding...' : 'Add Resource'}</button>
            </div>
          )}
        </CrudModal>
      </ModulePage>
    );
  }

  function AiInsightsTab() {
    const ai = aiPredictions;
    return (
      <ModulePage title="AI Insights" desc="Predictive analytics and intelligent recommendations">
        {ai.loading ? <LoadingSkeleton rows={4} cols={3} /> : ai.error ? <ErrorState message={ai.error} onRetry={ai.refetch} /> : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {(ai.data || []).map((p: any, i: number) => (
              <Card key={i} className="p-4">
                <div className="flex items-start justify-between mb-2">
                  <Brain size={18} className="text-[#6D4CFF]" />
                  <Badge variant={p.risk_level === 'high' ? 'danger' : p.risk_level === 'medium' ? 'warning' : 'success'} className="text-[9px]">{p.risk_level || 'normal'}</Badge>
                </div>
                <div className="text-sm font-bold mb-1">{p.title || 'AI Prediction'}</div>
                <div className="text-[11px] text-gray-500">{p.description || 'No details available'}</div>
                {p.score && <div className="mt-2 text-xs font-semibold text-[#6D4CFF]">Score: {p.score}%</div>}
              </Card>
            ))}
            {(!ai.data || ai.data.length === 0) && <EmptyState message="No AI insights available yet" />}
          </div>
        )}
      </ModulePage>
    );
  }

  function CollaborationTab() {
    const [colTab, setColTab] = useState('overview');
    const dash = collabDash;
    const classrooms = collabClassrooms;
    const projects = collabProjects;
    const docs = collabDocs;
    const forums = collabForums;
    const whiteboards = collabWhiteboards;
    const [colModal, setColModal] = useState<{ type: string; data?: any } | null>(null);
    const crForm = useForm({ name: '', description: '', subject: '', teacher_id: '', max_students: 30 });
    const pjForm = useForm({ title: '', description: '', subject: '', lead_id: '', max_members: 5, due_date: '' });
    const docForm = useForm({ title: '', content: '', classroom_id: '', project_id: '' });
    const frForm = useForm({ title: '', description: '', classroom_id: '', is_pinned: false });
    const wbForm = useForm({ title: '', classroom_id: '' });
    const [creating, setCreating] = useState(false);
    const refreshAll = () => { classrooms.refetch(); projects.refetch(); docs.refetch(); forums.refetch(); whiteboards.refetch(); dash.refetch(); };

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-5 gap-4">
          <KpiCard icon={School} label="Classrooms" value={dash.data?.summary?.totalClassrooms || 0} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={Activity} label="Active" value={dash.data?.summary?.activeClassrooms || 0} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={Briefcase} label="Projects" value={dash.data?.summary?.totalProjects || 0} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={FileText} label="Documents" value={dash.data?.summary?.totalDocuments || 0} color={CLR.warning} bg={`${CLR.warning}10`} />
          <KpiCard icon={MessageSquare} label="Forums" value={dash.data?.summary?.totalForums || 0} color={CLR.secondary} bg={`${CLR.secondary}10`} />
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {dash.data?.recentClassrooms?.length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Recent Classrooms</h3>
              <div className="space-y-2">{dash.data.recentClassrooms.map((c: any) => (
                <div key={c.id} className="flex items-center justify-between p-2.5 rounded-lg bg-gray-50">
                  <div><div className="text-xs font-semibold">{c.name}</div><div className="text-[10px] text-gray-400">{c.subject || '—'} • {c.memberCount || 0} members</div></div>
                  <Badge variant={c.status === 'active' ? 'success' : 'warning'} className="text-[9px]">{c.status}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
          {dash.data?.recentProjects?.length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Recent Projects</h3>
              <div className="space-y-2">{dash.data.recentProjects.map((p: any) => (
                <div key={p.id} className="flex items-center justify-between p-2.5 rounded-lg bg-gray-50">
                  <div><div className="text-xs font-semibold">{p.title}</div><div className="text-[10px] text-gray-400">{p.subject || '—'} • {p.memberCount || 0} members</div></div>
                  <Badge variant={p.status === 'active' ? 'success' : 'info'} className="text-[9px]">{p.status}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
        </div>
      </div>
    );

    const renderClassrooms = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { crForm.reset(); setColModal({ type: 'classroom' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Classroom</button>
        </div>
        <DataTable columns={[
          { key: 'name', label: 'Classroom', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'subject', label: 'Subject' },
          { key: 'teacherName', label: 'Teacher' },
          { key: 'memberCount', label: 'Members' },
          { key: 'code', label: 'Code', render: (v: string) => v ? <span className="text-[10px] font-mono bg-gray-100 px-1.5 py-0.5 rounded">{v}</span> : '—' },
          { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : 'warning'} className="text-[9px]">{v}</Badge> },
        ]} data={classrooms.data || []} loading={classrooms.loading} error={classrooms.error} onRetry={classrooms.refetch} emptyMessage="No classrooms yet" />
      </div>
    );

    const renderProjects = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { pjForm.reset(); setColModal({ type: 'project' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Project</button>
        </div>
        <DataTable columns={[
          { key: 'title', label: 'Project', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'subject', label: 'Subject' },
          { key: 'memberCount', label: 'Members' },
          { key: 'taskCount', label: 'Tasks' },
          { key: 'due_date', label: 'Due', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : v === 'completed' ? 'info' : 'warning'} className="text-[9px]">{v}</Badge> },
        ]} data={projects.data || []} loading={projects.loading} error={projects.error} onRetry={projects.refetch} emptyMessage="No projects yet" />
      </div>
    );

    const renderDocuments = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { docForm.reset(); setColModal({ type: 'document' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Document</button>
        </div>
        <DataTable columns={[
          { key: 'title', label: 'Title', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'collaboratorCount', label: 'Collaborators' },
          { key: 'version', label: 'Version', render: (v: number) => <span className="text-[10px]">v{v || 1}</span> },
          { key: 'updated_at', label: 'Updated', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          { key: 'id', label: '', render: (_: string, r: any) => <button onClick={(e) => { e.stopPropagation(); }} className="text-[#6D4CFF] text-[10px] hover:underline">Open</button> },
        ]} data={docs.data || []} loading={docs.loading} error={docs.error} onRetry={docs.refetch} emptyMessage="No documents yet" />
      </div>
    );

    const renderForums = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { frForm.reset(); setColModal({ type: 'forum' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Forum</button>
        </div>
        <DataTable columns={[
          { key: 'title', label: 'Forum', render: (v: string, r: any) => <div className="flex items-center gap-2">{r.is_pinned && <MapPin size={12} className="text-[#6D4CFF]" />}<span className="font-semibold text-xs">{v}</span></div> },
          { key: 'description', label: 'Description', render: (v: string) => <span className="text-[10px] text-gray-500 truncate max-w-[200px]">{v || '—'}</span> },
          { key: 'postCount', label: 'Posts' },
        ]} data={forums.data || []} loading={forums.loading} error={forums.error} onRetry={forums.refetch} emptyMessage="No forums yet" />
      </div>
    );

    const renderWhiteboards = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => { wbForm.reset(); setColModal({ type: 'whiteboard' }); }}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Whiteboard</button>
        </div>
        <DataTable columns={[
          { key: 'title', label: 'Whiteboard', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'is_live', label: 'Live', render: (v: boolean) => v ? <Badge variant="danger" className="text-[9px]">Live</Badge> : <span className="text-[10px] text-gray-400">Offline</span> },
          { key: 'updated_at', label: 'Updated', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
        ]} data={whiteboards.data || []} loading={whiteboards.loading} error={whiteboards.error} onRetry={whiteboards.refetch} emptyMessage="No whiteboards yet" />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'classrooms', label: `Classrooms (${(classrooms.data || []).length})` },
      { key: 'projects', label: `Projects (${(projects.data || []).length})` },
      { key: 'documents', label: `Documents (${(docs.data || []).length})` },
      { key: 'forums', label: `Forums (${(forums.data || []).length})` },
      { key: 'whiteboards', label: 'Whiteboards' },
    ];

    return (
      <ModulePage title="Collaboration" desc="Virtual classrooms and project spaces — create classrooms, manage projects, collaborate on documents, and discuss in forums">
        {dash.loading ? <LoadingSkeleton rows={4} cols={4} /> : dash.error ? <ErrorState message={dash.error} onRetry={dash.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setColTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${colTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
                  {tab.label}
                </button>
              ))}
            </div>
            {colTab === 'overview' && renderOverview()}
            {colTab === 'classrooms' && renderClassrooms()}
            {colTab === 'projects' && renderProjects()}
            {colTab === 'documents' && renderDocuments()}
            {colTab === 'forums' && renderForums()}
            {colTab === 'whiteboards' && renderWhiteboards()}
          </>
        )}

        <CrudModal open={!!colModal} onClose={() => setColModal(null)}
          title={colModal?.type === 'classroom' ? 'Create Classroom' : colModal?.type === 'project' ? 'Create Project' : colModal?.type === 'document' ? 'Create Document' : colModal?.type === 'forum' ? 'Create Forum' : 'Create Whiteboard'}>
          {colModal?.type === 'classroom' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Classroom Name</label>
              <input type="text" value={crForm.values.name} onChange={e => crForm.handleChange('name', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Subject</label>
              <input type="text" value={crForm.values.subject} onChange={e => crForm.handleChange('subject', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Description</label>
              <textarea value={crForm.values.description} onChange={e => crForm.handleChange('description', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-20" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Max Students</label>
              <input type="number" value={crForm.values.max_students} onChange={e => crForm.handleChange('max_students', parseInt(e.target.value))} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await collaborationApi.createClassroom({ ...crForm.values, created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { toast.success('Classroom created'); refreshAll(); setColModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Classroom'}</button>
            </div>
          )}
          {colModal?.type === 'project' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Project Title</label>
              <input type="text" value={pjForm.values.title} onChange={e => pjForm.handleChange('title', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Subject</label>
              <input type="text" value={pjForm.values.subject} onChange={e => pjForm.handleChange('subject', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Description</label>
              <textarea value={pjForm.values.description} onChange={e => pjForm.handleChange('description', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-20" /></div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Max Members</label>
                <input type="number" value={pjForm.values.max_members} onChange={e => pjForm.handleChange('max_members', parseInt(e.target.value))} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
                <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Due Date</label>
                <input type="date" value={pjForm.values.due_date} onChange={e => pjForm.handleChange('due_date', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              </div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await collaborationApi.createProject({ ...pjForm.values, created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { toast.success('Project created'); refreshAll(); setColModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Project'}</button>
            </div>
          )}
          {colModal?.type === 'document' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Document Title</label>
              <input type="text" value={docForm.values.title} onChange={e => docForm.handleChange('title', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Content</label>
              <textarea value={docForm.values.content} onChange={e => docForm.handleChange('content', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-32 font-mono" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await collaborationApi.createDocument({ ...docForm.values, created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { toast.success('Document created'); refreshAll(); setColModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Document'}</button>
            </div>
          )}
          {colModal?.type === 'forum' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Forum Title</label>
              <input type="text" value={frForm.values.title} onChange={e => frForm.handleChange('title', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Description</label>
              <textarea value={frForm.values.description} onChange={e => frForm.handleChange('description', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-20" /></div>
              <div className="flex items-center gap-2"><input type="checkbox" checked={!!frForm.values.is_pinned} onChange={e => frForm.handleChange('is_pinned', e.target.checked)} className="rounded" /><span className="text-[10px] text-gray-600">Pin this forum</span></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await collaborationApi.createForum({ ...frForm.values, created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { toast.success('Forum created'); refreshAll(); setColModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Forum'}</button>
            </div>
          )}
          {colModal?.type === 'whiteboard' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Whiteboard Title</label>
              <input type="text" value={wbForm.values.title} onChange={e => wbForm.handleChange('title', e.target.value)} className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button disabled={creating} onClick={async () => {
                setCreating(true); const r = await collaborationApi.createWhiteboard({ ...wbForm.values, created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { toast.success('Whiteboard created'); refreshAll(); setColModal(null); } else toast.error(r.error || 'Failed'); setCreating(false);
              }} className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Whiteboard'}</button>
            </div>
          )}
        </CrudModal>
      </ModulePage>
    );
  }

  function BiometricsTab() {
    const [bioTab, setBioTab] = useState('overview');
    const dash = bioDash;
    const devices = bioDevices;
    const templates = bioTemplates;
    const attendance = bioAttendance;
    const assignments = bioAssignments;
    const [bioModal, setBioModal] = useState<{ type: string; data?: any } | null>(null);
    const [creating, setCreating] = useState(false);

    const refreshAll = () => { dash.refetch(); devices.refetch(); templates.refetch(); attendance.refetch(); assignments.refetch(); };

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <KpiCard icon={Fingerprint} label="Devices" value={dash.data?.summary?.totalDevices || 0} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={CheckCircle2} label="Active Devices" value={dash.data?.summary?.activeDevices || 0} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={Users} label="Templates" value={dash.data?.summary?.activeTemplates || 0} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={Activity} label="Today Logs" value={dash.data?.summary?.todayLogs || 0} color={CLR.warning} bg={`${CLR.warning}10`} />
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
          {dash.data?.deviceBreakdown && Object.keys(dash.data.deviceBreakdown).length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Devices by Type</h3>
              <div className="space-y-2">{Object.entries(dash.data.deviceBreakdown).map(([type, count]: any) => (
                <div key={type} className="flex items-center justify-between p-2 rounded-lg bg-gray-50">
                  <span className="text-xs capitalize">{type.replace('_', ' ')}</span>
                  <Badge className="text-[9px]">{count}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
          {dash.data?.statusBreakdown && Object.keys(dash.data.statusBreakdown).length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Devices by Status</h3>
              <div className="space-y-2">{Object.entries(dash.data.statusBreakdown).map(([status, count]: any) => (
                <div key={status} className="flex items-center justify-between p-2 rounded-lg bg-gray-50">
                  <span className="text-xs capitalize">{status}</span>
                  <Badge variant={status === 'active' ? 'success' : status === 'offline' ? 'danger' : 'warning'} className="text-[9px]">{count}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
          {dash.data?.recentLogs?.length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Recent Activity</h3>
              <div className="space-y-2">{dash.data.recentLogs.slice(0, 8).map((l: any) => (
                <div key={l.id} className="flex items-center justify-between p-2 rounded-lg bg-gray-50">
                  <div><div className="text-[10px] font-semibold">{l.user_type} • {l.verification_type}</div>
                  <div className="text-[9px] text-gray-400">{new Date(l.verified_at).toLocaleString()}</div></div>
                  <Badge variant={l.status === 'verified' ? 'success' : 'danger'} className="text-[9px]">{l.status}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
        </div>
      </div>
    );

    const renderDevices = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setBioModal({ type: 'device' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Device</button>
        </div>
        <DataTable columns={[
          { key: 'device_name', label: 'Device', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'device_type', label: 'Type', render: (v: string) => <span className="capitalize text-[10px]">{v.replace('_', ' ')}</span> },
          { key: 'location', label: 'Location' },
          { key: 'serial_number', label: 'Serial' },
          { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'active' ? 'success' : v === 'offline' ? 'danger' : 'warning'} className="text-[9px]">{v}</Badge> },
          { key: 'last_sync_at', label: 'Last Sync', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          { key: 'id', label: '', render: (_: string, r: any) => <button onClick={() => setBioModal({ type: 'device', data: r })} className="text-[#6D4CFF] text-[10px] hover:underline">Edit</button> },
        ]} data={devices.data || []} loading={devices.loading} error={devices.error} onRetry={devices.refetch} emptyMessage="No devices registered" />
      </div>
    );

    const renderTemplates = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setBioModal({ type: 'template' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ Enroll Template</button>
        </div>
        <DataTable columns={[
          { key: 'user_type', label: 'User Type', render: (v: string) => <span className="capitalize text-xs font-semibold">{v}</span> },
          { key: 'template_type', label: 'Type', render: (v: string) => <span className="capitalize">{v}</span> },
          { key: 'quality_score', label: 'Quality', render: (v: number) => v != null ? <span>{v}%</span> : '—' },
          { key: 'is_active', label: 'Active', render: (v: boolean) => v ? <Badge variant="success" className="text-[9px]">Yes</Badge> : <Badge variant="warning" className="text-[9px]">No</Badge> },
          { key: 'device', label: 'Device', render: (v: any) => v?.device_name || '—' },
          { key: 'enrolled_at', label: 'Enrolled', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
        ]} data={templates.data || []} loading={templates.loading} error={templates.error} onRetry={templates.refetch} emptyMessage="No biometric templates enrolled" />
      </div>
    );

    const renderAttendance = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setBioModal({ type: 'attendance' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ Record Attendance</button>
        </div>
        <DataTable columns={[
          { key: 'user_type', label: 'User', render: (v: string, r: any) => <span className="capitalize text-xs font-semibold">{v} • {r.user_id?.slice(0, 8)}</span> },
          { key: 'verification_type', label: 'Method', render: (v: string) => <span className="capitalize">{v}</span> },
          { key: 'match_score', label: 'Score', render: (v: number) => v != null ? <span>{v}%</span> : '—' },
          { key: 'direction', label: 'Dir', render: (v: string) => v ? <Badge variant={v === 'in' ? 'success' : 'info'} className="text-[9px]">{v}</Badge> : '—' },
          { key: 'device', label: 'Device', render: (v: any) => v?.device_name || '—' },
          { key: 'status', label: 'Status', render: (v: string) => <Badge variant={v === 'verified' ? 'success' : 'danger'} className="text-[9px]">{v}</Badge> },
          { key: 'verified_at', label: 'Time', render: (v: string) => v ? new Date(v).toLocaleString() : '—' },
        ]} data={attendance.data || []} loading={attendance.loading} error={attendance.error} onRetry={attendance.refetch} emptyMessage="No attendance logs yet" />
      </div>
    );

    const renderAssignments = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setBioModal({ type: 'assignment' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Assignment</button>
        </div>
        <DataTable columns={[
          { key: 'device', label: 'Device', render: (v: any) => <span className="font-semibold text-xs">{v?.device_name || '—'}</span> },
          { key: 'location_type', label: 'Location Type', render: (v: string) => <span className="capitalize">{v}</span> },
          { key: 'location_name', label: 'Location Name' },
          { key: 'is_primary', label: 'Primary', render: (v: boolean) => v ? <Badge variant="success" className="text-[9px]">Yes</Badge> : '—' },
        ]} data={assignments.data || []} loading={assignments.loading} error={assignments.error} onRetry={assignments.refetch} emptyMessage="No device assignments" />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'devices', label: `Devices (${(devices.data || []).length})` },
      { key: 'templates', label: `Templates (${(templates.data || []).length})` },
      { key: 'attendance', label: `Attendance (${(attendance.data || []).length})` },
      { key: 'assignments', label: 'Assignments' },
    ];

    return (
      <ModulePage title="Biometrics" desc="Biometric device management and integration — fingerprint, face recognition, and attendance logging">
        {dash.loading ? <LoadingSkeleton rows={3} cols={4} /> : dash.error ? <ErrorState message={dash.error} onRetry={dash.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setBioTab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${bioTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
                  {tab.label}
                </button>
              ))}
            </div>
            {bioTab === 'overview' && renderOverview()}
            {bioTab === 'devices' && renderDevices()}
            {bioTab === 'templates' && renderTemplates()}
            {bioTab === 'attendance' && renderAttendance()}
            {bioTab === 'assignments' && renderAssignments()}
          </>
        )}

        <CrudModal open={!!bioModal} onClose={() => setBioModal(null)}
          title={bioModal?.type === 'device' ? (bioModal.data ? 'Edit Device' : 'New Device') : bioModal?.type === 'template' ? 'Enroll Template' : bioModal?.type === 'attendance' ? 'Record Attendance' : 'Create Assignment'}>
          {bioModal?.type === 'device' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Device Name</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Device Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="fingerprint">Fingerprint</option>
                <option value="face_recognition">Face Recognition</option>
                <option value="iris">Iris Scanner</option>
                <option value="palm">Palm Scanner</option>
                <option value="multi">Multi-modal</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Serial Number</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Location</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">IP Address</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button onClick={async () => { setCreating(true); const r = await biometricsApi.createDevice({ device_name: 'New Device', device_type: 'fingerprint' }); if (r.success) { refreshAll(); setBioModal(null); } setCreating(false); }}
                className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Device'}</button>
            </div>
          )}
          {bioModal?.type === 'template' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">User ID</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">User Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="student">Student</option>
                <option value="staff">Staff</option>
                <option value="parent">Parent</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Template Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="fingerprint">Fingerprint</option>
                <option value="face">Face</option>
                <option value="iris">Iris</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Template Data</label>
              <textarea className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-20 font-mono" /></div>
              <button className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">Enroll Template</button>
            </div>
          )}
          {bioModal?.type === 'attendance' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">User ID</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Verification Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="fingerprint">Fingerprint</option>
                <option value="face">Face</option>
                <option value="iris">Iris</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Direction</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="in">In</option>
                <option value="out">Out</option>
              </select></div>
              <button className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">Record Attendance</button>
            </div>
          )}
          {bioModal?.type === 'assignment' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Device ID</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Location Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="entrance">Entrance</option>
                <option value="classroom">Classroom</option>
                <option value="library">Library</option>
                <option value="lab">Lab</option>
                <option value="hostel">Hostel</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Location Name</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">Create Assignment</button>
            </div>
          )}
        </CrudModal>
      </ModulePage>
    );
  }

  function AnalyticsTab() {
    const [aTab, setATab] = useState('overview');
    const dash = analyticsDash;
    const dashboards = analyticsDashboards;
    const reports = analyticsReports;
    const sources = analyticsDataSources;
    const [aModal, setAModal] = useState<{ type: string; data?: any } | null>(null);
    const [creating, setCreating] = useState(false);
    const [selDashId, setSelDashId] = useState<string | null>(null);
    const [dashWidgets, setDashWidgets] = useState<any[]>([]);

    const refreshAll = () => { dash.refetch(); dashboards.refetch(); reports.refetch(); sources.refetch(); };

    const loadWidgets = async (dashId: string) => {
      const r = await analyticsApi.getWidgets(dashId);
      if (r.success) setDashWidgets(r.data || []);
    };

    const renderOverview = () => (
      <div className="space-y-6">
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <KpiCard icon={LayoutDashboard} label="Dashboards" value={dash.data?.summary?.totalDashboards || 0} color={CLR.primary} bg={`${CLR.primary}10`} />
          <KpiCard icon={FileText} label="Reports" value={dash.data?.summary?.totalReports || 0} color={CLR.info} bg={`${CLR.info}10`} />
          <KpiCard icon={Layers} label="Data Sources" value={dash.data?.summary?.totalDataSources || 0} color={CLR.success} bg={`${CLR.success}10`} />
          <KpiCard icon={Activity} label="Active Sources" value={dash.data?.summary?.activeSources || 0} color={CLR.warning} bg={`${CLR.warning}10`} />
        </div>
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
          {dash.data?.recentDashboards?.length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Recent Dashboards</h3>
              <div className="space-y-2">{dash.data.recentDashboards.map((d: any) => (
                <div key={d.id} className="flex items-center justify-between p-2 rounded-lg bg-gray-50 cursor-pointer hover:bg-gray-100" onClick={() => { setSelDashId(d.id); loadWidgets(d.id); setATab('dashboards'); }}>
                  <div><div className="text-xs font-semibold">{d.name}</div><div className="text-[10px] text-gray-400">{d.widgetCount || 0} widgets</div></div>
                  {d.is_default && <Badge variant="success" className="text-[9px]">Default</Badge>}
                </div>
              ))}</div>
            </Card>
          )}
          {dash.data?.reportsByType && Object.keys(dash.data.reportsByType).length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Reports by Type</h3>
              <div className="space-y-2">{Object.entries(dash.data.reportsByType).map(([type, count]: any) => (
                <div key={type} className="flex items-center justify-between p-2 rounded-lg bg-gray-50">
                  <span className="text-xs capitalize">{type}</span>
                  <Badge className="text-[9px]">{count}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
          {dash.data?.dataSourceTypes && Object.keys(dash.data.dataSourceTypes).length > 0 && (
            <Card className="p-5"><h3 className="font-bold text-sm mb-3">Data Sources</h3>
              <div className="space-y-2">{Object.entries(dash.data.dataSourceTypes).map(([type, count]: any) => (
                <div key={type} className="flex items-center justify-between p-2 rounded-lg bg-gray-50">
                  <span className="text-xs capitalize">{type}</span>
                  <Badge className="text-[9px]">{count}</Badge>
                </div>
              ))}</div>
            </Card>
          )}
        </div>
      </div>
    );

    const renderDashboards = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setAModal({ type: 'dashboard' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Dashboard</button>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {(dashboards.data || []).map((d: any) => (
            <Card key={d.id} className="p-4 hover:shadow-md transition-shadow cursor-pointer" onClick={() => { setSelDashId(d.id); loadWidgets(d.id); }}>
              <div className="flex items-start justify-between mb-3">
                <LayoutDashboard size={18} className="text-[#6D4CFF]" />
                {d.is_default && <Badge variant="success" className="text-[9px]">Default</Badge>}
              </div>
              <div className="text-sm font-bold mb-1">{d.name}</div>
              {d.description && <div className="text-[10px] text-gray-500 mb-3">{d.description}</div>}
              <div className="flex items-center justify-between text-[10px] text-gray-400">
                <span>{d.widgetCount || 0} widgets</span>
                <span>{d.is_public ? 'Public' : 'Private'}</span>
              </div>
            </Card>
          ))}
          {(!dashboards.data || dashboards.data.length === 0) && <EmptyState message="No dashboards yet. Create your first one!" />}
        </div>
        {selDashId && (
          <Card className="p-4 mt-4"><h3 className="font-bold text-sm mb-3">Dashboard Widgets</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              {dashWidgets.map((w: any) => (
                <div key={w.id} className="p-3 rounded-lg border border-gray-100 bg-gray-50">
                  <div className="text-[10px] font-semibold text-gray-500 uppercase">{w.widget_type.replace('_', ' ')}</div>
                  <div className="text-xs font-bold mt-1">{w.title}</div>
                  {w.subtitle && <div className="text-[10px] text-gray-400">{w.subtitle}</div>}
                </div>
              ))}
              {dashWidgets.length === 0 && <div className="text-[10px] text-gray-400 col-span-full">No widgets on this dashboard</div>}
            </div>
          </Card>
        )}
      </div>
    );

    const renderReports = () => (
      <div className="space-y-4">
        <div className="flex justify-end gap-2">
          <button onClick={() => setAModal({ type: 'report' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Report</button>
        </div>
        <DataTable columns={[
          { key: 'name', label: 'Report', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'report_type', label: 'Type', render: (v: string) => <span className="capitalize text-[10px]">{v}</span> },
          { key: 'data_source', label: 'Source' },
          { key: 'is_scheduled', label: 'Scheduled', render: (v: boolean) => v ? <Badge variant="success" className="text-[9px]">Yes</Badge> : '—' },
          { key: 'last_run_at', label: 'Last Run', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          { key: 'last_run_status', label: 'Status', render: (v: string) => v ? <Badge variant={v === 'success' ? 'success' : 'danger'} className="text-[9px]">{v}</Badge> : '—' },
          { key: 'id', label: '', render: (_: string, r: any) => (
            <div className="flex gap-1">
              <button onClick={() => analyticsApi.executeReport(r.id).then(() => toast.success('Report executed'))} className="text-[#6D4CFF] text-[10px] hover:underline">Run</button>
              <button onClick={() => setAModal({ type: 'report', data: r })} className="text-gray-400 text-[10px] hover:underline">Edit</button>
            </div>
          )},
        ]} data={reports.data || []} loading={reports.loading} error={reports.error} onRetry={reports.refetch} emptyMessage="No saved reports" />
      </div>
    );

    const renderDataSources = () => (
      <div className="space-y-4">
        <div className="flex justify-end">
          <button onClick={() => setAModal({ type: 'source' })}
            className="px-3 py-1.5 rounded-lg bg-[#6D4CFF] text-white text-[10px] font-semibold">+ New Data Source</button>
        </div>
        <DataTable columns={[
          { key: 'name', label: 'Source', render: (v: string) => <span className="font-semibold text-xs">{v}</span> },
          { key: 'source_type', label: 'Type', render: (v: string) => <span className="capitalize text-[10px]">{v}</span> },
          { key: 'refresh_strategy', label: 'Refresh', render: (v: string) => <span className="capitalize">{v}</span> },
          { key: 'is_active', label: 'Active', render: (v: boolean) => v ? <Badge variant="success" className="text-[9px]">Active</Badge> : <Badge variant="warning" className="text-[9px]">Inactive</Badge> },
          { key: 'last_sync_at', label: 'Last Sync', render: (v: string) => v ? new Date(v).toLocaleDateString() : '—' },
          { key: 'id', label: '', render: (_: string, r: any) => (
            <div className="flex gap-1">
              <button onClick={() => analyticsApi.testDataSource(r.id).then(() => toast.success('Source tested'))} className="text-[#6D4CFF] text-[10px] hover:underline">Test</button>
            </div>
          )},
        ]} data={sources.data || []} loading={sources.loading} error={sources.error} onRetry={sources.refetch} emptyMessage="No data sources configured" />
      </div>
    );

    const tabs = [
      { key: 'overview', label: 'Overview' },
      { key: 'dashboards', label: `Dashboards (${(dashboards.data || []).length})` },
      { key: 'reports', label: `Reports (${(reports.data || []).length})` },
      { key: 'sources', label: `Data Sources (${(sources.data || []).length})` },
    ];

    return (
      <ModulePage title="Analytics" desc="Advanced analytics and custom dashboards — build custom dashboards, save reports, and visualize institutional data">
        {dash.loading ? <LoadingSkeleton rows={3} cols={4} /> : dash.error ? <ErrorState message={dash.error} onRetry={dash.refetch} /> : (
          <>
            <div className="flex gap-1 mb-6 p-1 bg-gray-50 rounded-xl w-fit overflow-x-auto">
              {tabs.map(tab => (
                <button key={tab.key} onClick={() => setATab(tab.key)}
                  className={`px-4 py-1.5 rounded-lg text-[11px] font-semibold transition-all whitespace-nowrap ${aTab === tab.key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'}`}>
                  {tab.label}
                </button>
              ))}
            </div>
            {aTab === 'overview' && renderOverview()}
            {aTab === 'dashboards' && renderDashboards()}
            {aTab === 'reports' && renderReports()}
            {aTab === 'sources' && renderDataSources()}
          </>
        )}

        <CrudModal open={!!aModal} onClose={() => setAModal(null)}
          title={aModal?.type === 'dashboard' ? 'New Dashboard' : aModal?.type === 'report' ? 'New Report' : 'New Data Source'}>
          {aModal?.type === 'dashboard' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Dashboard Name</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Description</label>
              <textarea className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs h-20" /></div>
              <div className="flex items-center gap-2"><input type="checkbox" className="rounded" /><span className="text-[10px] text-gray-600">Set as default</span></div>
              <button onClick={async () => { setCreating(true); const r = await analyticsApi.createDashboard({ name: 'New Dashboard', description: '', created_by: '00000000-0000-0000-0000-000000000002' }); if (r.success) { refreshAll(); setAModal(null); } setCreating(false); }}
                className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">{creating ? 'Creating...' : 'Create Dashboard'}</button>
            </div>
          )}
          {aModal?.type === 'report' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Report Name</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Report Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="tabular">Tabular</option>
                <option value="summary">Summary</option>
                <option value="comparison">Comparison</option>
                <option value="trend">Trend</option>
                <option value="custom">Custom</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Data Source</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <button className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">Create Report</button>
            </div>
          )}
          {aModal?.type === 'source' && (
            <div className="space-y-3">
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Source Name</label>
              <input type="text" className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs" /></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Source Type</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="supabase">Supabase</option>
                <option value="database">Database</option>
                <option value="api">API</option>
                <option value="csv">CSV</option>
                <option value="custom">Custom</option>
              </select></div>
              <div><label className="text-[10px] font-semibold text-gray-600 mb-1 block">Refresh Strategy</label>
              <select className="w-full px-3 py-2 border border-gray-200 rounded-lg text-xs">
                <option value="manual">Manual</option>
                <option value="scheduled">Scheduled</option>
                <option value="realtime">Realtime</option>
              </select></div>
              <button className="w-full py-2.5 rounded-lg bg-[#6D4CFF] text-white text-xs font-semibold">Create Data Source</button>
            </div>
          )}
        </CrudModal>
      </ModulePage>
    );
  }

  // ======================== MAIN RENDER ========================
  return (
    <div className="app-layout">
      <div className={`sidebar-overlay ${sidebarOpen ? 'open' : ''}`} onClick={() => setSidebarOpen(false)} />

      <aside className={`sidebar ${sidebarOpen ? 'open' : ''}`}>
        <div className="sidebar-logo">
          <div className="sidebar-logo-icon">P</div>
          <div><div className="sidebar-logo-text">Prasunet ERP</div><div className="sidebar-logo-badge">School Operating System</div></div>
        </div>
        <nav className="sidebar-nav">
          {navGroups.map(group => (
            <div key={group.label}>
              <div className="sidebar-section-label">{group.label}</div>
              {group.items.map(item => (
                <NavItem key={item.key} item={item} isActive={activeTab === item.key} />
              ))}
            </div>
          ))}
        </nav>
        <div className="sidebar-footer">
          <button className="sidebar-footer-item" onClick={logout}><LogOut size={14} /><span>Sign Out</span></button>
        </div>
      </aside>

      <main className="main-content">
        <header className="header">
          <div className="header-left">
            <button className="header-mobile-btn" onClick={() => setSidebarOpen(true)}><Menu size={19} /></button>
            <div className="hidden lg:flex search-bar">
              <Search size={16} />
              <input type="text" placeholder="Search students, staff, classes..." value={searchQuery} onChange={e => setSearchQuery(e.target.value)} />
              <span className="search-badge"><Sparkles size={10} /> AI</span>
            </div>
          </div>
          <div className="header-right">
            <LanguageSwitcher />
            <div className="header-divider" />
            <button className="header-btn" onClick={() => setDarkMode(!darkMode)}>{darkMode ? <Sun size={17} /> : <Moon size={17} />}</button>
            <div className="header-divider" />
            <div className="relative" ref={notifRef}>
              <button className="header-btn" onClick={() => setShowNotifDropdown(!showNotifDropdown)}>
                <Bell size={17} />
                {unreadCount > 0 && (
                  <span className="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 rounded-full text-white text-[8px] font-bold flex items-center justify-center">
                    {unreadCount > 99 ? '99+' : unreadCount}
                  </span>
                )}
              </button>
              {showNotifDropdown && (
                <motion.div initial={{ opacity: 0, y: 8, scale: 0.96 }} animate={{ opacity: 1, y: 0, scale: 1 }}
                  className="absolute right-0 top-full mt-2 w-[360px] bg-white rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.12)] border border-gray-100 z-50 overflow-hidden">
                  <div className="p-4 border-b border-gray-100 flex items-center justify-between">
                    <h3 className="font-bold text-sm">Notifications</h3>
                    {unreadCount > 0 && (
                      <button className="text-[10px] text-[#6D4CFF] font-semibold hover:underline"
                        onClick={async () => {
                          await notificationApi.markAllAsRead();
                          setNotifList(prev => prev.map((n: any) => ({ ...n, read: true })));
                          setUnreadCount(0);
                        }}>
                        Mark all read
                      </button>
                    )}
                  </div>
                  <div className="max-h-80 overflow-y-auto">
                    {notifList.length === 0 ? (
                      <div className="p-8 text-center text-xs text-gray-400">No notifications</div>
                    ) : (notifList.map((n: any) => (
                      <div key={n.id}
                        className={`p-3.5 border-b border-gray-50 hover:bg-gray-50 transition-colors cursor-pointer $                    {!n.read ? 'bg-[#F3F0FF]/40' : ''}`}
                        onClick={async () => {
                          if (!n.read) {
                            await notificationApi.markAsRead(n.id);
                            setNotifList(prev => prev.map(x => x.id === n.id ? { ...x, read: true } : x));
                            setUnreadCount(prev => Math.max(0, prev - 1));
                          }
                        }}>
                        <div className="flex items-start gap-2.5">
                          <div className={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${
                            n.type === 'danger' ? 'bg-red-500' :
                            n.type === 'warning' ? 'bg-amber-500' :
                            n.type === 'success' ? 'bg-green-500' : 'bg-[#6D4CFF]'
                          }`} />
                          <div className="flex-1 min-w-0">
                            <div className={`text-xs ${!n.read ? 'font-semibold' : 'font-medium'}`}>{n.title || 'Notification'}</div>
                            <div className="text-[11px] text-gray-400 mt-0.5 line-clamp-2">{n.message || ''}</div>
                            <div className="text-[10px] text-gray-300 mt-1">
                              {n.created_at ? (() => {
                                const diff = Date.now() - new Date(n.created_at).getTime();
                                const mins = Math.floor(diff / 60000);
                                if (mins < 1) return 'Just now';
                                if (mins < 60) return `${mins}m ago`;
                                const hours = Math.floor(mins / 60);
                                if (hours < 24) return `${hours}h ago`;
                                const days = Math.floor(hours / 24);
                                return `${days}d ago`;
                              })() : ''}
                            </div>
                          </div>
                        </div>
                      </div>
                    )))}
                  </div>
                </motion.div>
              )}
            </div>
            <div className="header-divider" />
            <div className="flex items-center gap-2.5 cursor-pointer">
              <Avatar className="w-8 h-8 ring-2 ring-[#F3F0FF]">
                <div className="flex h-full w-full items-center justify-center bg-gradient-to-br from-[#6D4CFF] to-[#8B5CF6] text-white text-xs font-bold rounded-full">{userInitials}</div>
              </Avatar>
              <div className="hidden sm:block">
                <div className="text-xs font-semibold">{session?.user?.full_name || 'Administrator'}</div>
                <div className="text-[10px] text-gray-400">School Admin</div>
              </div>
            </div>
          </div>
        </header>

        <div className="page">
          <Toaster />
          <AnimatePresence mode="wait">
            <motion.div key={activeTab} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }} transition={{ duration: 0.2 }}>
              {activeTab === 'dashboard' ? renderDashboard() : renderModule()}
            </motion.div>
          </AnimatePresence>
        </div>
      </main>
    </div>
  );
}
