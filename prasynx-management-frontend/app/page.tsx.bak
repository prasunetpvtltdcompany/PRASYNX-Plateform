                        <span className="font-bold text-gray-800 text-sm capitalize">{selectedStaff.department || '—'}</span>
                      </div>
                      <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                        <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Qualification</span>
                        <span className="font-bold text-gray-800 text-sm">{selectedStaff.qualification || '—'}</span>
                      </div>
