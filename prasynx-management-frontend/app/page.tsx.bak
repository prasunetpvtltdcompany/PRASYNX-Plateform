                          <option value="librarian">Librarian Assignment</option>
                          <option value="accountant">Accountant Assignment</option>
                          <option value="receptionist">Receptionist Assignment</option>
                          <option value="driver">Bus Driver Assignment</option>
                          <option value="transport_manager">Transport Manager Assignment</option>
                          <option value="security">Security Duty Assignment</option>
                          <option value="housekeeping">Housekeeping Assignment</option>
                          <option value="nurse">Nurse Assignment</option>
                          <option value="it_support">IT Support Assignment</option>
                          <option value="sports">Sports Coach Assignment</option>
                          <option value="hostel">Hostel Warden Assignment</option>
                          <option value="general">Other / General Staff Duty</option>
                        </select>
                      </div>

                      {/* Dynamic Form Mappings */}
                      <div className="space-y-3 border-t border-gray-50 pt-3">
                        {selectedAssignRole === 'teacher' && (
