                      <p className="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Assigned Classes</p>
                      <p className="text-2xl font-extrabold text-purple-700 mt-1">{statsCards.classes}</p>
                    </div>
                    <div className="bg-white p-4 rounded-xl border-l-4 border-l-blue-500 border border-gray-100 shadow-sm">
