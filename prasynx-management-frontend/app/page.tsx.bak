                            <span className="font-bold text-gray-800 text-xs">{selectedStaff.city || '—'}{selectedStaff.state ? `, ${selectedStaff.state}` : ''}</span>
                          </div>
                          <div className="bg-gray-50/60 p-3 rounded-lg border border-gray-100/80">
                            <span className="text-gray-400 block font-semibold text-[10px] uppercase tracking-wider mb-1">Pin Code / Country</span>
                            <span className="font-bold text-gray-800 text-xs">{selectedStaff.postal_code || '—'}{selectedStaff.country ? `, ${selectedStaff.country}` : ''}</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div className="bg-white rounded-xl p-5 border border-gray-100 shadow-sm flex flex-col justify-between">
