                                  return (
                                    <label key={resp} className="flex items-center gap-2 font-medium text-gray-700 cursor-pointer">
                                      <input 
                                        type="checkbox"
                                        checked={checked}
                                        onChange={e => {
                                          const next = e.target.checked 
                                            ? [...list, resp]
                                            : list.filter((r: string) => r !== resp);
                                          setAssignFormPayload((p: any) => ({ ...p, responsibilities: next }));
                                        }}
                                        className="rounded text-purple-600 border-gray-300 w-3.5 h-3.5"
                                      />
