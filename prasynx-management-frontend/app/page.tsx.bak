                                    <span key={s.id} className="bg-blue-50 text-blue-700 border border-blue-100 rounded-lg px-2.5 py-1 font-bold flex items-center gap-1.5">
                                      <span>{s.subjects?.name || 'Subject'}</span>
                                      <button 
                                        onClick={() => handleRemoveAssignment('teacher_subject', s.id)}
                                        className="text-blue-400 hover:text-red-500 font-bold transition-all"
                                      >
                                        ×
                                      </button>
                                    </span>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* Class Teachers */}
                            {assignmentsData.class_teachers?.length > 0 && (
                              <div className="space-y-2">
                                <h5 className="font-bold text-indigo-600 text-[10px] uppercase tracking-wider">Class Teacher Supervision</h5>
                                <div className="space-y-2">
                                  {assignmentsData.class_teachers.map((ct: any) => (
                                    <div key={ct.id} className="bg-indigo-50/40 border border-indigo-100 rounded-xl p-3 flex items-start justify-between gap-3">
                                      <div className="space-y-1">
                                        <p className="font-bold text-indigo-950">
                                          🏫 Class Teacher: {ct.classes?.name} - {ct.sections?.name || 'All Sections'}
                                        </p>
                                        {Array.isArray(ct.responsibilities) && ct.responsibilities.length > 0 && (
                                          <div className="flex flex-wrap gap-1 mt-1">
                                            {ct.responsibilities.map((r: string, idx: number) => (
