generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  management
  staff
  teacher
  student
  parent
  jobprovider
  organization
  recruiter
}

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?  @map("logo_url")
  status    String   @default("active")

  users      User[]
  classes    Class[]
  subjects   Subject[]
  teachers   Teacher[]
  students   Student[]

  timetableEntries        TimetableEntry[]
  attendanceRecords       AttendanceRecord[]
  exams                   Exam[]
  examSchedules           ExamSchedule[]
  examResults             ExamResult[]
  assignments             Assignment[]
  libraryBooks            LibraryBook[]
  libraryIssues           LibraryIssue[]
  feeStructures           FeeStructure[]
  studentFees             StudentFee[]
  feePayments             FeePayment[]
  announcements           Announcement[]
  events                  Event[]
  transportRoutes         TransportRoute[]
  transportVehicles       TransportVehicle[]
  transportAssignments    TransportAssignment[]
  hostelRooms             HostelRoom[]
  hostelAllocations       HostelAllocation[]
  grades                  Grade[]
  scholarships            Scholarship[]
  clubs                   Club[]
  careerSessions          CareerSession[]
  healthRecords           HealthRecord[]
  partTimeJobs            PartTimeJob[]
  leaveApplications       LeaveApplication[]
  complaints              Complaint[]
  documents               Document[]
  qrSessions              QrSession[]
  auditLogs               AuditLog[]
  classSubjectTeacherMaps ClassSubjectTeacherMap[]
  payrollRecords          PayrollRecord[]
  ledgerEntries           LedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organisations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fullName       String   @map("full_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           UserRole
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  status         String   @default("active")
  lastLogin      DateTime? @map("last_login")
  twoFactorSecret String? @map("two_factor_secret")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  teacherProfile  Teacher?
  studentProfile  Student?
  parentLinks     ParentStudentLink[] @relation("parent")
  studentLinks    ParentStudentLink[] @relation("student")

  sentMessages     DirectMessage[] @relation("sender")
  receivedMessages DirectMessage[] @relation("recipient")

  announcements      Announcement[]
  leaveApplications  LeaveApplication[]
  complaints         Complaint[]
  documents          Document[]
  auditLogs          AuditLog[]
  qrSessions         QrSession[]
  sessions           UserSession[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  oauthAccounts      OauthAccount[]
  partTimeJobApps    PartTimeJobApplication[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([role])
  @@map("users")
}

model Teacher {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacherCode    String   @unique @map("teacher_code")
  fullName       String   @map("full_name")
  email          String?
  phone          String?
  subject        String?
  assignedClass  String?  @map("assigned_class") @db.Uuid
  classRelation  Class?   @relation(fields: [assignedClass], references: [id], onDelete: SetNull)
  qualification  String?
  joinDate       DateTime? @map("join_date") @db.Date
  status         String   @default("active")

  timetableEntries       TimetableEntry[]
  attendanceRecords      AttendanceRecord[]
  assignments            Assignment[]
  libraryIssues          LibraryIssue[]
  grades                 Grade[]
  qrSessions             QrSession[]
  classSubjectTeacherMaps ClassSubjectTeacherMap[]
  payrollRecords         PayrollRecord[]
  feeItems               FeeItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@map("teachers")
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String   @map("full_name")
  rollNumber     String?  @map("roll_number")
  studentClass   String?  @map("student_class") @db.Uuid
  class          Class?   @relation(fields: [studentClass], references: [id], onDelete: SetNull)
  section        String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?
  address        String?
  phone          String?
  email          String?
  parentName     String?  @map("parent_name")
  parentEmail    String?  @map("parent_email")
  parentPhone    String?  @map("parent_phone")
  bloodGroup     String?  @map("blood_group")
  status         String   @default("active")

  attendanceRecords      AttendanceRecord[]
  examResults            ExamResult[]
  assignmentSubmissions  AssignmentSubmission[]
  libraryIssues          LibraryIssue[]
  studentFees            StudentFee[]
  feePayments            FeePayment[]
  hostelAllocations      HostelAllocation[]
  parentLinks            ParentStudentLink[]
  grades                 Grade[]
  scholarships           Scholarship[]
  healthRecords          HealthRecord[]
  jobApplications        PartTimeJobApplication[]
  canteenBalances        CanteenBalance[]
  canteenOrders          CanteenOrder[]
  transportAssignments   TransportAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([studentClass])
  @@map("students")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  section        String?
  gradeLevel     String?  @map("grade_level")
  capacity       Int?     @default(30)
  status         String   @default("active")

  students                 Student[]
  teachers                 Teacher[]
  timetableEntries         TimetableEntry[]
  examSchedules            ExamSchedule[]
  assignments              Assignment[]
  feeStructures            FeeStructure[]
  announcements            Announcement[]
  classSubjectTeacherMaps  ClassSubjectTeacherMap[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("classes")
}

model Subject {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  description    String?

  timetableEntries       TimetableEntry[]
  examSchedules          ExamSchedule[]
  examResults            ExamResult[]
  assignments            Assignment[]
  grades                 Grade[]
  classSubjectTeacherMaps ClassSubjectTeacherMap[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subjects")
}

model TimetableEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  classId        String   @map("class_id") @db.Uuid
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String   @map("subject_id") @db.Uuid
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String?  @map("teacher_id") @db.Uuid
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek      Int      @map("day_of_week")
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time
  room           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("timetable_entries")
}

model AttendanceRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studentId      String   @map("student_id") @db.Uuid
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String?  @map("teacher_id") @db.Uuid
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  date           DateTime @db.Date
  status         String
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@map("attendance_records")
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  examType       String?  @map("exam_type")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  maxMarks       Int?     @default(100) @map("max_marks")
  status         String   @default("upcoming")

  schedules  ExamSchedule[]
  results    ExamResult[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exams")
}

model ExamSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  examId         String   @map("exam_id") @db.Uuid
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId        String   @map("class_id") @db.Uuid
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String   @map("subject_id") @db.Uuid
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date           DateTime? @db.Date
  startTime      DateTime? @map("start_time") @db.Time
  endTime        DateTime? @map("end_time") @db.Time
  room           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("exam_schedules")
}

model ExamResult {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  examId         String   @map("exam_id") @db.Uuid
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String   @map("student_id") @db.Uuid
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String?  @map("subject_id") @db.Uuid
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  marksObtained  Decimal? @map("marks_obtained") @db.Decimal(5, 2)
  maxMarks       Decimal? @default(100) @map("max_marks") @db.Decimal(5, 2)
  grade          String?
  remarks        String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([examId, studentId, subjectId])
  @@index([studentId])
  @@index([examId])
  @@map("exam_results")
}

model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teacherId      String?  @map("teacher_id") @db.Uuid
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId      String?  @map("subject_id") @db.Uuid
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classId        String   @map("class_id") @db.Uuid
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  dueDate        DateTime @map("due_date") @db.Date
  maxScore       Decimal? @default(100) @map("max_score") @db.Decimal(5, 2)
  fileUrl        String?  @map("file_url")
  status         String   @default("active")

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String   @map("student_id") @db.Uuid
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionText String?  @map("submission_text")
  fileUrl        String?  @map("file_url")
  grade          Decimal? @db.Decimal(5, 2)
  feedback       String?
  submittedAt    DateTime @default(now()) @map("submitted_at")
  status         String   @default("submitted")

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model LibraryBook {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String?  @map("organisation_id") @db.Uuid
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title           String
  author          String?
  isbn            String?
  category        String?
  publisher       String?
  publishYear     Int?     @map("publish_year")
  copiesTotal     Int?     @default(1) @map("copies_total")
  copiesAvailable Int?     @default(1) @map("copies_available")
  shelfLocation   String?  @map("shelf_location")
  status          String   @default("active")

  issues LibraryIssue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("library_books")
}

model LibraryIssue {
  id          String   @id @default(uuid()) @db.Uuid
  organisationId String? @map("organisation_id") @db.Uuid
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bookId      String   @map("book_id") @db.Uuid
  book        LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId   String   @map("student_id") @db.Uuid
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy    String?  @map("issued_by") @db.Uuid
  issuer      Teacher? @relation(fields: [issuedBy], references: [id], onDelete: SetNull)
  issueDate   DateTime @default(now()) @map("issue_date") @db.Date
  dueDate     DateTime @map("due_date") @db.Date
  returnDate  DateTime? @map("return_date") @db.Date
  status      String   @default("issued")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookId])
  @@index([studentId])
  @@map("library_issues")
}

model FeeStructure {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  classId        String?  @map("class_id") @db.Uuid
  class          Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear   String?  @map("academic_year")
  totalAmount    Decimal? @default(0) @map("total_amount") @db.Decimal(10, 2)
  status         String   @default("active")

  items      FeeItem[]
  studentFees StudentFee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fee_structures")
}

model FeeItem {
  id             String   @id @default(uuid()) @db.Uuid
  feeStructureId String   @map("fee_structure_id") @db.Uuid
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  itemName       String   @map("item_name")
  amount         Decimal  @db.Decimal(10, 2)
  teacherId      String?  @map("teacher_id") @db.Uuid
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("fee_items")
}

model StudentFee {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studentId      String   @map("student_id") @db.Uuid
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String?  @map("fee_structure_id") @db.Uuid
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
  paidAmount     Decimal? @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueDate        DateTime? @map("due_date") @db.Date
  status         String   @default("pending")

  payments FeePayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_fees")
}

model FeePayment {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studentFeeId   String   @map("student_fee_id") @db.Uuid
  studentFee     StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  studentId      String?  @map("student_id") @db.Uuid
  student        Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  amountPaid     Decimal  @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod  String?  @map("payment_method")
  transactionId  String?  @map("transaction_id")
  paymentDate    DateTime @default(now()) @map("payment_date")
  receiptUrl     String?  @map("receipt_url")
  status         String   @default("completed")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("fee_payments")
}

model Announcement {
  id            String   @id @default(uuid()) @db.Uuid
  organisationId String? @map("organisation_id") @db.Uuid
  organisation  Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy     String?  @map("created_by") @db.Uuid
  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  title         String
  content       String
  targetRole    String?  @map("target_role")
  targetClassId String?  @map("target_class_id") @db.Uuid
  targetClass   Class?   @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  priority      String   @default("normal")
  publishedAt   DateTime @default(now()) @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@map("announcements")
}

model Event {
  id            String   @id @default(uuid()) @db.Uuid
  organisationId String? @map("organisation_id") @db.Uuid
  organisation  Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  eventType     String?  @map("event_type")
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  startTime     DateTime? @map("start_time") @db.Time
  endTime       DateTime? @map("end_time") @db.Time
  location      String?
  status        String   @default("upcoming")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@map("events")
}

model ParentStudentLink {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String   @map("parent_id") @db.Uuid
  parent       User     @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String   @map("student_id") @db.Uuid
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_student_links")
}

model DirectMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  sender      User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String    @map("recipient_id") @db.Uuid
  recipient   User      @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String?
  message     String
  fileUrl     String?   @map("file_url")
  readAt      DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([senderId])
  @@map("direct_messages")
}

model TransportRoute {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  routeName      String   @map("route_name")
  startPoint     String?  @map("start_point")
  endPoint       String?  @map("end_point")
  stops          Json?    @db.JsonB
  distance       Decimal? @db.Decimal(8, 2)
  status         String   @default("active")

  vehicles    TransportVehicle[]
  assignments TransportAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("transport_routes")
}

model TransportVehicle {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vehicleNumber  String   @map("vehicle_number")
  routeId        String?  @map("route_id") @db.Uuid
  route          TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  driverName     String?  @map("driver_name")
  driverPhone    String?  @map("driver_phone")
  capacity       Int?     @default(40)
  vehicleType    String?  @map("vehicle_type")
  status         String   @default("active")

  assignments TransportAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("transport_vehicles")
}

model TransportAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studentId      String   @map("student_id") @db.Uuid
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vehicleId      String   @map("vehicle_id") @db.Uuid
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId        String?  @map("route_id") @db.Uuid
  route          TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  pickupPoint    String?  @map("pickup_point")
  dropPoint      String?  @map("drop_point")
  status         String   @default("active")

  @@unique([studentId])
  @@map("transport_assignments")
}

model HostelRoom {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
