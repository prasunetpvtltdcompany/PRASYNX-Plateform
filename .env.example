# =============================================================================
# PRASYNX PLATFORM - Environment Template
# Copy to server/.env (never commit .env files)
# =============================================================================

# --- HTTP --------------------------------------------------------------------
PORT=4000

# --- Supabase (Database + Storage ONLY - never call from frontend) -----------
SUPABASE_URL=https://your-project.supabase.co
# Service-role key. Server-side ONLY. Bypasses RLS; use only in repositories for admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon key. Used to build the per-request RLS client from an authenticated user's JWT.
SUPABASE_ANON_KEY=your-anon-key

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ISSUER=prasynx-api
JWT_AUDIENCE=prasynx-portals
# Access token lifetime (short)
JWT_ACCESS_TTL=15m
# Refresh token lifetime (long)
JWT_REFRESH_TTL=30d
# bcrypt cost
BCRYPT_ROUNDS=12

# --- Redis (optional in dev; in-memory fallback when unset) ------------------
REDIS_URL=

# --- CORS --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# --- Mail --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PRASYNX <no-reply@yourdomain.com>
FRONTEND_URL=http://localhost:3000