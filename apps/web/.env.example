# =============================================================================
# PRASYNX WEB (.env for apps/web, or as NEXT_PUBLIC_* / process env at runtime)
# Copy to apps/web/.env.local (never commit .env files)
# =============================================================================

# Base URL of the PRASYNX monolith API. All /api/v1/* requests from the browser
# are rewritten here by next.config.ts, so the app never calls another origin.
# Three ways to set: env var, apps/web/.env.local, or this file copied there.
API_BASE_URL=http://localhost:4000

# When true, Next.js/React run in strict mode (recommended, default true).
NEXT_PUBLIC_APP_NAME=PRASYNX